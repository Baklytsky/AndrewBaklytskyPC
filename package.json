{
  "name": "carbone-vite",
  "author": "Presidio Creative",
  "license": "Copyright Presidio Creative",
  "version": "1.0.0",
  "description": "",
  "main": "vite.config.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --raw --kill-others --passthrough-arguments \"npm run shopify:dev\" \"npm run vite:dev\"",
    "shopify:dev": "shopify theme dev -e production",
    "vite:dev": "vite dev",
    "pull:settings": "shopify theme pull --only='config/*.json'  --only='sections/*.json'  --only='templates/*.json'",
    "pull:updates": "shopify theme pull --path=src/ --only='assets/swatches.css' --only='assets/design-mode.css' --only='layout/'  --only='config/*.json' --only='sections/' --only='snippets/' --only='templates/**/*.json' && find snippets/ -name 'icon-*' -delete",
    "deploy": "npm run build && npm run shopify:push",
    "shopify:push": "shopify theme push -e production",
    "build": "vite build"
  },
  "keywords": [],
  "devDependencies": {
    "@by-association-only/vite-plugin-shopify-clean": "^1.2.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.3",
    "postcss-load-config": "^5.0.2",
    "sass": "^1.82.0",
    "vite": "^5.2.5",
    "vite-plugin-shopify": "^3.1.1"
  },
  "dependencies": {
    "@shopify/theme-addresses": "4.1.1",
    "@shopify/theme-images": "4.1.1",
    "flickity": "3.0.0",
    "flickity-fade": "2.0.0",
    "photoswipe": "4.1.3",
    "scroll-lock": "^2.1.5",
    "vite-plugin-page-reload": "^0.2.0",
    "swiper": "^11.2.6"
  }
}