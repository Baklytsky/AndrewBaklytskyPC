{
  "name": "andrewbaklytsky",
  "version": "1.0.0",
  "description": "",
  "main": "vite.config.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --raw --kill-others --passthrough-arguments \"npm run shopify:dev\" \"npm run vite:dev\"",
    "shopify:dev": "shopify theme dev -e dev",
    "vite:dev": "vite",
    "pull:settings": "shopify theme pull --only='config/*.json'  --only='sections/*.json'  --only='templates/*.json'",
    "pull:updates": "shopify theme pull",
    "deploy": "npm run build && npm run shopify:push",
    "shopify:push": "shopify theme push -e dev",
    "build": "vite build",
    "login": "shopify theme open -s andrewbaklytsky.myshopify.com"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@by-association-only/vite-plugin-shopify-clean": "^1.2.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.49",
    "postcss-load-config": "^5.0.2",
    "sass": "^1.82.0",
    "swiper": "^9.4.1",
    "vite": "^5.2.5",
    "vite-plugin-shopify": "^3.1.1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "axios": "^1.8.2",
    "dialog-polyfill": "^0.5.6",
    "nouislider": "^15.7.0",
    "pinia": "^2.0.23",
    "swiper": "^9.4.1",
    "tailwindcss": "^4.0.6",
    "vite-plugin-page-reload": "^0.2.0",
    "vue3-touch-events": "^5.0.13"
  }
}
