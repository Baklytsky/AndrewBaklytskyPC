{
  "name": "carbone-vite",
  "author": "Presidio Creative",
  "license": "Copyright Presidio Creative",
  "version": "1.0.0",
  "description": "",
  "main": "vite.config.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --raw --kill-others --passthrough-arguments \"npm run shopify:dev\" \"npm run vite:dev\"",
    "shopify:dev": "shopify theme dev -e production",
    "vite:dev": "vite dev",
    "pull:settings": "shopify theme pull --only='config/*.json'  --only='sections/*.json'  --only='templates/*.json'",
    "pull:updates": "shopify theme pull --path=src/ --only='assets/swatches.css' --only='assets/design-mode.css' --only='layout/'  --only='config/*.json' --only='sections/' --only='snippets/' --only='templates/' && find snippets/ -name 'icon-*' -delete",
    "deploy": "npm run build && npm run shopify:push",
    "shopify:push": "shopify theme push -e production",
    "build": "vite build",
    "zip": "npm run build && mkdir -p upload && timestamp=$(date +%Y%m%d%H%M%S) && zip_file=\"upload/theme-${timestamp}.zip\" && rm -f \"$zip_file\" && find layout -type f -name \"*.liquid\" | zip -r \"$zip_file\" assets config locales sections snippets templates -@ -x \"**/.*\" -x \"**/.DS_Store\" && echo \"Theme zip created at $zip_file\""
  },
  "keywords": [],
  "devDependencies": {
    "@by-association-only/vite-plugin-shopify-clean": "^1.2.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.3",
    "postcss-load-config": "^5.0.2",
    "sass": "^1.82.0",
    "vite": "^6.3.5",
    "vite-plugin-shopify": "^3.1.1"
  },
  "dependencies": {
    "@shopify/cli": "^3.58.2",
    "@shopify/theme-addresses": "4.1.1",
    "@shopify/theme-images": "4.1.1",
    "photoswipe": "4.1.3",
    "scroll-lock": "^2.1.5",
    "swiper": "^11.2.6",
    "vite-plugin-page-reload": "^0.2.0"
  }
}
