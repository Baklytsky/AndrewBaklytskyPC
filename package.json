{
  "name": "carbon",
  "version": "1.0.0",
  "license": "Copyright Presidio Creative",
  "private": true,
  "scripts": {
    "build": "gulp",
    "build:assets": "NODE_ENV=production gulp",
    "build:external": "NODE_ENV=development gulp",
    "zip": "NODE_ENV=production gulp zip ",
    "start": "gulp watch",
    "deploy": "NODE_ENV=production gulp deploy",
    "deploy:prod": "NODE_ENV=production gulp deploy --env production",
    "deploy:update": "NODE_ENV=production gulp deploy --nodelete",
    "test": "gulp && theme-check",
    "lint": "eslint --max-warnings 0 src/",
    "pull:updates": "shopify theme pull --path=src/ --only='assets/swatches.css' --only='assets/design-mode.css' --only='layout/'  --only='config/*.json' --only='sections/' --only='snippets/' --only='templates/' && find src/snippets/ -name 'icon-*' -delete"
  },
  "devDependencies": {
    "@babel/core": "^7.21.4",
    "@babel/eslint-parser": "^7.21.3",
    "@lhci/cli": "0.10.0",
    "@rollup/plugin-buble": "0.21.3",
    "@rollup/plugin-commonjs": "21.1.0",
    "@rollup/plugin-node-resolve": "13.2.1",
    "@shopify/eslint-plugin": "^42.1.0",
    "@swc/core": "1.2.181",
    "ansi-colors": "4.1.3",
    "autoprefixer": "10.4.13",
    "babel-eslint": "^10.1.0",
    "css-loader": "^6.7.3",
    "del": "6.0.0",
    "eslint": "^8.45.0",
    "eslint-plugin-compat": "4.0.2",
    "eslint-plugin-no-only-tests": "^3.1.0",
    "eslint-plugin-only-warn": "1.1.0",
    "eslint-plugin-plugin": "^0.0.1",
    "eslint-plugin-prettier": "4.2.1",
    "fancy-log": "2.0.0",
    "gulp": "5.0.1",
    "gulp-cheerio": "1.0.0",
    "gulp-cssimport": "7.0.0",
    "gulp-dart-sass": "^1.1.0",
    "gulp-if": "3.0.0",
    "gulp-plumber": "1.2.1",
    "gulp-postcss": "9.0.1",
    "gulp-rename": "2.0.0",
    "gulp-size": "4.0.1",
    "gulp-svgmin": "4.1.0",
    "gulp-transform": "3.0.5",
    "gulp-zip": "5.1.0",
    "html-webpack-plugin": "5.5.0",
    "liquidjs": "10.0.0",
    "mochawesome": "7.1.3",
    "postcss": "^8.4.35",
    "postcss-loader": "^7.3.0",
    "postcss-scss": "4.0.6",
    "prettier": "2.6.2",
    "prettier-eslint": "13.0.0",
    "rollup": "2.79.2",
    "rollup-plugin-inject-process-env": "^1.3.1",
    "rollup-plugin-multi-input": "1.3.1",
    "rollup-plugin-sizes": "1.0.4",
    "rollup-plugin-swc": "0.2.1",
    "rollup-plugin-terser": "7.0.2",
    "rollup-plugin-visualizer": "5.6.0",
    "stylelint": "14.6.1",
    "stylelint-config-recommended": "^14.0.1",
    "stylelint-config-shopify": "7.4.0",
    "stylelint-config-standard": "^36.0.1",
    "webpack": "5.94.0",
    "webpack-dev-server": "5.2.1",
    "yargs": "17.6.2"
  },
  "dependencies": {
    "sass": "^1.72.0",
    "@shopify/theme-addresses": "4.1.1",
