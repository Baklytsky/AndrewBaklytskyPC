// cSpell Settings
{
  // Version of the setting file.  Always 0.2
  "version": "0.2",
  // language - current active spelling language
  "language": "en",
  // words - list of words to be always considered correct
  "words": [
    "lookbook",
    "frontpage",
    "metafields",
    "Blas",
    "Rauser",
    "Bizcaino",
    "Luffin",
    "Elouise",
    "datetime",
    "clearfix",
    "linklist",
    "linklists",
    "larr",
    "rarr",
    "endcase",
    "endcapture",
    "endpaginate",
    "endfor",
    "endif",
    "endstyle",
    "endschema",
    "endform",
    "endunless",
    "flickity",
    "forloop",
    "autocorrect",
    "autocapitalize",
    "handleize",
    "fieldset",
    "stylesheet",
    "MSIE",
    "photoswipe",
    "smoothscroll",
    "rgba",
    "endcomment",
    "crossorigin",
    "upsell",
    "quickview",
    "preconnect",
    "ndash",
    "popdown",
    "fullwidth",
    "classlist",
    "labelledby",
    "autofocus",
    "tabindex",
    "Orban",
    "Orbani"
  ],
  "files": [
    "/**/config/settings_data.json",
    "/**/config/settings_schema.json",
    "/**/js/*.js",
    "/**/css/*.scss",
    "/**/sections/*.json",
    "/**/sections/*.liquid",
    "/**/templates/**/*.json",
    "/**/*.md"
  ],
  // flagWords - list of words to be always considered incorrect
  // This is useful for offensive words and common spelling errors.
  // For example "hte" should be "the"
  "flagWords": [
    "hte"
  ],
  "enableFiletypes": [
    "liquid",
    "css",
    "js",
    "json",
    "scss"
  ]
}
