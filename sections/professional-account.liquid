          "label": "Button link"
        }
      ]
    },
    {
      "name": "Rewards",
      "limit": 1,
      "type": "rewards",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "textarea",
          "id": "bottom_text",
          "label": "Bottom text"
        },
        {
