          "label": "Text"
        },
        {
          "type": "html",
          "id": "step_cta_image_1_1",
          "label": "CTA SVG 1"
        },
        {
          "type": "url",
          "id": "step_cta_url_1_1",
          "label": "CTA URL 1"
        },
        {
          "type": "html",
          "id": "step_cta_image_2_1",
          "label": "CTA SVG 2"
        },
        {
          "type": "url",
          "id": "step_cta_url_2_1",
          "label": "CTA URL 2"
        },
        {
          "type": "header",
          "content": "Content step 2"
        },
        {
          "type": "text",
          "id": "step_heading_2",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "step_text_2",
          "label": "Text"
        },
        {
          "type": "header",
          "content": "Content step 3"
        },
        {
          "type": "text",
          "id": "step_heading_3",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "step_text_3",
