{{ 'section-iwt-carousel.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  {%- assign heading = section.settings.heading -%}
	{%- assign anchor_link = section.settings.anchor_link -%}
  
  {%- capture config_content_carousel -%}
    {
      "slidesPerView": 1,
      "watchOverflow": true,
      "effect": "fade",
      "loop": true,
      "loopedSlides": 5,
      "fadeEffect": {
        "crossFade": true
      },
      "allowTouchMove": false
    }
  {%- endcapture -%}
  
  {%- capture config_image_carousel -%}
    {
    "slidesPerView": 1,
    "spaceBetween": 36,
    "loop": true,
    "loopedSlides": 5,
    "navigation": {
      "nextEl": ".next-{{ section.id }}",
      "prevEl": ".prev-{{ section.id }}"
    },
    "pagination": {
      "el": ".swiper-pagination-{{ section.id }}",
      "type": "progressbar"
      },
    "breakpoints": {
        "989": {
          "shortSwipes": false,
          "allowTouchMove": false
        }
      }
    }
  {%- endcapture -%}
  
  <div id="{{ section.id }}" class="iwt-carousel {% if section.settings.color_theme == 'black' %}landing-colors{% endif %}">
    {%- if heading != blank -%}
      <h2 class="h1 page-width iwt-carousel__heading"
          style="color: {{ section.settings.heading_color }}; {% if section.settings.heading_alignment == 'right' %}text-align: right;{% endif %}">
        {{ heading }}
      </h2>
    {%- endif -%}
  
    <slideshow-swiper class="page-width iwt-carousel__wrapper {% if section.settings.carousel_text_position == 'bottom' %}text-bottom{% endif %}"
                      data-config='{{ config_content_carousel }}'
											{% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}
                      data-arrows-appear="true"
                      data-control-slider="#iwt-carousel-control-{{ section.id }}">
      <div class="iwt-carousel__content">
        <div class="swiper">
          <ul class="swiper-wrapper">
            {%- for block in section.blocks -%}
              {%- assign heading = block.settings.heading -%}
              {%- assign subheading = block.settings.item_subheading -%}
              {%- assign text = block.settings.item_text -%}
            
              {%- if heading != blank or text != blank or subheading != blank -%}
                <li class="iwt-carousel__content-item swiper-slide">
                  {%- if heading != blank -%}
                    <h4 class="h4 iwt-carousel__content-heading">
                      {{ heading }}
                    </h4>
                  {%- endif -%}
                
                  {%- if subheading != blank -%}
                    <p class="iwt-carousel__content-subheading">
                      {{ subheading }}
                    </p>
                  {%- endif -%}
                
                  {%- if text != blank -%}
                    <div class="iwt-carousel__content-text">
                      {{ text }}
                    </div>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
      <div class="iwt-carousel__image swiper" id="iwt-carousel-control-{{ section.id }}" data-config='{{ config_image_carousel }}'>
        <ul class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {%- assign image = block.settings.item_image -%}
          
            {%- if image != blank -%}
              <li class="iwt-carousel__image-item swiper-slide">
                <div class="iwt-carousel__image-wrapper">
                  {% render 'image', image: image, class_name: 'image-abs-cover' %}
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        <div class="swiper-pagination {% if section.settings.color_theme == 'black' %}swiper-pagination-progressbar--secondary{% endif %} swiper-pagination-{{ section.id }} small-up-hide {% unless section.settings.show_progressbar %}hidden{% endunless %}"></div>
      </div>
      <div class="swiper-button-next {% if section.settings.color_theme == 'black' %}swiper-button-next--secondary{% endif %} next-{{ section.id }}"></div>
      <div class="swiper-button-prev {% if section.settings.color_theme == 'black' %}swiper-button-prev--secondary{% endif %} prev-{{ section.id }}"></div>
    </slideshow-swiper>
  </div>

  {%- style -%}
    {% if section.settings.color_theme == 'white' %}
      #{{ section.id }} .iwt-carousel__wrapper:before {
        background-color: rgb(var(--color-background));
      }

      #{{ section.id }} .iwt-carousel__content {
      background-color: rgb(var(--color-background));
      }
    {% endif %}

    {% unless section.settings.show_progressbar %}
      @media screen and (max-width: 749px) {
        #{{ section.id }} .iwt-carousel__content {
          margin-top: -38px;
        }
      }
    {% endunless %}

{%- endstyle -%}

{%- endif -%}


{% schema %}
{
  "name": "Image with text carousel",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "select",
      "id": "color_theme",
      "label": "Color theme",
      "options": [
        {
          "value": "black",
          "label": "Black"
        },
        {
          "value": "white",
          "label": "White"
        }
      ],
      "default": "black"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#303030"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Carousel settings"
    },
    {
      "type": "select",
      "id": "carousel_text_position",
      "label": "Carousel text position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_progressbar",
      "label": "Show mobile progressbar",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "carousel-item",
      "name": "Carousel item",
      "settings": [
        {
          "type": "image_picker",
          "id": "item_image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "item_subheading",
          "label": "Subheading"
        },
        {
          "type": "textarea",
          "id": "item_text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text carousel"
    }
  ]
}
{% endschema %}
