{%- liquid
	assign anchor_link = section.settings.anchor_link
  assign section_hide = false
  assign template_for_hidden = section.settings.template_for_hidden
  assign show_counter = section.settings.show_counter
  assign show_dots = section.settings.show_dots
  assign text_color = section.settings.text_color
  assign blocks_heading_type = section.settings.blocks_heading_type
  assign grid_align = section.settings.grid_align
  assign heading = section.settings.heading
  assign text = section.settings.text
  assign heading_type = section.settings.heading_type
  assign padding_top = section.settings.padding_top | append: 'px'
  assign padding_bottom = section.settings.padding_bottom | append: 'px'
  assign mobile_padding_top = section.settings.mobile_padding_top | append: 'px'
  assign mobile_padding_bottom = section.settings.mobile_padding_bottom | append: 'px'
-%}

{%- if template_for_hidden != blank and template_for_hidden contains template.name -%}
  {%- assign section_hide = true -%}
{%- endif -%}

{%- if section.blocks.size > 0 and section_hide != true -%}
  {{ 'section-text-blocks.css' | asset_url | stylesheet_tag }}
  
  {% capture config %}
    {
      "slidesPerView": 1,
      "spaceBetween": 24,
      "pagination": {% if show_dots %} {
        "el": ".swiper-pagination-{{ section.id }}",
        "type": "progressbar"
      }{% else %}false{% endif %}
    }
  {% endcapture %}
  
  <section class="section-text-blocks" id="section-text-blocks-{{ section.id }}" style="--text-color: {{ text_color }}; --padding-top: {{ padding_top }}; --padding-bottom: {{ padding_bottom }}; --mobile-padding-top: {{ mobile_padding_top }}; --mobile-padding-bottom: {{ mobile_padding_bottom }}">
    <div class="page-width" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
      {%- if heading != blank or text != blank -%}
        <div class="section-text-blocks__header center">
          {%- if heading != blank -%}
            <h2 class="section-text-blocks__heading {{ heading_type}}">
              {{ heading }}
            </h2>
          {%- endif -%}

          {%- if text != blank -%}
            <div class="section-text-blocks__text">
              {{ text }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <slideshow-swiper id="text-blocks-{{ section.id }}"
                        class="text-blocks"
                        data-config='{{ config }}'
                        data-breakpoint='min-width: 990px'>
        <div class="swiper">
          <ul class="text-blocks__wrapper swiper-wrapper" role="list" style="--grid-align: {{ grid_align }}">
            {%- for block in section.blocks -%}
              {%- capture buttons -%}
                {%- for i in (1..2) -%}
                  {%- liquid
                    assign button_text_i = 'button_text_' | append: i
                    assign button_text = block.settings[button_text_i]
                    assign button_link_i = 'button_link_' | append: i
                    assign button_link = block.settings[button_link_i]
                    assign button_type_i = 'button_type_' | append: i
                    assign button_type = block.settings[button_type_i]
                  -%}

                  {%- if button_text != blank -%}
                    <a{% if button_link == blank %} role="link" aria-disabled="true"{% else %}
                      href="{{ button_link }}"{% endif %}
                            class="text-block__button button button--{{ button_type }}"
                            {{ block.shopify_attributes }}>
                      {{ button_text | escape }}
                    </a>
                  {%- endif -%}

                {%- endfor -%}
              {%- endcapture -%}
              <li class="text-block text-block--{{ section.settings.grid }} swiper-slide center"
                  role="listitem" {{ block.shopify_attributes }}>
                {%- if show_counter -%}
                  <div class="text-block__counter h1">
                    {%- if forloop.index < 10 -%}
                      {{ forloop.index | prepend: 0 }}
                    {%- else -%}
                      {{ forloop.index }}
                    {%- endif -%}
                  </div>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="text-block__heading {{ blocks_heading_type }}">
                    {%- if block.settings.link != blank -%}
                      <a href="{{ block.settings.link }}">{{ block.settings.heading | escape }}</a>
                    {%- else -%}
                      {{ block.settings.heading | escape }}
                    {%- endif -%}
                  </h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="text-block__description center">
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}

                {%- if buttons -%}
                  <div class="text-block__buttons-wrapper">
                    {{ buttons }}
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>

          {%- if show_dots -%}
            <div class="swiper-pagination {% if section.settings.color_theme == 'black' %}swiper-pagination-progressbar--secondary{% endif %} swiper-pagination-{{ section.id }} small-up-hide"></div>
          {%- endif -%}
        </div>
      </slideshow-swiper>
    </div>
    
    <style>
      #section-text-blocks-{{ section.id }} {
        background-color: {{ section.settings.section_bg }};
      }
    </style>
  </section>
{%- endif -%}


{% schema %}
{
  "name": "Text blocks",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "color",
      "id": "section_bg",
      "default": "#FFFFFF",
      "label": "Section background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#070707",
      "label": "Blocks text color"
    },
    {
      "type": "select",
      "id": "grid",
      "options": [
        {
          "value": "1",
          "label": "1/1"
        },
        {
          "value": "2",
          "label": "1/2"
        },
        {
          "value": "3",
          "label": "1/3"
        }
      ],
      "default": "3",
      "label": "Text blocks grid"
    },
    {
      "type": "select",
      "id": "grid_align",
      "label": "Grid align",
      "default": "center",
      "options": [
        {
          "label": "Left",
          "value": "flex-start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ]
    },
    {
      "type": "select",
      "id": "blocks_heading_type",
      "label": "Blocks heading type",
      "default": "h6",
      "options": [
        {
          "label": "H3",
          "value": "h3"
        },
        {
          "label": "H4",
          "value": "h4"
        },
        {
          "label": "H5",
          "value": "h5"
        },
        {
          "label": "H6",
          "value": "h6"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_counter",
      "label": "Show counter",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": false,
      "info": "For mobile only"
    },
    {
      "type": "text",
      "id": "template_for_hidden",
      "label": "Template for hidden"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "heading_type",
      "label": "Heading type",
      "default": "h4",
      "options": [
        {
          "label": "H3",
          "value": "h3"
        },
        {
          "label": "H4",
          "value": "h4"
        },
        {
          "label": "H5",
          "value": "h5"
        },
        {
          "label": "H6",
          "value": "h6"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 122
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 122
    },
    {
      "type": "paragraph",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 70
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 70
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": "text block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Heading Link"
        },
        {
          "type": "header",
          "content": "Button settings"
        },
        {
          "type": "text",
          "id": "button_text_1",
          "label": "Button text (1)"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "Button link (1)"
        },
        {
          "type": "select",
          "id": "button_type_1",
          "options": [
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "primary",
              "label": "Primary"
            }
          ],
          "default": "primary",
          "label": "Button type (1)"
        },
        {
          "type": "text",
          "id": "button_text_2",
          "label": "Button text (2)"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Button link (2)"
        },
        {
          "type": "select",
          "id": "button_type_2",
          "options": [
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "primary",
              "label": "Primary"
            }
          ],
          "default": "primary",
          "label": "Button type (2)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text blocks"
    }
  ]
}
{% endschema %}
