{{ 'section-text-with-nav.css' | asset_url | stylesheet_tag }}

{%- assign anchor_link = section.settings.anchor_link -%}
{%- assign section_small_bottom_margin = section.settings.section_small_bottom_margin -%}
{%- assign menu = section.settings.menu -%}
{%- assign heading = section.settings.heading | default: page.title -%}
{%- assign button_text = section.settings.button_text -%}
{%- assign button_url = section.settings.button_url -%}
{%- assign button_style = section.settings.button_style -%}
{%- assign text = section.settings.text | default: page.content -%}
{%- assign text_max_width = section.settings.text_max_width -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.section_bg_color }};
    color: {{ section.settings.section_text_color }};
  }
{%- endstyle -%}

<div class="text-with-nav {% if section_small_bottom_margin %}small-pb{% endif %}" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
  <div class="page-width twn__wrapper">
    {%- if menu != blank -%}
      <ul class="twn__nav" role="list" tabindex="-1">
        {%- for link in menu.links -%}
          <li class="twn__nav-item">
            <a href="{{ link.url }}" class="twn__nav-link {% if link.active %}active{% endif %}">{{ link.title }}</a>
          </li>
        {% endfor %}
      </ul>
    {%- endif -%}
    
    {%- unless page.handle == "get-notified-text" -%}
    {%- if heading != blank -%}
      <h1 class="h1 twn__heading">{{ heading }}</h1>
    {%- endif -%}
    {%- endunless -%}

    
    {%- if text != blank -%}
      <div class="twn__text rte" style="--max-width: {{ text_max_width }}px">{{ text }}</div>
    {%- endif -%}

    {%- if button_text != blank -%}
      <div class="twn__button-wrapper">
        <a{% if button_url == blank %} role="link" aria-disabled="true"{% else %}
          href="{{ button_url }}"{% endif %}
                class="twn__button button button--{{ button_style }}">
          {{ button_text }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Text with navigation",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background color",
      "default": "#070707"
    },
    {
      "type": "color",
      "id": "section_text_color",
      "label": "Section text color",
      "default": "#F9F9F9"
    },
    {
      "type": "checkbox",
      "id": "section_small_bottom_margin",
      "label": "Small bottom margin"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "By default page title"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "By default page content"
    },
    {
      "type": "range",
      "id": "text_max_width",
      "min": 400,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "label": "Text max-width",
      "default": 630
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button url"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "transparent",
          "label": "Transparent"
        }
      ],
      "default": "secondary",
      "label": "Button style"
    }
  ],
  "presets": [
    {
      "name": "Text with navigation"
    }
  ],
  "templates": ["page"]
}
{% endschema %}
