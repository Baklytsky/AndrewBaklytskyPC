{%- if section.blocks.size > 0 -%}
  {{ 'section-iwot-carousel.css' | asset_url | stylesheet_tag }}
	{%- assign anchor_link = section.settings.anchor_link -%}
  
  {%- capture config -%}
    {
    "slidesPerView": 1,
    "spaceBetween": 24,
    "watchOverflow": true,
    "navigation": {
      "nextEl": ".next-{{ section.id }}",
      "prevEl": ".prev-{{ section.id }}"
    },
    "pagination": {
      "el": ".swiper-pagination-{{ section.id }}",
      "type": "progressbar"
    },
    "breakpoints": {
      "1200": {
        "slidesPerView": 3,
        "allowTouchMove": false,
        "spaceBetween": 36
        },
      "900": {
        "shortSwipes": false,
        "slidesPerView": 2.5,
        "spaceBetween": 24
        },
      "750": {
        "slidesPerView": 1.5,
        "spaceBetween": 24
        }
      }
    }
  {%- endcapture -%}

  <div id="iwot-carousel-{{ section.id }}" class="iwot-carousel {% if section.settings.color_theme == 'black' %}landing-colors{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="h1 page-width iwot-carousel__heading-section iwt-carousel__heading"
          style="color: {{ section.settings.heading_color }}; {% if section.settings.heading_alignment == 'right' %}text-align: right;{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
    
    <slideshow-swiper class="page-width iwot-carousel__wrapper rel" data-config='{{ config }}' data-arrows-appear="true" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
      <div class="swiper">
        <ul class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {%- assign image = block.settings.image -%}
            {%- assign heading = block.settings.heading -%}
            {%- assign subheading = block.settings.subheading -%}
            {%- assign overlay_description = block.settings.overlay_description -%}
            {%- assign overlay_heading = block.settings.overlay_heading -%}
            {%- assign overlay_text = block.settings.overlay_text -%}
            
            <li class="iwot-carousel__item swiper-slide">

              <div class="iwot-carousel__item-inner">
                {% if image != blank %}
                  {% render 'image', image: image, class_name: 'image-abs-cover iwot-carousel__image' %}
                {% endif %}

                <div class="iwot-carousel__item-overlay">
                  <div class="iwot-carousel__item-overlay-wrapper hide-scrollbar">
                    {% if overlay_description != blank %}
                      <p class="iwot-carousel__item-descr">{{ overlay_description }}</p>
                    {% endif %}

                    {% if overlay_heading != blank %}
                      <h5 class="iwot-carousel__item-card-heading">{{ overlay_heading }}</h5>
                    {% endif %}

                    {%- for i in (1..3) -%}
                      {%- assign item_product_id = 'overlay_product_' | append: i -%}
                      {%- assign item_product = all_products[block.settings[item_product_id]] -%}

                      {%- if item_product != blank -%}
                        <a href="{{ item_product.url }}" class="iwot-carousel__item-product">{{ item_product.title }}</a>
                      {%- endif -%}
                    {%- endfor -%}

                    {% if overlay_text != blank %}
                      <p class="iwot-carousel__item-text">{{ overlay_text }}</p>
                    {% endif %}
                  </div>
               </div>
                
                {%- if overlay_description != blank or overlay_heading != blank or overlay_text != blank or block.settings.overlay_product_1 != blank -%}
                  <button class="iwot-carousel__overlay_button">{% render 'icon-plus' %}</button>
                {%- endif -%}
              </div>
              
              {% if heading != blank %}
                <h3 class="iwot-carousel__heading">{{ heading }}</h3>
              {% endif %}
  
              {% if subheading != blank %}
                <div class="iwot-carousel__subheading">{{ subheading }}</div>
              {% endif %}
            </li>
          {%- endfor -%}
        </ul>
  
        <div class="swiper-pagination {% if section.settings.color_theme == 'black' %}swiper-pagination-progressbar--secondary{% endif %} swiper-pagination-{{ section.id }} small-up-hide"></div>
      </div>
  
      <div class="swiper-button-next {% if section.settings.color_theme == 'black' %}swiper-button-next--secondary{% endif %} next-{{ section.id }}"></div>
      <div class="swiper-button-prev {% if section.settings.color_theme == 'black' %}swiper-button-prev--secondary{% endif %} prev-{{ section.id }}"></div>
      
    </slideshow-swiper>
  </div>
  
  
  <script>
    (function cardWithOverlay() {
      const container = document.getElementById('iwot-carousel-{{ section.id }}')
      const cardsBtn = container.querySelectorAll('.iwot-carousel__overlay_button')

      cardsBtn.forEach((btn) => {
        btn.addEventListener('click', function () {
          const cardInner = this.closest('.iwot-carousel__item-inner');
          const overlayContent = cardInner.querySelector('.iwot-carousel__item-overlay');
          
          this.classList.toggle('is-open');
          if (overlayContent) {overlayContent.classList.toggle('is-visible')}
        });
      });
    })()
  </script>
  
{%- endif -%}


{% schema %}
{
  "name": "Image card carousel",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "select",
      "id": "color_theme",
      "label": "Color theme",
      "options": [
        {
          "value": "black",
          "label": "Black"
        },
        {
          "value": "white",
          "label": "White"
        }
      ],
      "default": "black"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#303030"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "carousel-item",
      "name": "Carousel item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "header",
          "content": "Card content"
        },
        {
          "type": "textarea",
          "id": "overlay_description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "overlay_heading",
          "label": "Heading"
        },
        {
          "type": "product",
          "id": "overlay_product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "overlay_product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "overlay_product_3",
          "label": "Product 3"
        },
        {
          "type": "textarea",
          "id": "overlay_text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image card carousel"
    }
  ]
}
{% endschema %}
