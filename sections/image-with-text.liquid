{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}

{%- assign anchor_link = section.settings.anchor_link -%}

{% capture config %}
  {
    "slidesPerView": 1,
    "spaceBetween": 24,
    {% if section.settings.enable_autoplay and section.blocks.size > 1 -%}
      "loop": true,
      "autoplay": {
        "delay": {{ section.settings.autoplay_speed | times: 1000 }}
      },
    {%- endif %}
    "breakpoints": {
      "900": {
        "shortSwipes": false,
        "spaceBetween": 36
      }
    }
  }
{% endcapture %}

{%- if section.blocks.size > 0 -%}
<slideshow-swiper id="image-with-text-{{ section.id }}" class="page-width" data-config='{{ config }}' data-autoplay="{{ section.settings.enable_autoplay }}">
  <div class="swiper" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
    <ul class="swiper-wrapper" role="list">
      {%- for block in section.blocks -%}
        <li class="image-with-text swiper-slide" role="listitem" {{ block.shopify_attributes }}>
          <div class="image-with-text__wrapper rel {% if block.settings.layout == 'text_first' %} image-with-text__wrapper--reverse{% endif %}">
            <div class="image-with-text__media {% if block.settings.image != blank %}media{% else %}image-with-text__media--placeholder placeholder{% endif %} large-hide">
              {%- if block.settings.image != blank -%}
                {% render 'image', image: block.settings.image %}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="image-with-text__content">
              {%- if section.blocks.size > 1 -%}
                <div class="image-with-text__blocks-counter">
                  <span>{%- if forloop.index < 10 -%}{{ 0 | append: forloop.index }}{%- else -%}{{ forloop.index }}{%- endif -%}</span>
                  <span>/</span>
                  <span>{%- if section.blocks.size < 10 -%}{{ 0 | append: section.blocks.size }}{%- else -%}{{ section.blocks.size }}{%- endif -%}</span>
                </div>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="image-with-text__heading h1 large-hide">
                  {{ block.settings.heading | escape }}
                </h2>
              {%- endif -%}
              <div class="image-with-text__content-image rel {% if block.settings.image == blank %}image-with-text__media--placeholder placeholder{% endif %} large-up-hide">
                {%- if block.settings.heading != blank -%}
                  <h2 class="image-with-text__heading h1">
                    {{ block.settings.heading | escape }}
                  </h2>
                {%- endif -%}
                {%- if block.settings.image != blank -%}
                  {% render 'image', image: block.settings.image %}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              {%- if block.settings.text != blank -%}
                <div class="image-with-text__text">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a{% if block.settings.button_link == blank %} role="link" aria-disabled="true"{% else %}
                  href="{{ block.settings.button_link }}"{% endif %}
                        class="image-with-text__button button {% if block.settings.button_style == 'secondary' %} button--secondary-border{% else %} button--{{ block.settings.button_style }}{% endif %}">
                  {{ block.settings.button_label | escape }}
                </a>
              {%- endif -%}
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</slideshow-swiper>

{%- endif -%}

{% schema %}
{
  "name": "t:sections.image-with-text.name",
  "class": "section-image-with-text section-margin-bottom",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "header",
      "content": "Slider settings"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "sec",
      "label": "Carousel autoplay speed",
      "default": 2
    }
  ],
  "blocks": [
    {
      "type": "iwt_block",
      "name": "iwt block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Image with text",
          "label": "t:sections.image-with-text.blocks.heading.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>",
          "label": "t:sections.image-with-text.blocks.text.settings.text.label"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "t:sections.image-with-text.blocks.button.settings.button_label.label",
          "info": "t:sections.image-with-text.blocks.button.settings.button_label.info"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.image-with-text.blocks.button.settings.button_link.label"
        },
        {
          "type": "select",
          "id": "button_style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "transparent",
              "label": "Transparent"
            }
          ],
          "default": "secondary",
          "label": "Button style"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.image-with-text.settings.image.label"
        },
        {
          "type": "select",
          "id": "layout",
          "options": [
            {
              "value": "image_first",
              "label": "t:sections.image-with-text.settings.layout.options__1.label"
            },
            {
              "value": "text_first",
              "label": "t:sections.image-with-text.settings.layout.options__2.label"
            }
          ],
          "default": "image_first",
          "label": "t:sections.image-with-text.settings.layout.label",
          "info": "t:sections.image-with-text.settings.layout.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.image-with-text.presets.name",
      "blocks": [
        {
          "type": "iwt_block"
        }
      ]
    }
  ]
}
{% endschema %}
