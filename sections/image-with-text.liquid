{{ 'image-with-text.min.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign border_bottom = section.settings.section_border_bottom
  assign show_plus = section.settings.show_plus
  assign section_heading = section.settings.heading
  assign section_subheading = section.settings.subheading
  assign padding_top_desk = section.settings.padding_top_desk
  assign padding_bottom_desk = section.settings.padding_bottom_desk
  assign padding_top_mob = section.settings.padding_top_mob
  assign padding_bottom_mob = section.settings.padding_bottom_mob
  assign text_blocks = section.blocks | where: 'type', 'text'
  assign image_blocks = section.blocks | where: 'type', 'image'
-%}

{%- if text_blocks.size > 0 and text_blocks != blank -%}
  {%- capture text_side -%}
    <ul class="image-with-text__text-wrapper">
      {%- for block in text_blocks -%}
        {%- liquid
          assign text = block.settings.text | escape | newline_to_br
        -%}

        {%- if text != blank -%}
          <li class="image-with-text__text-item h5 border-bottom">
            {{ text }}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endcapture -%}
{%- endif -%}


{% if section.blocks.size > 0 or section_heading != blank %}
  <div data-aos="fade-up" class="image-with-text page-width">
    <div
      style="
        --padding-bottom-desktop: {{ padding_bottom_desk }}px;
        --padding-top-desktop: {{ padding_top_desk }}px;
        --padding-bottom-mobile: {{ padding_bottom_mob }}px;
        --padding-top-mobile: {{ padding_top_mob }}px;"
      class="image-with-text__content-wrapper {% if border_bottom %}border-bottom{% endif %}">

      {% if section_subheading != blank %}
        <p class="image-with-text__section-subheading h6">
          {{ section_subheading }}
        </p>
      {% endif %}

      {% if section_heading != blank %}
        <h2 class="image-with-text__section-heading h4">
          {{ section_heading }}
        </h2>
      {% endif %}

      <div class="image-with-text__content-blocks{% if image_blocks == blank or text_blocks == blank %} image-with-text__content-blocks--one-block{% endif %} {% if show_plus %} image-with-text__content-blocks--show-plus{% endif %}">
        {% for block in section.blocks %}
          {% assign block_type = block.type %}

          {% case block_type %}
          {% when 'image' %}
          {%- liquid
            assign image = block.settings.image
            assign text = block.settings.text
            assign text_color = block.settings.text_color
          -%}

            {% if image != blank %}
              <div class="image-with-text__image-wrapper rel">
                {% render 'image',
                  image: image,
                  class_name: 'image-abs-cover',
                  alt: image.alt %}

                {%- if text != blank -%}
                  <p class="image-with-text__text-on-image h4" style="--color: {{ text_color }}">{{ text | escape | newline_to_br }}</p>
                {%- endif -%}
              </div>
            {% endif %}
          {% when 'text' %}
            {%- if text_side != blank and text_blocks != blank -%}
              {%- assign text_blocks = '' -%}

              {{ text_side }}
            {%- endif -%}
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>
{% else %}
  <div data-aos="fade-up" class="image-with-text page-width">
    <div
      style="
        --padding-bottom-desktop: {{ padding_bottom_desk }}px;
        --padding-top-desktop: {{ padding_top_desk }}px;
        --padding-bottom-mobile: {{ padding_bottom_mob }}px;
        --padding-top-mobile: {{ padding_top_mob }}px;"
      class="image-with-text__content-wrapper border-bottom">
        <p class="image-with-text__section-subheading h6">{{ "image_with_text.empty_subheading" | t }}</p>
        <h2 class="image-with-text__section-heading h4">{{ "image_with_text.empty_heading" | t }}</h2>

      <div class="image-with-text__content-blocks image-with-text__content-blocks--show-plus">
        <div class="image-with-text__image-wrapper rel">
          {{ 'image' | placeholder_svg_tag }}

          <p class="image-with-text__text-on-image h4" style="--color: {{ text_color }}">{{ "image_with_text.empty_subheading_text_on_image" | t }}</p>
        </div>

        <ul class="image-with-text__text-wrapper">
          {%- for i in (1..3) -%}
            <li class="image-with-text__text-item h5 border-bottom">
              {{ "image_with_text.empty_text_block" | t }}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "section_border_bottom",
      "label": "Section border bottom desktop",
      "default": false
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Section paddings"
    },
    {
      "type": "range",
      "id": "padding_top_desk",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top desktop",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desk",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom desktop",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mob",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top mobile",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mob",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom mobile",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "show_plus",
      "label": "Show plus",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "image",
      "limit": 1,
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#383838"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
