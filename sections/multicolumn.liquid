{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}

{%- assign anchor_link = section.settings.anchor_link -%}
{%- liquid
  assign title = section.settings.title
  assign remove_desktop_bottom_spacing = section.settings.remove_desktop_bottom_spacing
-%}


{%- if section.blocks.size > 0 -%}
  <div class="multicolumn page-width" data-remove-bottom-spacing="{{ remove_desktop_bottom_spacing }}" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
    {%- if title != blank -%}
      <span class="multicolumn-card__info-title h5">
        {{ title }}
      </span>
    {%- endif -%}
    <ul class="multicolumn-list" role="list">
      {%- for block in section.blocks -%}
        <li class="multicolumn-list__item multicolumn-list__item--{{ section.settings.grid }}"
            role="listitem" {{ block.shopify_attributes }}>
          <div class="multicolumn-card">
            {%- if block.settings.image != blank -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="multicolumn-card__image-wrapper rel">
                  {% render 'image', image: block.settings.image, class_name: 'image-abs-cover', %}
                </a>
              {%- else -%}
                <div class="multicolumn-card__image-wrapper rel">
                  {% render 'image', image: block.settings.image, class_name: 'image-abs-cover', %}
                </div>
              {%- endif -%}
            {%- endif -%}
            <div class="multicolumn-card__info">
              {%- if block.settings.title != blank -%}
                <span class="multicolumn-card__info-title h5">
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>
                  {%- else -%}
                    {{ block.settings.title | escape }}
                  {%- endif -%}
                </span>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="multicolumn-card__info-description">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "class": "section-multicolumn",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "text",
      "id": "title",
      "default": "Multicolumn",
      "label": "t:sections.multicolumn.settings.title.label"
    },
    {
      "type": "select",
      "id": "grid",
      "options": [
        {
          "value": "1",
          "label": "1/1"
        },
        {
          "value": "2",
          "label": "1/2"
        },
        {
          "value": "3",
          "label": "1/3"
        }
      ],
      "default": "2",
      "label": "Column grid"
    },
    {
      "type": "checkbox",
      "id": "remove_desktop_bottom_spacing",
      "default": false,
      "label": "Remove desktop bottom spacing"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.multicolumn.blocks.column.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.multicolumn.blocks.column.settings.image.label"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Column",
          "label": "t:sections.multicolumn.blocks.column.settings.title.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>",
          "label": "t:sections.multicolumn.blocks.column.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.multicolumn.presets.name",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
