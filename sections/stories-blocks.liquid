{%- if section.blocks.size > 0 -%}
  {{ 'section-stories.css' | asset_url | stylesheet_tag }}
  
  {%- assign heading = section.settings.heading -%}
	{%- assign anchor_link = section.settings.anchor_link -%}
  
  <style>
    #stories-blocks-{{ section.id }} {
      background-color: {{ section.settings.bg_color }};
      color: {{ section.settings.text_color }};
    }
  </style>
  
  <div id="stories-blocks-{{ section.id }}" class="stories-blocks">
    <div class="page-width stories-blocks__wrapper" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
      {%- if heading != blank -%}
        <h2 class="stories-blocks__heading">{{ heading }}</h2>
      {%- endif -%}
    
      <ul class="stories-blocks__list">
        {%- for block in section.blocks -%}
          {%- assign subheading = block.settings.item_subheading -%}
          {%- assign heading = block.settings.heading -%}
          {%- assign label = block.settings.item_label -%}
          {%- assign link = block.settings.item_url -%}
        
          {%- if subheading != blank or heading != blank or label != blank -%}
            <li class="stories-blocks__item">
            
              {%- if link != blank -%}
                <a href="{{ link }}" target="_blank">
              {%- endif -%}
              
                {% if subheading != blank %}
                  <div class="stories-blocks__item-subheading">{{ subheading }}</div>
                {% endif %}
              
                {% if heading != blank %}
                  <h4 class="stories-blocks__item-heading">{{ heading }}</h4>
                {% endif %}
              
                {% if label != blank %}
                  <div class="stories-blocks__item-label">{{ label }}</div>
                {% endif %}
              
              {%- if link != blank -%}
                </a>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}


{% schema %}
{
  "name": "Stories blocks",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "default": "#181818",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#f9f9f9",
      "label": "Text color"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "stories",
      "name": "Stories",
      "settings": [
        {
          "type": "text",
          "id": "item_subheading",
          "label": "Subheading"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "item_label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "item_url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stories blocks"
    }
  ]
}
{% endschema %}
