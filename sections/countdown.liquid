{{ 'section-countdown.css' | asset_url | stylesheet_tag }}

{%- liquid
	assign anchor_link = section.settings.anchor_link
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
-%}

{% style %}
  :root {
    --countdown_bg_color: {{ bg_color }};
    --countdown_text_color: {{ text_color }};
  }
{% endstyle %}

<div class="countdown page-width {{ section.settings.custom_select }}" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}

      {%- case block.type -%}
      {%- when 'heading' -%}

      {%- liquid assign heading = block.settings.heading -%}

        {%- if heading != blank -%}
          <h3 class="countdown__text countdown__block" {{ block.shopify_attributes }}>
            {{ heading }}
          </h3>
        {%- endif -%}

      {%- when 'countdown' -%}

      {%- liquid
        assign today_date = 'now' | date: '%Y/%m/%d'
        assign end_content_date = block.settings.end_date | date: '%Y/%m/%d' -%}

        {%- if today_date < end_content_date -%}
          <countdown-timer class="countdown__timer countdown__block h3"
               data-end-date="{{ block.settings.end_date }}"
               style="display: none" {{ block.shopify_attributes }}>
            <span class="countdown__timer-days days"></span>
            <span class="countdown__timer-hours hours"></span>
            <span class="countdown__timer-minutes minutes"></span>
            <span class="countdown__timer-seconds seconds"></span>
          </countdown-timer>
        {%- endif -%}

      {%- when 'button' -%}

      {%- liquid
        assign button_label = block.settings.button_label
        assign button_url = block.settings.button_url
        assign button_style = block.settings.button_style -%}

        {%- if button_label != blank -%}
          <a{% if button_url == blank %} role="link" aria-disabled="true"{% else %}
            href="{{ button_url }}"{% endif %}
                  class="twn__button button button--{{ button_style }} countdown__block" {{ block.shopify_attributes }}>
            {{ button_label }}
          </a>
        {%- endif -%}

      {%- endcase -%}

    {%- endfor -%}

  {%- else -%}

    <h3 class="countdown__text countdown__block">{{ 'sections.countdown.title' | t }}</h3>
    <a role="link" aria-disabled="true" class="countdown__button button button--secondary countdown__block">
      {{ 'sections.countdown.button_label' | t }}
    </a>

  {%- endif -%}
</div>

{% schema %}
{
  "name": "Countdown banner",
  "tag": "section",
  "class": "section-countdown",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "text",
      "id": "custom_select",
      "label": "Custom select"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Announce something here"
        }
      ]
    },
    {
      "type": "countdown",
      "name": "Countdown",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "end_date",
          "label": "Countdown end date",
          "info": "Example: Des 30, 2022 07:30:00 GMT-08:00"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button url"
        },
        {
          "type": "select",
          "id": "button_style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "transparent",
              "label": "Transparent"
            }
          ],
          "default": "secondary",
          "label": "Button style"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Countdown banner"
    }
  ]
}
{% endschema %}
