
{% comment %}
  Built with attentive prelaunch iframe

  Important:
  This section must be set to the password-page for a secure site.

{% endcomment %}

<style>

  {% if section.settings.prelaunch_background_image_mobile != blank %}
    #shopify-section-{{ section.id }} {
      {% if section.settings.prelaunch_background_image_mobile != blank %}
        background-image: url('https:{{ section.settings.prelaunch_background_image_mobile.src | img_url: '800x' }}');
        background-size: cover;
        background-position: center;
      {% endif %}
    }
    @media screen and (min-width: 767px) {
      #shopify-section-{{ section.id }} {
        {% if section.settings.prelaunch_background_image != blank %}
          background-image: url('https:{{ section.settings.prelaunch_background_image.src | img_url: '2900x' }}');
          background-position: unset;
        {% endif %}
      }
    }

  {% else %}
    #shopify-section-{{ section.id }} {
      {% if section.settings.prelaunch_background_image != blank %}
        background-image: url('https:{{ section.settings.prelaunch_background_image.src | img_url: '2900x' }}');
        background-size: cover;
      {% endif %}
    }
{% endif %}

  #shopify-section-{{ section.id }} .prelaunch_container {
    -webkit-backdrop-filter: blur({{ section.settings.blur }}px);
    backdrop-filter: blur({{ section.settings.blur }}px);
  }

/* manual backup disable css */

.prelaunch_container .ra-modal__content p {
  color: var(--stroke-primary);
}

.prelaunch_logo {
  padding-top: 36px;
}

@media (min-width: 768px) {
  .prelaunch_logo {
    padding-top: 54px;
  }
}

.prelaunch_container .ra-modal__content .ra-icon {
  color: var(--stroke-primary);
}

.kl-private-reset-css-Xuajs1 [role="option"] {
  background-color: var(--text-primary) !important;
}

.kl-private-reset-css-Xuajs1 button:not([role="combobox"]) {
  background-color: rgba(236,234,229,1) !important;
  color: #28282A !important;
}

#shopify-section-footer {
  display: none;
}

.locale-selectors__container {
  display: none;
}

.header {
  display: none;
}

.ra-preheader{
display: none;
}

</style>
<div class="w-full prelaunch_container flex flex-col justify-end">

  <div class="prelaunch_logo w-100% flex justify-center items-center">
    {% if section.settings.prelaunch_desktop_logo != blank %}
      {{
        section.settings.prelaunch_desktop_logo
        | image_url: width: 760
        | image_tag: alt: logo_alt, class: 'w-[51px] md:w-24'
      }}
    {% endif %}
  </div>

  {% if section.settings.klaviyo_list_id != blank %}
   <div class="prelaunch_klaviyo w- w-full h-full px-6 pb-6 md:pb-12 md:pt-24 md:px-24 flex flex-col justify-end md:flex-row md:justify-start ">
    <div class="w-full justify-end md:w-[426px] h-full flex flex-col">
      <div class="klaviyo-form-{{ section.settings.klaviyo_list_id }}"></div>
    </div>
   </div>
  {% endif %}

  <div class="w-full pb-6 md:pb-12 px-6 md:px-24">
      <div class="w-full flex col justify-between text-white ">
        <div class="w-1/2 pr-[5%] md:pr-0">
          <div class="mx-auto">
            <div class="mono-12 py-2 !no-underline color[--white] uppercase">
              <span>
              ©
                  <script>
                    document.write(new Date().getFullYear());
                  </script>
                  {{ section.settings.copyright_text }}
                </span>
            </div>
          </div>
        </div>
        <div class="w-1/2 pl-[5%] md:pl-0">
          <div class="mx-auto flex h-full col">
          {% if section.settings.footerlink2_url != blank %}
            <button id="modal-1" class="mono-12 py-2 color[--white] uppercase underline m-auto w-full text-right" label='open modal' title="{{ section.settings.footerlink2_title }} " aria-label="{{ section.settings.footerlink2_title }}">{{ section.settings.footerlink2_title | escape }}</button>
            {% capture content %}
            <div class="max-h-[500px] overflow-y-scroll mt-3">
              <h3 class="mb-3 mono-16 md:!text-[32px] text-stroke-primary !font-light">Terms and Conditions</h3>
              {{ section.settings.footerlink2_url.content }}
            </div>
            {% endcapture %}
            {% render 'ra-modal', classes: 'pre-launch__modal', id: 'modal-1', title: 'Terms & Conditions', content: content %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  body { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background-color: #67655f; }
  .prelaunch_container { height: 100dvh; }

  @media screen and (orientation:landscape)
and (min-device-width: 319px)
and (max-device-width: 480px) {
    body { position: static; }
    .prelaunch_container { height: 100%; }
  }

  #gorgias-chat-container {
    display: none !important;
  }
</style>

<script>
  window.addEventListener("load", (event) => {
    const chatWidget = document.getElementById('gorgias-chat-container')
    chatWidget.remove()
  });
</script>


{% schema %}
{
  "name": "Prelaunch",
  "settings": [
    {
      "type": "header",
      "content": "Prelaunch Page",
      "info": "This section must be set to the password-page for a secure site. Designed for full size iframe from Attentive"
    },
    {
      "type": "text",
      "id": "klaviyo_list_id",
      "label": "Klaviyo Form ID"
    },
    {
      "type": "image_picker",
      "id": "prelaunch_background_image",
      "label": "Desktop prelaunch page background image",
      "info": "Desktop background image displays behind the entire page"
    },
    {
      "type": "image_picker",
      "id": "prelaunch_background_image_mobile",
      "label": "Mobile prelaunch page background image",
      "info": "Mobile background image displays behind the entire page"
    },
    {
      "type": "range",
      "id": "blur",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Image blur",
      "default": 50
    },
    {
      "type": "image_picker",
      "id": "prelaunch_desktop_logo",
      "label": "Prelaunch desktop logo image",
      "info": "Logo image displays seperately on desktop view"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "KHY ALL RIGHTS RESERVED."
    },
    {
      "type": "text",
      "id": "footerlink2_title",
      "label": "Footer Right Link Title ",
      "default": "Terms & Conditions"
    },
    {
      "type": "page",
      "id": "footerlink2_url",
      "label": "Footer Terms Content Page",
      "info": "Selected page content will display in Terms modal"
    }
  ],
  "presets": [
    {
      "name": "Prelaunch"
    }
  ]
}
{% endschema %}
