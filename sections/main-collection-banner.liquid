{%- assign show_section = collection.metafields.banner.show_section | default: 'false' -%}
{%- assign anchor_link = section.settings.anchor_link -%}

{%- if show_section == 'true' -%}
  {{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

  {%- assign hero_mob_image = collection.metafields.banner.image_mobile[0] -%}
  {%- assign hero_image = collection.metafields.banner.image[0] | default: hero_mob_image -%}
  {%- assign banner_text_align = collection.metafields.banner.text_align | default: 'left' -%}
  {%- assign hide_banner_image = collection.metafields.banner.hide_banner_image | default: 'false' -%}
  {%- assign hide_banner_text = collection.metafields.banner.hide_banner_text | default: 'false' -%}
  {%- assign alt_heading = collection.metafields.banner.alt_heading -%}
  {%- assign image_overlay_opacity = collection.metafields.accentuate.image_overlay_opacity -%}

  {%- style -%}
    .collection-hero--{{ section.id }}::after {
      opacity: {{ image_overlay_opacity | divided_by: 100.0 }};
    }

    {%- if hide_banner_image == 'true' -%}
      .collection-hero--{{ section.id }} {
        color: rgb(var(--color-text));
      }

      .collection-hero--{{ section.id }} {
        min-height: unset;
      }
    {%- endif -%}
  {%- endstyle -%}

  <div class="collection-hero--{{ section.id }} collection-hero rel" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
    <div class="collection-hero__inner collection-hero__inner--{{ banner_text_align }} page-width">
      {%- if hide_banner_text == 'false' -%}
        <div class="collection-hero__text-wrapper rel z2">

          <h2 class="collection-hero__title h3">
            <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
            {%- if alt_heading != blank -%}
              {{ alt_heading }}
            {%- else -%}
              {{- collection.title | escape -}}
            {%- endif -%}
          </h2>

          {%- if section.settings.show_collection_description -%}
            <div class="collection-hero__description">{{ collection.description }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if hide_banner_image == 'false' -%}
      {%- assign hero_image_class_name = 'image-abs-cover' -%}

      {%- if hero_mob_image != blank -%}
        {%- assign hero_image_class_name = 'image-abs-cover small-hide' -%}
        {% render 'image-metafields', image: hero_mob_image, class_name: 'image-abs-cover small-up-hide', preload: true %}
      {%- endif -%}

      {%- if hero_image != blank -%}
        {% render 'image-metafields', image: hero_image, class_name: hero_image_class_name, preload: true %}
      {%- else -%}
        {% render 'image', image: collection.image, class_name: 'image-abs-cover', preload: true %}
      {%- endif -%}

    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "spaced-section--full-width",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    }
  ]
}
{% endschema %}
