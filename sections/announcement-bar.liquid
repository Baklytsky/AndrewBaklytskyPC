{%- if section.blocks.size > 0 and section.settings.enable_bar -%}
  {% render '_announcement-bar.min.css' %}

  {%- capture slider_config -%}
    {
    "simulateTouch": false,
    "autoHeight": false,
    {% if section.blocks.size > 1 %}
      "loop": true,
      "autoplay": {
      "delay": {{ section.settings.autoplay_speed | times: 1000 }}
      },
    {% endif %}
    "effect": "fade",
    "speed": 600,
    "fadeEffect": {
      "crossFade": true
      }
    }
  {%- endcapture -%}

  {%- capture affiliate_bar -%}
    {%- if section.settings.enable_affiliate_bar -%}
      {% render '_affiliate-announcement.min.css' %}
      <script src="{{ 'affiliate-announcement.min.js' | asset_url }}" defer="defer"></script>
      <affiliate-announcement class="affiliate-bar hidden"
                              data-bar="affiliate"
                              style="
                                --affiliate-bg-color: {{ section.settings.affiliate_bg_color }};
                                --affiliate-color: {{ section.settings.affiliate_color }};">

        <div class="affiliate-bar__inner">
          <div class="body3--bold" data-text-content>
            {{ section.settings.affiliate_text }}
          </div>
          <button class="affiliate-bar__close btn--reset" data-announcement-close>
            <span class="visually-hidden"> {{ 'accessibility.close_announcement' | t }}</span>
            {% render 'icon' with 'close-small' %}
          </button>
        </div>

      </affiliate-announcement>
    {%- endif -%}
  {%- endcapture -%}

  {%- capture additional_bar -%}
    {%- if section.settings.enable_additional_bar  -%}
      {%- assign additional_text = section.settings.additional_text -%}
      {%- assign additional_bg_color = section.settings.additional_bg_color -%}
      {%- assign additional_color = section.settings.additional_color -%}

      {% if additional_text != blank %}
        <div class="announcement-bar__additional-item body3--bold" style="--bg-color: {{ additional_bg_color }}; --color: {{ additional_color }};">
          <div class="announcement-bar__additional-item-inner">
            {{ additional_text }}
          </div>
        </div>
      {% endif %}
    {%- endif -%}
  {%- endcapture -%}

  <div class="announcement-bar" id="{{ section.id }}">
    {{ additional_bar }}
    {{ affiliate_bar }}
    <slideshow-swiper data-config='{{ slider_config }}' data-bar="announcement">
      <div class="swiper announcement-bar__inner">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {%- assign text = block.settings.text -%}
            {%- assign bg_color = block.settings.bg_color -%}
            {%- assign text_color = block.settings.text_color -%}

            {% if text != blank %}
              <div class="announcement-bar__item body3--bold swiper-slide" style="--bg-color: {{ bg_color }}; --color: {{ text_color }};">
                <div class="announcement-bar__item-inner">
                  {{ text }}
                </div>

                <button class="announcement-bar__close btn--reset" data-announcement-close>
                  <span class="visually-hidden"> {{ 'accessibility.close_announcement' | t }}</span>
                  {% render 'icon' with 'close-small' %}
                </button>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </slideshow-swiper>
  </div>

  <script>
    function setAnnouncementHeight() {
      document.documentElement.style.setProperty('--announcement-bar-height',
        document.getElementById('shopify-section-announcement-bar').getBoundingClientRect().height + 'px');
    }
    setAnnouncementHeight();
    window.addEventListener('resize', setAnnouncementHeight);

    function setCSSProperties() {
      const announcementBar = document.getElementById('shopify-section-announcement-bar');
      const header = document.querySelector('.header');

      if (announcementBar) {
        document.documentElement.style.setProperty('--announcement-bar-height',
          announcementBar.getBoundingClientRect().height + 'px');
      }

      if (header) {
        document.documentElement.style.setProperty('--header-height', header.getBoundingClientRect().height + 'px');
        document.documentElement.style.setProperty('--header-bottom', header.getBoundingClientRect().bottom + 'px');
      }
    }

    (function () {
      const closeButtons = document.querySelectorAll('[data-announcement-close]');
      const announcementBar = document.querySelector('[data-bar=announcement]');
      const affiliateBar = document.querySelector('[data-bar=affiliate]');
      const isHiddenAnnouncement = sessionStorage.getItem('hidden-announcement-bar');
      const isHiddenAffiliate = sessionStorage.getItem('hidden-affiliate-bar');
      setCSSProperties();

      if (isHiddenAnnouncement === 'true') {
        announcementBar.classList.add('hidden');
        setCSSProperties();
      }

      if (isHiddenAffiliate === 'true') {
        affiliateBar.classList.add('hidden');
        setCSSProperties();
      }

      closeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const bar = btn.closest('[data-bar]');
          const type = bar.getAttribute('data-bar');
          bar.classList.add('hidden');
          sessionStorage.setItem(`hidden-${type}-bar`, 'true');
          setCSSProperties();
        })
      })
    })()
  </script>
{%- endif -%}


{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 5,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_bar",
      "label": "Enable bar",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "sec",
      "label": "Autoplay speed",
      "default": 5
    },
    {
      "type": "header",
      "content": "Affiliate bar"
    },
    {
      "type": "checkbox",
      "id": "enable_affiliate_bar",
      "label": "Enable Affiliate bar",
      "default": true
    },
    {
      "type": "color",
      "id": "affiliate_color",
      "label": "Text color",
      "default" : "#383838"
    },
    {
      "type": "color",
      "id": "affiliate_bg_color",
      "label": "Background color"
    },
    {
      "type": "textarea",
      "id": "affiliate_text",
      "label": "Text",
      "info": "Enter the text where [[company_name]] will be replaced with the company name.",
      "default": "[[company_name]]"
    },
    {
      "type": "header",
      "content": "Additional bar"
    },
    {
      "type": "checkbox",
      "id": "enable_additional_bar",
      "label": "Enable additional bar",
      "default": true
    },
    {
      "type": "color",
      "id": "additional_color",
      "label": "Text color",
      "default" : "#383838"
    },
    {
      "type": "color",
      "id": "additional_bg_color",
      "label": "Background color"
    },
    {
      "type": "textarea",
      "id": "additional_text",
      "label": "Text",
      "default": "Text"
    }
  ],
  "blocks": [
    {
      "name": "Announcement",
      "type": "announcement",
      "settings": [
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background color",
          "default": "#383838"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ]
}
{% endschema %}
