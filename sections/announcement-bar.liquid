{%- assign show_announcement_bar = section.settings.show_announcement_bar -%}

{%- if show_announcement_bar -%}
  {%- assign announcement_heading = section.settings.announcement_heading -%}
  {%- assign announcement_bg = section.settings.announcement_bg | default: '#000000' -%}
  {%- assign announcement_text_color = section.settings.announcement_text_color | default: '#FFFFFF' -%}
  {%- assign use_announcement_bar_as_link = section.settings.use_announcement_bar_as_link -%}
  {%- assign announcement_bar_link = section.settings.announcement_bar_link -%}

  {%- if announcement_heading != blank -%}
    {%- if section.blocks.size > 0 and use_announcement_bar_as_link == false -%}
      <modal-opener class="announcement-bar__wrapper"
                    style="background-color: {{ announcement_bg }};"
                    data-modal="#AnnouncementModal-{{ section.id }}"
                    role="region">
        <button class="announcement-bar"
                aria-haspopup="dialog"
                aria-label="{{ announcement_heading }}"
                style="color: {{ announcement_text_color }}; cursor: pointer">
          <span class="announcement-bar__message page-width">
            {{ announcement_heading }}<span style="padding-left: 10px">+</span>
          </span>
        </button>
      </modal-opener>
    {%- else -%}
      {%- if announcement_bar_link != blank -%}
        <a href="{{ announcement_bar_link }}" class="announcement-bar__wrapper"
             style="background-color: {{ announcement_bg }};">
          <div class="announcement-bar page-width">
            <p class="announcement-bar__message"
               style="color: {{ announcement_text_color }}">
              {{ announcement_heading }}
            </p>
          </div>
        </a>
      {%- else -%}
      <div class="announcement-bar__wrapper"
                    style="background-color: {{ announcement_bg }};">
        <div class="announcement-bar page-width">
          <p class="announcement-bar__message"
             style="color: {{ announcement_text_color }}">
            {{ announcement_heading }}
          </p>
        </div>
      </div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.blocks.size > 0 and use_announcement_bar_as_link == false -%}
      <modal-dialog id="AnnouncementModal-{{ section.id }}"
                    class="announcement-modal primary-bg">
        <div class="announcement-modal-content hide-scrollbar"
             role="dialog"
             aria-label="{{ announcement_heading | escape }}"
             aria-modal="true"
             tabindex="-1">
          <button id="ModalClose-{{ section.id }}"
                  type="button"
                  class="button__modal-close"
                  aria-label="{{ 'accessibility.close' | t }}">
            {% render 'icon-close' %}
          </button>
          {%- for block in section.blocks -%}
            {%- assign block_heading = block.settings.heading -%}
            {%- assign block_content = block.settings.block_content -%}

            {%- if block_heading != blank or block_content != blank -%}
              <div class="announcement-modal__block">
                {%- if block_heading != blank -%}
                  <h4 class="announcement-modal__block-heading">{{ block_heading }}</h4>
                {%- endif -%}
                {%- if block_content != blank -%}
                  <div class="announcement-modal__block-content">
                    {{ block_content }}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- endfor -%}
        </div>
      </modal-dialog>
    {%- endif -%}

  {%- endif -%}
{%- endif -%}

<script>
  function announcementHeight() {
    document.documentElement.style.setProperty('--announcement-bar-height', document.getElementById('shopify-section-announcement-bar').offsetHeight + 'px');
    //document.documentElement.style.setProperty('--announcement-bottom-position', `${parseInt(document.getElementById('shopify-section-announcement-bar').getBoundingClientRect().bottom)}px`);
  }
  announcementHeight();
  window.addEventListener('resize', announcementHeight);

  function announcementObserver() {
    let announcementBar = document.querySelector('#shopify-section-announcement-bar');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        entry.target.classList.toggle('decrease-height', !entry.isIntersecting);

        announcementHeight();
      })
    }, {root: null, threshold: 1, rootMargin: '100px'})
    observer.observe(announcementBar)
  }

  if (window.innerWidth < 1024) {
    announcementObserver();
  }
</script>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement_bar",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_heading",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "use_announcement_bar_as_link",
      "label": "Use as a link",
      "default": false
    },
    {
      "type": "url",
      "id": "announcement_bar_link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "modal_content",
      "name": "modal content",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "html",
          "id": "block_content",
          "label": "Content"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "modal_content"
      }
    ]
  }
}
{% endschema %}
