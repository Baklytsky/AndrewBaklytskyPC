{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- assign enable_sorting = section.settings.enable_sorting -%}
{%- assign color_label = 'color,colour,couleur,colore,farbe,색,色,färg,farve' | split: ',' -%}
{%- assign size_label = 'size,taille,größe,tamanho,tamaño,koko,サイズ' | split: ',' -%}
{%- assign hide_filter_menu = collection.metafields.custom.hide_filter_menu -%}
{%- assign products_per_page = section.settings.products_per_page -%}

<div id="main-collection">
  <script src="{{ 'clp-load-more.js' | asset_url }}" defer="defer"></script>

  <div class="collection-wrapper page-width {% if hide_filter_menu %}collection-wrapper--hidden-facets{% endif %}">
    {%- if section.settings.enable_filtering and collection.products.size != 0 -%}
      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

      <modal-opener data-modal="#main-collection-filters-{{ section.id }}"
                    role="region"
                    class="large-up-hide {% if hide_filter_menu %}hidden{% endif %}">
        <button aria-haspopup="dialog"
                aria-label="Filters Opener"
                class="button button--primary focus-inset button-filter-opener--mobile">
          <span>Filter</span>
          <span>{%- render 'icon' with 'filters' -%}</span>
        </button>
      </modal-opener>

      <modal-dialog id="main-collection-filters-{{ section.id }}"
                    class="announcement-modal primary-bg {% if hide_filter_menu %}hidden{% endif %}">
        <div class="announcement-modal-content hide-scrollbar"
             role="dialog"
             aria-label="{{ announcement_heading | escape }}"
             aria-modal="true"
             tabindex="-1">
          <button id="ModalClose-{{ section.id }}"
                  type="button"
                  class="button__modal-close"
                  aria-label="{{ 'accessibility.close' | t }}">
            {% render 'icon-close' %}
          </button>
          <div id="main-collection-filters-{{ section.id }}" data-id="{{ section.id }}" class="main-collection-filters">
            {% render 'facets',
              results: collection,
              enable_filtering: section.settings.enable_filtering,
              enable_sorting: enable_sorting,
              hide_color_swatch: section.settings.hide_color_swatch,
              hide_filter_menu: hide_filter_menu
            %}
          </div>
        </div>
      </modal-dialog>
    {%- endif -%}

    {% style %}
      :root {
      {%- if section.index == 1 or request.design_mode -%}
        --clp-wrapper-mt-desktop: 90px;
        --clp-wrapper-mt-mobile: 35px;
      {%- else -%}
        --clp-wrapper-mt-desktop: 40px;
        --clp-wrapper-mt-mobile: 10px;
      {%- endif -%}
      }
    {% endstyle %}
    
    <div class="collection__wrapper">
      {% render 'collection-breadcrumbs-navigation', class_name: 'large-up-hide' %}
      
      {%- if enable_sorting and collection.products.size > 0 and section.settings.enable_filtering -%}
        {%- render 'collection-filters',
          results: collection,
          section: section,
          hide_filter_menu: hide_filter_menu -%}
      {%- endif -%}
      
      <div id="ProductGridContainer">
        {%- paginate collection.products by 1000 -%}
          {%- if collection.products.size == 0 -%}
            <div class="collection collection--empty" id="product-grid" data-id="{{ section.id }}">
              <div class="loading-overlay primary-bg"></div>
              <div class="title-wrapper center">
                <h2 class="title title--primary">
                  {{ 'sections.collection_template.empty' | t }}<br>
                  {{ 'sections.collection_template.use_fewer_filters_html' | t: link: collection.url, class: "underlined-link link" }}
                </h2>
              </div>
            </div>
          {%- else -%}
            {%- render 'collection-grid',
              results: collection,
              section: section,
              products_per_page: products_per_page,
              paginate: paginate -%}
          {%- endif -%}
        {%- endpaginate -%}

      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "swatch_type",
      "options": [
        {
          "value": "thumbnails",
          "label": "Thumbnails"
        },
        {
          "value": "Circles",
          "label": "Circles"
        }
      ],
      "default": "thumbnails",
      "label": "Color swatch types"
    },
    {
      "type": "checkbox",
      "id": "show_product_reviews",
      "default": true,
      "label": "Show product reviews"
    },
    {
      "type": "checkbox",
      "id": "show_product_description",
      "default": true,
      "label": "Show product description"
    },
    {
      "type": "checkbox",
      "id": "show_product_description_metafield",
      "default": false,
      "label": "Show product description from metafield"
    },
    {
      "type": "checkbox",
      "id": "show_product_price",
      "default": true,
      "label": "Show product price"
    },
    {
      "type": "checkbox",
      "id": "show_product_price_range",
      "default": true,
      "label": "Show product price range"
    },
    {
      "type": "checkbox",
      "id": "show_product_badge",
      "default": true,
      "label": "Show product badge"
    },
    {
      "type": "checkbox",
      "id": "show_color_options_size",
      "default": true,
      "label": "Show colors count"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    },
    {
      "type": "checkbox",
      "id": "enable_menu_filter",
      "default": true,
      "label": "Enable menu in filters"
    },
    {
      "type": "link_list",
      "id": "menu_filter",
      "label": "Filter menu"
    },
    {
      "type": "checkbox",
      "id": "hide_color_swatch",
      "default": false,
      "label": "Hide color swatch filtering"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 48,
      "step": 3,
      "default": 30,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    }
  ]
}
{% endschema %}
