{{ 'collection.min.css' | asset_url | stylesheet_tag }}
{{ 'fasets.min.css' | asset_url | stylesheet_tag }}
{{ 'grid.min.css' | asset_url | stylesheet_tag }}
{{ 'collection-blocks.min.css' | asset_url | stylesheet_tag }}
{{ 'page-header.min.css' | asset_url | stylesheet_tag }}

<script src="{{ 'component-facets.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-show-more.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-custom-select.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-view-more-pagination.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-page-header.min.js' | asset_url }}" defer="defer"></script>


{%- liquid
  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile
  assign show_promo_banner_flag = true
  assign show_promo_card_flag = true
-%}

{% if section.settings.enable_filtering != true or collection.filters.size < 1 %}
  {%- assign full_width_class = 'collection__content-grid--fill-width' -%}
{% endif %}

{%- assign collections_list = section.settings.collections_list -%}
{%- assign description = collection.description -%}

<div class="collection page-width">
  {% render 'page-header', description: description %}

  <div class="collection__content">
    <div class="collection__content-filters" data-id="{{ section.id }}">
      {% render 'facets', results: collection, enable_filtering: section.settings.enable_filtering, enable_sorting: section.settings.enable_sorting, filter_type: section.settings.filter_type, collections_list: collections_list  %}
    </div>

    <div class="collection__content-grid {{ full_width_class }}" id="ProductGridContainer">
      {%- paginate collection.products by section.settings.products_per_page -%}
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty" id="product-grid" data-id="{{ section.id }}">
            <div class="title-wrapper center">
              <h3 class="title title--primary">
                {{ 'sections.collection_template.empty' | t }}<br>
                {{ 'sections.collection_template.use_fewer_filters_html' | t: link: collection.url, class: " link" }}
              </h3>
            </div>
          </div>
        {%- else -%}
          <div class="collection__content-grid-wrapper">
            {% render 'ga-product-list-event',  event_type: 'view_item_list', product_list: collection.products, list_name: collection.title, list_id: section.id, is_collection: true %}

            <ul id="product-grid"
                data-id="{{ section.id }}"
                style="--columns-desktop: {{ columns_desktop }}; --columns-mobile: {{ columns_mobile }}"
                class="collection__content-grid-list product-grid-{{ section.id }} grid product-grid grid--{{ columns_mobile }}-col-tablet-down grid--{{ columns_desktop }}-col-desktop">
              {% if collection.metafields.promo_card.show_section == 'true' and paginate.current_page == 1 %}
                {%- assign show_promo_card_flag = false -%}

                <li class="collection__content-grid-list-item grid__item grid__item-promo {% if collection.products.size < 2 %} grid__item-promo--second-position {% elsif collection.products.size == 2 %}  grid__item-promo--third-position {% endif %}">
                  {% render 'collection-blocks' block_type: 'promo-card' %}
                </li>
              {% endif %}

              {% if collection.metafields.promo_banner.show_section == 'true' and paginate.current_page == 1 %}
                {%- liquid
                  assign show_promo_banner_flag = false
                  assign column_position_desktop = collection.products.size | divided_by: columns_desktop
                  assign column_position_desktop = column_position_desktop | plus: 1
                  assign column_position_mobile = collection.products.size | divided_by: columns_mobile
                  assign column_position_mobile = column_position_mobile | plus: 1

                  if column_position_desktop >= 4
                    assign column_position_desktop = 4
                  else
                    assign column_position_desktop = column_position_desktop | plus: 1
                  endif

                  if column_position_mobile >= 5
                    assign column_position_mobile = 5
                  else
                    assign column_position_mobile = column_position_mobile | plus: 1
                  endif
                -%}

                <li
                  style="--column-position-mobile: {{ column_position_mobile }}; --column-position-desktop: {{ column_position_desktop }}"
                  class="collection__content-grid-list-item grid__item grid__item-promo-banner rel">
                  {% render 'collection-blocks' block_type: 'promo-banner' %}
                </li>
              {% endif %}

              {%- for product in collection.products -%}

                {%- if product.tags contains 'dev_product'
                  or product.tags contains 'test_product'
                  or product.tags contains 'hidden'
                  or product.tags contains 'not-allowed' -%}
                  {% continue %}
                {%- endif -%}

                {%- liquid
                  if collection.metafields.promo_card.show_section == 'true'
                    assign has_promo_card = 1
                  else
                    assign has_promo_card = 0
                  endif

                  assign real_count_items = paginate.page_size | times: paginate.current_page | plus: has_promo_card
                  assign need_count_items =  collection.products.size
                -%}

                <li class="collection__content-grid-list-item grid__item{% if real_count_items != need_count_items and forloop.index == section.settings.products_per_page and paginate.next.url != null and collection.metafields.promo_card.show_section %} visually-hidden {% endif %}">
                  {% render 'product-card' product: product, quick_add: true, collection_filters: collection.filters %}
                </li>
              {%- endfor -%}
            </ul>

            {% if paginate.next.url != null %}
              {%- assign next_url = paginate.next.url -%}
            {% endif %}
          </div>
        {%- endif -%}
      {%- endpaginate -%}

      {%- if next_url != blank -%}
        <div class="collection__content-grid-btn-wrapper">
          <view-more class="collection__content-grid-btn btn btn--secondary"
                     data-next-page-url="{{ next_url | append: '&section_id=' | append: section.id }}"
                     data-target-wrapper=".product-grid-{{ section.id }}">
            {{ 'sections.collection_template.show_more' | t }}
          </view-more>
        </div>
      {%- endif -%}

      {% render 'collection-blocks' block_type: 'safety' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "tag": "section",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "link_list",
      "id": "collections_list",
      "label": "Collections list"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 24,
      "step": 6,
      "default": 12,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "default": "3",
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_desktop.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_desktop.options__2.label"
        },
        {
          "value": "3",
          "label": "t:sections.main-collection-product-grid.settings.columns_desktop.options__3.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__3.content"
    }
  ],
  "presets": [
    {
      "name": "Main collection grid"
    }
  ],
  "templates": ["collection"]
}
{% endschema %}
