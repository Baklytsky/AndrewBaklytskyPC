{{ 'customer.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'customer.min.js' | asset_url }}" defer="defer"></script>

{%- assign image = section.settings.image -%}

<customer-form class="recover-form__wrapper reset-form__wrapper">
  <div class="recover-form__content">
    <div class="recover-form__content-inner">
      <h1 class="h4 recover-form__heading">
        {{ 'customer.activate_account.title' | t }}
      </h1>
      <p>
        {{ 'customer.activate_account.subtext' | t }}
      </p>
      {%- form 'activate_customer_password', data-form-name: "Activate account" -%}
        <div class="form-field">
          <input
            type="password"
            name="customer[password]"
            id="password"
            autocomplete="new-password"
            placeholder="{{ 'customer.activate_account.password' | t }}"
            {% if form.errors contains 'password' %}
              aria-invalid="true"
              aria-describedby="password-error"
            {% endif %}
            class="form-input"
          >
          <label for="password" class="visually-hidden">
            {{ 'customer.activate_account.password' | t }}
          </label>
        </div>

        <div class="form-field">
          <input
            type="password"
            name="customer[password_confirmation]"
            id="password_confirmation"
            autocomplete="new-password"
            placeholder="{{ 'customer.activate_account.password_confirm' | t }}"
            {% if form.errors contains 'password' %}
              aria-invalid="true"
              aria-describedby="password_confirmation-error"
            {% endif %}
            class="form-input"
          >
          <label for="password_confirmation" class="visually-hidden">
            {{ 'customer.activate_account.password_confirm' | t }}
          </label>
        </div>
        
        <p class="body3 recover-form__pass-text">
          {{ 'customer.recover_password.passwords_validation_text' | t }}
        </p>

        <div class="customer__edit-buttons">
          <button type="submit" class="btn btn--primary-alt">
            {{ 'customer.activate_account.submit' | t }}
          </button>
          <button name="decline" class="a btn--reset body4 customer__cancel-btn">
            {{ 'customer.activate_account.cancel' | t }}
          </button>
        </div>

        <p class="body3 form-error form-error--password hide">{{ "form_errors.password_confirm" | t }}</p>
        <p class="body3 form-error form-error--password-length hide">{{ "form_errors.password_length" | t }}</p>
        <p class="body3 form-error form-error--password-valid hide">{{ "form_errors.password" | t }}</p>
        {%- if form.errors -%}
        <script>
          window.dataLayer.push({
            'event': 'form_error',
            'form': {
              'form_name': 'Activate account',
              'form_validation_errors': '',
              'error_message': ''
            }
          });
        </script>
          <ul>
            {%- for field in form.errors -%}
              <li class="body3 form-error">
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  <a href="#{{ field }}">
                    {{ form.errors.translated_fields[field] | capitalize }}
                    {{ form.errors.messages[field] }}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>

  {%- if image != blank -%}
    <div class="recover-form__image">
      {% render 'image', image: image, class_name: '', preload: true %}
    </div>
  {%- endif -%}
</customer-form>

{% schema %}
{
  "name": "t:sections.main-activate-account.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ]
}
{% endschema %}
