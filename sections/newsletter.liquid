{{ 'component-form.css' | asset_url | stylesheet_tag }}
{{ 'newsletter-section.css' | asset_url | stylesheet_tag }}

{%- assign anchor_link = section.settings.anchor_link -%}

<div class="newsletter__message--success-wrapper hidden-success">
  <p class="newsletter__message--success-text page-width">{{ 'templates.contact.form.newsletter_success' | t }}</p>
</div>

<modal-dialog id="NewsletterModal" class="newsletter primary-bg rel" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
  <div class="newsletter__wrapper hide-scrollbar"
       role="dialog"
       aria-label=""
       aria-modal="true"
       tabindex="-1">
    <button id="ModalClose-{{ section.id }}"
            type="button"
            class="button__modal-close small-up-hide"
            aria-label="{{ 'accessibility.close' | t }}">
      {% render 'icon-close' %}
    </button>
    <form-klaviyo aria-label="{{ heading_form | default : 'Email us' }}"
                   data-klaviyo-list-id="{{ section.settings.klaviyo_list_id }}" data-source="Newsletter form">
        <form action="/contact" method="post" id="newsletter-form">
          {%- if section.settings.heading != blank -%}
            <h4 class="newsletter__heading h6">
              {{ section.settings.heading }}
            </h4>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="newsletter__subheading">
              {{ section.settings.subheading }}
            </p>
          {%- endif -%}
          {%- if section.settings.show_name -%}
            <div class="form__item">
              <input type="text" class="form__input" name="contact[name]"
                     id="form__input-name-{{ section.id }}"
                     data-field="name"
                     aria-label="{{ 'templates.contact.form.name' | t }}"
                     placeholder="{{ 'templates.contact.form.name' | t }}"
                     {% if customer %}value="{{ customer.name }}"{% endif %}
                     required
                     autocomplete="off">
              <label for="form__input-name-{{ section.id }}">{{ 'templates.contact.form.name' | t }}</label>
            </div>
          {%- endif -%}

          <div class="form__item">
            <input type="email" class="form__input" name="contact[email]"
                   id="form__input-email"
                   data-field="email"
                   aria-label="{{ 'templates.contact.form.email' | t }}"
                   placeholder="{{ 'templates.contact.form.email' | t }}"
                   {% if customer %}value="{{ customer.email }}"{% endif %}
                   required
                   autocomplete="off">
            <label for="form__input-email">{{ 'templates.contact.form.email' | t }}</label>
          </div>

          {%- if section.settings.show_birthday -%}
            <div class="form__item">
              <input type="text" class="form__input js-date" name="contact[birthday]"
                     id="form__input-birthday-{{ section.id }}"
                     data-field="birthday"
                     data-properties="true"
                     aria-label="{{ 'templates.contact.form.birthdate' | t }}"
                     placeholder="{{ 'templates.contact.form.birthdate_placeholder' | t }}"
                     pattern="\d{1,2}/\d{1,2}/\d{4}"
                     maxlength="10"
                     autocomplete="off">
              <label for="form__input-birthday-{{ section.id }}">{{ 'templates.contact.form.birthdate_placeholder' | t }}</label>
            </div>
          {%- endif -%}

          {%- if section.settings.show_preference -%}
            <div class="form__item">
              <custom-select class="form__select">
                <div class="form__select-btn"
                     type="button" aria-expanded="false" aria-controls="form__input-preference" role="button">
                  {{ 'templates.contact.form.shopping_preference' | t }}
                </div>

                <ul class="form__select-dropdown" id="form__input-preference">
                  <li class="form__select-dropdown-option" data-option-value="Men's">Men's</li>
                  <li class="form__select-dropdown-option" data-option-value="Women's">Woman's</li>
                </ul>

                <label for="form__input-preference-{{ section.id }}">{{ 'templates.contact.form.shopping_preference' | t }}</label>

                <select class="form__select-hidden"
                        id="form__input-preference-{{ section.id }}"
                        data-field="preference"
                        data-properties="true"
                        name="contact[preference]"
                        title="{{ 'templates.contact.form.shopping_preference' | t }}">
                  <option selected disabled value></option>
                  <option value="Men's">Men's</option>
                  <option value="Women's">Women's</option>
                </select>
              </custom-select>
            </div>
          {%- endif -%}

          {%- if section.settings.show_question -%}
            <div class="form__item">
              <custom-select class="form__select">
                <div class="form__select-btn"
                     type="button" aria-expanded="false" aria-controls="form__input-question" role="button">
                  {{ 'templates.contact.form.sign_up_question' | t }}
                </div>

                <ul class="form__select-dropdown" id="form__input-question">
                  <li class="form__select-dropdown-option" data-option-value="No, I just like your shoes">No, I just like your shoes</li>
                  <li class="form__select-dropdown-option" data-option-value="Once or twice a year">Once or twice a year</li>
                  <li class="form__select-dropdown-option" data-option-value="At least once a month">At least once a month</li>
                  <li class="form__select-dropdown-option" data-option-value="Every week without fail">Every week without fail</li>
                </ul>

                <label for="form__input-question-{{ section.id }}">{{ 'templates.contact.form.sign_up_question' | t }}</label>

                <select class="form__select-hidden"
                        id="form__input-question-{{ section.id }}"
                        data-field="question"
                        data-properties="true"
                        name="contact[question]"
                        title="{{ 'templates.contact.form.sign_up_question' | t }}">
                  <option selected disabled value></option>
                  <option value="No, I just like your shoes">No, I just like your shoes</option>
                  <option value="Once or twice a year">Once or twice a year</option>
                  <option value="At least once a month">At least once a month</option>
                  <option value="Every week without fail">Every week without fail</option>
                </select>
              </custom-select>
            </div>
          {%- endif -%}

          <button type="submit"
                  class="button button--primary button--full-width"
                  data-email-btn-send>
            {{ 'templates.contact.form.sign_up_label' | t }}
          </button>

          {%- if section.settings.description != blank -%}
            <p class="newsletter__description">
              {{ section.settings.description }}
            </p>
          {%- endif -%}
        </form>
        {%- if section.blocks.size > 0 -%}
          <ul class="newsletter__dropdown-list" role="list" data-accordion-collapseble>
            {%- for block in section.blocks -%}
              {%- assign heading = block.settings.heading -%}
              {%- assign description = block.settings.description -%}

              {%- if heading != blank and description != blank -%}
                <li class="newsletter__dropdown-list-item" role="listitem">
                  <details data-accordion-opener data-keep-open class="newsletter__dropdown-item-wrapper">
                    <summary type="button" class="newsletter__dropdown-item-heading-wrapper form__select-btn" aria-controls="link-{{ heading }}"
                             aria-expanded="false" role="button">
                      <span class="newsletter__dropdown-item-heading">{{ heading }}</span>
                    </summary>

                    {%- if description != blank -%}
                      <div class="footer__info-list-inner" id="link-{{ heading }}" data-accordion-content>
                        {{ description }}
                      </div>
                    {%- endif -%}
                  </details>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </form-klaviyo>
  </div>
</modal-dialog>

{% schema %}
{
  "name": "Newsletter pop-up",
  "tag": "section",
  "class": "spaced-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "header",
      "content": "Form settings"
    },
    {
      "type": "text",
      "id": "klaviyo_list_id",
      "label": "Klaviyo list ID"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "checkbox",
      "id": "show_name",
      "label": "Show name field",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_birthday",
      "label": "Show birthday field",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_preference",
      "label": "Show shopping preference select",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_question",
      "label": "Show question select",
      "default": true
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description"
    }
  ],
  "blocks": [
    {
      "type": "dropdown",
      "name": "Dropdown block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Dropdown heading",
          "label": "Dropdown heading"
        },
        {
          "type": "textarea",
          "id": "description",
          "default": "Dropdown description",
          "label": "Dropdown description"
        }
      ]
    }
  ]
}
{% endschema %}
