{{ 'contact-form.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'contact-form.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-custom-select.min.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading = section.settings.heading
  assign klaviyo_list_id = section.settings.klaviyo_list_id
  assign error_message = section.settings.error_message
  assign error_message = section.settings.error_message
  assign success_message = section.settings.success_message
  assign is_subscribed = section.settings.is_subscribed
-%}

<modal-dialog id="contact-form-popup">
  <div class="popup popup-contact" data-popup role="dialog" tabindex="-1" aria-modal="true" aria-hidden="true">
    <contact-form class="contact-form contact-form-popup hide-scrollbar" data-klaviyo-list-id="{{ klaviyo_list_id }}">
      <button class="a btn--reset modal-close" type="button" data-close-popup>
        {%- render 'icon' with 'close' -%}
      </button>
      <div class="contact-form__inner">
        <div class="contact-form__wrapper">
          {%- if heading != blank -%}
            <h2 class="h4 contact-form__heading">{{ heading }}</h2>
          {%- endif -%}

          {%- if klaviyo_list_id != blank -%}
            {%- render 'contact-form-klaviyo',
              blocks: section.blocks,
              id: 'contact-us-page',
              class: 'contact-form__form',
              bottom_text: bottom_text,
              error_message: error_message,
              success_message: success_message,
              is_subscribed: is_subscribed -%}
          {%- else -%}
            {%- render 'contact-form',
              blocks: section.blocks,
              id: 'contact-us-page',
              class: 'contact-form__form',
              bottom_text: bottom_text,
              error_message: error_message,
              success_message: success_message,
              is_subscribed: is_subscribed -%}
          {%- endif -%}


        </div>
      </div>
    </contact-form>
  </div>
</modal-dialog>

