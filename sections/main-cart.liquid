{% if template.name == 'cart' %}
  <script>
    function redirectFromCart() {
      const searchParams = new URLSearchParams(window.location.search);
      searchParams.append('cart', 'open');

      window.location = `/?${searchParams.toString()}`;
    }

    redirectFromCart();
  </script>
{% endif %}

<script src="{{ 'cart.min.js' | asset_url }}" defer="defer"></script>
{% render '_main-cart.min.css' %}

<cart-popup id="cart-drawer" data-section-id="{{ section.id }}">
  {%- liquid
    assign cart_title = section.settings.cart_title
    assign cart_heading = section.settings.cart_heading
    assign button_label = section.settings.button_label
    assign button_url = section.settings.button_url
    assign free_shipping_limit = section.settings.free_shipping_limit | plus: 0 | times: 100
    assign text_before_free_shipping = section.settings.text_before_free_shipping
    assign text_after_free_shipping = section.settings.text_after_free_shipping
    assign cart_total_price = cart.total_price
    assign progress_bar_show = section.settings.progress_bar
    assign enable_ordergroove_opt_in = section.settings.enable_ordergroove_opt_in

    assign recommended_heading_empty = section.settings.recommended_heading_empty
    assign recommended_collection_empty = section.settings.recommended_collection_empty
    assign recommended_products_limit_empty = section.settings.recommended_products_limit_empty
    assign recommended_products_empty_bg = section.settings.recommended_products_empty_bg
    assign gwp_type = section.settings.gwp_type
    assign gwp_texts = ""
  -%}

  {%- for block in section.blocks -%}
    {%- assign target = block.settings.target | handleize -%}

    {%- if target contains "empty" and emty_cart_slider == blank -%}
      {%- assign emty_cart_slider = block -%}
    {%- endif -%}
  {%- endfor -%}

  {%- capture swiper_config -%}
    {
      "slidesPerView": 1.05,
      "watchOverflow": true,
      "mousewheel": {
        "forceToAxis": true
      },
      "breakpoints": {
        "768": {
          "slidesPerView": 1.2
        }
      }
    }
  {%- endcapture -%}

  {%- comment -%} Create data for GWP {%- endcomment -%}

  {%- liquid
    assign gwp_products_keys_in_cart = ""
    assign gwp_data_for_add = ""
    assign gwp_data_for_remove = ""
    assign set_qty_to_1 = ""
    assign cart_clear = false
  -%}

  {%- if gwp_type != "false" -%}
    {%- assign gwp_enable = true -%}
  {%- endif -%}

  {%- if gwp_enable -%}   {%- comment -%} for subscription GWP {%- endcomment -%}
    {%- liquid assign subscription_gwp_arr_blocks = section.blocks | where: 'type', 'subscription_gwp' -%}
  {%- endif -%}

  {%- if gwp_type == "threshold" -%}
    {%- liquid
      assign threshold_arr_blocks = section.blocks | where: 'type', 'single_threshold'
      assign cart_position = threshold_arr_blocks[0].settings.cart_position
    -%}
  {%- elsif gwp_type == "multiple_threshold" -%}
    {%- assign threshold_arr_blocks = section.blocks | where: 'type', 'multiple_threshold' -%}
  {%- endif -%}

  {%- if subscription_gwp_arr_blocks.size > 0 -%}
    {%- assign threshold_arr_blocks = threshold_arr_blocks | concat: subscription_gwp_arr_blocks -%}
    {%- assign cart_has_subscription_product = false -%}
  {%- endif -%}

  {%- assign total_premier_points = 0 -%}
  {%- if cart.item_count -%}
    {%- for item in cart.items -%}
      {%- assign item_property_size = item.properties | size -%}

      {%- if item.selling_plan_allocation and cart_has_subscription_product != true -%}  {%- comment -%} for subscription GWP {%- endcomment -%}
        {%- assign cart_has_subscription_product = true -%}
      {%- endif -%}

      {%- if gwp_type == "buy_x_get_y" and item.product.metafields.custom.gwp != blank -%}
        {%- assign gwp_variant = item.product.metafields.custom.gwp.value -%}

        {%- if gwp_variant.available -%}
          {%- if subscription_gwp_arr_blocks.size > 0 -%}
            {%- liquid
              assign block = subscription_gwp_arr_blocks[0]
              assign get_product = block.settings.get_product
              assign get_product_variant_id = block.settings.get_product_variant_id
              assign get_product_by_variant = get_product.variants | where: 'id', get_product_variant_id | first | default: get_product.variants[0]
            -%}

            {%- if gwp_variant.id == get_product_by_variant.id -%}
              {%- assign subscription_gwp_ignore = true -%}
            {%- endif -%}
          {%- endif -%}

          {%- assign gwp_data_for_add = gwp_data_for_add | append: ","  | append: gwp_variant.id -%}
          {% continue %}
        {%- endif -%}
      {%- endif -%}

      {%- if item_property_size > 0 -%}
        {%- for prop in item.properties -%}
          {%- assign property_name = prop.first | handleize -%}

          {%- if property_name contains "free-gift" -%}
            {%- assign gwp_products_keys_in_cart = gwp_products_keys_in_cart | append: ","  | append: item.key -%}

            {% break %}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {% if settings.premier_points_enabled %}
        {%- assign item_final_price = item.final_price | money_without_currency | round | times: item.quantity -%}
        {%- assign item_line_points = item_final_price | times: settings.points_coefficient -%}
        {%- assign total_premier_points = total_premier_points | plus: item_line_points -%}
      {% endif %}
    {%- endfor -%}

    {%- if gwp_type == "buy_x_get_y" -%}
     {%- comment -%}start for subscription GWP {%- endcomment -%}

      {%- unless subscription_gwp_ignore -%}
        {% liquid
          assign block = subscription_gwp_arr_blocks[0]
          assign get_product = block.settings.get_product
          assign get_product_variant_id = block.settings.get_product_variant_id
          assign get_product_by_variant = get_product.variants | where: 'id', get_product_variant_id | first | default: get_product.variants[0]
        -%}

        {%- if cart_has_subscription_product and get_product_by_variant.available -%}
          {%- unless gwp_data_for_add contains get_product_by_variant.id -%}
          {%- assign gwp_data_for_add = gwp_data_for_add | append: "," | append: get_product_by_variant.id -%}
          {%- endunless -%}
        {%- endif -%}
        {%- comment -%}end for subscription GWP {%- endcomment -%}
      {%- endunless -%}
    {%- endif -%}
  {%- endif -%}

  {%- if gwp_type != "buy_x_get_y" -%}
    {%- assign remove_old_gwps = gwp_products_keys_in_cart -%}
    {%- assign gwp_products_keys_in_cart = gwp_products_keys_in_cart | remove_first: ',' | split: ',' -%}
  {%- endif -%}

  {%- if threshold_arr_blocks.size > 0 -%}
    {%- for block in threshold_arr_blocks -%}
      {%- liquid
        assign amount = block.settings.amount | times: 100
        assign get_product = block.settings.get_product
        assign get_product_variant_id = block.settings.get_product_variant_id
        assign get_product_by_variant = get_product.variants | where: 'id', get_product_variant_id | first | default: get_product.variants[0]
        assign gwp_card_text = block.settings.gwp_card_text | append: "-" | append: get_product_by_variant.id | default: " "
        assign gwp_texts = gwp_texts | append: gwp_card_text | append: ","
      -%}

      {%- if gwp_type == "threshold" and block.type == "single_threshold" -%}
        {%- assign gwp_card_text = block.settings.gwp_card_text -%}
        {%- assign single_threshold_product_id = get_product_by_variant.id -%}
      {%- endif -%}

      {%- if amount != blank and get_product != blank and block.type != "subscription_gwp" -%}
        {%- if amount <= cart.total_price -%}
          {%- if gwp_products_keys_in_cart.size > 0 -%}
            {% include 'cart-gwp-data-helper' %}
          {%- else -%}

            {%- if get_product_by_variant.available -%}
              {%-  assign gwp_data_for_add = gwp_data_for_add | append: "," | append: get_product_by_variant.id -%}
            {%- endif -%}

          {%- endif -%}
        {%- elsif gwp_products_keys_in_cart.size > 0 and block.type != "subscription_gwp" -%}
          {%- for key_in_cart in gwp_products_keys_in_cart -%}
            {%- assign variant_id_in_cart = key_in_cart | split: ':' | first -%}

            {%- if variant_id_in_cart contains get_product_by_variant.id -%}
              {%- assign gwp_data_for_remove = gwp_data_for_remove | append: "," | append: key_in_cart -%}

              {% break %}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- elsif block.type == "subscription_gwp" -%}   {%- comment -%} for subscription GWP {%- endcomment -%}
        {%- for block in threshold_arr_blocks -%}
          {%- liquid
            assign get_local_product = block.settings.get_product
            assign get_local_product_variant_id = block.settings.get_product_variant_id
            assign get_local_product_by_variant = get_local_product.variants | where: 'id', get_local_product_variant_id | first | default: get_local_product.variants[0]
          -%}

          {%- if get_local_product_by_variant.id == get_product_by_variant.id and block.type != "subscription_gwp" -%}
            {%- assign subscription_gwp_ignore = true -%}
            {% break %}
          {%- endif -%}
        {%- endfor -%}

        {%- if cart_has_subscription_product and subscription_gwp_ignore != true -%}
          {% include 'cart-gwp-data-helper' %}
        {%- else -%}
          {%- unless subscription_gwp_ignore -%}
            {%- for key_in_cart in gwp_products_keys_in_cart -%}
              {%- assign variant_id_in_cart = key_in_cart | split: ':' | first -%}

              {%- if variant_id_in_cart contains get_product_by_variant.id -%}
                {%- assign gwp_data_for_remove = gwp_data_for_remove | append: "," | append: key_in_cart -%}

                {% break %}
              {%- endif -%}
            {%- endfor -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endif -%}   {%- comment -%} for subscription GWP {%- endcomment -%}
    {%- endfor -%}
  {%- elsif gwp_type != "buy_x_get_y" -%}
    {%- assign gwp_data_for_remove = gwp_products_keys_in_cart -%}
  {%- endif -%}

  {%- if gwp_type != "buy_x_get_y" -%}
    {%- assign remove_old_gwps = remove_old_gwps | split: "," | uniq -%}
    {%- assign gwp_data_for_remove = gwp_data_for_remove | concat: remove_old_gwps | uniq | join: ',' -%}
  {%- endif -%}

  {%- assign gwp_card_texts_arr = gwp_texts | split: ',' -%}

  {%- comment -%} End create data for GWP {%- endcomment -%}

  {% if cart.item_count > 0 %}
    {% capture cart_items %}

      {% for item in cart.items %}
        {%- assign is_gwp_item = false -%}
        {%- assign item_property_size =  item.properties | size -%}

        {% if item_property_size > 0 %}
          {% for prop in item.properties %}
            {%- assign property_name = prop.first | handleize -%}

            {% if property_name == "_free-gift" %}
              {% assign is_gwp_item = true %}

              {%- if item.quantity > 1 -%}
                {%- assign set_qty_to_1 = set_qty_to_1 | append: "," | append: item.key -%}
              {%- endif -%}
            {% endif %}

          {% endfor %}
        {% endif %}

        {%- if gwp_type == "buy_x_get_y" and is_gwp_item -%}
          {%- liquid
            assign gwp_products_keys_in_cart = gwp_products_keys_in_cart | append: ',' | append: line_item.key
            assign gwp_data_for_add_arr = gwp_data_for_add | remove_first: "," | split: "," | uniq
            assign flag = true
          -%}

          {%- if gwp_data_for_add_arr.size > 0 -%}
            {%- for gwp_variant_id in gwp_data_for_add_arr -%}
              {%- assign line_item_variant_id_handle = item.variant_id | handleize -%}

              {%- if gwp_variant_id == line_item_variant_id_handle -%}
                {%- assign gwp_data_for_add = gwp_data_for_add | remove: line_item_variant_id_handle -%}
                {%- assign flag = false -%}

                {%- break -%}
              {%- elsif flag and forloop.last -%} {%- comment -%} for the case when we remove the free product {%- endcomment -%}
                  {%- assign gwp_data_for_remove = gwp_data_for_remove | append: ',' | append: item.key -%}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- assign gwp_data_for_remove = gwp_data_for_remove | append: ',' | append: item.key -%}
          {%- endif -%}
        {%- endif -%}

        {% if gwp_products_keys_in_cart contains item.key and gwp_type != "false" %}
          {%- for gwp_card_text_id in gwp_card_texts_arr -%}
            {%- if gwp_card_text_id contains item.variant_id -%}
              {%- assign gwp_card_text = gwp_card_text_id | split: '-' | first -%}
              {% break %}
            {%- else -%}
              {%- assign gwp_card_text = false -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if single_threshold_product_id == item.variant.id -%} {%- comment -%} single_threshold_banner {%- endcomment -%}
            {%- assign cart_has_gwp = true -%}
          {%- endif -%}

          {% render 'cart-item' item: item, gwp: true, message: gwp_card_text, enable_ordergroove_opt_in: enable_ordergroove_opt_in %}
        {% else %}
          {% render 'cart-item' item: item, enable_ordergroove_opt_in: enable_ordergroove_opt_in %}
        {% endif %}
      {% endfor %}

    {% endcapture %}
  {% endif %}

  <div class="cart-popup popup drawer drawer--right" data-popup tabindex="-1" aria-modal="true" aria-hidden="true" role="dialog">
    <div class="cart-popup__content">
      <div id="cart-popup-inner" class="cart-popup__inner">
        <modal-opener>
          <button
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="#cart-drawer"
            data-close-drawers
            class="cart-popup__close-btn btn--reset a">
            {% render 'icon' with 'close' %}

            <span class="visually-hidden">{{ 'templates.cart.cart_close' | t }}</span>
          </button>
        </modal-opener>

        <div class="cart-popup__header-wrapper cart-padding">
          <div class="cart-popup__header border-bottom">
            {% if cart_title != blank %}
              <h3 class="cart-popup__title h5">{{ cart_title }}</h3>
            {% endif %}

            <span class="cart-popup__item-count body3">
            {{ 'templates.cart.count' | t: count: cart.item_count }}
          </span>
            <span class="cart-count hidden">{{ cart.item_count }}</span>
          </div>
        </div>

        {% if cart.item_count == 0 %}
          <div class="cart-popup__empty-state-wrapper">
            <div class="cart-popup__empty-state-info">
              {% if cart_heading != blank %}
                <h4 class="cart-popup__empty-state-heading h5">{{ cart_heading }}</h4>
              {% endif %}

              {%- if button_label != blank and button_url != blank -%}
                <a href="{{ button_url }}" class="btn btn--primary-alt">{{ button_label }}</a>
              {%- endif -%}
            </div>

            {% if emty_cart_slider != blank %}
              <div class="cart-popup__empty-state-slider">
                {%- render 'cart-recomended-products', config: swiper_config, block: emty_cart_slider, class_name: 'empty-slider' -%}
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% render 'ga-product-list-event', event_type: 'view_cart', class_name: 'hide cart-view-event' %}

        {% if cart.item_count > 0 %}
          <cart-items>
            <div class="cart-popup__wrapper" id="cart-popup__wrapper" data-id="{{ section.id }}">
              <div class="hide-scrollbar cart-popup__scrolling" id="cart-popup__inner">
                {% if progress_bar_show %}
                  {%- if gwp_type == "threshold" or gwp_type == "multiple_threshold" -%}
                    {% render 'cart-progress-bar', blocks: threshold_arr_blocks, treshold: true %}
                  {%- else -%}
                    {% render 'cart-progress-bar', treshold: false %}
                  {%- endif -%}
                {% endif %}
                <div class="cart__items  cart-padding" id="main-cart">
                  <form action="{{ routes.cart_url }}" class="cart__contents" method="post" id="cart">
                    <div class="cart__item-box">
                      {{ cart_items }}
                    </div>
                  </form>

                  {%- assign counter = 0 -%}
                  {%- capture gwpConditions -%}
                    {%- for block in threshold_arr_blocks -%}
                      {%- liquid
                        assign amount = block.settings.amount
                        assign get_product = block.settings.get_product
                        assign get_product_variant_id = block.settings.get_product_variant_id
                        assign get_product_by_variant = get_product.variants | where: 'id', get_product_variant_id | first | default: get_product.variants[0] -%}

                      {%- if get_product_by_variant.available and amount != blank -%}
                        {%- assign counter = counter | plus: 1 -%}
                        {%- if counter > 1 -%},{%- endif -%}{
                          "id": "gid://shopify/ProductVariant/{{ get_product_by_variant.id }}",
                          "threshold": "{{ amount }}"
                        }
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endcapture -%}

                  <script type="application/json" data-gwp-conditions>
                    {"__gwp": [{{- gwpConditions -}}]}
                  </script>
                </div>

                {% for block in section.blocks %}
                  {%- case block.type -%}
                  {% when 'slider' %}
                    {%- assign target = block.settings.target | handleize -%}

                    {% unless target contains "empty" %}
                      <div class="cart-popup__slider">
                        {%- render 'cart-recomended-products', config: swiper_config, block: block, class_name: 'cart-slider' -%}
                      </div>
                    {% endunless %}
                  {% when 'promo_card' %}
                    {% render 'cart-promo-banner' block: block %}
                  {%- endcase -%}

                  {%- if cart_position < forloop.index or forloop.last and cart_position != 100 -%}
                    {%- assign cart_position = 100 -%}

                    {% if cart_has_gwp != true and gwp_type == "threshold" %}
                      {% if threshold_arr_blocks.size > 0 %}
                        {% render 'cart-promo-banner' block: threshold_arr_blocks[0] %}
                      {% endif %}
                    {% endif %}
                  {%- endif -%}
                {% endfor %}
              </div>

              {% if cart.item_count > 0 %}
                <div class="cart-popup-footer border-top">
                  <div class="cart-popup__checkout cart-padding">
                    <div class="cart-popup__total-price">
                      <div class="cart-popup__subtotal">
                        <span class="cart-subtotal__text body3 body3--bold">
                          {{ 'templates.cart.footer.title' | t }}
                        </span>
                      </div>

                      <div class="cart-popup__price body3 body3--bold">
                        {{ cart.total_price | money }}
                      </div>
                    </div>
                    <div class="cart-popup-checkout-button">
                      <a href="/checkout" class="btn btn--primary btn--primary-alt">{{ 'templates.cart.checkout_btn' | t }}</a>
                    </div>

                    {% if settings.premier_points_enabled %}
                      <div class="cart-popup__total-points body4">
                        {{ 'templates.cart.footer.final_points' | t: premier_points: total_premier_points }}
                      </div>
                    {% endif %}
                  </div>
                </div>
              {% endif %}

              {%- assign gwp_data_for_remove = gwp_data_for_remove | remove_first: "," | split: "," | uniq -%}
              {%- assign gwp_data_for_add = gwp_data_for_add | remove_first: "," | split: "," | uniq -%}
              {%- assign set_qty_to_1 = set_qty_to_1 | remove_first: "," | split: "," | uniq -%}
              {%- assign gwp_in_cart = cart.items | map: 'properties' | where: '_free-gift'  -%}

              {%- if gwp_in_cart.size == cart.items.size or cart.items.size > 0 and cart.total_price == 0 -%}
                {%- assign cart_clear = true -%}
              {%- endif -%}

              {%- if gwp_type == "false" -%}
                {%- assign gwp_data_for_add = '' -%}

                {%- for item in gwp_products_keys_in_cart -%} {%- comment -%} check if the variable is an array {%- endcomment -%}
                  {%- assign gwp_data_for_remove = gwp_products_keys_in_cart | uniq -%}
                  {% break %}
                {%- else -%}
                  {%- assign gwp_data_for_remove = '' -%}
                {%- endfor -%}
              {%- endif -%}

              <script id="giftProductData" type="application/json">
                {
                  "gwp_enabled": {{ gwp_enable | json }},
                  "gwp_items_for_remove": {{ gwp_data_for_remove | json }},
                  "set_qty_to_1": {{ set_qty_to_1 | json }},
                  "gwp_items_for_add": {{ gwp_data_for_add | json }},
                  "cart_clear": {{ cart_clear | json }}
                }
              </script>


              <script type="application/ld+json" data-begin-checkout>
                {
                  "event": "begin_checkout",
                  "ecommerce": {
                    "currency": "{{ shop.currency }}",
                    "value": "{{ cart.total_price | money_without_currency }}",
                    "items": [
                      {%- for line_item in cart.items -%}
                        {%- assign promotion_prop_arr = line_item.properties['_promotion'] | split: ' | ' -%}
                        {%- assign promotion_name = promotion_prop_arr[0]-%}
                        {%- assign promotion_id = promotion_prop_arr[1]-%}
                      {
                        "item_id": "{{ line_item.id }}",
                        "item_name": "{{ line_item.title }}",
                        "coupon": "{{ line_item.line_level_discount_allocations[0].discount_application.title }}",
                        "discount": "{{ line_item.line_level_total_discount | money_without_currency }}",
                        "index": "{{ forloop.index }}",
                        "item_brand": "{{ line_item.product.vendor }}",
                        {% for collecton in line_item.product.collections limit: 5 %}
                        "item_category{% unless forloop.first %}{{- forloop.index }}{% endunless %}": "{{ collecton.title | strip_html  | remove: '"'}}",
                        {% endfor %}
                        "item_list_name": "Cart line items list",
                        "item_list_id": "cart-line-items",
                        "item_variant": "{{ line_item.variant.title }}",
                        "price": "{{ line_item.variant.price | money_without_currency }}",
                        "quantity": "{{ line_item.quantity }}",
                        "product_type": "{{ line_item.product.type }}",
                        "promotion_id": "{{ promotion_id }}",
                        "promotion_name": "{{ promotion_name }}",
                        "creative_name": "",
                        "creative_slot": ""
                       }{% unless forloop.last %},{% endunless %}
                          {%- endfor -%}
                    ]
                  }
                }
              </script>
            </div>
          </cart-items>
        {% endif %}
      </div>
    </div>
  </div>
</cart-popup>


{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "header",
      "content": "Cart empty state"
    },
    {
      "type": "text",
      "id": "cart_title",
      "label": "Title",
      "default": "Your Bag"
    },
    {
      "type": "text",
      "id": "cart_heading",
      "label": "Empty state heading"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Progress bar"
    },
    {
      "type": "checkbox",
      "id": "progress_bar",
      "label": "Enable",
      "default": true
    },
    {
      "type": "text",
      "id": "first_progress_message",
      "label": "First message",
      "default": "You’re [price] away from free shipping",
      "info": "Use the custom tag - [price] to enter the price in the string"
    },
    {
      "type": "text",
      "id": "second_progress_message",
      "label": "Second message",
      "default": "You’re [price] away from a free gift",
      "info": "Use the custom tag - [price] to enter the price in the string"
    },
    {
      "type": "text",
      "id": "third_progress_message",
      "label": "Third message",
