{%- if product.metafields.pdp_merged_products.main_product != blank -%}
	{%- assign redirect_product = all_products[product.metafields.pdp_merged_products.main_product] -%}

	{%- if redirect_product.url != product.url -%}
		<script type="application/javascript">
      const searchParams = window.location.search ? `${window.location.search}` : '';

      window.location.href = `{{ redirect_product.url }}${searchParams}`
		</script>
	{%- endif -%}
{%- endif -%}


