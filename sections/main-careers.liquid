{{ 'main-careers.min.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
-%}

{% if section.blocks.size > 0 %}
  <div class="main-careers">
    <div class="page-width">
      <div class="main-careers__content">
        {%- if heading != blank -%}
          <h4 class="h6 main-careers__heading">{{ heading }}</h4>
        {%- endif -%}

        <ul class="main-careers__list">
          {% for block in section.blocks %}
            {%- liquid
              assign heading = block.settings.heading | escape | newline_to_br
              assign description = block.settings.description
              assign link_label = block.settings.link_label
              assign link_url = block.settings.link_url
            -%}

            {%- if heading != blank or description != blank -%}
              <li class="main-careers__item">
                {%- if heading != blank -%}
                  {% if link_url != blank %}
                     <a href="{{ link_url }}" target="_blank" class="h5 main-careers__item-heading">
                  {% else %}
                     <h5 class="main-careers__item-heading">
                  {% endif %}
                    {{ heading }}
                  {% if link_url != blank %}</a>{% else %}</h5>{% endif %}
                {%- endif -%}

                <div class="main-careers__item-content">
                  {%- if description != blank -%}
                    <div class="main-careers__item-desc body1">{{ description }}</div>
                  {%- endif -%}

                  {%- if link_url != blank and link_label != blank -%}
                    <a href="{{ link_url }}" target="_blank" class="body1 main-careers__item-link">{{ link_label }}</a>
                  {%- endif -%}
                </div>
              </li>
            {%- endif -%}
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Main careers",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Current Job Openings"
    }
  ],
  "blocks": [
    {
      "type": "job",
      "name": "Job",
      "settings": [
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "View Job Opening"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link url"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Main careers"
    }
  ],
  "templates": ["page"]
}
{% endschema %}
