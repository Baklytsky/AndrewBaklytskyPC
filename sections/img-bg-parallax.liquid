{{ 'section-image-banner-with-parallax.css' | asset_url | stylesheet_tag }}

{% liquid
	assign image = section.settings.image
	assign image_2 = section.settings.image_2
%}

{%- style -%}
	#shopify-section-{{ section.id }} .aspect-ratio {
		--aspect-ratio: {{ image.aspect_ratio}}
	}

	{% if image_2 -%}
		#shopify-section-{{ section.id }} .aspect-ratio {
			@media screen and (max-width: 749px) {
				--aspect-ratio: {{ image_2.aspect_ratio}}
			}
		}
	{%- endif %}

      @media screen and (max-width: 749px) {
        .banner-parallax .aspect-ratio > div {
            background-attachment: scroll;
        }
      }
{%- endstyle -%}


{%- if image -%}
	<div id="Banner-{{ section.id }}"
			 class="aspect-ratio">

		<div class="lazyload absolute {%- if image_2 %} small-hide{%- endif -%}"
			data-bgset="{% if image.width > 180 %}{{ image | img_url: '180x' }} 180w {{ 180 | divided_by: image.aspect_ratio | round }}h,{% endif %}
									{% if image.width > 360 %}{{ image | img_url: '360x' }} 360w {{ 360 | divided_by: image.aspect_ratio | round }}h,{% endif %}
									{% if image.width > 540 %}{{ image | img_url: '540x' }} 540w {{ 540 | divided_by: image.aspect_ratio | round }}h,{% endif %}
									{% if image.width > 720 %}{{ image | img_url: '720x' }} 720w {{ 720 | divided_by: image.aspect_ratio | round }}h,{% endif %}
									{% if image.width > 900 %}{{ image | img_url: '900x' }} 900w {{ 900 | divided_by: image.aspect_ratio | round }}h,{% endif %}
									{% if image.width > 1080 %}{{ image | img_url: '1080x' }} 1080w {{ 1080 | divided_by: image.aspect_ratio | round }}h,{% endif %}
									{% if image.width > 1296 %}{{ image | img_url: '1296x' }} 1296w {{ 1296 | divided_by: image.aspect_ratio | round }}h,{% endif %}
									{% if image.width > 1512 %}{{ image | img_url: '1512x' }} 1512w {{ 1512 | divided_by: image.aspect_ratio | round }}h,{% endif %}
									{% if image.width > 1728 %}{{ image | img_url: '1728x' }} 1728w {{ 1728 | divided_by: image.aspect_ratio | round }}h,{% endif %}
									{{ image | img_url: 'master' }} {{ image.width }}w {{ image.height }}h" role="img" aria-label="{{ image.alt }}">
		</div>

			{%- if image_2 -%}
				<div class="lazyload absolute small-up-hide"
						 data-bgset="{% if image_2.width > 180 %}{{ image_2 | img_url: '180x' }} 180w {{ 180 | divided_by: image_2.aspect_ratio | round }}h,{% endif %}
									{% if image_2.width > 360 %}{{ image_2 | img_url: '360x' }} 360w {{ 360 | divided_by: image_2.aspect_ratio | round }}h,{% endif %}
									{% if image_2.width > 540 %}{{ image_2 | img_url: '540x' }} 540w {{ 540 | divided_by: image_2.aspect_ratio | round }}h,{% endif %}
									{% if image_2.width > 720 %}{{ image_2 | img_url: '720x' }} 720w {{ 720 | divided_by: image_2.aspect_ratio | round }}h,{% endif %}
									{% if image_2.width > 900 %}{{ image_2 | img_url: '900x' }} 900w {{ 900 | divided_by: image_2.aspect_ratio | round }}h,{% endif %}
									{{ image_2 | img_url: 'master' }} {{ image_2.width }}w {{ image_2.height }}h" role="img" aria-label="{{ image_2.alt }}" role="img" aria-label="{{ image_2.alt }}">
				</div>
			{%- endif -%}
	</div>
{%- endif -%}

{% schema %}
{
	"name": "Image with parallax",
	"tag": "section",
	"class": "spaced-section--full-width banner-parallax",
	"settings": [
		{
			"type": "image_picker",
			"id": "image",
			"label": "Desktop image"
		},
		{
			"type": "image_picker",
			"id": "image_2",
			"label": "Mobile image"
		}
	],
	"blocks": [],
	"presets": [
		{
			"name": "Image with parallax",
			"blocks": []
		}
	]
}
{% endschema %}
