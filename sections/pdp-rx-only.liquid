{{ 'pdp-main.min.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign show_breadcrumbs = section.settings.show_breadcrumbs
  assign arrows_layout = section.settings.arrows_layout
  assign dots_layout = section.settings.dots_layout

  if product.selected_or_first_available_variant.featured_media
  assign seo_media = product.selected_or_first_available_variant.featured_media
  else
  assign seo_media = product.featured_media
  endif
-%}

{%- if show_breadcrumbs -%}
  {% render 'breadcrumbs' %}
{%- endif -%}

<div class="pdp-main">
  {%- render 'pdp-rx-only-media', product: product, arrows_layout: arrows_layout, dots_layout: dots_layout -%}
  {%- render 'pdp-rx-only-details', product: product -%}
</div>

<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "@id" : "{{shop.url}}{{ product.url }}",
    "name": {{ product.title | json }},
    "url": {{ shop.url | append: product.url | json }},
    {% if seo_media -%}
  {%- assign media_size = seo_media.preview_image.width | append: 'x' -%}
      "image": [
        {{ seo_media | img_url: media_size | prepend: "https:" | json }}
      ],
    {%- endif %}
    "description": {{ product.description | strip_html | json }},
    {% if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif %}
    "brand": {
      "@type": "Thing",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "url" : {{ shop.url | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Product details (rx-only)",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "arrows_layout",
      "label": "Arrows layout",
      "options": [
        {
          "value": "show-on-mobile",
          "label": "Show only on mobile"
        },
        {
          "value": "show-on-desktop",
          "label": "Show only on desktop"
        },
        {
          "value": "show",
          "label": "Show"
        },
        {
          "value": "hide",
          "label": "Hide"
        }
      ],
      "default": "hide"
    },
    {
      "type": "select",
      "id": "dots_layout",
      "label": "Dots layout",
      "options": [
        {
          "value": "show-on-mobile",
          "label": "Show only on mobile"
        },
        {
          "value": "show-on-desktop",
          "label": "Show only on desktop"
        },
        {
          "value": "show",
          "label": "Show"
        },
        {
          "value": "hide",
          "label": "Hide"
        }
      ],
      "default": "show-on-mobile"
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "collection",
      "name": "Collection",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Description",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "subtitle",
      "name": "Subtitle",
      "limit": 1
    },
    {
      "type": "info_label",
      "name": "Info label",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1
    },
    {
      "type": "product-rx-form",
      "name": "Product-rx-form",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_sticky_bar",
          "label": "Show sticky bar",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_quantity_selector",
          "default": true,
          "label": "Show quantity selector"
        }
      ]
    },
    {
      "type": "skin_type_and_concern",
      "name": "Skin type and concern",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Best for",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "ingredients",
      "name": "Ingredients",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Ingredients",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "safety_information",
      "name": "Safety information",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Safety information",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Product details (rx-only)"
    }
  ],
  "templates": ["product"]
}
{% endschema %}
