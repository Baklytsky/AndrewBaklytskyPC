{{ 'section-heading-with-text.css' | asset_url | stylesheet_tag }}

{%- assign anchor_link = section.settings.anchor_link -%}
{%- assign heading = section.settings.heading | default: page.title -%}
{%- assign text = section.settings.text | default: page.content -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.section_bg_color }};
    color: {{ section.settings.section_text_color }};
  }
{%- endstyle -%}

<div class="page-width hwt__wrapper" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
  {%- if heading != blank -%}
    <h1 class="h1 hwt__heading">{{ heading }}</h1>
  {%- endif -%}
  
  {%- if text != blank -%}
    <div class="hwt__text rte">{{ text }}</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Heading with text",
  "class": "heading-with-text hwt",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background color",
      "default": "#070707"
    },
    {
      "type": "color",
      "id": "section_text_color",
      "label": "Section text color",
      "default": "#F9F9F9"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "By default page title"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "By default page content"
    }
  ],
  "presets": [
    {
      "name": "Heading with text"
    }
  ],
  "templates": ["page"]
}
{% endschema %}
