{%- assign anchor_link = section.settings.anchor_link -%}

<style>
	.storemapper-wrapper {
		background-color: rgb(7, 7, 7);
		/*color: #FFFFFF;*/
	}

  .storemapper-wrapper #storemapper {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 24px;
	}

  .storemapper-wrapper .strmpr-search-results .strmpr-search-result .strmpr-field-show-on-map:hover {
    color: rgb(var(--color-button-hover-text-secondary));
    background-color: rgb(var(--color-button-hover-bg-secondary));
	}

  /*.storemapper-wrapper .strmpr-search .strmpr-search-box-wrapper .strmpr-search-box:focus-visible {*/
  /*  box-shadow: none;*/
	/*}*/

  .storemapper-wrapper .strmpr-search .strmpr-search-box-wrapper .strmpr-search-box:focus {
    font-size: 14px;
  }

  /*.storemapper-wrapper #storemapper .strmpr-search-results .strmpr-search-result {*/
  /*  background-color: rgb(7, 7, 7);*/
	/*	color: #FFFFFF;*/
	/*}*/

  /*.storemapper-wrapper #storemapper .strmpr-search-results a{*/
  /*  color: #FFFFFF;*/
	/*}*/

  .storemapper-wrapper #storemapper .strmpr-view-more-stores-button {
		display: none;
	}

  @media screen and (min-width: 750px) {
    .storemapper-wrapper #storemapper {
      padding: 0 72px;
    }
	}
</style>


<div class="storemapper-wrapper" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
	{% if section.settings.heading != blank %}
		<h2 class="h1 page-width iwot-carousel__heading-section iwt-carousel__heading" style="color: #303030; ">
			{{ section.settings.heading }}
		</h2>
	{% endif %}
	<div id='storemapper' style='width:100%;'>
		<p>Store Locator is loading from <a href='https://www.storemapper.co'>Storemapper store locator software</a>...</p>
	</div>
</div>

<script data-storemapper-start='2024,01,22'
				data-storemapper-id='23852-jt2HGOrCnjMM2cBD'>
  (function() {var script = document.createElement('script');
    script.type  = 'text/javascript';script.async = true;
    script.src = 'https://www.storemapper.co/js/widget-3.min.js';
    var entry = document.getElementsByTagName('script')[0];
    entry.parentNode.insertBefore(script, entry);}
  ());
</script>

{% schema %}
{
  "name": "Storemapper",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "presets": [
    {
      "name": "Storemapper"
    }
  ]
}
{% endschema %}
