{%- liquid
	assign anchor_link = section.settings.anchor_link
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign blocks = section.blocks
-%}

{%- if blocks.size > 0 -%}
  {{ 'section-text-with-button.css' | asset_url | stylesheet_tag }}

  <div class="text-with-button" style="--bg-color: {{ bg_color }}; --text-color: {{ text_color }}" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
    <div class="page-width text-with-button__wrapper">
      {%- for block in blocks -%}
        {%- case block.type -%}
        {%- when 'heading' -%}
          {%- liquid
            assign heading = block.settings.heading
            assign text_style = block.settings.text_style
          -%}

          {%- if heading != blank -%}
            <h2 class="text-with-button__heading {{ text_style }}" {{ block.shopify_attributes }}>
              {{ heading }}
            </h2>
          {%- endif -%}
        {%- when 'text' -%}
          {%- liquid
            assign text = block.settings.text
          -%}

          {%- if text != blank -%}
            <div class="text-with-button__text" {{ block.shopify_attributes }}>
              {{ text }}
            </div>
          {%- endif -%}
        {%- when 'button' -%}
          {%- liquid
            assign button_text = block.settings.button_text
            assign button_url = block.settings.button_url
            assign button_style = block.settings.button_style
            assign button_attr = block.settings.button_attr
          -%}

          <a href="{{ button_url }}" class="button button--{{ button_style }}" {{ button_attr }} {{ block.shopify_attributes }}>
            {{ button_text }}
          </a>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.addEventListener('click', function(event) {
      if (event.target.classList.contains('lion-action-button')) {
        const accountComponent = document.getElementById('AccountModal');
        const modalBlock = document.querySelector('modal-block');
        const params = new URLSearchParams(window.location.search);
        const loyaltyCloseModalButton = document.querySelector('.lion-referral-widget-modal__close-button');

        if (!accountComponent)  return;

        if (event.target.getAttribute('href') === '/account/login') {
          event.preventDefault();
          params.delete('create');
          params.set('login', 'true');

          accountComponent.show(event.target);
          modalBlock.checkingResponse(params.toString());
          modalBlock.clearResponse();
          if (loyaltyCloseModalButton)  loyaltyCloseModalButton.click();
        } else if (event.target.getAttribute('href') === '/account/register') {
          event.preventDefault();
          params.delete('login');
          params.set('create', 'true');

          accountComponent.show(event.target);
          modalBlock.checkingResponse(params.toString());
          modalBlock.clearResponse();
          if (loyaltyCloseModalButton)  loyaltyCloseModalButton.click();
        }
      }
    })
  })
</script>

{% schema %}
	{
		"name": "Text with button",
		"settings": [
      {
        "type": "text",
        "id": "anchor_link",
        "label": "Anchor link"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text"
      }
    ],
		"blocks": [
      {
        "type": "heading",
        "name": "Heading",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading"
          },
          {
            "type": "select",
            "id": "text_style",
            "label": "Text style",
            "default": "h2",
            "options": [
              {
                "label": "H1",
                "value": "h1"
              },
              {
                "label": "H2",
                "value": "h2"
              },
              {
                "label": "H3",
                "value": "h3"
              },
              {
                "label": "H4",
                "value": "h4"
              },
              {
                "label": "H5",
                "value": "h5"
              },
              {
                "label": "H6",
                "value": "h6"
              }
            ]
          }
        ]
      },
      {
        "type": "text",
        "name": "Text",
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "label": "Text",
            "default": "<p>Lorem ipsum</p>"
          }
        ]
      },
      {
        "type": "button",
        "name": "Button",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "button_text",
            "label": "Button text"
          },
          {
            "type": "url",
            "id": "button_url",
            "label": "Button url"
          },
          {
            "type": "select",
            "id": "button_style",
            "options": [
              {
                "value": "primary",
                "label": "Primary"
              },
              {
                "value": "secondary",
                "label": "Secondary"
              },
              {
                "value": "transparent",
                "label": "Transparent"
              }
            ],
            "default": "secondary",
            "label": "Button style"
          },
          {
            "type": "text",
            "id": "button_attr",
            "label": "Attribute",
            "info": "(optional)"
          }
        ]
      }
    ],
		"presets": [
      {
        "name": "Loyalty - Text with button"
      }
    ]
	}
{% endschema %}