{% style %}
  @media (max-width: 47.9375rem) {
  #shopify-section-{{ section.id }} .ra-split-section {
  padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_right_mobile }}px {{ section.settings.padding_bottom_mobile }}px {{ section.settings.padding_left_mobile }}px;
  }
  }

  @media (min-width: 48rem) {
  #shopify-section-{{ section.id }} .ra-split-section {
  padding: {{ section.settings.padding_top }}px {{ section.settings.padding_right }}px {{ section.settings.padding_bottom }}px {{ section.settings.padding_left }}px;
  }
  }


  #shopify-section-{{ section.id }} .ra-left-split {
  --col-size: 100%;
  {% if section.blocks.size == 1 %}
    --col-size-md: 100%;
  {% else %}
    --col-size-md: 50%;
  {% endif %}
  }

  #shopify-section-{{ section.id }} .ra-right-split {
  --col-size: 100%;
  {% if section.blocks.size == 1 %}
    --col-size-md: 100%;
  {% else %}
    --col-size-md: 50%;
  {% endif %}
  }
{% endstyle %}


<div class="">
  <article class="ra-split-section mx:px-7 set--aspect-ratio-respect-media">
    <div class="ra-split-section__layout-container component-layout ra-row ra-no-gap !items-stretch">
      {% if section.blocks.size > 0 %}
        {%- for block in section.blocks  -%}
          {%- case block.type -%}
            {%- when 'copy' -%}
              {% liquid
                assign cta_1_text = block.settings.cta_1_text
                assign cta_1_url = block.settings.cta_1_url
                assign open_new_tab_1 = block.settings.open_new_tab_1
                assign cta_1_style = block.settings.cta_1_style

                assign cta_2_text = block.settings.cta_2_text
                assign cta_2_url = block.settings.cta_2_url
                assign open_new_tab_2 = block.settings.open_new_tab_2
                assign cta_2_style = block.settings.cta_2_style

                assign enable_cta_1 = false
                assign enable_cta_2 = false

                if cta_1_text != blank and cta_1_url != blank
                  assign enable_cta_1 = true
                endif

                if cta_2_text != blank and cta_2_url != blank
                  assign enable_cta_2 = true
                endif
              %}

              <div class="ra-col ra-right-split ra-split-copy component-details z-10 p-[32px] md:p-10 md:pl-[111px] flex items-center " data-col-size="-size,-md" style="
                --component-bg-color: var({{- block.settings.bg_color -}});
                --component-bg-color-md: var({{- block.settings.bg_color_md -}});
                --component-fg-color: var({{- block.settings.text_color_mobile -}});
                --component-fg-color-md: var({{- block.settings.text_color_desktop -}});">
                <div class="ra-split-section__copy max-w-[380px] set--v-align-middle-sm set--v-align-{{ block.settings.vertical_align_md }}-md set--h-align-{{ block.settings.horizontal_align }}-sm set--h-align-{{ block.settings.horizontal_align_md }}-md">
                  {% if block.settings.eyebrow_text != blank %}
                    <div class="ra-split-section__subtitle mono-16 flex items-center gap-x-3 mb-[18px]" >
                      {% if block.settings.show_eyebrow_arrow == true %}
                        {%- render 'ra-icon', icon: 'right-arrow', width: '9px' height: '9px' -%}
                      {% endif %}
                      {{- block.settings.eyebrow_text -}}
                    </div>
                  {% endif %}
                  {% if block.settings.title != blank %}
                    <div
                      class="ra-split-section__title
                      {% if block.settings.description != blank %}
                        {% if block.settings.show_countdown == false %}
                         mb-[50px]
                        {% endif %}
                      {% endif %}"
                    >
                      {{- block.settings.title -}}
                    </div>
                  {% endif %}

                  {% if block.settings.show_countdown %}
                    <div class="ra-split-section__countdown my-12 w-full flex justify-between">
                      <p>{{ block.settings.countdown_text }}</p>
                      {% comment %}<split-countdown-timer class="ra-split-section__countdown-timer ra-split-section__countdown-timer-{{ block.id }}"{% endcomment %}
                                       {% comment %}data-countdown-date="{{ block.settings.countdown_date }}"{% endcomment %}
                                       {% comment %}data-countdown-time="{{ block.settings.countdown_time }}"{% endcomment %}
                                       {% comment %}data-block-id="{{ block.id }}"{% endcomment %}
                      {% comment %}>{% endcomment %}
                      {% comment %}</split-countdown-timer>{% endcomment %}
                      <p class="ra-split-section__countdown-timer"
                         data-countdown-date="{{ block.settings.countdown_date }}"
                         data-countdown-time="{{ block.settings.countdown_time }}">
                      </p>
                    </div>
                  {% endif %}

                  {% if block.settings.description != blank %}
                    <div class="mono-16 rte {% if enable_cta_1 or enable_cta_2 or block.settings.show_calendar_button %} mb-12 {% endif %}">
                      {{- block.settings.description | replace: "<p", "<p class='mono-16'" -}}
                    </div>
                  {% endif %}
                  {% if block.settings.show_calendar_button %}
                    <div data-vue-root="AddToCalendarButton"   class="w-full">
                      <add-to-calendar-button
                        name="{{ block.settings.calendar_reminder_title }}"
                        startDate="{{ block.settings.countdown_date }}"
                        {% if block.settings.countdown_end_time != blank %}
                          startTime="{{ block.settings.countdown_time }}"
                          endTime="{{ block.settings.countdown_end_time }}"
                        {% endif %}
                        options="'Apple','Google','iCal'"
                        hideIconButton="true"
                        hideBackground
                        label="{{ block.settings.calendar_button_text }}"
                        {% if block.settings.calendar_reminder_description != blank %}
                          description="{{ block.settings.calendar_reminder_description }}"
                        {% endif %}
                        buttonStyle="custom"
                        trigger="click"
                        customCss="{{ 'main.css' | asset_url | split: '?' | first }}"
                        lightMode="light"
                        timeZone="America/Los_Angeles"
                        listStyle="overlay"
                      ></add-to-calendar-button>
                    </div>
                  {% else %}
                    {% if enable_cta_1 or enable_cta_2 %}
                      <div class="ra-link-list ra-text-only-banner__link-list">
                        {% if enable_cta_1 %}
                          {% render 'ra-button',
                            type: 'a',
                            style: cta_1_style,
                            url: cta_1_url,
                            new_tab: open_new_tab_1,
                            label: cta_1_text,
                            class: 'ra-link-list min-w-[175px] w-full'
                          %}
                        {% endif %}
                        {% if enable_cta_2 %}
                          {% render 'ra-button',
                            type: 'a',
                            style: cta_2_style,
                            url: cta_2_url,
                            new_tab: open_new_tab_2,
                            label: cta_2_text,
                            class: 'ra-link-list min-w-[175px] w-full'
                          %}
                        {% endif %}
                      </div>
                    {% endif %}
                  {% endif %}
                </div>
              </div>

            {%- when 'media' -%}
              {% liquid
                assign image_width = 850
              %}

              <div class="ra-col ra-left-split component-media" data-col-size="-size" data-col-auto="-md">
                {% if block.settings.internal_video != blank %}
                  <div class="ra-split-section__media">
                    <div class="ra-image ra-split-section__image ra-image--use-aspect-ratio">
                      {% render 'ra-video',
                        video: block.settings.internal_video,
                        lazyload: true,
                        controls: true,
                        autoplay: true,
                        loop: true,
                        width: width,
                        class: "ra-image__media w-full",
                        video_class: "h-full object-cover"
                      %}
                    </div>
                  </div>
                {% elsif block.settings.external_video != blank %}
                  <div class="ra-split-section__media">
                    <div class="ra-image ra-split-section__image ra-image--use-aspect-ratio">
                      {% render 'ra-video',
                        video_url: block.settings.external_video,
                        lazyload: true,
                        controls: true,
                        autoplay: true,
                        loop: true,
                        width: width,
                        class: "ra-image__media w-full",
                        video_class: "h-full object-cover"
                      %}
                    </div>
                  </div>
                {% elsif block.settings.image != blank %}
                  <div class="ra-split-section__media {% if block.settings.mobile_image != blank %}ra-split-section__media-desktop{% endif %}">
                    <div class="ra-image ra-split-section__image ra-image--use-aspect-ratio">
                      {% render 'ra-image', image: block.settings.image, width: width, height: height, classes: "ra-image__media w-full", lazyload: true %}
                    </div>
                  </div>

                  {% if block.settings.mobile_image != blank %}
                    <div class="ra-split-section__media ra-split-section__media-mobile">
                      <div class="ra-image ra-split-section__image ra-image--use-aspect-ratio">
                        {% render 'ra-image', image: block.settings.mobile_image, width: width, height: height, classes: "ra-image__media w-full", lazyload: true %}
                      </div>
                    </div>
                  {% endif %}
                {% endif %}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      {% endif %}
    </div>
  </article>
</div>

<script>
  const countdownItems = document.querySelectorAll('#shopify-section-{{ section.id }} .ra-split-section__countdown-timer');
  countdownItems.forEach((item) => {
    const countdownDate = item.getAttribute("data-countdown-date");
    const countdownTime = item.getAttribute("data-countdown-time");
    const end = new Date(`${countdownDate} ${countdownTime}`);
    let timer;
    let _second = 1000;
    let _minute = _second * 60;
    let _hour = _minute * 60;
    let _day = _hour * 24;

    function showRemaining() {
      const now = new Date();
      const distance = end - now;
      if (distance < 0) {

        clearInterval(timer);
        item.innerHTML = 'EXPIRED!';

        return;
      }
      let days = Math.floor(distance / _day);
      let hours = Math.floor((distance % _day) / _hour);
      let minutes = Math.floor((distance % _hour) / _minute);
      let seconds = Math.floor((distance % _minute) / _second);

      item.innerHTML = String(days).length === 1 ? '0' + days + ':'  : days + ':';
      item.innerHTML += String(hours).length === 1 ? '0' + hours + ':'  : hours + ':';
      item.innerHTML += String(minutes).length === 1 ? '0' + minutes  : minutes;
    }
    if (item) {
      timer = setInterval(showRemaining, 1000);
    }
  })
</script>

