{% render '_hero.min.css' %}

{%- liquid
  assign video = section.settings.video
  assign video_mp4 = section.settings.video_mp4
  assign video_mp4_mobile = section.settings.video_mp4_mobile
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign overlay_bg = section.settings.overlay_bg
  assign content_position = section.settings.content_position
  assign mobile_content_position = section.settings.mobile_content_position
  assign image = section.settings.image
  assign second_image = section.settings.second_image
  assign image_mobile = section.settings.image_mobile
  assign second_image_mobile = section.settings.second_image_mobile
  assign video_display_format = section.settings.video_display_format
  assign video_display_format_mobile = section.settings.video_display_format_mobile
  assign controls_position = section.settings.controls_position
  assign controls_color = section.settings.controls_color
  assign show_play_button = section.settings.show_play_button
  assign show_mute_button = section.settings.show_mute_button
  assign border_bottom = section.settings.section_border_bottom
  assign desktop_section_height = section.settings.desktop_section_height
  assign desktop_content_width = section.settings.desktop_content_width
  assign mobile_section_height = section.settings.mobile_section_height

  if video_display_format == 'contain'
    assign contain_video_desk = true
  endif

  if video_display_format_mobile == 'contain'
    assign contain_video_mobile = true
  endif

  assign analytic_promotion_products = collections[section.settings.analytic_promotion_collection].products | default: section.settings.analytic_promotion_products
  assign analytic_promotion_name = section.settings.analytic_promotion_name
  assign analytic_promotion_id = section.settings.analytic_promotion_id
  assign desktop_image_class = 'image-abs-cover'
  assign mobile_image_class = 'image-abs-cover small-up-hide'

  if image and second_image
    assign desktop_image_class = desktop_image_class | append: ' hero__half-image'
    assign desktop_second_image_attr = 'data-second-image'
  endif

  if image_mobile or second_image_mobile
    assign desktop_image_class = desktop_image_class | append: ' small-hide'
  endif

  if image_mobile and second_image_mobile
    assign mobile_image_class = mobile_image_class | append: ' hero__half-image'
    assign mobile_second_image_attr = 'data-second-image'
  endif

  if desktop_section_height == 'aspect_ratio' and image
    assign desktop_section_height = 100 | divided_by: image.aspect_ratio | append: 'vw'
  endif
-%}

<div
  style="
    --desktop-section-height: {{ desktop_section_height }};
    --desktop-content-width: {{ desktop_content_width }};
    {% if image %}--aspect-ratio: {{ image.aspect_ratio }};{% endif %}
    --mobile-section-height: {{ mobile_section_height }};"
  class="hero
   hero--desktop-{{ content_position }}
   hero--mobile-{{ mobile_content_position }}
   {% if border_bottom %}border-bottom{% endif %}
   rel {% if template == 'page.professional' %}hero--pro{% endif %}">

  {%- if overlay_bg != blank and overlay_opacity != 0.0 -%}
    <div class="hero__overlay"
         style="--overlay-opacity: {{ overlay_opacity }};
           --overlay-bg: {{ overlay_bg }};"></div>
  {%- endif -%}

  {%- if image -%}
    {% render 'image',
      image: image,
      class_name: desktop_image_class,
      alt: image.alt,
      preload: true,
      show_preloader_img: true %}
  {%- endif -%}

  {%- if second_image -%}
    {% render 'image',
      image: second_image,
      class_name: desktop_image_class,
      alt: second_image.alt,
      image_attr: desktop_second_image_attr, preload: true, show_preloader_img: true %}
  {%- endif -%}

  {%- if image_mobile -%}
    {% render 'image',
      image: image_mobile,
      class_name: mobile_image_class,
      alt: image.alt, preload: true, show_preloader_img: true %}
  {%- endif -%}

  {%- if second_image_mobile -%}
    {% render 'image',
      image: second_image_mobile,
      class_name: mobile_image_class,
      alt: second_image_mobile.alt,
      image_attr: mobile_second_image_attr, preload: true, show_preloader_img: true %}
  {%- endif -%}

  {%- if video != blank or video_mp4 or video_mp4_mobile -%}

    {%- assign class_name_desk = 'block hero__video' -%}
    {%- if video_mp4_mobile or image_mobile != blank or second_image_mobile != blank -%}
      {%- assign class_name_desk = 'block hero__video small-hide' -%}
    {%- endif -%}

    {%- render 'video',
      video: video_mp4,
      video_youtube_vimeo: video,
      video_url: false,
      default_controls: false,
      controls_position: controls_position,
      autoplay: true,
      show_play_button: show_play_button,
      show_mute_button: show_mute_button,
      poster: false,
      poster_from_metafield: false,
      video_from_metafield: false,
      controls_color: controls_color,
      disable_video_scale_on_desktop: contain_video_desk,
      cdisable_video_scale_on_mobile: contain_video_mobile,
      class: class_name_desk
    -%}
  {%- endif -%}

  {%- if video_mp4_mobile -%}
    {%- render 'video',
      video: video_mp4_mobile,
      video_youtube_vimeo: false,
      video_url: false,
      default_controls: false,
      controls_position: controls_position,
      autoplay: true,
      show_play_button: show_play_button,
      show_mute_button: show_mute_button,
      poster: false,
      poster_from_metafield: false,
      video_from_metafield: false,
      controls_color: controls_color,
      disable_video_scale_on_desktop: contain_video_desk,
      disable_video_scale_on_mobile: contain_video_mobile,
      class: 'block hero__video small-up-hide'
    -%}
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="hero__content rel" data-aos="fade-up">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
        {%- when 'heading' -%}
          {% liquid
            assign sections_heading = block.settings.heading | handleize | replace: '-', ' ' | capitalize
            assign sections_heading_size = block.settings.text_size
            assign heading_margin_bottom_desktop = block.settings.margin_bottom_desktop
            assign heading_margin_bottom_mobile = block.settings.margin_bottom_mobile
          %}

          <h2 class="hero__content-block hero__content-heading {{ sections_heading_size}} {% if block.settings.mobile_hide %}small-hide{% endif %}"
              style="
                --heading-color: {{ block.settings.heading_color }};
                --margin-bottom-desktop: {{ heading_margin_bottom_desktop }}px;
                --margin-bottom-mobile: {{ heading_margin_bottom_mobile }}px;
                "
            {{ block.shopify_attributes }}>
            {{ block.settings.heading | escape | newline_to_br }}
          </h2>

        {%- when 'subheading' -%}
          {% liquid
            assign type_text = block.settings.type_text
            assign sections_subheading = block.settings.subheading | handleize | replace: '-', ' ' | capitalize
            assign subheading_margin_bottom_desktop = block.settings.margin_bottom_desktop
            assign subheading_margin_bottom_mobile = block.settings.margin_bottom_mobile
          %}

          <p class="hero__content-block hero__content-subheading {{ type_text }}"
             style="
               --subheading-color: {{ block.settings.subheading_color }};
               --margin-bottom-desktop: {{ subheading_margin_bottom_desktop }}px;
               --margin-bottom-mobile: {{ subheading_margin_bottom_mobile }}px;
               "
            {{ block.shopify_attributes }}>
            {{ block.settings.subheading | escape | newline_to_br }}
          </p>
        {%- when 'search' -%}
          {%- render 'blog-predictive-search' -%}

        {%- when 'button' -%}
          {% liquid
            assign btn_label = block.settings.button_label
            assign btn_link = block.settings.button_link
            assign btn_style = block.settings.button_style
            assign btn_margin_bottom_desktop = block.settings.margin_bottom_desktop
            assign btn_margin_bottom_mobile = block.settings.margin_bottom_mobile
          %}

          {%- if btn_label != blank -%}
            <a class="hero__content-block hero__content-btn btn btn--{{ btn_style }} btn--physician-finder"
              style="
                --margin-bottom-desktop: {{ btn_margin_bottom_desktop }}px;
                --margin-bottom-mobile: {{ btn_margin_bottom_mobile }}px;
              "
              {% if btn_link == blank %}
                role="link"
                aria-disabled="true"
                disabled
              {% else %}
                href="{{ btn_link }}"
              {% endif %}

              {% if analytic_promotion_name != blank and analytic_promotion_name != blank %}
                data-promotion-click-event="{{ sections_heading | handleize }}"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {{ btn_label | escape }}
            </a>
          {%- endif -%}

        {%- when 'badge' -%}
          {% liquid
            assign badge = block.settings.badge
            assign badge_svg = block.settings.svg
            assign badge_width = block.settings.badge_width
            assign margin_bottom   = block.settings.margin_bottom
          %}

          {% if badge != blank or badge_svg != blank %}
            <div class="hero__content-block hero__content-badge small-hide"
              style="
                --margin-bottom-desktop: {{ margin_bottom }}px;
                --badge-width: {{ badge_width }}px;
              "
              {{ block.shopify_attributes }}
            >
              {% if badge_svg != blank %}
                {{ badge_svg }}
              {% else %}
                {% render 'image', image: badge %}
              {% endif %}
            </div>
          {% endif %}
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- assign button_block = section.blocks | where: 'type', 'button' -%}

    {%- if button_block[0].settings.btn_entire_section -%}
      <a href="{{ button_block[0].settings.button_link }}" class="hero__content-btn-full"><span class="visually-hidden">{{ button_block[0].settings.button_label }}</span></a>
    {%- endif -%}
  {%- endif -%}

</div>

{%- if analytic_promotion_name != blank and analytic_promotion_name != blank -%}
  {%- liquid
    assign list_id = sections_heading | handleize
    if template == 'index'
      assign creative_slot = 'Home Page Hero'
    else
      assign creative_slot = template.name | append: ' hero' | camelcase
    endif
  -%}

  {% render 'ga-product-list-event', event_type: 'view_promotion',
    product_list: analytic_promotion_products,
    list_name: sections_heading,
    list_id: list_id,
    creative_slot: creative_slot,
    creative_name: sections_subheading,
    promotion_name: analytic_promotion_name,
    promotion_id: analytic_promotion_id
  %}
{%- endif -%}

