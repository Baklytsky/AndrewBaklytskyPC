        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding top desktop",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding bottom desktop",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding top mobile",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding bottom mobile",
      "default": 20
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "banner-large",
      "name": "Banner large",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "desktop_banner_height",
          "label": "Banner desktop height",
          "options": [
            {
              "value": "400px",
              "label": "400px"
            },
            {
              "value": "500px",
              "label": "500px"
            },
            {
              "value": "600px",
              "label": "600px"
            },
            {
              "value": "700px",
              "label": "700px"
            },
            {
              "value": "800px",
              "label": "800px"
            },
            {
              "value": "1000px",
              "label": "1000px"
            },
            {
              "value": "100vh",
              "label": "Full height"
            }
          ],
          "default": "700px"
        },
        {
          "type": "select",
          "id": "mobile_banner_height",
          "label": "Mobile banner height",
          "options": [
            {
              "value": "400px",
              "label": "400px"
            },
            {
