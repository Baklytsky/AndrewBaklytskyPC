              "label": "500px"
            },
            {
              "value": "600px",
              "label": "600px"
            },
            {
              "value": "700px",
              "label": "700px"
            },
            {
              "value": "80vw",
              "label": "80vw"
            }
          ],
          "default": "80vw"
        },
        {
          "type": "select",
          "id": "banner_width",
          "label": "Banner desktop width",
          "info": "On mobile banner will be full width.",
          "options": [
            {
              "value": "33.333%",
              "label": "1/3"
            },
            {
              "value": "50%",
              "label": "Half"
            },
            {
              "value": "66.666%",
              "label": "2/3"
            }
          ],
          "default": "50%"
        },
        {
          "type": "select",
          "id": "content_position_desktop",
          "label": "Content position desktop",
          "options": [
            {
              "value": "flex-start",
              "label": "Top"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "flex-end",
              "label": "Bottom"
            }
          ],
          "default": "center"
