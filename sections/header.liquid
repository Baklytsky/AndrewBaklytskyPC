{% liquid
  assign page_header_transparent = page.metafields.custom.transparenct_header

  assign opacity = section.settings.bg_opacity | divided_by: 100.00
  assign header_bg = section.settings.header_bg
  assign icon_bg_color = section.settings.icon_bg_color
  assign icon_color = section.settings.icon_color

  assign alt_pages = section.settings.alt_header_pages | split: ','
  assign current_page = request.path
  assign use_alt_header = false

  for alt_page in alt_pages
    assign stripped_page = alt_page | strip
    if stripped_page == current_page
      assign use_alt_header = true
      assign header_bg = section.settings.alt_header_bg
      assign icon_bg_color = section.settings.alt_icon_bg_color
      assign icon_color = section.settings.alt_icon_color
    endif
  endfor
%}

{% capture header_class %}
  {% if template.name == "product" or page.handle contains 'look' %}
    opacity-0	lg:opacity-100
  {% endif %}
{% endcapture %}

<style>
  #shopify-section-{{ section.id }} {
    --background-color: "trasparent";
    --logo-width-desktop: {{ section.settings.logo_size_desktop | append: "px" }};
    --logo-width-mobile: {{ section.settings.logo_size_mobile | append: "px" }};
    --bg-image: {{ section.settings.bg_image | image_url: width: 375 }};
    --bg-color-nav: {{ section.settings.bg_color_nav | color_modify: 'alpha', opacity }};
  }
  #shopify-section-{{ section.id }} .header__bg {
    background: {{ header_bg }};
  }
  #shopify-section-{{ section.id }} .nav-icon-bg,
  #shopify-section-{{ section.id }} .slide-out-cart {
    background: {{ icon_bg_color }};
  }
</style>

<ra-header class="header flex items-center justify-center fixed w-full left-0 transition-all duration-200 z-[500] h-[92px] md:h-[96px]">
  <div class="header__wrapper flex h-full w-full flex-wrap justify-between px-[24px] md:px-[26px] relative content-center">
  <div class="{% unless page_header_transparent == true %}header__bg{% endunless %} absolute w-full h-full top-0 left-0 transition-all duration-200 delay-500 -z-10"></div>
    <div class="header__inner relative z-10 h-[45px] flex justify-between md:justify-normal w-full items-center">
      {%- comment -%}
        hamburger
      {%- endcomment -%}
      <a
        class="header__hamburger flex items-center justify-center group nav-icon-bg w-[44px] h-[44px] rounded-full"
        href="#"
        title="toggle menu"
        aria-label="toggle menu"
      >
        {% render 'ra-icon',
          icon: 'hamburger',
          width: '18px',
          height: '14px',
          color: icon_color,
          class: 'hamburger-icon flex group-[.active]:hidden transition-all delay-300'
        %}
        {%- comment -%}
          {% render 'ra-icon',
            icon: 'hamburger',
            width: '18px',
            height: '14px',
            color: 'var(--black)',
            class: 'hamburger-icon hamburger-icon-dark hidden flex group-[.active]:hidden transition-all delay-300'
          %}
        {%- endcomment -%}
      </a>

      {%- comment -%}
        Logo
      {%- endcomment -%}
      {% if section.settings.logo != blank %}
        <a
          class="header__logo logo-icon flex items-center m-0 md:!mr-4 md:ml-7 {{ header_class | strip }}"
          href="{{ shop.url }}"
          title="{{ shop.name }} logo"
          aria-label="{{ shop.name }} logo"
        >
          {% assign logo_alt = shop.name | append: ' Logo' %}
          {% if use_alt_header %}
            {{
              section.settings.alt_logo
              | image_url: width: 500
              | image_tag: alt: logo_alt, class: 'header__logo-image w-full block'
            }}
          {% else %}
            {{
              section.settings.logo
              | image_url: width: 500
              | image_tag: alt: logo_alt, class: 'header__logo-image w-full block'
            }}
          {% endif %}
        </a>
        {% if section.settings.alt_logo != blank %}
          <a
            class="header__logo logo-icon-dark hidden flex items-center m-0 md:!mr-4 md:ml-7 {{ header_class | strip }}"
            href="{{ shop.url }}"
            title="{{ shop.name }} logo"
            aria-label="{{ shop.name }} logo"
          >
            {% assign logo_alt = shop.name | append: ' Logo' %}

              {{
                section.settings.alt_logo
                | image_url: width: 500
                | image_tag: alt: logo_alt, class: 'header__logo-image w-full block'
              }}

          </a>
        {% endif %}
      {% else %}
        <a href="{{ shop.url }}" title="{{ shop.name }} logo" aria-label="{{ shop.name }} logo">
          <h1 class="h4">{{ shop.name }}</h1>
        </a>
      {% endif %}

      {% if section.settings.menu != blank %}
        {%- comment -%}
          Navigation menu - mobile
        {%- endcomment -%}
        <nav class="header__mobile-navigation flex flex-col left-0 fixed w-full z-[510] overflow-hidden transition-all duration-300 lg:w-1/3 md:max-w-[475px] pt-[26px]">
          <div class="flex flex-col justify-start gap-[47px] h-full px-[26px] overflow-y-auto custom-scrollbar pb-12">

            {%- comment -%} Header {%- endcomment -%}
            <div class="flex justify-between w-full">
              <a
                class="header__hamburger flex items-center justify-center group nav-icon-bg w-[44px] h-[44px] rounded-full"
                href="#"
                title="toggle menu"
                aria-label="toggle menu"
              >
                {% render 'ra-icon',
                  icon: 'close',
                  width: '14px',
                  height: '14px',
                  color: icon_color,
                  class: 'close-icon group-[.active]:flex transition-all delay-300'
                %}
              </a>

              {% if section.settings.logo != blank %}
                <a
                  class="header__logo flex items-center !m-0 md:!mr-4 md:hidden"
                  href="{{ shop.url }}"
                  title="{{ shop.name }} logo"
                  aria-label="{{ shop.name }} logo"
                >
                  {% assign logo_alt = shop.name | append: ' Logo' %}
                  {{
                    section.settings.logo
                    | image_url: width: 500
                    | image_tag: alt: logo_alt, class: 'header__logo-image w-full block'
                  }}
                </a>
              {% else %}
                <a
                  href="{{ shop.url }}"
                  title="{{ shop.name }} logo"
                  aria-label="{{ shop.name }} logo"
                  class="md:hidden"
                >
                  <h1 class="h4">{{ shop.name }}</h1>
                </a>
              {% endif %}
              <div data-vue-root="CartIcon" class="md:hidden">
                <cart-icon icon-color="{{ icon_color }}" use-cart-title="{{ section.settings.use_cart_title }}"/>
              </div>
            </div>

            {%- comment -%} Fake Search {%- endcomment -%}
            {% if section.settings.show_search %}
              <button class="mobile-search-toggle md:hidden">
                {% render 'ra-icon', icon: 'search', width: '14px', height: '14px', color: 'inherit' %}
                <span class="mobile-search-toggle__label">Search</span>
              </button>
            {% endif %}

            <ra-accordion class="flex flex-col justify-start gap-[47px]">
              {%- comment -%} Primary Nav {%- endcomment -%}
              <ul class="p-0 mt-1" role="list" tabindex="-1">
                {%- for link in section.settings.menu.links -%}
                  {% render 'mobile-navigation-menu',
                    link: link,
                    featured_contents: section.blocks,
                    index: forloop.index0,
                    menu: 'primary'
                  %}
                {%- endfor -%}
              </ul>

              {%- comment -%} Secondary Nav {%- endcomment -%}
              <ul class="p-0 mt-1" role="list" tabindex="-1">
                {%- for link in section.settings.secondary_menu.links -%}
                  {% render 'mobile-navigation-menu',
                    link: link,
                    featured_contents: section.blocks,
                    index: forloop.index0
                  %}
                {%- endfor -%}
              </ul>
            </ra-accordion>

            {%- comment -%} Sub Nav {%- endcomment -%}
            <ul class="p-0" role="list" tabindex="-1">
              {%- for link in section.settings.sub_menu.links -%}
                <li class="header__mobile-navigation-secondary-links list-none mb-[20px] last:mb-0 flex items-center gap-x-sm">
                  <a
                    class="mono-12"
                    href="{{ link.url }}"
                    title="{{ link.title }}"
                    aria-label="{{ link.title }}"
                  >
                    {{ link.title }}
                  </a>
                  <div class="header__mobile-navigation-secondary-link-arrow overflow-hidden">
                    {%- render 'ra-icon',
                      icon: 'left-arrow',
                      width: '9px',
                      height: '8px',
                      class: 'duration-100',
                      color: 'inherit'
                    -%}
                  </div>
                </li>
              {%- endfor -%}
            </ul>

          </div>

          <div class="header__mobile-navigation__bg-blur absolute w-full h-full top-0 left-0"></div>
          <div
            class="header__mobile-navigation__bg-image absolute w-full h-full top-0 left-0 bg-cover bg-center bg-no-repeat"
            style="background-image: url('{{ section.settings.bg_image | image_url: width: 475 }}')"
          ></div>
        </nav>
        <div
          class="header__mobile-navigation__backdrop z-[11] fixed top-0 left-0 w-full h-full bg-grey-900 opacity-[0.65]"
        ></div>
      {% endif %}

      {%- comment -%}
        Action (cart, account, search, wishlist)
      {%- endcomment -%}
      <div class="md:ml-auto m-0">
        {% render 'ra-header-actions', icon_color: icon_color %}
      </div>
    </div>
    {% render 'ra-search-bar', icon_color: icon_color, icon_bg: icon_bg_color %}
  </div>
  <div id="SearchResponse" class="col-start-1 col-span-5 text-grey-900"></div>
</ra-header>

