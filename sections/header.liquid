<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-header.css' | asset_url }}">

{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'component-loading-overlay.css' | asset_url }}">
{%- endif -%}

<noscript>{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-search.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-menu-drawer.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-header.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
  assign highlight_links_list = section.settings.highlighted_links | split: ',' | downcase
  assign highlighted_links_color = section.settings.highlighted_links_color

  assign transparent_header = false
-%}

{%- if section.settings.transparent_header -%}

  {%- if template contains 'index' -%}
    {%- assign transparent_header = true -%}
  {% elsif template contains 'page' %}
    {%- assign transparent_header = true -%}
  {% elsif template contains 'account' %}
    {%- assign transparent_header = true -%}
  {% elsif template contains 'wsg-proxy-template' %}
    {%- assign transparent_header = true -%}
  {% endif %}
  
  {%- if template contains 'page.landing-scrolled' -%}
    {%- assign transparent_header = false -%}
  {%- endif -%}

  {%- assign transparent_logo = true -%}

  {%- if template contains 'account' -%}
    {%- assign transparent_logo = false -%}
    {% elsif template contains 'wsg-proxy-template' %}
    {%- assign transparent_logo = false -%}
  {%- endif -%}

{%- endif -%}

<style>
  {%- if transparent_header -%}

  #shopify-section-header {
    position: absolute;
    top: var(--announcement-bar-height);
    left: 0;
    width: 100%;
  }

  .header-wrapper {
    background-color: transparent;

  {%- unless template contains 'account' or template contains 'wsg-proxy-template'-%}
    color: rgb(var(--color-secondary-text));
  {%- endunless -%}
  }

  {%- unless template contains 'account' or template contains 'wsg-proxy-template' -%}
  .header__icon {
    color: rgb(var(--color-secondary-text));
  }
  {%- endunless -%}

  .header__heading-logo-static {
    display: none;
  }

  .cart-count-bubble {
    color: rgb(var(--color-base-text));
    background-color: rgb(var(--color-secondary-text));
  }

  #shopify-section-header.shopify-section-header-sticky {
    position: fixed;
    top: 0;
  }

  #shopify-section-header.shopify-section-header-sticky .header-wrapper {
    background-color: rgb(var(--color-secondary-text));
    color: rgb(var(--color-base-text));
  }

  #shopify-section-header.mobile-menu-open .header-wrapper {
    color: rgb(var(--color-base-text));
  }

  #shopify-section-header.shopify-section-header-sticky .header__icon,
  #shopify-section-header.mobile-menu-open .header__icon {
    color: rgb(var(--color-base-text));
  }

  #shopify-section-header.shopify-section-header-sticky .header__heading-logo-static,
  #shopify-section-header.mobile-menu-open .header__heading-logo-static {
    display: block;
  }

  #shopify-section-header.shopify-section-header-sticky .header__heading-logo-transparent,
  #shopify-section-header.mobile-menu-open .header__heading-logo-transparent {
    display: none;
  }
  {%- endif -%}

  {% if section.settings.logo != blank %}
    .header__heading {
      width: {{ section.settings.mobile_logo_width | append: 'px' }};
    }
  {% endif %}

  .header__heading-logo {
    max-width: {{ section.settings.mobile_logo_width | append: 'px' }};
  }

  @media screen and (min-width: 990px) {
    header-drawer {
      display: none;
    }

    {%- unless transparent_header -%}
    #shopify-section-header .header__heading-logo-transparent {
      display: none;
    }
    {%- endunless -%}

    {% if section.settings.logo != blank %}
      .header__heading {
        width: {{ section.settings.logo_width | append: 'px' }};
      }
    {% endif %}

    .header__heading-logo {
      max-width: {{ section.settings.logo_width | append: 'px' }};
    }
  }

  @media screen and (max-width: 989px) {
    #shopify-section-header.shopify-section-header-sticky .header-wrapper,
    #shopify-section-header .header-wrapper {
      background-color: rgb(var(--color-base-text));
      color: rgb(var(--color-secondary-text));
    }

    #shopify-section-header .header-wrapper,
    #shopify-section-header .header-wrapper .header__icon {
      color: rgb(var(--color-secondary-text));
    }

    #shopify-section-header.mobile-menu-open .header-wrapper,
    #shopify-section-header.mobile-menu-open .header-wrapper .header__icon {
      color: rgb(var(--color-base-text));
    }

    #shopify-section-header .header-wrapper .header__heading-logo-static,
    #shopify-section-header.mobile-menu-open .header-wrapper .header__heading-logo-transparent {
      display: none;
    }

    #shopify-section-header .header-wrapper .header__heading-logo-transparent,
    #shopify-section-header.mobile-menu-open .header-wrapper .header__heading-logo-static {
      display: block;
    }
  }
</style>

<script src="{{ 'details-disclosure.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>

<svg xmlns="http://www.w3.org/2000/svg" class="hidden">
  <symbol id="icon-search" viewbox="0 0 18 19" fill="none">
    <path fill-rule="evenodd" clip-rule="evenodd" d="M11.03 11.68A5.784 5.784 0 112.85 3.5a5.784 5.784 0 018.18 8.18zm.26 1.12a6.78 6.78 0 11.72-.7l5.4 5.4a.5.5 0 11-.71.7l-5.41-5.4z" fill="currentColor"/>
  </symbol>

  <symbol id="icon-close" class="icon icon-close" fill="none" viewBox="0 0 18 17">
    <path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.846-.37.5.5 0 00-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 10-.707-.708L8.991 7.853 1.413.573a.5.5 0 10-.693.72l7.563 7.268-7.418 7.417z" fill="currentColor">
  </symbol>
</svg>

<{% if section.settings.enable_sticky_header %}sticky-header{% else %}div{% endif %} id="Header" class="header-wrapper {% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}">
  <header class="header header--middle-left page-width{% if section.settings.menu != blank %} header--has-menu{% endif %} {% if section.settings.custom_class_name != blank %}{{ section.settings.custom_class_name }}{% endif %} {% if section.settings.custom_class_name_b != blank %}{{ section.settings.custom_class_name_b }}{% endif %}">
    {%- if section.settings.menu-mobile != blank -%}
      <header-drawer data-breakpoint="tablet">
        <details id="Details-menu-drawer-container" class="menu-drawer-container">
          <summary class="header__icon header__icon--menu header__icon--summary link focus-inset" aria-label="{{ 'sections.header.menu' | t }}">
            <span>
              {% render 'icon-hamburger' %}
              {% render 'icon-close' %}
            </span>
          </summary>
          <div id="menu-drawer" class="menu-drawer motion-reduce content hide-scrollbar" tabindex="-1">
            <div class="menu-drawer__inner-container">
              <div class="menu-drawer__navigation-container">
                <nav class="menu-drawer__navigation">
                  <ul class="menu-drawer__menu list-menu" role="list">
                    {%- for link in section.settings.menu-mobile.links -%}
                      {%- assign has_banner = false -%}

                      {%- assign link_title_handle = link.title | handleize -%}
                      {%- for block in section.blocks -%}
                        {%- if block.type == 'banner' -%}
                          {%- assign menu_item_handle = block.settings.title | handleize -%}
                          {%- if link_title_handle == menu_item_handle -%}
                            {%- assign has_banner = true -%}

                            {%- capture banner -%}
                            {%- assign bg_color = block.settings.bg_color -%}
                            {%- assign text_color = block.settings.text_color -%}
                            {%- assign banner_image = block.settings.banner_image -%}
                            {%- assign banner_heading = block.settings.banner_heading -%}
                            {%- assign banner_description = block.settings.banner_description -%}
                            {%- assign button_label = block.settings.button_label -%}
                            {%- assign button_link = block.settings.button_link -%}
                              <div class="header__banner"
                                   style="color: {{ text_color }};" {{ block.shopify_attributes }}>
                                {%- if banner_image != blank -%}
                                  {%- if button_link != blank -%}
                                    <a href="{{ button_link }}" class="header__banner-image rel" style="background-color: {{ bg_color }};">
                                      {% render 'image', image: banner_image, class_name: 'image-abs-cover', %}
                                    </a>
                                  {%- else -%}
                                    <div class="header__banner-image rel" style="background-color: {{ bg_color }};">
                                      {% render 'image', image: banner_image, class_name: 'image-abs-cover', %}
                                    </div>
                                  {%- endif -%}
                                {%- endif -%}
                                {%- if banner_heading != blank -%}
                                  <h3 class="header__banner-heading h6">
                                    {%- if button_link != blank -%}
                                      <a href="{{ button_link }}">{{ banner_heading }}</a>
                                    {%- else -%}
                                      {{ banner_heading }}
                                    {%- endif -%}
                                  </h3>
                                {%- endif -%}
                              </div>
                            {%- break -%}
                            {%- endcapture -%}
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}

                      <li>
                        {%- if link.links != blank or has_banner -%}
                          <details id="Details-menu-drawer-menu-item-{{ forloop.index }}">
                            <summary class="menu-drawer__menu-item list-menu__item link link--text focus-inset jcb">
                              {{ link.title | escape }}
                              <div class="menu-drawer__chevron">
                                {% render 'icon' with 'chevron-right' %}
                              </div>
                            </summary>
                            <div id="link-{{ link.title | escape }}" class="menu-drawer__submenu motion-reduce" tabindex="-1">
                              <div class="menu-drawer__inner-submenu">
                                <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                                  <div class="menu-drawer__chevron">
                                    {% render 'icon' with 'chevron-left' %}
                                  </div>
                                  {{ link.title | escape }}
                                </button>
                                <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                                  {%- for childlink in link.links -%}
                                    <li>
                                      {%- if childlink.links == blank -%}
                                        <a href="{{ childlink.url }}" class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"{% if childlink.current %} aria-current="page"{% endif %}>
                                          {%- if childlink.title contains '<sup>' -%}
                                            <span class="sup-wrapper">
                                              <span>{{ childlink.title | split: '<sup>' | first | strip }}</span>
                                              <span class="sup">{{ childlink.title | split: '<sup>' | last | strip }}</span>
                                            </span>
                                          {%- else -%}
                                            <span>{{ childlink.title }}</span>
                                          {%- endif -%}
                                        </a>
                                      {%- else -%}
                                        <details id="Details-menu-drawer-submenu-{{ forloop.index }}">
                                          <summary class="menu-drawer__menu-item link link--text list-menu__item focus-inset jcb">
                                            {{ childlink.title | escape }}
                                            <div class="menu-drawer__chevron">
                                              {% render 'icon' with 'chevron-right' %}
                                            </div>
                                          </summary>
                                          <div id="childlink-{{ childlink.title | escape }}" class="menu-drawer__submenu motion-reduce">
                                            <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                                              <div class="menu-drawer__chevron">
                                                {% render 'icon' with 'chevron-left' %}
                                              </div>
                                              {{ childlink.title | escape }}
                                            </button>
                                            <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                                              {%- for grandchildlink in childlink.links -%}
                                                <li>
                                                  <a href="{{ grandchildlink.url }}" class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                                    {%- if grandchildlink.title contains '<sup>' -%}
                                                      <span class="sup-wrapper">
                                                        <span>{{ grandchildlink.title | split: '<sup>' | first | strip }}</span>
                                                        <span class="sup">{{ grandchildlink.title | split: '<sup>' | last | strip }}</span>
                                                      </span>
                                                    {%- else -%}
                                                      <span>{{ grandchildlink.title }}</span>
                                                    {%- endif -%}
                                                  </a>
                                                </li>
                                              {%- endfor -%}
                                            </ul>
                                          </div>
                                        </details>
                                      {%- endif -%}
                                    </li>
                                  {%- endfor -%}
                                  {%- if has_banner -%}
                                    {{ banner }}
                                  {%- endif -%}
                                </ul>
                              </div>
                            </div>
                          </details>
                        {%- else -%}
                          <a href="{{ link.url }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"{% if link.current %} aria-current="page"{% endif %}>
                            {%- if link.title contains '<sup>' -%}
                              <span class="sup-wrapper">
                                <span>{{ link.title | split: '<sup>' | first | strip }}</span>
                                <span class="sup">{{ link.title | split: '<sup>' | last | strip }}</span>
                              </span>
                            {%- else -%}
                              <span>{{ link.title }}</span>
                            {%- endif -%}
                          </a>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </nav>
                {%- if section.settings.show_custom_link -%}
                  {%- assign custom_link_url = section.settings.custom_link_url -%}
                  {%- assign custom_link_text = section.settings.custom_link_text -%}
                  {%- assign custom_link_svg = section.settings.custom_link_svg -%}
                  {%- assign custom_link_height = section.settings.custom_link_height -%}

                  <div class="header__custom">
                    <a href="{{ custom_link_url }}"
                       class="header__menu-item header__custom-link {% if custom_link_url == blank %} disabled{% endif %}"
                       aria-label="{{ custom_link_text }}"
                       {% if custom_link_svg != blank %}style="height: {{ custom_link_height }}px"{% endif %}>
                      {%- if custom_link_svg != blank -%}
                        {{ custom_link_svg }}
                      {%- else -%}
                        {{ custom_link_text }}
                      {%- endif -%}
                    </a>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        </details>
      </header-drawer>
    {%- endif -%}
    {%- if section.settings.menu == blank -%}
      <details-modal class="header__search">
        <details>
          <summary class="header__icon header__icon--search header__icon--summary link focus-inset modal__toggle" aria-haspopup="dialog" aria-label="{{ 'general.search.search' | t }}">
            <span>
              <svg class="modal__toggle-open icon icon-search" aria-hidden="true" focusable="false" role="presentation">
                <use href="#icon-search">
              </svg>
              <svg class="modal__toggle-close icon icon-close" aria-hidden="true" focusable="false" role="presentation">
                <use href="#icon-close">
              </svg>
            </span>
          </summary>
          <div class="search-modal modal__content" role="dialog" aria-modal="true" aria-label="{{ 'general.search.search' | t }}">
            <div class="modal-overlay"></div>
            <div class="search-modal__content" tabindex="-1">
              {%- if settings.predictive_search_enabled -%}
              <predictive-search class="search-modal__form" data-loading-text="{{ 'accessibility.loading' | t }}">
                {%- endif -%}
                <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
                  <div class="field">
                    <input class="search__input field__input"
                           id="Search-In-Modal-1"
                           type="search"
                           name="q"
                           value=""
                           placeholder="{{ 'general.search.search' | t }}"
                            {%- if settings.predictive_search_enabled -%}
                              role="combobox"
                              aria-expanded="false"
                              aria-owns="predictive-search-results-list"
                              aria-controls="predictive-search-results-list"
                              aria-haspopup="listbox"
                              aria-autocomplete="list"
                              autocorrect="off"
                              autocomplete="off"
                              autocapitalize="off"
                              spellcheck="false"
                            {%- endif -%}
                    >
                    <label class="field__label" for="Search-In-Modal-1">{{ 'general.search.search' | t }}</label>
                    <input type="hidden" name="options[prefix]" value="last">
                    <input type="hidden" name="type" value="product">
                    <button class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
                      <svg class="icon-search" aria-hidden="true" focusable="false" role="presentation">
                        <use href="#icon-search">
                      </svg>
                    </button>
                  </div>
                  {%- if settings.predictive_search_enabled -%}
                    <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
                      <div class="predictive-search__loading-state">
                        <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                          <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                        </svg>
                      </div>
                    </div>
                    <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
                  {%- endif -%}
                </form>
                {%- if settings.predictive_search_enabled -%}
              </predictive-search>
              {%- endif -%}
              <button type="button" class="modal__close-button link link--text focus-inset" aria-label="{{ 'accessibility.close' | t }}">
                <svg class="icon icon-close" aria-hidden="true" focusable="false" role="presentation">
                  <use href="#icon-close">
                </svg>
              </button>
            </div>
          </div>
        </details>
      </details-modal>
    {%- endif -%}
    {%- if request.page_type == 'index' -%}
    <h1 class="header__heading">
      {%- endif -%}
      <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset
          {% unless request.page_type == 'index' %}header__heading{% endunless %}">
          {%- if section.settings.transparent_logo != blank -%}
            {%- assign image_size = section.settings.logo_width | append: 'x' -%}
            <img srcset="{{ section.settings.transparent_logo | img_url: image_size }} 1x, {{ section.settings.transparent_logo | img_url: image_size, scale: 2 }} 2x"
                 src="{{ section.settings.transparent_logo | img_url: image_size }}"
                 loading="lazy"
                 class="header__heading-logo header__heading-logo-transparent"
                 width="{{ section.settings.transparent_logo.width }}"
                 height="{{ section.settings.transparent_logo.height }}"
                 alt="{{ section.settings.transparent_logo.alt | default: shop.name | escape }}"
            >
          {%- endif -%}
          {%- if section.settings.logo != blank -%}
            {%- assign image_size = section.settings.logo_width | append: 'x' -%}
            <img srcset="{{ section.settings.logo | img_url: image_size }} 1x, {{ section.settings.logo | img_url: image_size, scale: 2 }} 2x"
                 src="{{ section.settings.logo | img_url: image_size }}"
                 loading="lazy"
                 class="header__heading-logo header__heading-logo-static"
                 width="{{ section.settings.logo.width }}"
                 height="{{ section.settings.logo.height }}"
                 alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
            >
          {%- else -%}
            <span class="h2">{{ shop.name }}</span>
          {%- endif -%}
      </a>
      {%- if request.page_type == 'index' -%}
    </h1>
    {%- endif -%}
    {%- if section.settings.menu != blank -%}
      <nav class="header__inline-menu">
        <ul id="header__main-navigation" class="list-menu list-menu--inline" role="list">
          {%- for link in section.settings.menu.links -%}
            {%- liquid
              assign link_title_handle = link.title | handleize
              assign link_title_downcase = link.title | downcase
              assign has_banner = false

              for block in section.blocks
                if block.type == 'banner'
                  assign menu_item_handle = block.settings.title | handleize
                  if link_title_handle == menu_item_handle
                    assign has_banner = true
                    break
                  endif
                endif
              endfor
            -%}
            
            <li>
              {%- if link.links != blank or has_banner -%}
                <header-mega-menu-opener
                        type="button"
                        class="header__menu-item list-menu__item link focus-inset" {% if highlight_links_list contains link_title_downcase %}style="--highlight-color: {{ highlighted_links_color }}"{% endif %}
                        aria-controls="{{ link.title }}-{{ forloop.index }}">
                  {{ link.title | escape }}
                </header-mega-menu-opener>
              {%- else -%}
                <header-mega-menu-opener class="header__menu-item list-menu__item link focus-inset" {% if highlight_links_list contains link_title_downcase %}style="--highlight-color: {{ highlighted_links_color }}"{% endif %}>
                  <a href="{{ link.url }}">
                    <span>{{ link.title | escape }}</span>
                  </a>
                </header-mega-menu-opener>

              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
      <header-mega-menu role="dialog" aria-modal="true">
        {%- for link in section.settings.menu.links -%}
          {%- assign link_title_handle = link.title | handleize -%}
          {%- assign has_banner = false -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'banner' -%}
              {%- assign menu_item_handle = block.settings.title | handleize -%}
              {%- if link_title_handle == menu_item_handle -%}
                {%- capture banner -%}
                {%- assign bg_color = block.settings.bg_color -%}
                {%- assign text_color = block.settings.text_color -%}
                {%- assign banner_image = block.settings.banner_image -%}
                {%- assign banner_heading = block.settings.banner_heading -%}
                {%- assign banner_description = block.settings.banner_description -%}
                {%- assign button_label = block.settings.button_label -%}
                {%- assign button_link = block.settings.button_link -%}
                  <div class="header__banner"
                       style="background-color: {{ bg_color }}; color: {{ text_color }};"
                          {{ block.shopify_attributes }}>
                    {%- if banner_image != blank -%}
                      {%- if button_link != blank -%}
                        <a href="{{ button_link }}" class="header__banner-image rel">
                          {% render 'image', image: banner_image, class_name: 'image-abs-cover', %}
                        </a>
                      {%- else -%}
                        <div class="header__banner-image rel" style="background-color: {{ bg_color }};">
                          {% render 'image', image: banner_image, class_name: 'image-abs-cover', %}
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                    {%- if banner_heading != blank -%}
                      <h3 class="header__banner-heading h6">
                        {%- if button_link != blank -%}
                          <a href="{{ button_link }}">{{ banner_heading }}</a>
                        {%- else -%}
                          {{ banner_heading }}
                        {%- endif -%}
                      </h3>
                    {%- endif -%}
                    {%- if banner_description != blank -%}
                      <p class="header__banner-description">{{ banner_description }}</p>
                    {%- endif -%}
                    {%- if button_label != blank -%}
                      <a{% if button_link == blank %} role="link" aria-disabled="true"{% else %}
                        href="{{ button_link }}"{% endif %}
                              class="header__banner-button">
                        {{ button_label | escape }}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endcapture -%}
                {%- assign has_banner = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if link.links != blank or has_banner -%}
            <div id="{{ link.title }}-{{ forloop.index }}"
                 class="header__submenu list-menu list-menu--disclosure"
                 tabindex="-1"
                 aria-hidden="true" {%- if link.links == blank -%} style="justify-content: flex-end" {%- endif -%}>
              {%- if link.links != blank -%}
