{% render '_header.min.css' %}
<script src="{{ 'header.min.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign enable_sticky_header = section.settings.enable_sticky_header
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign logo = section.settings.logo
  assign logo_svg = section.settings.logo_svg
  assign logo_width = section.settings.logo_width | append: 'px'
  assign logo_url_width = section.settings.logo_width | times: 2 | append: 'px'
  assign transparent_text_color = section.settings.transparent_text_color
  assign transparent_logo = section.settings.transparent_logo
  assign menu_primary = linklists[section.settings.menu_primary]
  assign menu_secondary = linklists[section.settings.menu_secondary]
  assign mobile_menu_primary = linklists[section.settings.mobile_menu_primary] | default: menu_primary
  assign mobile_menu_secondary = linklists[section.settings.mobile_menu_secondary]
  assign transparent_header = false
  assign search_trending = section.settings.search_trending
  assign search_popular_products = section.settings.search_popular_products
  assign result_btn_text = section.settings.result_btn_text
  assign result_btn_link = section.settings.result_btn_link | default: 'Shop All'

  assign enable_animation_cart_icon = section.settings.enable_animation_cart_icon

  if template contains 'index' and section.settings.transparent_header_homepage
    assign transparent_header = true
  endif
-%}

{%- include 'customer-status' -%}
{%- comment -%}
  - 'customer-status' return {{ customer_status }} variable
{%- endcomment -%}

<{% if enable_sticky_header %}sticky-header{% else %}div{% endif %} class="header-wrapper">

  {%- render 'header-mobile-menu', mobile_menu_primary: mobile_menu_primary, mobile_menu_secondary: mobile_menu_secondary, customer_status: customer_status  -%}

  <header class="header {% if transparent_header %}header--transparent{% endif %} {% if is_professional_page %}header__professional{% endif %}" style="--bg-color: {{ bg_color }}; --text-color: {{ text_color }}; --transparent-text-color: {{ transparent_text_color }}; --logo-width: {{ logo_width }}">
    {%- render 'predictive-search' -%}

    <div class="header__container">

      <nav class="header-menu">

      <!---------- Desktop navigation -------->
        <modal-opener class="link mobile-menu-opener">
            <button class="btn--reset hamburger-icon header-mobile-menu__opener medium-up-hide close-all-drawers"
                    id="drawer-menu-open"
                    aria-controls="#mobile-menu-drawer"
                    aria-haspopup="true"
                    aria-expanded="false"
                    data-close-drawers
                    aria-label="{{ 'accessibility.mobile_menu_open' | t }}">
              <span></span>
              <span></span>
              <span></span>
            </button>
          </modal-opener>

        <button class="btn--reset hamburger-icon hidden search-modal__close medium-up-hide"
                data-close-search
                aria-label="{{ 'accessibility.close_search' | t }}"
                aria-expanded="true">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </nav>
      <!--------- Logo --------->
      {%- assign logo_link = routes.root_url -%}

      {%- if logo != blank -%}
        <a href="{{ logo_link }}" class="header__logo">
          {%- assign logo_alt = logo.alt | default: shop.name | escape -%}

          {%- if transparent_header and transparent_logo and logo_svg == blank -%}
            {% render 'image', image: transparent_logo, class_name: 'header__logo-img--transparent', small_size: true, alt: logo_alt, preload: true %}
          {%- endif -%}

          {%- if logo_svg != blank -%}
            {{ logo_svg }}
          {%- else -%}
            {%- render 'image', image: logo, class_name: 'header__logo-img', small_size: true,  alt: logo_alt, preload: true -%}
          {%- endif -%}
        </a>
      {%- else -%}
        {%- if request.page_type == 'index' -%}
          <h1 class="header__heading h3">
            {{ shop.name }}
          </h1>
        {%- endif -%}
      {%- endif -%}

      <!--------- Right menu & icons ---------->
      <div class="header-right-menu">

        {%- if menu_secondary != blank and menu_secondary.links.size > 0 -%}
          <nav class="header-menu medium-hide">
            <ul class="header-menu__list header-menu__list--secondary list--unstyled medium-hide">
              {%- for link in menu_secondary.links -%}

                {%- assign direct_link_access = link.object.metafields.custom.direct_link_access | default: false -%}

                {%- if direct_link_access -%}
                  {% continue %}
                {%- endif -%}

                {% if section.blocks.size > 0 %}
                  {%- assign menu_block = blank -%}

                  {% for block in section.blocks %}
                    {%- assign link_handleize = link.title | handleize -%}
                    {%- assign chain_handle = block.settings.heading | handleize -%}

                    {% if link_handleize == chain_handle %}
                      {%- assign menu_block = block -%}
                      {% break %}
                    {% endif %}
                  {% endfor %}
                {% endif %}

                <li class="header-menu__item body3">
                  {% if link.links.size > 0 or menu_block != blank %}
                    {%- render 'mega-menu', main_link: link, block: menu_block, index: forloop.index -%}
                  {%- else -%}

                    {%- assign link_title_handelize = link.title | handleize -%}

                    {%- if link_title_handelize == 'for-professionals' and customer_status == 'Partner' or
                      link_title_handelize == 'for-professionals' and customer_status == 'Premier Partner' -%}
                      {%- assign link_url = settings.professional_homepage_url -%}
                    {%- endif -%}

                    {%- capture top_nav_event_config -%}
                      {
                      "nav_level_1": "{{ link.title }}",
                      "nav_level_2": "",
                      "nav_level_3": ""
                      }
                    {%- endcapture -%}
                    <a href="{{ link_url | default: link.url }}" class="header-menu__link" data-menu-opener data-event-nav-link='{{ top_nav_event_config }}' data-nav-link-level="1">{{ link.title }}</a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        <ul class="header-icons list--unstyled">
          <li class="header-icons__item">
            {%- capture top_nav_event_config -%}
              {
                "nav_level_1": "Search",
                "nav_level_2": "",
                "nav_level_3": ""
              }
            {%- endcapture -%}

            <modal-opener>
              <button class="btn--reset header__icon header__icon--search"
                      aria-haspopup="true"
                      aria-expanded="false"
                      aria-controls="#search-modal-drawer"
                      data-open-modal
                      style="display: block"
                      data-event-nav-link='{{ top_nav_event_config }}'>
                {% render 'icon' with 'search' %}
                <span class="visually-hidden">{{ 'general.search.search' | t }}</span>
              </button>
            </modal-opener>
          </li>

          {%- if shop.customer_accounts_enabled -%}
            <li class="header-icons__item {% unless is_professional_page %}medium-hide{% endunless %}">
              {%- capture top_nav_event_config -%}
                {
                  "nav_level_1": "Account",
                  "nav_level_2": "",
                  "nav_level_3": ""
                }
              {%- endcapture -%}
              <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="header__icon header__icon--account" data-event-nav-link='{{ top_nav_event_config }}'>
                {% render 'icon' with 'account' %}
                <span class="visually-hidden">
                  {%- liquid
                    if customer
                      echo 'customer.account_fallback' | t
                    else
                      echo 'customer.log_in' | t
                    endif
                  -%}
                </span>
              </a>
            </li>
          {%- endif -%}

          <li class="header-icons__item header-icons__cart rel">
            {%- capture top_nav_event_config -%}
              {
                "nav_level_1": "Cart",
                "nav_level_2": "",
                "nav_level_3": ""
              }
            {%- endcapture -%}
            <modal-opener>
              <button
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="#cart-drawer"
                data-open-modal
                style="display: block"
                class="btn--reset header__icon header__icon--cart a rel"
                data-event-nav-link='{{ top_nav_event_config }}'>
                {% render 'icon' with 'bag' %}

                <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
              </button>

              <div
                class="cart-count-bubble
                {% if cart == empty %}visually-hidden{% endif %}
                {% if enable_animation_cart_icon %}cart-count-bubble--anim{% endif %}">
                <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
              </div>
            </modal-opener>
          </li>
        </ul>
      </div>
    </div>
    {%- if menu_primary != blank and  menu_primary.links.size > 0  -%}
      <ul class="header-menu__list header-menu__list--primary list--unstyled medium-hide">
        {%- for link in menu_primary.links -%}
          {%- assign direct_link_access = link.object.metafields.custom.direct_link_access | default: false -%}

          {%- if direct_link_access -%}
            {% continue %}
          {%- endif -%}

          {% if section.blocks.size > 0 %}
            {%- assign menu_block = blank -%}

            {% for block in section.blocks %}
              {%- assign link_handleize = link.title | handleize -%}
              {%- assign chain_handle = block.settings.heading | handleize -%}

              {% if link_handleize == chain_handle %}
                {%- assign menu_block = block -%}
                {% break %}
              {% endif %}
            {% endfor %}
          {% endif %}

          <li class="header-menu__item body3">
            {% if link.links.size > 0 or menu_block != blank %}
              {%- render 'mega-menu', main_link: link, block: menu_block, index: forloop.index -%}
            {%- else -%}
              {%- liquid assign link_title_handleize = link.title | handleize -%}
              {%- capture top_nav_event_config -%}
                {
                "nav_level_1": "{{ link.title }}",
                "nav_level_2": "",
                "nav_level_3": ""
                }
              {%- endcapture -%}
              <a href="{{ link.url }}" class="header-menu__link" aria-expanded="false" data-menu-opener data-event-nav-link='{{ top_nav_event_config }}'>{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </header>
  <div class="header-overlay" aria-hidden="true"><span class="visually-hidden">{{ 'accessibility.header_overlay' | t }}</span></div>

</{%- if enable_sticky_header -%}sticky-header{%- else -%}div{%-endif-%}>


<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if section.settings.logo %}
  {% assign image_size = section.settings.logo.width | append: 'x' %}
      "logo": {{ section.settings.logo | img_url: image_size | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ shop.url | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = shop.url | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ shop.url | append: page.url | json }}
    }
  </script>
{%- endif -%}

<script>
  function setHeaderHeightVar() {
    document.documentElement.style.setProperty('--header-height', document.querySelector('.header').getBoundingClientRect().height + 'px');
    document.documentElement.style.setProperty('--header-bottom', document.querySelector('.header').getBoundingClientRect().bottom + 'px');
  }
  setHeaderHeightVar();
  window.addEventListener('resize', setHeaderHeightVar);
  // Waiting when lazyload load logo and update header height
  setTimeout(setHeaderHeightVar, 1000)
</script>

