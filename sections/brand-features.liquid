{{ 'brand-features.min.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_bg_color = section.settings.section_bg_color
  assign text_color = section.settings.text_color
  assign heading = section.settings.heading
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign button_style = section.settings.button_style
  assign image = section.settings.image
  assign image_alt = image.alt | default: heading | default: 'Brand features image'
  assign image_heading = section.settings.image_heading
  assign image_description = section.settings.image_description
  assign image_text_color = section.settings.image_text_color
  assign image_position = section.settings.image_position
-%}

<div class="brand-features"
     data-aos="fade-up"
     style="
       --bg-color: {{ section_bg_color }};
       --color: {{ text_color }}
       ">
  <div class="brand-features__wrapper--{{ image_position }} page-width">

    <div class="brand-features__image-wrapper">
      <div class="brand-features__image rel">
        {%- if image -%}
          <div class="brand-features__image-content" style="--image-text-color: {{ image_text_color }}">
            {%- if image_heading != blank -%}
              <h3 class="brand-features__image-heading">{{ image_heading }}</h3>
            {%- endif -%}
            {%- if image_description != blank -%}
              <p class="brand-features__image-description body2">{{ image_description }}</p>
            {%- endif -%}
          </div>
          {% render 'image',
            image: image,
            class_name: 'image-abs-cover',
            alt: image_alt %}
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'image-abs-cover' }}
        {%- endif -%}
      </div>
    </div>

    <div class="brand-features__content">
      {%- if heading != blank -%}
        <h3 class="brand-features__content-heading h6">{{ heading | escape }}</h3>
      {%- endif -%}
      <ul class="brand-features__content-list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign title = block.settings.title
            assign link = block.settings.link
          -%}
          {%- if title != blank -%}
            <li class="brand-features__content-item h3" {{ block.shopify_attributes }}>
              <span class="brand-features__content-item-icon">
                {% render 'icon' with 'arrow-right-large' %}
              </span>
              {%- if link != blank -%}
                <a href="{{ link }}">{{ title | escape }}</a>
              {%- else -%}
                {{ title | escape }}
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            <li class="brand-features__content-item h3">
              <span class="brand-features__content-item-icon">
                {% render 'icon' with 'arrow-right-large' %}
              </span>
              {{ 'Brand feature ' | append: i }}
            </li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>
      {%- if button_label != blank -%}
        <a{% if button_link == blank %} role="link" aria-disabled="true" disabled{% else %}
          href="{{ button_link }}"{% endif %}
          class="brand-features__btn btn btn--{{ button_style }}">
          {{ button_label | escape }}
        </a>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Brand features",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Background color",
      "default": "#F9F9F9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#383838"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Brand features:"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "primary-alt",
          "label": "Primary alternative"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "secondary-alt",
          "label": "Secondary alternative"
        }
      ],
      "default": "primary"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_heading",
      "label": "Image heading"
    },
    {
      "type": "textarea",
      "id": "image_description",
      "label": "Image description"
    },
    {
      "type": "color",
      "id": "image_text_color",
      "label": "Image text color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "brand-feature",
      "name": "Brand feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "default": "Brand feature",
          "label": "Feature text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Feature link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand features"
    }
  ]
}
{% endschema %}
