{% if customer %}
  <script>
    window.location.href ='/account'
  </script>
{% endif %}

{{ 'customer.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'customer.min.js' | asset_url }}" defer="defer"></script>


{% liquid
  assign professional_login_text = section.settings.professional_login_text
  assign email_marketing_text = section.settings.email_marketing_text
  assign recover_pass_text = section.settings.recover_pass_text
  assign recover_pass_image = section.settings.recover_pass_image
%}

<section id="{{ section.id }}" class="customer-register-page">
  {%- render 'customer-recover-form', recover_text: recover_pass_text, image: recover_pass_image -%}
  <div class="customer-wrapper page-width">
    {% render 'customer-login-form', login_text: professional_login_text, return_to: routes.account_url  %}
    {% render 'customer-register-form', email_marketing_text: email_marketing_text %}
  </div>
</section>


{% schema %}
{
  "name": "t:sections.main-register.name",
  "settings": [
    {
      "type": "header",
      "content": "Login form"
    },
    {
      "type": "richtext",
      "id": "professional_login_text",
      "label": "Professional sign in text"
    },
    {
      "type": "header",
      "content": "Register form"
    },
    {
      "type": "richtext",
      "id": "email_marketing_text",
      "label": "Consent email marketing text"
    },
    {
      "type": "header",
      "content": "Recover password form"
    },
    {
      "type": "richtext",
      "id": "recover_pass_text",
      "label": "Description",
      "default": "<p>Fill in your email below to request a new password. An email will be sent to the address below containing a link to verify your email address.</p>"
    },
    {
      "type": "image_picker",
      "id": "recover_pass_image",
      "label": "Image desktop"
    }
  ]
}
{% endschema %}
