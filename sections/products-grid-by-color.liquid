{{ 'section-products-grid.css' | asset_url | stylesheet_tag }}

{%- assign anchor_link = section.settings.anchor_link -%}
{%- liquid
  assign color_theme = section.settings.color_theme
  assign custom_id = section.settings.custom_id
  assign heading = section.settings.heading
  assign product_list = section.settings.product_list
  assign desktop_grid_layout = section.settings.desktop_grid_layout
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_mobile_top = section.settings.padding_mobile_top
  assign padding_mobile_bottom = section.settings.padding_mobile_bottom
-%}

{% style %}
  .products-grid--{{ section.id }} {
    --desktop-grid-layout: {{ desktop_grid_layout }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    --padding-mobile-top: {{ padding_mobile_top }}px;
    --padding-mobile-bottom: {{ padding_mobile_bottom }}px;
  }
{% endstyle %}

{%- if heading != blank or section.blocks.size > 0 -%}
  <div {% if custom_id != blank %} id="{{ custom_id }}"{% endif %}
          class="products-grid products-grid--{{ section.id }} {% if section.settings.color_theme == 'black' %}products-grid--black{% endif %}"
		{% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}
	>
    <div class="page-width">
      {%- if heading != blank -%}
        <h3 class="products-grid__heading">
          {{ heading }}
        </h3>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="products-grid__wrapper">
          {%- for block in section.blocks -%}
            {%- assign product = block.settings.product -%}
            {%- assign colors_to_show = block.settings.colors_to_show | split: ',' -%}
            {%- assign colors_to_show_handleize_arr = blank -%}
            {%- assign uniq_id = section.id | append: '--' | append: product.id | append: '--' | append: forloop.index -%}

            {%- if colors_to_show.size > 0 -%}

              {%- for color in colors_to_show -%}
                {%- assign color_handle = color | handleize -%}
                {%- assign colors_to_show_handleize_arr = colors_to_show_handleize_arr | append: '###' | append: color_handle -%}
              {%- endfor -%}

              {%- assign colors_to_show_handleize_arr = colors_to_show_handleize_arr | remove_first: '###' | split: '###' -%}
            {%- endif -%}

            {%- if product.tags contains 'hidden' -%}
              {% continue %}
            {%- endif -%}

						{% if product != blank %}
							{% render 'product-card',
								product: product,
								hide_variants: false,
								uniq_id: uniq_id,
								colors_to_show: colors_to_show_handleize_arr,
								show_product_title: true,
								show_product_reviews: true,
								show_product_description: true,
								show_product_description_metafield: true,
								show_product_price: true,
								show_product_price_range: true,
								show_product_badge: true,
								show_color_options_size: true,
								show_image_thumbnails: true,
								custom_class: 'products-grid__card' %}
						{% endif %}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Products grid by color",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "select",
      "id": "color_theme",
      "label": "Color theme",
      "options": [
        {
          "value": "black",
          "label": "Black"
        },
        {
          "value": "white",
          "label": "White"
        }
      ],
      "default": "white"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom id",
      "info": "Can be used for anchor links"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "desktop_grid_layout",
      "label": "Desktop grid layout",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding top (Desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (Desktop)",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding top (Mobile)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (Mobile)",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "product-item",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "colors_to_show",
          "label": "Colors to show",
          "info": "Enter the colors you want to display, separated by commas. Example: Black, White, Green.."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Products grid by color"
    }
  ]
}
{% endschema %}