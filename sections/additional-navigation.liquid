{{ 'additional-navigation.css' | asset_url | stylesheet_tag }}
{% if section.settings.sticky_section %}
	<script src="{{ 'additional-navigation.js' | asset_url }}"></script>
{% endif %}

{% liquid
	assign sticky_section = section.settings.sticky_section
	assign show_border_bottom = section.settings.show_border_bottom
	assign bg_color = section.settings.bg_color
	assign heading_color = section.settings.heading_color
	assign text_color = section.settings.text_color
	assign heading = section.settings.heading
	assign heading_type = section.settings.heading_type
	assign padding_top = section.settings.padding_top
	assign padding_bottom = section.settings.padding_bottom
%}

{% if section.blocks.size > 0 %}
	<{% if sticky_section %}additional-navigation{% else %}div{% endif %} class="additional-navigation" style="
		--bg-color: {{ bg_color }};
		--text-color: {{ text_color }};
		--padding-top: {{ padding_top }}px;
		--padding-bottom: {{ padding_bottom }}px;
		{% if section.blocks.size > 6 %} --items-count: 6; {% else %} --items-count: {{ section.blocks.size }}; {% endif %}
		{% if show_border_bottom %}border-bottom: 1px solid #212121; {% endif %}
		">
		<div class="additional-navigation__wrapper page-width">
			{% if heading != blank %}
			<{{ heading_type }} class="additional-navigation__heading">{{ heading }}</{{ heading_type }}>
		{% endif %}
			<div class="additional-navigation__items-container">
				<div class="additional-navigation__items-wrapper" style="{% if section.blocks.size > 6 %}flex-wrap: wrap; {% endif %} {% if heading != blank %}padding-top: 32px; {% endif %}">
					{% for block in section.blocks %}
						{% liquid
							assign image = block.settings.image
							assign url = block.settings.url
							assign title = block.settings.title
						%}
						{% if image != blank or title != blank %}
							<div class="additional-navigation__item">
								{% if image != blank %}
									<div class="additional-navigation__item-image">
										{% if url != blank %}
											<a href="{{ url }}" class="additional-navigation__item-image-link full-unstyled-link"><span class="visually-hidden">{{ heading }}</span></a>
										{% endif %}
										{%- render 'image', image: image, alt: title -%}
									</div>
								{% endif %}

								{% if title != blank and url != blank %}
									<h3 class="additional-navigation__item-title h6">
										<a href="{{ url }}" class="full-unstyled-link">{{ title }}</a>
									</h3>
								{% elsif title != blank %}
									<h3 class="additional-navigation__item-title h6">{{ title }}</h3>
								{% endif %}
							</div>
						{% endif %}
					{% endfor %}
				</div>
			</div>
		</div>
	</{% if sticky_section %}additional-navigation{% else %}div{% endif %}>
{% endif %}

{% schema %}
{
  "name": "Additional navigation",
	"class": "additional-navigation__section",
  "settings": [
    {
      "type": "checkbox",
      "id": "sticky_section",
      "default": true,
      "label": "Sticky section"
    },
    {
      "type": "header",
      "content": "Section settings"
    },
    {
      "type": "checkbox",
      "id": "show_border_bottom",
      "default": true,
      "label": "Show border bottom"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F2F1F1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#182844"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "select",
      "id": "heading_type",
      "label": "Heading type",
      "info": "Choose the type of the heading",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
				{
          "value": "h5",
          "label": "H5"
        }
			],
      "default": "h3"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Desktop padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Desktop padding bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "name": "Item",
      "type": "item",
      "settings":[
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Recommended size 750x950px"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Title"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL",
          "info": "To use it as a anchor link, enter '#' and the ID of the section you want to scroll to. Example: '#section-id'"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Additional navigation",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}