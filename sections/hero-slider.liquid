{% render '_hero-slider.min.css' %}

{% liquid
  assign speed = section.settings.speed | times: 1000 | ceil
  assign delay = section.settings.delay | times: 1000 | ceil
  assign autoplay = section.settings.autoplay
  assign loop = section.settings.infinity_loop
  assign desktop_section_height = section.settings.desktop_section_height
  assign mobile_section_height = section.settings.mobile_section_height
  assign border_bottom = section.settings.section_border_bottom
%}

{%- if section.blocks.size < 2 -%}
  {%- assign loop = false -%}
{%- endif -%}

{%- capture config -%}
  {
  "direction": "horizontal",
  "effect": "slide",
  "speed": {{ speed }},
  "autoHeight": false,
  {% if autoplay and section.blocks.size > 1 %}
    "autoplay": {
    "delay": {{ delay }}
    },
  {% endif %}
  {% if section.blocks.size > 1 %}
    "loop": {{ loop }},
  {% endif %}
  {% if section.blocks.size > 0 %}
    "pagination": {
      "el": ".swiper-pagination--{{ section.id }}",
      "type": "bullets",
      "clickable": true
    },
  {% endif %}
  "slidesPerView": "auto"
  }
{%- endcapture -%}

{% if section.blocks.size > 0 %}
  <div class="hero-slider{% if border_bottom %} border-bottom{% endif %}" style="
    --desktop-section-height: {{ desktop_section_height }};
    --mobile-section-height: {{ mobile_section_height }};">

    <slideshow-swiper data-config='{{ config }}' data-slider="data-slider">
      <div class="swiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% liquid
              assign desktop_image_class = 'image-abs-cover'
              assign mobile_image_class = 'image-abs-cover small-up-hide'
              assign heading = block.settings.heading
              assign text = block.settings.text
              assign type_text = block.settings.type_text
              assign image = block.settings.image
              assign second_image = block.settings.second_image
              assign image_mobile = block.settings.image_mobile
              assign video_display_format = block.settings.video_display_format
              assign video_display_format_mobile = block.settings.video_display_format_mobile
              assign video_mp4 = block.settings.video_mp4
              assign video_mp4_mobile = block.settings.video_mp4_mobile
              assign controls_position = block.settings.controls_position
              assign controls_color = block.settings.controls_color
              assign show_play_button = block.settings.show_play_button
              assign show_mute_button = block.settings.show_mute_button
              assign btn_label = block.settings.btn_label
              assign btn_url = block.settings.btn_url
              assign btn_entire_section = block.settings.btn_entire_section

              assign horizontal_position = block.settings.horizontal_position
              assign vertical_position = block.settings.vertical_position
              assign desktop_text_align = block.settings.desktop_text_align
              assign desktop_color = block.settings.desktop_color
              assign desktop_button_type = block.settings.desktop_button_type

              assign mobile_horizontal_position = block.settings.mobile_horizontal_position
              assign mobile_vertical_position = block.settings.mobile_vertical_position
              assign mobile_text_align = block.settings.mobile_text_align
              assign mobile_color = block.settings.mobile_color
              assign mobile_button_type = block.settings.mobile_button_type

              if image != blank and second_image != blank
                assign desktop_image_class = desktop_image_class | append: ' hero__half-image'
                assign desktop_second_image_attr = 'data-second-image'
              endif

              if video_display_format == 'contain'
                assign contain_video_desk = true
              endif

              if video_display_format_mobile == 'contain'
                assign contain_video_mobile = true
              endif
            %}

            <div class="swiper-slide">
              <div class="hero-item__wrapper rel" style="
                --content-horizontal-position: {{ horizontal_position }};
                --content-vertical-position: {{ vertical_position }};
                --mobile-horizontal-content-position: {{ mobile_horizontal_position }};
                --mobile-vertical-content-position: {{ mobile_vertical_position }};
                --desktop-text-align: {{ desktop_text_align }};
                --mobile-text-align: {{ mobile_text_align }};
                --desktop-color: {{ desktop_color }};
                --mobile-color: {{ mobile_color }};
                ">
                {%- if video_mp4 or video_mp4_mobile -%}
                  {%- if video_mp4 -%}

                    {%- assign class_name_desk = 'block hero__video' -%}
                    {%- if video_mp4_mobile or image_mobile != blank  -%}
                      {%- assign class_name_desk = 'block hero__video small-hide' -%}
                    {%- endif -%}

                    {%- render 'video',
                      video: video_mp4,
                      default_controls: false,
                      controls_position: controls_position,
                      autoplay: true,
                      show_mute_button: show_mute_button,
                      show_play_button: show_play_button,
                      controls_color: controls_color,
                      disable_video_scale_on_desktop: contain_video_desk,
                      disable_video_scale_on_mobile: contain_video_mobile,
                      class: class_name_desk
                    -%}
                  {%- endif -%}

                  {%- if video_mp4_mobile -%}
                    {%- render 'video',
                      video: video_mp4_mobile,
                      default_controls: false,
                      controls_position: controls_position,
                      autoplay: true,
                      show_mute_button: show_mute_button,
                      show_play_button: show_play_button,
                      controls_color: controls_color,
                      disable_video_scale_on_desktop: contain_video_desk,
                      disable_video_scale_on_mobile: contain_video_mobile,
                      class: 'block hero__video small-up-hide'
                    -%}
                  {%- endif -%}
                {%- endif -%}

                {% if image != blank or second_image != blank %}
                  {%- render 'image', image: image, alt: image.alt, class_name: desktop_image_class, preload: true, show_preloader_img: true -%}

                  {%- if second_image -%}
                    {% render 'image', image: second_image, class_name: desktop_image_class, alt: second_image.alt, image_attr: desktop_second_image_attr, preload: true, show_preloader_img: true %}
                  {%- endif -%}

                  {%- if image_mobile != blank -%}
                    {%- render 'image', image: image_mobile, alt: image_mobile.alt, class_name: mobile_image_class, preload: true, show_preloader_img: true -%}
                  {%- endif -%}
                {% endif %}

                {% if heading != blank or text != blank or btn_label != blank %}
                  <div class="hero-item__container">
                    <div class="hero-item__content">
                      {% if text != blank %}
                        <span class="hero-item__subcopy {{ type_text }}">{{ text }}</span>
                      {% endif %}

                      {% if heading != blank %}
                        <h1 class="hero-item__heading h1">{{ heading }}</h1>
                      {% endif %}

                      {%- if btn_label != blank -%}
                        <a{% if btn_url == blank %} role="link" aria-disabled="true" disabled{% else %}
                          href="{{ btn_url }}"{% endif %}
                          class="hero-item__btn btn btn--{{ desktop_button_type }} {% if desktop_button_type != mobile_button_type %}small-hide{% endif %}"
                          {{ block.shopify_attributes }}>
                          {{ btn_label }}
                        </a>
                      {%- endif -%}

                      {% if desktop_button_type != mobile_button_type %}
                        <a{% if btn_url == blank %} role="link" aria-disabled="true" disabled{% else %}
                          href="{{ btn_url }}"{% endif %}
                          class="hero-item__btn btn btn--{{ mobile_button_type }} small-up-hide"
                          {{ block.shopify_attributes }}>
                          {{ btn_label }}
                        </a>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}

                {% if btn_url != blank and btn_entire_section %}
                  <a href="{{ btn_url }}" class="hero-item__link"><span class="visually-hidden">{{ btn_label }}</span></a>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.blocks.size > 0 %}
        <div class="hero-pagination swiper-pagination--{{ section.id }}"></div>
      {% endif %}
    </slideshow-swiper>
  </div>
{% endif %}


