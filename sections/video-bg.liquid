{{ 'video-section.css' | asset_url | stylesheet_tag }}

{%- liquid
	assign anchor_link = section.settings.anchor_link
  assign video = section.settings.video
  assign video_mobile = section.settings.video_mobile
  assign video_size = section.settings.video_size
  assign video_size_mobile = section.settings.video_size_mobile
-%}

<style>
  .video-section__wrapper-{{ section.id }} {
    --video-size: {{ video_size }};
    --video-size-mobile: {{ video_size_mobile }};
  }
</style>

<div id="{{ section.id }}"
     class="video-section__wrapper video-section__wrapper--bg {% if section.settings.color_theme == 'black' %}landing-colors{% endif %} video-section__wrapper-{{ section.id }}">
  <noscript>
    <div class="video-section__media" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
      <a href="{{ section.settings.video_url }}"
         class="video-section__poster media media--transparent media--landscape{% if section.settings.cover_image == blank %} video-section__placeholder{% endif %}">
        {%- if section.settings.cover_image != blank -%}
          {% render 'image', image: section.settings.cover_image %}
        {%- else -%}
          {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
        {%- endif -%}
      </a>
    </div>
  </noscript>

  {%- if video_mobile -%}
    <video class="image-abs-cover small-up-hide" loop playsinline autoplay muted title="{{ section.settings.description | escape }}">
      {%- for source in video_mobile.sources -%}
        <source src="{{ source.url }}" type="{{ source.mime_type }}">
      {%- endfor -%}
    </video>
  {%- endif -%}

  {%- if video -%}
    <video class="image-abs-cover {% if video_mobile %}small-hide{% endif %}" loop playsinline autoplay muted title="{{ section.settings.description | escape }}">
      {%- for source in video.sources -%}
        <source src="{{ source.url }}" type="{{ source.mime_type }}">
      {%- endfor -%}
    </video>
  {%- endif -%}

  {%- if section.settings.cover_image != blank -%}
    {% render 'image', image: section.settings.cover_image, class_name: 'image-abs-cover' %}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Video background",
  "tag": "section",
  "class": "video-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "select",
      "id": "color_theme",
      "label": "Color theme",
      "options": [
        {
          "value": "black",
          "label": "Black"
        },
        {
          "value": "white",
          "label": "White"
        }
      ],
      "default": "black"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.video.settings.cover_image.label"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Video (mobile)"
    },
    {
      "type": "header",
      "content": "Video size"
    },
    {
      "type": "select",
      "id": "video_size",
      "label": "Video size",
      "options": [
        {
          "value": "75vw",
          "label": "4:3"
        },
        {
          "value": "56.25vw",
          "label": "16:9"
        },
        {
          "value": "50vh",
          "label": "Half height"
        },
        {
          "value": "100vh",
          "label": "Full height"
        }
      ],
      "default": "56.25vw"
    },
    {
      "type": "select",
      "id": "video_size_mobile",
      "label": "Video size (mobile)",
      "options": [
        {
          "value": "133vw",
          "label": "3:4"
        },
        {
          "value": "56.25vw",
          "label": "16:9"
        },
        {
          "value": "50vh",
          "label": "Half height"
        },
        {
          "value": "100vh",
          "label": "Full height"
        }
      ],
      "default": "56.25vw"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:sections.video.settings.description.label",
      "info": "t:sections.video.settings.description.info"
    }
  ],
  "presets": [
    {
      "name": "Video background"
    }
  ]
}
  {% endschema %}
