{{ 'section-featured-products.css' | asset_url | stylesheet_tag }}

{%- assign anchor_link = section.settings.anchor_link -%}

{% capture config %}
  {
    "slidesPerView": 1,
    "spaceBetween": 24,
    "loop": true,
    "effect": "fade",
    "navigation": {
      "nextEl": ".next-{{ section.id }}",
      "prevEl": ".prev-{{ section.id }}"
    },
    "breakpoints": {
      "900": {
        "shortSwipes": false,
        "spaceBetween": 36
      }
    }
  }
{% endcapture %}

{%- if section.blocks.size > 0 -%}
<slideshow-swiper id="featured-products"
                  data-config='{{ config }}'
                  data-arrows-appear="true"
                  class="featured-products-{{ section.id }}"
                  style="background-color: {{ section.settings.section_bg }};">
  <div class="swiper" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
    <ul class="swiper-wrapper" role="list">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.featured_product -%}

        {%- if product != blank -%}
          {%- assign heading = block.settings.heading | default: product.title -%}
          {%- assign subheading = block.settings.subheading -%}
          {%- assign text = block.settings.text | default: product.description -%}
          {%- assign product_image = block.settings.image | default: product.featured_image -%}
          {%- assign image_bg = block.settings.image_bg -%}
          {%- assign default_button_label = product.title | prepend: 'Shop ' -%}
          {%- assign button_label = block.settings.button_label | default: default_button_label -%}
          {%- assign button_link = block.settings.button_link | default: product.url -%}

          {%- assign reviews_count = product.metafields.junip.rating_count | plus: 0 -%}
          {%- assign reviews_count_length = reviews_count | split: '' -%}
          {%- assign reviews_count_string = reviews_count -%}

          {%- if reviews_count_length > 3 -%}
            {%- assign reviews_count_string = '' -%}
            {%- for i in reviews_count_length -%}
              {%- assign reviews_count_string = reviews_count_string | append: i -%}
              {%- if forloop.first -%}
                {%- assign reviews_count_string = reviews_count_string | append: ',' -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- capture text_content -%}
            <div class="featured-products__text-content">
              {%- if subheading != blank -%}
                <div class="featured-products__subheading">
                  {{ subheading }}
                </div>
              {%- endif -%}

              {%- if text != blank -%}
                <div class="featured-products__text">
                  {{ text | truncate: 130 }}
                </div>
              {%- endif -%}

              <a href="{{ button_link }}" class="featured-products__button button {% if block.settings.button_style == 'secondary' %} button--secondary-border{% else %} button--{{ block.settings.button_style }}{% endif %}">
                {{ button_label }}
              </a>
            </div>
          {%- endcapture -%}

            <li class="featured-products swiper-slide" role="listitem" {{ block.shopify_attributes }} style="background-color: {{ section.settings.section_bg }};">
              <div class="featured-products__wrapper {% if block.settings.layout == 'text_first' %} featured-products__wrapper--reverse{% endif %}">
                <div class="featured-products__media rel {% if product_image == blank %}featured-products__media--placeholder placeholder{% endif %}"
                     style="background-color: {{ image_bg }};">
                  {%- if product_image != blank -%}
                    {% render 'image', image: product_image, class_name: 'image-abs-cover' %}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="featured-products__content">
                  <div class="featured-products__content-wrapper">
                    <div class="featured-products__reviews-stars">
                      {%- if reviews_count > 0 -%}
                        {% render 'junip-product-summary', product: product %}
                      {%- endif -%}
                    </div>

                    {%- if heading != blank -%}
                      <h3 class="featured-products__heading h3">
                        {{ heading }}
                      </h3>
                    {%- endif -%}

                    {%- if reviews_count > 0 -%}
                      <p class="featured-products__reviews-rating">
                        {{ product.metafields.junip.rating_average | plus: 0 | round: 1 }} stars from over {{ reviews_count_string }} reviews
                      </p>
                    {%- endif -%}

                    <div class="tablet-hide">
                      {{ text_content }}
                    </div>
                  </div>
                </div>
              </div>
              <div class="tablet-up-hide">
                {{ text_content }}
              </div>
            </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if section.blocks.size > 1 -%}
      <div class="swiper-button-next next-{{ section.id }}"></div>
      <div class="swiper-button-prev prev-{{ section.id }}"></div>
    {%- endif -%}
  </div>
</slideshow-swiper>

{%- endif -%}

{% schema %}
{
  "name": "Featured products",
  "class": "section-featured-products section-margin-bottom",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background color",
      "default": "#FFF"
    }
  ],
  "blocks": [
    {
      "type": "featured_product",
      "name": "Featured product",
      "settings": [
        {
          "type": "product",
          "id": "featured_product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "info": "Product description by default"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "transparent",
              "label": "Transparent"
            }
          ],
          "default": "secondary",
          "label": "Button style"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "color",
          "id": "image_bg",
          "label": "Image background",
          "default": "#F2F2F2"
        },
        {
          "type": "select",
          "id": "layout",
          "options": [
            {
              "value": "image_first",
              "label": "Image first"
            },
            {
              "value": "text_first",
              "label": "Text first"
            }
          ],
          "default": "text_first",
          "label": "Desktop layout"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "blocks": [
        {
          "type": "featured_product"
        }
      ]
    }
  ]
}
{% endschema %}
