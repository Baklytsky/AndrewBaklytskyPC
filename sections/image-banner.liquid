{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- assign anchor_link = section.settings.anchor_link -%}

{%- style -%}
  #Banner-{{ section.id }}::after {
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }

  {%- if section.settings.desktop_text_box_color != blank or section.settings.mobile_text_box_color != blank -%}
    {%- if section.settings.desktop_text_box_color != blank -%}
      @media screen and (min-width: 750px) {
        #Banner-{{ section.id }} .banner__box {
          color: {{ section.settings.desktop_text_box_color }};
        }
      }
    {%- endif -%}

    {%- if section.settings.mobile_text_box_color != blank -%}
      @media screen and (max-width: 749px) {
        #Banner-{{ section.id }} .banner__box {
          color: {{ section.settings.mobile_text_box_color }};
        }
      }
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.remove_top_margin -%}
    #shopify-section-{{ section.id }}.spaced-section {
      margin-top: 0;
    }
  {%- endif -%}
{%- endstyle -%}

{%- assign block_banner_url = section.blocks | where: 'type', 'banner_url' -%}
{%- assign banner_url = block_banner_url[0].settings.banner_url -%}
{%- assign banner_label = block_banner_url[0].settings.banner_label -%}
{%- assign image_height = section.settings.image_height -%}
{%- assign image_1 = section.settings.image -%}
{%- assign image_2 = section.settings.image_2 -%}
{%- assign video_desktop = section.settings.video_desktop -%}
{%- assign video_mobile = section.settings.video_mobile -%}
{%- assign show_play_button = section.settings.show_play_button -%}
{%- assign show_mute_button = section.settings.show_mute_button -%}

{%- if image_height == 'natural' and image_1 != blank -%}
  {% capture images_pb %}
    {%- assign image_style_pb = '--image-pb: calc(' | append: image_1.height | append: ' / ' | append: image_1.width | append: ' * 100%);' -%}
    {{ image_style_pb }}
    
    {%- if image_2 != blank -%}
      {%- assign image_mobile_style_pb = '--mob-image-pb: calc(' | append: image_2.height | append: ' / ' | append: image_2.width | append: ' * 100%);' -%}
      
      {{ image_mobile_style_pb }}
    {%- endif -%}
  {% endcapture %}
{% else %}
  {%- assign image_height = 'medium' -%}
{%- endif -%}

<div id="Banner-{{ section.id }}"
     class="banner banner--{{ image_height }}{% if section.settings.show_text_below and image_height != 'natural' %} banner--mobile-bottom{%- endif -%}"
     style="
       {% if section.settings.remove_bottom_margin %}margin-bottom: 0;{% endif %}
       {% if images_pb != blank %}{{ images_pb }}{% endif %}
       "
>
	{%- if video_mobile -%}
		<div class="banner__media media{% if video_mobile != blank %} small-up-hide{% endif %}">
			<div class="small-up-hide">
				{%- render 'video',
					video: video_mobile,
					default_controls: false,
					autoplay: true,
					show_mute_button: show_mute_button,
					show_play_button: show_play_button
				-%}
			</div>
		</div>
	{% elsif image_2 != blank %}
		<div class="banner__media media{% if image_1 != blank %} small-up-hide{% endif %}">
			{% render 'image', image: image_2 %}
		</div>
	{%- endif -%}

	{%- if video_desktop -%}
		<div class="banner__media media{% if video_mobile == blank and video_desktop == blank %} placeholder{% endif %}{% if video_mobile != blank %} small-hide{% endif %}">
			<div class="{% if video_mobile %}small-hide{% endif %}">
				{%- render 'video',
					video: video_desktop,
					default_controls: false,
					autoplay: true,
					show_mute_button: show_mute_button,
					show_play_button: show_play_button
				-%}
			</div>
		</div>
	{% elsif image_1 != blank %}
		<div class="banner__media media{% if image_1 == blank and image_2 == blank %} placeholder{% endif %}{% if image_2 != blank %} small-hide{% endif %}">
			{% render 'image', image: image_1 %}
		</div>
	{%- endif -%}

  {% comment %}{%- if image_1 != blank -%}{% endcomment %}
    {% comment %}<div class="banner__media media{% if image_1 == blank and image_2 == blank %} placeholder{% endif %}{% if image_2 != blank %} small-hide{% endif %}">{% endcomment %}
      {% comment %}{% render 'image', image: image_1 %}{% endcomment %}
    {% comment %}</div>{% endcomment %}
  {% comment %}{%- endif -%}{% endcomment %}
  {% comment %}{% endcomment %}
  {% comment %}{%- if image_2 != blank -%}{% endcomment %}
    {% comment %}<div class="banner__media media{% if image_1 != blank %} small-up-hide{% endif %}">{% endcomment %}
      {% comment %}{% render 'image', image: image_2 %}{% endcomment %}
    {% comment %}</div>{% endcomment %}
  {% comment %}{%- endif -%}{% endcomment %}
  
  <div class="banner__content banner__content--{{ section.settings.desktop_text_box_position }} banner__content--mobile-{{ section.settings.mobile_text_box_position }} page-width" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
    <div class="banner__box" style="max-width: {{ section.settings.desktop_text_box_width }}px">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class="banner__heading h3" {{ block.shopify_attributes }}>
              {{ block.settings.heading | default: page_title | escape }}
            </h2>
          {%- when 'old-english-heading' -%}
          <style>
            .banner__old-heading--{{ block.id }} {
              --old-heading-font-size: {{ block.settings.old_heading_font_size }}px;
              --old-heading-font-size-mobile: {{ block.settings.old_heading_font_size_mobile }}px;
            }
          </style>
          <h2 class="banner__heading banner__old-heading banner__old-heading--{{ block.id }}" {{ block.shopify_attributes }}>
            {{ block.settings.heading | default: page_title | escape }}
          </h2>
          {%- when 'text' -%}
            <div class="banner__text" {{ block.shopify_attributes }}>
              {{ block.settings.text | escape }}
            </div>
          {%- when 'richtext' -%}
          <style>
            .banner__richtext--{{ block.id }} {
              --richtext-font-size: {{ block.settings.richtext_font_size }}px;
              --richtext-font-size-mobile: {{ block.settings.richtext_font_size_mobile }}px;
            }
          </style>
          <div class="banner__richtext banner__richtext--{{ block.id }}" {{ block.shopify_attributes }}>
            {{ block.settings.richtext }}
          </div>
          {%- when 'text-light' -%}
            <div class="banner__text-light" {{ block.shopify_attributes }}>
              {{ block.settings.text_light | escape }}
            </div>
          {%- when 'image' -%}
            <div class="banner__logo" style="max-width: {{ block.settings.image_width }}px; padding-top: calc({{ 1 | divided_by: block.settings.logo_image.aspect_ratio }} * {{ block.settings.image_width }}px);" {{ block.shopify_attributes }}>
              {% render 'image', image: block.settings.logo_image %}
            </div>
          {%- when 'badge' -%}
            <div class="banner__badge" {{ block.shopify_attributes }}>
              <span>{{ block.settings.label }}</span>
            </div>
        {%- endcase -%}
      {%- endfor -%}
      
      <div class="banner__button-wrapper">
        {%- for block in section.blocks -%}
          {%- if block.type == 'button' -%}
            {%- liquid
              assign button_label = block.settings.button_label
              assign hide_for_customer = block.settings.hide_for_customer
            -%}

            {%- if button_label != blank -%}
              {%- unless customer and hide_for_customer -%}
                <a{% if block.settings.button_link == blank %} role="link" aria-disabled="true"{% else %}
                  href="{{ block.settings.button_link }}"{% endif %}
                        class="banner__button button button--{{ block.settings.desktop_button_style }} small-hide"
                        {{ block.shopify_attributes }}>
                  {{ button_label | escape }}
                </a>
                <a{% if block.settings.button_link == blank %} role="link" aria-disabled="true"{% else %}
                  href="{{ block.settings.button_link }}"{% endif %}
                        class="banner__button button button--{{ block.settings.mobile_button_style }} small-up-hide"
                        {{ block.shopify_attributes }}>
                  {{ button_label | escape }}
                </a>
              {%- endunless -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
  
  {%- if banner_url != blank -%}
    <a class="banner__url" href="{{ banner_url }}"><span class="u-sr-only">{{ banner_label }}</span></a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Media banner",
  "tag": "section",
  "class": "spaced-section spaced-section--full-width",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "checkbox",
      "id": "remove_top_margin",
      "default": false,
      "label": "Remove top space"
    },
    {
      "type": "checkbox",
      "id": "remove_bottom_margin",
      "default": false,
      "label": "Remove bottom space"
    },
    {
      "type": "video",
      "id": "video_desktop",
      "label": "Desktop video",
			"info": "Has priority over the image"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobile video",
      "info": "Has priority over the image"
    },
    {
      "type": "checkbox",
      "id": "show_play_button",
      "label": "Show play/pause button",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_mute_button",
      "label": "Show mute/unMute button",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Mobile image"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 0
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Full screen height"
        },
        {
          "value": "natural",
          "label": "Natural"
        }
      ],
      "default": "medium",
      "label": "Banner height",
      "info": "Use 'Natural' only without content"
    },
    {
      "type": "range",
      "id": "desktop_text_box_width",
      "min": 630,
      "max": 1300,
      "step": 10,
      "unit": "px",
      "label": "Desktop text box width",
      "default": 630
    },
    {
      "type": "select",
      "id": "desktop_text_box_position",
      "label": "Desktop text box position",
      "options": [
        {
          "value": "middle-left",
          "label": "Middle Left"
        },
        {
          "value": "middle-center",
          "label": "Middle Center"
        },
        {
          "value": "middle-right",
          "label": "Middle Right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom Left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom Center"
        },
        {
          "value": "bottom-right",
          "label": "Bottom Right"
        }
      ],
      "default": "middle-left"
    },
    {
      "type": "select",
      "id": "mobile_text_box_position",
      "label": "Mobile text box position",
      "options": [
        {
          "value": "middle-left",
          "label": "Middle Left"
        },
        {
          "value": "middle-center",
          "label": "Middle Center"
        },
        {
          "value": "middle-right",
          "label": "Middle Right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom Left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom Center"
        },
        {
          "value": "bottom-right",
          "label": "Bottom Right"
        }
      ],
      "default": "bottom-left"
    },
    {
      "type": "color",
      "id": "desktop_text_box_color",
      "label": "Desktop text box color",
      "default": "#F9F9F9"
    },
    {
      "type": "header",
      "content": "t:sections.image-banner.settings.header.content"
    },
    {
      "type": "color",
      "id": "mobile_text_box_color",
      "label": "Mobile text box color",
      "default": "#F9F9F9"
    },
    {
      "type": "checkbox",
      "id": "show_text_below",
      "default": true,
      "label": "t:sections.image-banner.settings.show_text_below.label"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.image-banner.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Image banner",
          "label": "t:sections.image-banner.blocks.heading.settings.heading.label"
        }
      ]
    },
    {
      "type": "old-english-heading",
      "name": "Old english heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Image banner",
          "label": "t:sections.image-banner.blocks.heading.settings.heading.label"
        },
        {
          "type": "range",
          "id": "old_heading_font_size",
          "min": 10,
          "max": 100,
          "step": 1,
          "label": "Font size",
          "default": 34,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "old_heading_font_size_mobile",
          "min": 10,
          "max": 100,
          "step": 1,
          "label": "Font size mobile",
          "default": 24,
          "unit": "px"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.image-banner.blocks.text.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Give customers details about the banner image(s) or content on the template.",
          "label": "t:sections.image-banner.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "richtext",
      "name": "Richtext",
      "limit": 3,
      "settings": [
        {
          "type": "richtext",
          "id": "richtext",
          "default": "<p>Give customers details about the banner image(s) or content on the template.</p>",
          "label": "t:sections.image-banner.blocks.text.settings.text.label"
        },
        {
          "type": "range",
          "id": "richtext_font_size",
          "min": 10,
          "max": 40,
          "step": 1,
          "label": "Font size",
          "default": 16,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "richtext_font_size_mobile",
          "min": 10,
          "max": 40,
          "step": 1,
          "label": "Font size mobile",
          "default": 16,
          "unit": "px"
        }
      ]
    },
    {
      "type": "text-light",
      "name": "Light text",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text_light",
          "default": "Give customers details about the banner image(s) or content on the template.",
          "label": "t:sections.image-banner.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo image"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 0,
          "max": 300,
          "step": 10,
          "label": "Image width",
          "default": 120
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "Button label",
          "info": "t:sections.image-banner.blocks.buttons.settings.button_label_1.info"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "desktop_button_style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "transparent",
              "label": "Transparent"
            }
          ],
          "default": "primary",
          "label": "Desktop button style"
        },
        {
          "type": "select",
          "id": "mobile_button_style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "transparent",
              "label": "Transparent"
            }
          ],
          "default": "primary",
          "label": "Mobile button style"
        },
        {
          "type": "checkbox",
          "id": "hide_for_customer",
          "label": "Hide for customers",
          "info": "The button will be hidden for auth users"
        }
      ]
    },
    {
      "type": "banner_url",
      "name": "Banner URL",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Don't use with 'Button' block"
        },
        {
          "type": "url",
          "id": "banner_url",
          "label": "Banner URL"
        },
        {
          "type": "text",
          "id": "banner_label",
          "label": "Banner label (for accessibility)"
        }
      ]
    },
    {
      "type": "badge",
      "name": "Badge",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "TRUE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media banner",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
