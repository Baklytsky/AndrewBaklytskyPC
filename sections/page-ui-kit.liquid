        link_url_1: link_url,
        link_text_1: 'Primary',
        details_location: 'overlay',
        width: 400,
        height: 300
      %}

      {% if content_image_2 != blank %}
        {% assign content_tile_slot_2 = content_image_2 %}
      {% else %}
        {% assign content_tile_slot_2 = section.settings.featured_product.featured_image %}
      {% endif %}

