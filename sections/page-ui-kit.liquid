        alt: img_alt,
        title: 'Content Tile Text After',
        description: "I'm not thinking about anything when I'm climbing.",
        link_url_1: link_url,
        link_text_1: 'Primary',
        link_url_2: link_url,
        link_text_2: 'Secondary',
        details_location: 'after',
        width: 400,
        height: 300
      %}

