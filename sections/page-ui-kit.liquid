    {% assign img_src = section.settings.featured_product.featured_image.src | image_url: width: 300 %}
    {% assign img_alt = section.settings.featured_product.featured_image.alt %}
    {% assign link_url = section.settings.featured_product.url %}

    <div class="grid gap-6 grid-cols-2 mb-5">
      {% render 'ra-icon-tile'
       , image: featured_image,
       image_src: img_src,
       image_alt: img_alt,
       title: 'This is a Title',
       description: "I'm not thinking about anything when I'm climbing.",
       details_location: 'after',
       stacked: true,
       link_url: link_url,
       link_text: 'Default',
       horizontal_align: 'right' %}
      {% render 'ra-icon-tile'
       , image: featured_image,
       image_src: img_src,
       image_alt: img_alt,
       image_width: 200,
       title: 'This is a Title',
       description: "I'm not thinking about anything when I'm climbing.",
       stacked: false,
       link_url: link_url,
       link_text: 'Default',
       horizontal_align: 'left',
       horizontal_align_md: 'center',
       vertical_align: 'bottom' %}
