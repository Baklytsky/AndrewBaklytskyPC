{% schema %}
  {
    "name": "UI-Kit Settings",
    "settings": [
      { "type": "header", "content": "Content Tiles Images" },
      {
        "type": "image_picker",
        "id": "content_tile_image_1",
        "label": "Content Tile Image 1"
      },
      {
        "type": "image_picker",
        "id": "content_tile_image_2",
        "label": "Content Tile Image 2"
      },
      {
        "type": "image_picker",
        "id": "content_tile_image_3",
        "label": "Content Tile Image 3"
      },
      { "type": "header", "content": "Product Tiles" },
      {
        "type": "product",
        "id": "featured_product",
        "label": "Featured Product"
      },
      {
        "type": "product",
        "id": "featured_product_2",
        "label": "Featured Product 2"
      },
      {
        "type": "text",
        "id": "video_url",
        "label": "A Shopify-hosted video"
      }
    ]
  }
{% endschema %}