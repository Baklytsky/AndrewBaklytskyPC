        link_text_1: 'Primary',
        link_url_2: link_url,
        link_text_2: 'Secondary',
        details_location: 'before',
        width: 400,
        height: 300
      %}

      {%
         render 'ra-content-tile',
       video: video_url,
       alt: img_alt,
       title: 'Content Tile w/ Video',
       description: "Options for 1, 2 or no CTA's",
       width: 400,
       height: 300,
       details_location: 'after', %}
    </div>
    <hr class="border my-20">
    <h4 id="content-tiles-video" class="text-h4 mt-10 mb-5">Product Tiles</h4>
    <div class="max-w-screen-2xl grid grid-cols-4 gap-2">
      {% render 'ra-product-tile',
        product: product,
        atc_button: true,
        atc_label: 'Add to Bag',
        atc_style: 'primary',
        wishlist: true,
        index: 0
      %}
      {% render 'ra-product-tile',
        product: product_2,
        atc_button: true,
        atc_label: 'Add to Bag',
        atc_style: 'secondary',
        index: 1
      %}
    </div>
    <hr class="border my-20">
