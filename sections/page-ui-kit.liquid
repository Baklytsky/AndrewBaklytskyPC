<section class="scroll-smooth">
  {% liquid
    assign product = section.settings.featured_product
    assign product_2 = section.settings.featured_product_2
    assign featured_image = section.settings.featured_product.featured_image
    assign img_src = section.settings.featured_product.featured_image.src | image_url: width: 300
    assign content_image_1 = section.settings.content_tile_image_1 | image_url: width: 300
    assign content_image_2 = section.settings.content_tile_image_2 | image_url: width: 300
    assign content_image_3 = section.settings.content_tile_image_3 | image_url: width: 300
    assign img_alt = section.settings.featured_product.featured_image.alt | default: section.settings.featured_product.title
    assign link_url = section.settings.featured_product.url
    assign video_url = section.settings.video_url
  %}

  <style>
    .box {
      width: 74px;
      height: 210px;
      font-size: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 4px;
    }
    html {
      scroll-behavior: smooth;
    }
  </style>

  <div class="fixed top-[150px] right-2 flex flex-col bg-grey-100 z-10 p-2 opacity-80">
    <h5>UI Kit Navigation</h5>
    <a class="hover:text-primary-900" href="#colors">Colors</a>
    <a class="hover:text-primary-900" href="#typography">Typography</a>
    <a class="hover:text-primary-900" href="#standard-buttons">Standard Buttons</a>
    <a class="hover:text-primary-900" href="#split-buttons">Split Buttons</a>
    <a class="hover:text-primary-900" href="#link-buttons">Link Buttons</a>
    <a class="hover:text-primary-900" href="#input">Form Inputs</a>
    <a class="hover:text-primary-900" href="#selection-controls">Selection Controls</a>
    <a class="hover:text-primary-900" href="#breadcrumbs">Breadcrumbs</a>
    <a class="hover:text-primary-900" href="#badges">Badges</a>
    <a class="hover:text-primary-900" href="#dividers">Dividers</a>
    <a class="hover:text-primary-900" href="#icons">Icons</a>
