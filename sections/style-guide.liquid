<link rel="stylesheet" href="{{ 'style-guide.min.css' | asset_url }}" media="print" onload="this.media='all'">

<section class="style-guide page-width">
  <h1 class="h1 center" data-aos="fade-up">Style guide</h1>
  <div class="style-guide__colors">
    <h2 class="h3" data-aos="fade-up">Colors</h2>

    <div class="style-guide__colors-grid" data-aos="fade-up">
      <div class="style-guide__colors-item color-body-bg">
        <p>
          Body background <br>
        </p>
      </div>

      <div class="style-guide__colors-item color-bg-primary">
        <p>
          Background primary <br>
        </p>
      </div>

      <div class="style-guide__colors-item color-heading">
        <p>
          Text heading
        </p>
      </div>

      <div class="style-guide__colors-item color-text-primary">
        <p>
          Text body primary
        </p>
      </div>

      <div class="style-guide__colors-item color-text-secondary">
        <p>
          Text body secondary
        </p>
      </div>

      <div class="style-guide__colors-item color-text-light">
        <p>
          Text body light
        </p>
      </div>

      <div class="style-guide__colors-item color-link-text">
        <p>
          Link text
        </p>
      </div>

      <div class="style-guide__colors-item color-link-text-hover">
        <p>
          Link hover
        </p>
      </div>

      <div class="style-guide__colors-item color-error">
        <p>
          Error
        </p>
      </div>

      <div class="style-guide__colors-item color-border">
        <p>
          Border
        </p>
      </div>

      <div class="style-guide__colors-item color-accent-primary">
        <p>
          Accent 1
        </p>
      </div>

      <div class="style-guide__colors-item color-accent-secondary">
        <p>
          Accent 2
        </p>
      </div>
    </div>
  </div>

  <div class="style-guide__ctas style-guide__btns" data-aos="fade-up">
    <h4 class="center">CTAs</h4>

    <div class="style-guide__ctas-grid">
      <div class="style-guide__ctas-item">
        <a  href="#" class="btn btn--primary">Button primary</a>
        <a  href="#" class="btn btn--primary-alt">Button primary alternative</a>
        <a  href="#" class="btn btn--primary" disabled>Button primary inactive</a>
        <a  href="#" class="btn btn--secondary">Button secondary</a>
        <a  href="#" class="btn btn--secondary-alt">Button secondary alternative</a>
        <a  href="#" class="btn btn--secondary" disabled>Button secondary inactive</a>
        <a  href="#" class="btn btn--secondary btn--small">Button small</a>
        <a  href="#" class="btn btn--secondary btn--full-width">Button full width</a>
      </div>
    </div>
  </div>

  <div class="style-guide__form-wrapper">
    <div class="style-guide__ctas custom-select" data-aos="fade-up">
      <h4 class="center">Form Fields</h4>

      <div class="style-guide__ctas-grid">
        <h5 class="center">Input</h5>
        <div class="style-guide__ctas-item">
          <div class="form-field">
            <input type="email"
                   value=""
                   name="email"
                   id="RecoverEmail"
                   autocorrect="off"
                   autocapitalize="off"
                   autocomplete="email"
                   class="form-input"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="RecoverEmail-email-error"
                autofocus
              {% endif %}
                   placeholder="{{ 'customer.login_page.email' | t }}"
            >
          </div>
        </div>
      </div>

      <div class="style-guide__ctas-grid" data-aos="fade-up">
        <h4 class="center">Quantity input</h4>
        <div class="style-guide__ctas-item">
          <div class="form-field">
            <quantity-input class="quantity" data-quantity-value="1">
              <button class="quantity__button quantity__button--minus no-js-hidden" name="minus" type="button">
                <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}</span>
                {%- render 'icon' with 'minus' -%}
              </button>
              <input class="quantity__input"
                     type="number"
                     name="updates[]"
                     value="1"
                     min="1"
                     aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
              >
              <button class="quantity__button quantity__button--plus no-js-hidden" name="plus" type="button">
                <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}</span>
                {%- render 'icon' with 'plus' -%}
              </button>
            </quantity-input>
          </div>
        </div>
      </div>

    </div>

    <div class="style-guide__ctas accordions" data-aos="fade-up">
      <h4 class="center">Accordions</h4>
      <h5 class="center">Multiple opened</h5>
      <div class="style-guide__ctas-grid">
        <div class="style-guide__ctas-item">
          <div class="form-field">
            <accordion-element class="accordion">
              <div class="accordion__item">
                <button type="button"
                        aria-expanded="false"
                        class="h6 btn--reset accordion__button"
                        aria-controls="content-1"
                        id="accordion-button-1">
                  <span class="accordion-title">
                    Description
                  </span>

                  <div class="accordion__icons">
                    {% render 'icon' with 'plus-small' %}
                    {% render 'icon' with 'minus-small' %}
                  </div>

                </button>

                <div id="content-1"
                     role="region"
                     aria-labelledby="accordion-button-1"
                     class="accordion__content"
                     style="display: none">
                  <div class="accordion__content-inner">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. sed do eiusmod tempor incididunt ut labore et dolore magna aliqua
                  </div>
                </div>
              </div>
            </accordion-element>

            <accordion-element class="accordion">
              <div class="accordion__item">
                <button type="button"
                        aria-expanded="false"
                        class="h6 btn--reset accordion__button"
                        aria-controls="content-2"
                        id="accordion-button-2">
                  <span class="accordion-title">
                    Ingredients
                  </span>

                  <div class="accordion__icons">
                    {% render 'icon' with 'plus-small' %}
                    {% render 'icon' with 'minus-small' %}
                  </div>
                </button>

                <div id="content-2"
                     role="region"
                     aria-labelledby="accordion-button-2"
                     class="accordion__content"
                     style="display: none">
                  <div class="accordion__content-inner">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. sed do eiusmod tempor incididunt ut labore et dolore magna aliqua
                  </div>
                </div>

              </div>
            </accordion-element>
          </div>
        </div>
      </div>

      <h5 class="center">Single opened</h5>
      <div class="style-guide__ctas-grid">
        <div class="style-guide__ctas-item">
          <div class="form-field">
            <accordion-element class="accordion" data-accordion-group="style-guide">
              <div class="accordion__item">
                <button type="button"
                        aria-expanded="false"
                        class="h6 btn--reset accordion__button"
                        aria-controls="content-1"
                        id="accordion-button-1">
                  <span class="accordion-title">
                    Description
                  </span>

                  <div class="accordion__icons">
                    {% render 'icon' with 'plus-small' %}
                    {% render 'icon' with 'minus-small' %}
                  </div>
                </button>

                <div id="content-1"
                     role="region"
                     aria-labelledby="accordion-button-1"
                     class="accordion__content"
                     style="display: none">
                  <div class="accordion__content-inner">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. sed do eiusmod tempor incididunt ut labore et dolore magna aliqua
                  </div>
                </div>
              </div>
            </accordion-element>

            <accordion-element class="accordion" data-accordion-group="style-guide">
              <div class="accordion__item">
                <button type="button"
                        aria-expanded="false"
                        class="h6 btn--reset accordion__button"
                        aria-controls="content-2"
                        id="accordion-button-2">
                  <span class="accordion-title">
                    Ingredients
                  </span>

                  <div class="accordion__icons">
                    {% render 'icon' with 'plus-small' %}
                    {% render 'icon' with 'minus-small' %}
                  </div>
                </button>

                <div id="content-2"
                     role="region"
                     aria-labelledby="accordion-button-2"
                     class="accordion__content"
                     style="display: none">
                  <div class="accordion__content-inner">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. sed do eiusmod tempor incididunt ut labore et dolore magna aliqua
                  </div>
                </div>

              </div>
            </accordion-element>
          </div>
        </div>
      </div>
    </div>

  </div>


  <div class="style-guide__typography" data-aos="fade-up">
    <h4 class="center">
      Typography
    </h4>

    <div>
      <div class="style-guide__typography-item">
        <p class="text-body">
          <span>H1</span>
          <span>Boogy Brut Poster, White</span>
          <span>Desktop: 100px</span>
          <span>Mobile: 60px</span>
          <span>Tag/class name: h1, .h1</span>
        </p>

        <div>
          <h1><span>Desktop:</span> Boogy Brut Poster</h1>
          <h1 class="mobile"><span>Mobile:</span> Boogy Brut Poster</h1>
        </div>
      </div>

      <div class="style-guide__typography-item">
