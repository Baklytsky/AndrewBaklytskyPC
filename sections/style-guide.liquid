          <h4 class="mobile"><span>Mobile:</span> Styrene B</h4>
          <h4 class="h4--italic"><span>Italic:</span> Styrene B</h4>
        </div>
      </div>

      <div class="style-guide__typography-item">
        <p class="text-body">
          <span>H5</span>
