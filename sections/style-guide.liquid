          <span>Desktop: 24px</span>
          <span>Mobile: 22px</span>
          <span>Tag/class name: h5, .h5</span>
        </p>

        <div>
          <h5><span>Desktop:</span> Styrene B</h5>
          <h5 class="mobile"><span>Mobile:</span> Styrene B</h5>
        </div>
      </div>

      <div class="style-guide__typography-item">
        <p class="text-body">
          <span>H6</span>
          <span>Styrene B, Medium</span>
          <span>Desktop: 12px</span>
          <span>Mobile: 12px</span>
          <span>Tag/class name: h6, .h6</span>
        </p>

        <div>
          <h6><span>Desktop:</span> Styrene B</h6>
          <h6 class="mobile"><span>Mobile:</span> Styrene B</h6>
        </div>
      </div>

      <div class="style-guide__typography-item">
        <p class="text-body">
          <span>.h7</span>
          <span>Styrene B, Regular</span>
          <span>Desktop: 42px</span>
          <span>Mobile: 34px</span>
          <span>Class name: .h7</span>
        </p>

        <div>
          <h6 class="h7"><span>Desktop:</span> Styrene B</h6>
          <h6 class="h7 mobile"><span>Mobile:</span> Styrene B</h6>
        </div>
      </div>

      <div class="style-guide__typography-item">
        <p class="text-body">
          <span>Body 1</span>
          <span>Styrene B, Regular</span>
          <span>Desktop: 18px</span>
          <span>Mobile: 16px</span>
          <span>Tag/class name: .body1</span>
        </p>

        <div>
          <p class="body1">Clinically-proven skincare</p>
        </div>
      </div>

      <div class="style-guide__typography-item">
        <p class="text-body">
          <span>Body 2</span>
          <span>Styrene B, Regular</span>
          <span>Desktop: 16px</span>
          <span>Mobile: 16px</span>
          <span>Tag/class name: .body2</span>
        </p>

        <div>
          <p  class="body2">Clinically-proven skincare</p>
        </div>
      </div>

      <div class="style-guide__typography-item">
        <p class="text-body">
          <span>Body 3</span>
          <span>Styrene B, Regular, Medium</span>
          <span>Desktop: 14px</span>
          <span>Mobile: 14px</span>
          <span>Tag/class name: .body3, .body3--bold</span>
        </p>

        <div>
          <p  class="body3">Clinically-proven skincare</p>
          <p  class="body3--bold">Clinically-proven skincare</p>
        </div>
      </div>

      <div class="style-guide__typography-item">
        <p class="text-body">
          <span>Body 4</span>
          <span>Styrene B, Regular</span>
          <span>Desktop: 12px</span>
          <span>Mobile: 12px</span>
          <span>Tag/class name: .body4</span>
        </p>

        <div>
          <p  class="body4">Clinically-proven skincare</p>
        </div>
      </div>
    </div>
  </div>

  <div class="style-guide__icons">
    <h4 class="center">
      Base svg icons
    </h4>

    <div class="style-guide__icons-grid">
      {% render 'icon' with 'search' %}
      {% render 'icon' with 'account' %}
      {% render 'icon' with 'bag' %}
      {% render 'icon' with 'arrow-right' %}
      {% render 'icon' with 'arrow-left' %}
      {% render 'icon' with 'arrow-up' %}
      {% render 'icon' with 'arrow-down' %}
      {% render 'icon' with 'arrow-right-large' %}
      {% render 'icon' with 'arrow-left-large' %}
      {% render 'icon' with 'menu' %}
      {% render 'icon' with 'close' %}
      {% render 'icon' with 'close-small' %}
      {% render 'icon' with 'gift' %}
      {% render 'icon' with 'heart' %}
      {% render 'icon' with 'filter' %}
      {% render 'icon' with 'plus' %}
      {% render 'icon' with 'minus' %}
      {% render 'icon' with 'plus-small' %}
      {% render 'icon' with 'minus-small' %}

    </div>
  </div>

</section>


{% schema %}
{
  "name": "Style guide",
  "settings": [],
  "presets": [
    {
      "name": "Style guide"
    }
