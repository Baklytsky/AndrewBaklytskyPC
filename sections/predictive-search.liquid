{%- if predictive_search.performed -%}
  <div id="predictive-search-results">
    {%- if predictive_search.resources.products.size > 0 -%} 
      <h2 id="predictive-search-products" class="predictive-search__heading h5 text-body">
        {{ 'templates.search.products' | t }}

        <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
          <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
        </svg>
      </h2>
    {%- endif -%}
    <ul id="predictive-search-results-list" class="predictive-search__results-list list-unstyled" role="listbox" aria-labelledby="predictive-search-products">
      {%- for product in predictive_search.resources.products -%}

        {%- if product.tags contains 'hidden' -%}
          {% continue %}
        {%- endif -%}

        {%- assign url = product.url -%}

        {%- if product.template_suffix == 'monogram' -%}
          {%- assign url = '/products/' | append: product.handle -%}
        {%- endif -%}

        <li id="predictive-search-option-{{ forloop.index }}" class="predictive-search__list-item" role="option" aria-selected="false">
          <a href="{{ url }}" class="predictive-search__item predictive-search__item--link link link--text" tabindex="-1">
            {%- assign image = product.metafields.custom.product_card_main_image.value | default: product.selected_or_first_available_variant.image | default: product.featured_media -%}
            {%- if image != blank -%}
              <img class="predictive-search__image"
                src="{{ image | img_url: '150x' }}"
                alt="{{ image.alt }}"
                width="50"
                height="{{ 50 | divided_by: image.preview_image.aspect_ratio }}"
              >
            {%- endif -%}
            <div class="predictive-search__item-content{% unless settings.predictive_search_show_vendor or settings.predictive_search_show_price %} predictive-search__item-content--centered{% endunless %}">
              {%- if settings.predictive_search_show_vendor -%} 
                <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span><div class="predictive-search__item-vendor caption-with-letter-spacing">{{ product.vendor }}</div>
              {%- endif -%}
              <h4 class="predictive-search__item-heading h6">{{ product.title }}</h4>
              
              {%- assign color_label = 'color,colour,couleur,colore,farbe,색,色,färg,farve' | split: ',' -%}
              {% for product_option in product.options_with_values %}
                {% assign option_name = product_option.name | handleize %}
                
                {% if color_label contains option_name %}
                  {% for value in product_option.values %}
                    {%- if forloop.index > 1 -%}
                      {%- assign only_one_thumbnail = false -%}
                      {%- break -%}
                    {%- endif -%}
                  {% endfor %}
                {% endif %}
                
                {%- unless only_one_thumbnail -%}
                {%- break -%}
                {%- endunless -%}
              {% endfor %}
              
              {%- assign product_variants = product.variants -%}
              {%- assign merge_product_handles = product.metafields.pdp.merged_products | split: '|' -%}
              {%- assign merge_product = false -%}
              
              {%- for merge_product_handle in merge_product_handles -%}
                {%- assign current_merge_product = all_products[merge_product_handle] -%}
                
                {% unless current_merge_product == empty %}
                {%- assign merge_product = true -%}
                {%- assign product_variants = product_variants | concat: current_merge_product.variants -%}
                {% endunless %}
              {%- endfor -%}
              
              {% if product.options %}
                {%- for option in product.options_with_values -%}
                  {% assign option_values = option.values %}
                  
                  {%- if merge_product -%}
                    {%- for merge_product_handle in merge_product_handles -%}
                      {%- assign current_merge_product = all_products[merge_product_handle] -%}
                      
                      {% unless current_merge_product == empty %}
                        {%- for this_option in current_merge_product.options_with_values -%}
                          {% assign this_option_name = this_option.name | handleize %}
                          
                          {% if this_option_name == option_name %}
                            {%- assign option_values = option_values | concat: this_option.values | uniq -%}
                          {% endif %}
                        {% endfor %}
                      {% endunless %}
                    {%- endfor -%}
                  {%- endif -%}
                  
                  {%- assign option_name = option.name | downcase -%}
                  
                  {%- if color_label contains option_name and option.values.size > 1 -%}
                    {%- assign option_name_multiple = option.name | append: 's' -%}
                    {%- assign option_color_selected_position = option.position | minus: 1 -%}
                    {%- assign hidden_colors = blank -%}
                    {%- assign shown_colors_count = option_values.size -%}
                    
                    {%- for variant in product_variants -%}
                      {%- if variant.metafields.custom.hide_variant.value -%}
                        {%- assign hidden_colors = hidden_colors | append: '#separator#' | append: variant.options[option_color_selected_position] -%}
                      {%- endif -%}
                    {%- endfor -%}
                    
                    {%- for value in option_values -%}
                      {%- if hidden_colors contains value -%}
                        {%- assign shown_colors_count = shown_colors_count | minus: 1 -%}
                      {%- endif -%}
                    {%- endfor -%}

										{% if shown_colors_count > 0 %}
											<p class="product-card__options--color">
												{{ shown_colors_count }} {{ shown_colors_count | pluralize: option.name, option_name_multiple }}
											</p>
										{% endif %}
                  {%- endif -%}
                {%- endfor -%}
              {% endif %}
              
              {%- if settings.predictive_search_show_price -%}
                {% render 'price', product: product, use_variant: true, show_badges: false %} 
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
      <li id="predictive-search-option-search-keywords" class="predictive-search__list-item" role="option">
        <button class="predictive-search__item predictive-search__item--term link link--text animate-arrow" tabindex="-1">
          {{ 'templates.search.search_for' | t: terms: predictive_search.terms }}
          {% render 'icon-arrow' %}
        </button>
      </li> 
    </ul>

    <div class="predictive-search__loading-state" aria-hidden="true">
      <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
        <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
      </svg>
    </div>
  </div>

  <span class="hidden" data-predictive-search-live-region-count-value>
    {%- if search.results_count == 0 -%}
      {{ 'templates.search.no_results' | t: terms: predictive_search.terms }}
    {%- else -%}
      {{ 'templates.search.results_with_count' | t: terms: predictive_search.terms, count: predictive_search.resources.products.size }}
    {%- endif -%}
  </span>
{%- endif -%}
