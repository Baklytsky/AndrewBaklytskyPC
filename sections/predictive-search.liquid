{%- if predictive_search.performed -%}
  {%- capture result_articles -%}
    {%- for article in predictive_search.resources.articles -%}
      <li id="predictive-search-option-{{ forloop.index }}" class="predictive-search__list-item" role="option" aria-selected="false">
        {% render 'article-card' blog: blog, article: article %}
      </li>
    {%- endfor -%}
  {%- endcapture -%}

  {%- capture result_products -%}
    {%- assign hidden_products = 0 -%}
    {%- for product in predictive_search.resources.products -%}

      {%- if product.tags contains 'dev_product'
        or product.tags contains 'test_product'
        or product.tags contains 'hidden'
        or product.tags contains 'not-allowed' -%}
        {%- assign hidden_products = hidden_products | plus: 1 -%}
        {% continue %}
      {%- endif -%}

      <li id="predictive-search-option-{{ forloop.index }}" class="predictive-search__list-item" role="option" aria-selected="false">
        {%- render 'product-card' product: product -%}
      </li>
    {%- endfor -%}
  {%- endcapture -%}

  <div id="predictive-search-results">
    <div class="predictive-search-results__header">
        <span class="body3--bold">
          {%- if predictive_search.resources.articles.size >= 0 -%}
            {%- assign results_count = predictive_search.resources.articles.size | default: 0 -%}
          {%- else -%}
            {%- assign results_count = predictive_search.resources.products.size | minus: hidden_products | default: 0  -%}
          {%- endif -%}

          {{ 'templates.search.results_with_count' | t: count: results_count }}
        </span>
      <button type="button" class="a btn--reset predictive-search-results__clear" data-search-clear>
        {{ 'templates.search.clear' | t }}
      </button>
    </div>

    {%- if predictive_search.resources.products.size > 0 -%}
      <ul id="predictive-search-results-list" class="predictive-search__results-list list-unstyled" role="listbox" aria-labelledby="predictive-search-products">
        {{ result_products }}

        {%- if settings.show_all_results_btn -%}
          <li id="predictive-search-option-search-keywords" class="predictive-search__list-item predictive-search__search-btn-item" role="option">
            <button type="submit" class="predictive-search__item predictive-search__item--term btn btn--secondary" tabindex="-1">
              {{ 'templates.search.search_for' | t: terms: predictive_search.terms }}
            </button>
          </li>
        {%- endif -%}

        {% render 'ga-product-list-event', event_type: 'view_item_list', product_list: predictive_search.resources.products, list_name: 'Header search', list_id: section.id %}
      </ul>
    {%- elsif predictive_search.resources.articles.size > 0 -%}
      <ul id="predictive-search-results-list" class="predictive-search__results-list list-unstyled" role="listbox" aria-labelledby="predictive-search-products">
        {{ result_articles }}
      </ul>
    {%- else -%}
      <div class="predictive-search__no-results">
        <p class="h4 no-result__heading">
          {{ 'templates.search.no_results' | t }}
          <span>"{{ predictive_search.terms }}"</span>
        </p>

        {%- if settings.search_trending != blank -%}
          <div class="body3 search-modal__trending">
            <p class="body3--bold">{{ 'general.search.trending' | t }}</p>
            {{ settings.search_trending }}
          </div>
        {%- endif -%}

        <a href="{{ settings.no_result_btn_link | default: '/' }}" class="btn btn--{{ settings.no_result_btn_style }}">{{ settings.no_result_btn_text | default: 'Shop all' }}</a>
      </div>
    {%- endif -%}

    <div class="predictive-search__loading-state" aria-hidden="true">
      {% render 'icon' with 'spinner' %}
    </div>
  </div>

  <span class="hidden" data-predictive-search-live-region-count-value="{{ results_count }}">
    {%- if predictive_search.results_count == 0 -%}
      {{ 'templates.search.no_results' | t: terms: predictive_search.terms }}
    {%- else -%}
      {{ 'templates.search.results_with_count' | t: terms: predictive_search.terms, count: results_count }}
    {%- endif -%}
  </span>

  <ga-product-list-event>
    <script type="application/ld+json">
      {
        "event": "search",
        "search": {
          "search_type": "Typed",
          "search_results_total" : "{{ results_count }}",
          "search_dropdown_selected": "",
          "search_term": "{{ predictive_search.terms }}"
        }
      }
    </script>
  </ga-product-list-event>


  <script type="application/ld+json" data-event-search>
    {
      "search_results_total": "{{ results_count }}",
      "search_term": "{{ predictive_search.terms }}"
    }
  </script>
{%- endif -%}
