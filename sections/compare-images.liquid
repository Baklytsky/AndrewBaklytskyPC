{{ 'compare-images.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-compare-images.min.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign desktop_slide_height = section.settings.desktop_slide_height
  assign mobile_slide_height = section.settings.mobile_slide_height
  assign section_bg_color = section.settings.background_color
  assign section_text_color = section.settings.text_color
  assign heading = section.settings.heading | escape | newline_to_br
  assign desktop_layout = section.settings.desktop_layout
  assign slide_counter = 0
-%}

{% style %}
  .comparison__wrapper--{{ section.id }} {
    --desktop-slide-height: {{ desktop_slide_height }};
    --mobile-slide-height: {{ mobile_slide_height }};
  }
{% endstyle %}

{%- capture slides -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'images' -%}

      {%- liquid
        assign after_image = block.settings.after_image
        assign after_video = block.settings.after_video
        assign before_image = block.settings.before_image
        assign before_video = block.settings.before_video
        assign slide_heading = block.settings.slide_heading
        assign left_align_text = block.settings.left_align_text
        assign right_align_text = block.settings.right_align_text
        assign slide_description = block.settings.slide_description
        assign slide_counter = slide_counter | plus: 1 -%}

      {%- assign has_after_element = false -%}
      {%- assign has_before_element = false -%}

      {%- if after_image != blank or after_video != blank -%}
        {%- assign has_after_element = true -%}
      {%- endif -%}

      {%- if before_image != blank or before_video != blank -%}
        {%- assign has_before_element = true -%}
      {%- endif -%}

      {%- if has_after_element or has_before_element -%}
        <div class="swiper-slide">
          <div class="comparison__slide rel">
            {%- if has_after_element and has_before_element -%}
              <compare-images class="comparison__images block rel">
                <div class="comparison__slide-image image-abs-cover">
                  {%- if after_video -%}
                    {%- render 'video',
                      video: after_video,
                      poster: after_image,
                      default_controls: false,
                      autoplay: true,
                      disable_video_scale_on_desktop: false,
                      disable_video_scale_on_mobile: false,
                      class: ''
                    -%}
                  {%- else -%}
                    {% render 'image', image: after_image, class_name: 'image-abs-cover', alt: after_image.alt %}
                  {%- endif -%}
                </div>
                <div class="comparison__slide-image image-abs-cover" data-comparison-overlay>
                  {%- if before_video -%}
                    {%- render 'video',
                      video: before_video,
                      poster: before_image,
                      default_controls: false,
                      autoplay: true,
                      disable_video_scale_on_desktop: false,
                      disable_video_scale_on_mobile: false,
                      class: ''
                    -%}
                  {%- else -%}
                    {% render 'image', image: before_image, class_name: 'image-abs-cover', alt: before_image.alt %}
                  {%- endif -%}
                </div>
                <div class="comparison__slide-divider" hidden>
                  <span class="u-sr-only">{{ 'comparison_images.divider_title' | t }}</span>
                  {%- render 'icon' with 'left-and-right-arrow' -%}
                </div>
              </compare-images>
            {%- elsif has_before_element -%}
              <div class="comparison__images block rel">
                <div class="comparison__slide-image">
                  {%- if before_video -%}
                    {%- render 'video',
                      video: before_video,
                      poster: before_image,
                      default_controls: false,
                      autoplay: true,
                      disable_video_scale_on_desktop: false,
                      disable_video_scale_on_mobile: false,
                      class: ''
                    -%}
                  {%- else -%}
                    {% render 'image', image: before_image, class_name: 'image-abs-cover', alt: before_image.alt %}
                  {%- endif -%}
                </div>
              </div>
            {%- else -%}
              <div class="comparison__images block rel">
                <div class="comparison__slide-image">
                  {%- if after_video -%}
                    {%- render 'video',
                      video: after_video,
                      poster: after_image,
                      default_controls: false,
                      autoplay: true,
                      disable_video_scale_on_desktop: false,
                      disable_video_scale_on_mobile: false,
                      class: ''
                    -%}
                  {%- else -%}
                    {% render 'image', image: after_image, class_name: 'image-abs-cover', alt: after_image.alt %}
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}

            {%- if slide_heading != blank -%}
              <h3 class="comparison__slide-heading body1">
                {{ slide_heading }}
              </h3>
            {%- endif -%}

            {%- if left_align_text != blank or right_align_text != blank -%}
              <div class="comparison__slide-compare-text">
                {%- if left_align_text != blank -%}
                  <span class="body3--bold block">{{ left_align_text }}</span>
                {%- endif -%}
                {%- if right_align_text != blank -%}
                  <span class="body3--bold right-align block">{{ right_align_text }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if slide_description != blank -%}
              <div class="comparison__slide-description body3">
                {{ slide_description }}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture content -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'text' -%}

      {%- liquid
        assign percent_value = block.settings.percent_value
        assign description = block.settings.description
      -%}

      <div class="comparison__content">
        <h6 class="comparison__content-heading h7">{{ percent_value | append: '%' }}</h6>
        {%- if description != blank -%}
          <div class="comparison__content-description body2">
            {{ description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if slides != blank -%}
  {%- capture swiper_config -%}
    {
    "slidesPerView": 1,
    "allowTouchMove": false,
    "analyticEvent": "clinical_trial_image_interaction",
    "navigation": {
      "nextEl": ".swiper-button-next--{{ section.id }}",
      "prevEl": ".swiper-button-prev--{{ section.id }}"
    },
    "pagination": {
      "el": ".swiper-pagination--{{ section.id }}",
      "type": "bullets",
      "clickable": true
      }
    }
  {%- endcapture -%}
{%- endif -%}

<div class="before-after"
     data-aos="fade-up"
     style="--bg-color: {{ section_bg_color }};
       --color: {{ section_text_color }}">

  {%- if heading != blank -%}
    <h2 class="comparison__heading page-width">
      {{ heading }}
    </h2>
  {%- endif -%}

  <div class="comparison__wrapper page-width {{ desktop_layout | handleize }} comparison__wrapper--{{ section.id }}">
    {%- if content != blank -%}
      <div class="comparison__wrapper-content {% if slides == blank %}x{% endif %}">
        {{ content }}
      </div>
    {%- endif -%}

    {%- if slides != blank -%}
      <div class="comparison__wrapper-slider {% if content == blank %}x{% endif %} {% if slide_counter == 1 %}hide-navigation{% endif %}">
        {%- render 'slideshow-swiper',
          class_name: 'comparison__slider rel',
          config: swiper_config,
          slides: slides,
          show_slider_nav: true,
          nav_id: section.id -%}
      </div>
    {%- endif -%}
  </div>
</div>


{% schema %}
{
"name": "Compare images",
"tag": "section",
"settings": [
  {
    "type": "select",
    "id": "desktop_slide_height",
    "label": "Slide height",
    "options": [
      {
        "value": "93.6%",
        "label": "1/1"
      },
      {
        "value": "56.25%",
        "label": "16/9"
      },
      {
        "value": "177%",
        "label": "9/16"
      },
      {
        "value": "125%",
        "label": "4/5"
      }
    ],
    "default": "93.6%"
  },
  {
    "type": "select",
    "id": "mobile_slide_height",
    "label": "Slide height",
    "options": [
      {
        "value": "93.6%",
        "label": "1/1"
      },
      {
        "value": "56.25%",
        "label": "16/9"
      },
      {
        "value": "177%",
        "label": "9/16"
      },
      {
        "value": "125%",
        "label": "4/5"
      }
    ],
    "default": "93.6%"
  },
  {
    "type": "color",
    "id": "background_color",
    "label": "Background color",
    "default": "#ffffff"
  },
  {
    "type": "color",
    "id": "text_color",
    "label": "Text color",
    "default": "#000000"
  },
  {
    "type": "text",
    "id": "heading",
    "label": "Heading"
  },
  {
    "type": "select",
    "id": "desktop_layout",
    "label": "Desktop layout",
    "options": [
      {
        "value": "slider-left",
        "label": "Slider left"
      },
      {
        "value": "slider-right",
        "label": "Slider right"
      }
    ],
    "default": "slider-right"
  }
],
"blocks": [
  {
    "type": "images",
    "name": "Images",
    "settings": [
      {
        "type": "text",
        "id": "slide_heading",
        "label": "Heading"
      },
      {
        "type": "image_picker",
        "id": "after_image",
        "label": "After image"
      },
      {
        "type": "video",
        "id": "after_video",
        "label": "After video",
        "info": "Has priority over the image"
      },
      {
        "type": "image_picker",
        "id": "before_image",
        "label": "Before image"
      },
      {
        "type": "video",
        "id": "before_video",
        "label": "Before video",
        "info": "Has priority over the image"
      },
      {
        "type": "text",
        "id": "left_align_text",
        "label": "Left align text"
      },
      {
        "type": "text",
        "id": "right_align_text",
        "label": "Right align text"
      },
      {
        "type": "textarea",
        "id": "slide_description",
        "label": "Description"
      }
    ]
  },
  {
    "type": "text",
    "name": "Text",
    "settings": [
      {
        "type": "range",
        "id": "percent_value",
        "label": "Percent value",
        "default": 100,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%"
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "Description"
      }
    ]
  }
],
"presets": [
  {
    "name": "Compare images"
  }
]
}
{% endschema %}
