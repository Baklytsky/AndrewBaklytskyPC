{% style %}
  #page-{{ section.id }} {
    --padding-top: {{ section.settings.top_padding }}px;
    --padding-bottom: {{ section.settings.bottom_padding }}px;
  }
  #page-{{ section.id }}.page__container {
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }
  {% if section.settings.override_background == true %}

    .page__container {
      background-color: var({{ section.settings.bg_color }});
    }

    body {
      background-color: var({{ section.settings.bg_color }});
    }
  {% endif %}
{% endstyle %}

{% if section.settings.hide_content != true %}
<div class="page__container" id="page-{{ section.id }}">
  <div class="page__title">
    <h1 class="lg:sticky
      {% if section.settings.top_padding < 140 %}
        top-[180px]
      {% else %}
        top-[var(--padding-top)]
      {% endif %}
      ">{{ page.title }}<h1>
  </div>
  <div class="page__body">
    {{ page.content }}
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "hide_content",
      "default": false,
      "label": "Hide Page Content",
      "info": "For use of section-only pages. Hides page content including title, text, and additional padding."
    },
    {
      "type": "header",
      "content": "Content padding"
    },
    {
      "type": "range",
      "id": "top_padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "bottom_padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Background Color"
    },
    {
      "type": "checkbox",
      "id": "override_background",
      "default": false,
      "label": "Override Page Background Color",
      "info": "Set background color of page to your selection below"
    },
    {
      "type": "select",
      "id": "bg_color",
      "label": "Page Background Color",
      "info": "Set the background color for the page. Override above must be checked.",
      "options": [{"label":"White","value":"--bg-primary"},{"label":"Light","value":"--bg-light"},{"label":"Dark","value":"--bg-dark"},{"label":"Black","value":"--black"},{"label":"Transparent","value":"--bg-transparent"}],
      "default": "--bg-primary"
    }
  ]
}
{% endschema %}
