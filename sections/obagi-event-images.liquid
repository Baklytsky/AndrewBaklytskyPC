{% liquid
  assign default_event_images = section.settings.default_event_images | image_url
%}

<script type="application/ld+json" data-events-info>
  {
    "defaultImage": "{{ default_event_images }}",
    "webinars": [
      {% for block in section.blocks  %}
        {% liquid
          assign id = block.settings.heading
          assign image_url = block.settings.image | image_url
          assign description = block.settings.description
        %}
          {% if id != blank %}
            {
              "id": {{ id }},
              "imageUrl": "{{ image_url | default: default_event_images }}",
              "description": "{{ description }}"
            }{% unless forloop.last%},{% endunless %}
          {% endif %}
        {% endfor %}
      ]
  }
</script>

{% schema %}
{
  "name": "Obagi events data",
  "settings": [
    {
      "type": "image_picker",
      "id": "default_event_images",
      "label": "Default event image"
    }
  ],
  "blocks": [
    {
      "name": "Event Info",
      "type": "image",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Event id"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ]
}
{% endschema %}
