{{ 'section-image-carousel.css' | asset_url | stylesheet_tag }}

{%- assign anchor_link = section.settings.anchor_link -%}
{%- assign content_position = section.settings.content_position -%}
{%- assign hide_slider_arrows_mobile = section.settings.hide_slider_arrows_mobile -%}
{%- assign show_slider_pagination = section.settings.show_slider_pagination -%}
{%- assign header_text_color = section.settings.header_text_color -%}
{%- assign desktop_top_padding = section.settings.desktop_top_padding -%}
{%- assign desktop_bottom_padding = section.settings.desktop_bottom_padding -%}
{%- assign mobile_top_padding = section.settings.mobile_top_padding -%}
{%- assign mobile_bottom_padding = section.settings.mobile_bottom_padding -%}

{%- if section.blocks.size > 0 -%}
  {%- assign tabs_str = blank -%}

  {%- for block in section.blocks -%}
    {%- if block.settings.heading != blank -%}
      {%- assign tabs_str = tabs_str | append: block.settings.heading | append: '/&&&&/'  -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if tabs_str != blank -%}
    {%- assign tabs_arr = tabs_str | split: '/&&&&/' | uniq -%}
  {%- endif -%}

  {%- if tabs_arr.size > 0 -%}
    <toggle-tabs class="image-carousel__tabs-{{ section.id }} image-carousel__tabs-wrapper" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
      <div class="page-width">
        <ul class="image-carousel__tabs-list hide-scrollbar">
          {%- for tab in tabs_arr -%}
            {%- assign id = tab | append: forloop.index -%}
            {%- assign hash = id | hmac_sha1: 'image tabs carousel' -%}
            {%- assign tab_handleize = tab | handleize -%}

            <li>
              <button class="image-carousel__tab"
                      type="button"
                      data-action="toggle-tab"
                      aria-controls="tab-{{ hash }}"
                      data-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                      style="
                        {%- if header_text_color != blank -%}
                        --color-text: {{ header_text_color.red }}, {{ header_text_color.green }}, {{ header_text_color.blue }};
                        {%- endif -%}
                        ">
                {{ tab }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      {%- for tab in tabs_arr -%}
        {%- assign id = tab | append: forloop.index -%}
        {%- assign hash = id | hmac_sha1: 'image tabs carousel' -%}
        {%- assign tab_handleize = tab | handleize -%}

          {% capture config %}
            {
              "slidesPerView": 1.15,
              "spaceBetween": 24,
              "watchOverflow": true,
              "navigation": {
                "nextEl": ".next-{{ section.id }}-{{ tab_handleize }}",
                "prevEl": ".prev-{{ section.id }}-{{ tab_handleize }}"
              },
              "pagination": {
                "el": ".swiper-pagination-{{ section.id }}-{{ tab_handleize }}",
                "type": "progressbar"
              },
              "breakpoints": {
                "1980": {
                  "slidesPerView": 2.5,
                  "spaceBetween": 36
                },
                "1200": {
                  "slidesPerView": 3,
                  "spaceBetween": 36
                },
                "900": {
                  "shortSwipes": false,
                  "slidesPerView": 1.5,
                  "spaceBetween": 24
                }
              }
            }
          {% endcapture %}

          <slideshow-swiper
                  id="tab-{{ hash }}"
                  class="image-carousel image-carousel__with-tabs rel"
                  data-config='{{ config }}'
                  {% if section.settings.show_slider_arrows %}data-arrows-appear="true"{% endif %}
                  data-tab="tab-{{ hash }}"
                  data-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  {{ block.shopify_attributes }}>

            <div class="swiper page-width rel">
              <ul class="image-carousel__list swiper-wrapper" role="list">
                {%- for block in section.blocks -%}
                  {%- assign block_tab_handleize = block.settings.heading | handleize -%}

                  {%- if block_tab_handleize == tab_handleize -%}
                    {%- liquid
                      assign card_url = block.settings.card_url
                      assign image = block.settings.image
                      assign image_overlay_opacity = block.settings.image_overlay_opacity
                      assign subheading = block.settings.subheading
                      assign heading = block.settings.title
                      assign text_color = block.settings.text_color
                      assign img_alt = image.alt | default: heading
                      assign link_description = heading | default: subheading | default: image.alt | default: forloop.index
                    -%}
                    {%- if image != blank or heading != blank or subheading != blank -%}
                      <li class="image-carousel__list-item swiper-slide rel" role="listitem">
                        <a {% if card_url != blank %} href="{{ card_url }}"{% else %} role="link" aria-disabled="true" {% endif %}
                                class="image-carousel__list-item-wrapper rel">

                          {%- if image != blank -%}
                            {% render 'image', image: image, class_name: 'image-abs-cover' %}
                          {%- endif -%}

                          {%- if content_position == 'inside' -%}
                            {%- if subheading != blank or heading != blank -%}
                              <div class="image-carousel__list-item-content z1" style="color: {{ text_color }}">
                                {%- if subheading != blank -%}
                                  <p class="image-carousel__subheading">{{ subheading }}</p>
                                {%- endif -%}
                                {%- if heading != blank -%}
                                  <h3 class="image-carousel__heading h5">{{ heading }}</h3>
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                          {%- endif -%}
                          <span class="u-sr-only">{{ link_description }}</span>
                        </a>

                        {%- if content_position == 'below' -%}
                          {%- if subheading != blank or heading != blank -%}
                            <div class="image-carousel__list-item-content-below" style="color: {{ text_color }}">
                              {%- if heading != blank -%}
                                <h3 class="image-carousel__heading h6">
                                  {%- if card_url != blank -%}
                                    <a href="{{ card_url }}">{{ heading }}</a>
                                  {%- else -%}
                                    {{ heading }}
                                  {%- endif -%}
                                </h3>
                              {%- endif -%}
                              {%- if subheading != blank -%}
                                <p class="image-carousel__subheading">{{ subheading }}</p>
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                        {%- endif -%}
                      </li>
                    {%- endif -%}

                  {%- endif -%}
                {%- endfor -%}
              </ul>
              <div class="swiper-pagination swiper-pagination-{{ section.id }}-{{ tab_handleize }} small-up-hide {% unless show_slider_pagination %}hidden{% endunless %}"></div>
            </div>
            {%- if section.settings.show_slider_arrows -%}
              <div class="swiper-button-next next-{{ section.id }}-{{ tab_handleize }} {% if hide_slider_arrows_mobile %}small-hide{% endif %}"></div>
              <div class="swiper-button-prev prev-{{ section.id }}-{{ tab_handleize }} {% if hide_slider_arrows_mobile %}small-hide{% endif %}"></div>
            {%- endif -%}
          </slideshow-swiper>
        
      {%- endfor -%}
    </toggle-tabs>

  {%- endif -%}
{%- endif -%}

<style>
  .image-carousel__tabs-{{ section.id }} {
    padding: {{ mobile_top_padding }}px 0 {{ mobile_bottom_padding }}px;
  }

  @media screen and (min-width: 990px) {
    .image-carousel__tabs-{{ section.id }} {
      padding: {{ desktop_top_padding }}px 0 {{ desktop_bottom_padding }}px;
      background-color: {{ section.settings.section_bg }};
    }
  }
</style>

{% schema %}
{
  "name": "Image carousel with tabs",
  "tag": "section",
  "class": "section-image-carousel",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section desktop background color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Image content position",
      "options": [
        {
          "value": "inside",
          "label": "Inside"
        },
        {
          "value": "below",
          "label": "Below"
        }
      ],
      "default": "inside"
    },
    {
      "type": "color",
      "id": "header_text_color",
      "label": "Header text color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "show_slider_arrows",
      "default": true,
      "label": "Show slider arrows"
    },
    {
      "type": "checkbox",
      "id": "hide_slider_arrows_mobile",
      "default": true,
      "label": "Hide slider arrows (mobile)"
    },
    {
      "type": "checkbox",
      "id": "show_slider_pagination",
      "default": false,
      "label": "Show slider pagination (mobile)"
    },
    {
      "type": "header",
      "content": "Paddings:"
    },
    {
      "type": "range",
      "id": "desktop_top_padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Top padding (Desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "desktop_bottom_padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Bottom padding (Desktop)",
      "default": 140
    },
    {
      "type": "range",
      "id": "mobile_top_padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Top padding (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_bottom_padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Bottom padding (Mobile)",
      "default": 60
    }
  ],
  "blocks": [
      {
        "type": "image_block",
        "name": "Image block",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Tab name"
          },
          {
            "type": "url",
            "id": "card_url",
            "label": "Card link"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "image"
          },
          {
            "type": "range",
            "id": "image_overlay_opacity",
            "min": 0,
            "max": 100,
            "step": 10,
            "unit": "%",
            "label": "Image overlay opacity",
            "default": 0
          },
          {
            "type": "text",
            "id": "subheading",
            "label": "Subheading"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Heading"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text color",
            "default": "#000000"
          }
        ]
      }
    ],
  "presets": [
    {
      "name": "Image carousel with tabs"
    }
  ]
}
{% endschema %}
