{{ 'refersion-form.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'refersion-form.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-custom-select.min.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading = section.settings.heading
  assign bottom_text = section.settings.bottom_text
  assign info_label_1 = section.settings.info_label_1
  assign info_text_1 = section.settings.info_text_1 | newline_to_br
  assign info_label_2 = section.settings.info_label_2
  assign info_text_2 = section.settings.info_text_2 | newline_to_br
  assign klaviyo_list_id = section.settings.klaviyo_list_id
  assign error_message = section.settings.error_message
  assign success_message = section.settings.success_message
  assign is_subscribed = section.settings.is_subscribed -%}

<refersion-form class="refersion-form">
  <div class="page-width refersion-form__inner">
    <div class="refersion-form__wrapper">
      {%- if heading != blank -%}
        <h2 class="body1 refersion-form__heading">{{ heading }}</h2>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        {%- render 'custom-form',
          action: '#'
          blocks: section.blocks,
          id: 'refersion-form',
          class: 'refersion-form__form',
          bottom_text: bottom_text,
          error_message: error_message,
          success_message: success_message,
          is_subscribed: is_subscribed -%}
      {%- endif -%}
    </div>
    <div class="refersion-form__info">
      {%- assign counter = 0 -%}
      {%- for i in (1..3) -%}
        {%- liquid
          assign title_key = 'info_label_' | append: i
          assign image_key = 'info_image_' | append: i
          assign text_key = 'info_text_' | append: i
          assign title = section.settings[title_key]
          assign image = section.settings[image_key]
          assign text = section.settings[text_key] -%}

        {%- if title != blank -%}
          {%- assign counter = counter | plus: 1 -%}
          <accordion-element class="accordion" data-accordion-group="refersion-form">
            <div class="accordion__item">
              <button type="button"
                      aria-expanded="{% if counter == 1 %}true{% else %}false{% endif %}"
                      class="h6 btn--reset accordion__button"
                      aria-controls="content-{{ i }}"
                      id="accordion-button-{{ i }}">
                  <span class="accordion-title">
                    {{ title }}
                  </span>

                <span class="accordion__icons">
                  {% render 'icon' with 'plus-small' %}
                  {% render 'icon' with 'minus-small' %}
                </span>
              </button>

              <div id="content-{{ i }}"
                   role="region"
                   aria-labelledby="accordion-button-{{ i }}"
                   class="accordion__content"
                   style="display: {% if counter == 1 %}block{% else %}none{% endif %}">
                <div class="accordion__content-inner">
                  {%- if image -%}
                    {% render 'image', image: image, alt: image.alt, no_leazy: true %}
                  {%- endif -%}
                  {%- if text != blank -%}
                    {{ text }}
                  {%- endif -%}
                </div>
              </div>
            </div>
          </accordion-element>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <style>
    refersion-form [data-country-select] [data-custom-select] li:first-child,
    refersion-form [data-country-select] [data-original-select] option:first-child {
      display: none;
    }
  </style>
</refersion-form>

