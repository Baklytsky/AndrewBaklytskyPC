{%- if section.blocks.size > 0 -%}
  {{ 'section-text-list.css' | asset_url | stylesheet_tag }}

	{%- assign anchor_link = section.settings.anchor_link -%}
  {%- assign bg_color = section.settings.bg_color -%}
  {%- assign text_color = section.settings.text_color -%}
  {%- assign heading = section.settings.heading -%}
  {%- assign item_text_desktop = section.settings.item_text_desktop -%}
  {%- assign item_text_mobile = section.settings.item_text_mobile -%}
  
  <div class="text-list {% if section.settings.color_theme == 'black' %}landing-colors{% endif %}"
       style="background-color: {{ bg_color }}; text-color: {{ text_color }};"
			 {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}
  >
    <div class="page-width text-list__wrapper">
      {%- if heading != blank -%}
        <h2 class="text-list__heading">{{ heading }}</h2>
      {%- endif -%}
    
      <ul class="text-list__list">
        {%- for block in section.blocks -%}
          {%- assign heading = block.settings.heading -%}
          {%- assign text = block.settings.item_text -%}
      
          {%- if heading != blank or text != blank  -%}
            <li class="text-list__item">
              {% if heading != blank %}
                <h4 class="text-list__item-heading">{{ heading }}</h4>
              {% endif %}
          
              {% if text != blank %}
                <p class="text-list__item-text"
                   style="
                     --item-text-desktop: var({{ item_text_desktop }});
                     --item-text-mobile: var({{ item_text_mobile }});
                     ">
                  {{ text }}</p>
              {% endif %}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}


{% schema %}
{
  "name": "Text list",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "select",
      "id": "color_theme",
      "label": "Color theme",
      "options": [
        {
          "value": "black",
          "label": "Black"
        },
        {
          "value": "white",
          "label": "White"
        }
      ],
      "default": "black"
    },
    {
      "type": "select",
      "id": "item_text_desktop",
      "label": "'Item text' size desktop",
      "options": [
        {
          "value": "--font-size-small",
          "label": "Small"
        },
        {
          "value": "--font-size-base",
          "label": "Base"
        },
        {
          "value": "--font-size-text",
          "label": "Large"
        }
      ],
      "default": "--font-size-text"
    },
    {
      "type": "select",
      "id": "item_text_mobile",
      "label": "'Item text' size mobile",
      "options": [
        {
          "value": "--font-size-small",
          "label": "Small"
        },
        {
          "value": "--font-size-base",
          "label": "Base"
        },
        {
          "value": "--font-size-text",
          "label": "Large"
        }
      ],
      "default": "--font-size-base"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "item_text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text list"
    }
  ]
}
{% endschema %}
