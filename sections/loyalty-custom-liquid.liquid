{%- liquid
	assign anchor_link = section.settings.anchor_link
  assign heading = section.settings.heading
  assign heading_type = section.settings.heading_type
  assign text = section.settings.text
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign blocks = section.blocks

  assign has_rules_block = false
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
  padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
  #shopify-section-{{ section.id }} {
  padding-top: {{ padding_top }}px;
  padding-bottom: {{ padding_bottom }}px;
  }
  }
{%- endstyle -%}

<div class="page-width rel overflow-hidden center" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
  {%- for block in blocks -%}
    {%- case block.type -%}
      {%- when 'heading' -%}
        {%- liquid
          assign heading = block.settings.heading
          assign not_signed_attr = block.settings.not_signed_attr
        -%}

        {%- if heading != blank -%}
          <h2 class="loyalty-heading {{ heading_type }}"
            {% unless customer %}
              {{ not_signed_attr }}
            {% endunless %}>{{ heading }}</h2>
        {%- endif -%}
      {%- when 'text' -%}
        {%- liquid
          assign text = block.settings.text
        -%}

        {%- if text != blank -%}
          <div class="loyalty-text">{{ text }}</div>
        {%- endif -%}
      {%- when 'liquid' -%}
        {%- if block.settings.custom_liquid != blank -%}
          <div>
            {{ block.settings.custom_liquid }}

            {%- if block.settings.custom_liquid contains 'data-lion-rules-list' -%}
              {%- assign has_rules_block = true -%}

              {%- if customer == blank -%}
                <a href="#" class="loyalty-invisible-background-link" data-lion-refer></a>

                <style>
                  .lion-rule-item {
                    cursor: pointer;
                  }
                </style>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- when 'link' -%}
        {%- liquid
          assign label = block.settings.label
          assign url = block.settings.url
          assign attributes = block.settings.attributes
          assign link_style = block.settings.link_style
          assign not_signed_attr = block.settings.not_signed_attr
        -%}

        <div class="loyalty-heading">
          <a href="{{ url }}"
             class="{{ link_style }}"
            {% unless customer %}
              {{ not_signed_attr }}
            {% endunless %}
            {{ attributes }}>{{ label }}</a>
        </div>
    {%- endcase -%}
  {%- endfor -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    const searchParams = new URLSearchParams(window.location.search);

    document.addEventListener('click', function(event) {
      if (event.target.classList.contains('lion-rule-item') || event.target.closest('.lion-rule-item')) {
        const invisiblePopupLink = event.target.closest('section').querySelector('[data-lion-refer]')
        if (invisiblePopupLink) invisiblePopupLink.click();
      }
    });

    {% if has_rules_block and customer %}
      function itemContentReplace(item) {
        const isCompleted = item.classList.contains('lion-rule-item--completed-forever');
        const isTemporaryComplete = item.querySelector('.lion-action-button--disabled');
        const itemActions = item.querySelector('.lion-rule-item__actions');

        if (isTemporaryComplete)  item.classList.add('lion-rule-item--completed-forever');

        if (!isCompleted && !isTemporaryComplete) {
          if (item.classList.contains('lion-rule-item--purchase')) {
            const blockLink = document.createElement('a');
            blockLink.classList.add('lion-action-button', 'lion-action-button--tile');
            blockLink.href = 'https://truelinkswear.com/collections/shop-all';
            blockLink.target = '_blank';
            blockLink.innerHTML = 'Shop Now';

            if (itemActions)  itemActions.prepend(blockLink);
          } else if (item.classList.contains('lion-rule-item--attentive_sms')) {
            const blockLink = document.createElement('a');
            blockLink.classList.add('lion-action-button', 'lion-action-button--tile');
            blockLink.href = 'https://truelinkswear.com/pages/get-notified-text';
            blockLink.target = '_blank';
            blockLink.innerHTML = 'Sign Up Now';

            if (itemActions)  itemActions.prepend(blockLink);
          } else if (item.classList.contains('lion-rule-item--referral')) {
            item.querySelector('.lion-action-button').innerHTML = 'Refer Now';
          }  else if (item.classList.contains('lion-rule-item--instagram-follow')) {
            item.querySelector('.lion-action-button').innerHTML = 'Follow Now';
          } else if (item.classList.contains('lion-rule-item--youtube_subscribe')) {
            /*
            YOUTUBE API W/ AUTH
            const ytAuthLink = document.createElement('a');
            ytAuthLink.classList.add('lion-action-button', 'lion-action-button--tile');
            ytAuthLink.href = 'https://accounts.google.com/o/oauth2/auth' +
                '?scope=https://www.googleapis.com/auth/youtube.force-ssl' +
                '&access_type=offline' +
                '&include_granted_scopes=true' +
                '&redirect_uri=https://truelinkswear.com/pages/loyalty/' +
                '&response_type=code' +
                '&client_id=567940505181-u6d2587irunej11a0v2koq3hus29skas';
            ytAuthLink.target = '_blank';
            ytAuthLink.innerHTML = 'Subscribe Now';

            if (itemActions)  itemActions.prepend(ytAuthLink);
            */

            // ON CLICK
            const blockLink = document.createElement('a');
            blockLink.classList.add('lion-action-button', 'lion-action-button--tile');
            blockLink.href = 'https://www.youtube.com/@truelinkswear9874?sub_confirmation=1';
            blockLink.target = '_blank';
            blockLink.innerHTML = 'Subscribe Now';
            if (blockLink)  itemActions.prepend(blockLink);

            blockLink.addEventListener('click', function(event) {
              fetch('https://j12plruu5l.execute-api.us-east-1.amazonaws.com/truelinkswear/loyalty', {
                method: 'POST',
                body: JSON.stringify({
                  name: 'youtube_subscribe',
                  customer_email: {{ customer.email | json }},
                  customer_id: "{{ customer.id | json }}"
                })
              }).then(response => response.json())
                  .then(response => {
                    console.log(response)
                  })
                  .catch(err => {
                    console.log(err)
                  })
            })
          }
        } else if (item.classList.contains('lion-rule-item--custom') && item.classList.contains('lion-rule-item--completed-forever')) {
          console.log(item);
          item.querySelector('.lion-rule-item__actions').innerHTML = getCompleteButton();
        }
      }

      loyaltylion.on('ready', () => {
        const rulesListContainer = section.querySelector('[data-lion-rules-list]');

        const observer = new MutationObserver(function(mutations, observer) {
          let flag = false;

          for (const mutation of mutations) {
            if (mutation.type === 'childList') {
              function itemObserverFunction(mutations, observer) {
                for (const mutation of mutations) {
                  if (mutation.type === 'childList') {
                    if (flag) return;

                    setTimeout(() => {
                      Array.from(mutation.target.closest('[data-lion-rules-list]').querySelectorAll('.lion-rule-item')).forEach((item, index) => {
                        itemContentReplace(item);
                      });
                    }, 100)

                    flag = true;
                  }
                }
              }

              const rulesList = mutation.target.closest('[data-lion-rules-list]').querySelector('.lion-rules-list');
              const blockItems = Array.from(rulesList.querySelectorAll('.lion-rule-item'));
              const hasNewsletterBlock = blockItems.some(item => item.classList.contains('lion-rule-item--newsletter-signup'));

              if (!hasNewsletterBlock)  rulesList.insertBefore(getNewsletterBlock(), blockItems[Math.floor(blockItems.length / 2)]);

              Array.from(rulesListContainer.querySelectorAll('.lion-rule-item')).forEach((item, index) => {
                itemContentReplace(item);
              });

              const itemObserver = new MutationObserver(itemObserverFunction);

              Array.from(rulesListContainer.querySelectorAll('.lion-rule-item')).forEach((item, index) => {
                itemObserver.observe(item, { childList: true, characterData: true, subtree: true });
              });
            }
          }

          observer.disconnect();
        });

        observer.observe(rulesListContainer, { childList: true, characterData: true, subtree: true });
      });

      function getNewsletterBlock() {
        const div = document.createElement('div');
        div.setAttribute('data-rule-id', '184608');
        div.classList.add('lion-rule-item', 'lion-rule-item--newsletter-signup', 'lion-rule-item--184608', 'lion-rule-item--$newsletter_signup', 'lion-rule-item--style-1', 'lion-rule-item--completed-forever', 'lion-rule-item--actionable', 'lion-rule-item--authenticated');
        div.innerHTML = `<div class="lion-rule-item__content"><div class="lion-rule-item__icon-wrap"><div class="lion-rule-item__icon lion-icon lion-icon__rule lion-icon__rule--newsletter-signup"></div></div><div class="lion-rule-item__title">Sign up to our mailing list</div><div class="lion-rule-item__points"><span data-i18n-key="ui.general.points_count"><span class="value">500</span> <span class="text">points</span></span></div><div class="lion-rule-item__actions"><button class="lion-action-button lion-action-button--tile lion-action-button--disabled lion-action-button--completed" data-testid="rule-item-button"><span class="lion-rule-item__completed" data-i18n-key="ui.general.completed">Completed</span></button></div></div>`;
        return div;
      }

      function getCompleteButton() {
        return `
          <button class="lion-action-button lion-action-button--tile lion-action-button--disabled lion-action-button--completed" data-testid="rule-item-button"><span class="lion-rule-item__completed" data-i18n-key="ui.general.completed">Completed</span></button>
        `;
      }

      {%- comment -%}
        <!-- YOUTUBE API -->
        if (searchParams.get('code') && searchParams.get('scope')) {
          localStorage.setItem('ytAuthCode', searchParams.get('code'));
          window.location.href = 'https://www.youtube.com/channel/UCN8cd_apHnAsERmoIIeX3Og?sub_confirmation=1';
          // window.location.href = 'https://www.youtube.com/@truelinkswear9874?sub_confirmation=1';
        }

        function getYTCodePromise(code, scope = null) {
          const authData = { auth: { code, scope } };
          if (localStorage.getItem('refresh_token')) {
            authData.auth.refresh_token = localStorage.getItem('refresh_token');
          }

          return fetch('https://neyxknm8wl.execute-api.us-east-1.amazonaws.com/truelinkswear/loyalty/youtube_auth', {
            method: 'POST',
            body: JSON.stringify(authData)
          });
        }

        function onTabVisible() {
          if (!localStorage.getItem('ytAuthCode') || document.hidden) return;

          getYTCodePromise(localStorage.getItem('ytAuthCode'))
              .then(response => response.json())
              .then(response => {
                const responseJSON = JSON.parse(response);
                const { access_token, refresh_token } = responseJSON;
                const data = {access_token}

                if (refresh_token) {
                  localStorage.setItem('refresh_token', refresh_token);
                  data['refresh_token'] = refresh_token;
                }

                localStorage.removeItem('ytAuthCode');

                fetch('https://neyxknm8wl.execute-api.us-east-1.amazonaws.com/truelinkswear/loyalty/youtube_auth', {
                  method: 'POST',
                  body: JSON.stringify({ getUser: data }),
                  // mode: 'no-cors'
                }).then(response => response.json())
                    .then(response => {
                      if (!response.body.items || !response.body.items.length)  return;

                      fetch('https://j12plruu5l.execute-api.us-east-1.amazonaws.com/truelinkswear/loyalty', {
                        method: 'POST',
                        body: JSON.stringify({
                          name: 'youtube_subscribe',
                          customer_email: {{ customer.email | json }},
                          customer_id: {{ customer.id | json }}
                        })
                      }).then(response => response.json())
                          .then(response => {
                            console.log(response);
                            history.pushState('', '', `${window.location.pathname}`);
                            window.removeTrapFocus('visibilitychange', onTabVisible);
                          })
                          .catch(err => {
                            console.log(err)
                          })
                    }).catch(err => {
                  // console.log(err)
                })
              }).catch(err => {
            console.log(err)
          })
        }

        window.addEventListener('visibilitychange', onTabVisible);
      {%- endcomment -%}
    {% endif %}
  });
</script>

{% schema %}
{
  "name": "Loyalty liquid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_type",
      "label": "Heading type",
      "default": "h5",
      "options": [
        {
          "label": "H3",
          "value": "h3"
        },
        {
          "label": "H4",
          "value": "h4"
        },
        {
          "label": "H5",
          "value": "h5"
        },
        {
          "label": "H6",
          "value": "h6"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:sections.custom-liquid.settings.custom_liquid.label",
      "info": "t:sections.custom-liquid.settings.custom_liquid.info"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "header",
          "content": "Customer setup"
        },
        {
          "type": "text",
          "id": "not_signed_attr",
          "label": "Not signed user attributes",
          "default": "data-lion-refer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "liquid",
      "name": "Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:sections.custom-liquid.settings.custom_liquid.label",
          "info": "t:sections.custom-liquid.settings.custom_liquid.info"
        }
      ]
    },
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        },
        {
          "type": "text",
          "id": "attributes",
          "label": "Attributes (optional)"
        },
        {
          "type": "select",
          "id": "link_style",
          "label": "Link style",
          "default": "h5",
          "options": [
            {
              "label": "H1",
              "value": "h1"
            },
            {
              "label": "H2",
              "value": "h2"
            },
            {
              "label": "H3",
              "value": "h3"
            },
            {
              "label": "H4",
              "value": "h4"
            },
            {
              "label": "H5",
              "value": "h5"
            },
            {
              "label": "H6",
              "value": "h6"
            }
          ]
        },
        {
          "type": "header",
          "content": "Customer setup"
        },
        {
          "type": "text",
          "id": "not_signed_attr",
          "label": "Not signed user attributes",
          "default": "data-lion-refer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Loyalty liquid"
    }
  ],
  "templates": ["page"]
}
{% endschema %}
