{{ 'customer.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'customer.min.js' | asset_url }}" defer="defer"></script>

{%- assign image = section.settings.image -%}

<customer-form class="recover-form__wrapper reset-form__wrapper">
  <div class="recover-form__content">
    <div class="recover-form__content-inner">
      <h1 class="h4 recover-form__heading">
        {{ 'customer.reset_password.title' | t }}
      </h1>
      {%- form 'reset_customer_password', data-form-name: "Reset password" -%}
        <div class="form-field">
          <input
            type="password"
            name="customer[password]"
            id="password"
            autocomplete="new-password"
            {% if form.errors contains 'password' %}
              aria-invalid="true"
              aria-describedby="password-error"
            {% endif %}
            placeholder="{{ 'customer.reset_password.password' | t }}"
            class="form-input"
            required
          >
          <label for="password" class="visually-hidden">
            {{ 'customer.reset_password.password' | t }}
          </label>
        </div>

        <div class="form-field">
          <input
            type="password"
            name="customer[password_confirmation]"
            id="password_confirmation"
            autocomplete="new-password"
            {% if form.errors contains 'password_confirmation' %}
              aria-invalid="true"
              aria-describedby="password_confirmation-error"
            {% endif %}
            placeholder="{{ 'customer.reset_password.password_confirm' | t }}"
            class="form-input"
            required
          >
          <label for="password_confirmation" class="visually-hidden">
            {{ 'customer.reset_password.password_confirm' | t }}
          </label>
        </div>

        <button type="submit" class="btn btn--primary-alt">
          {{ 'customer.reset_password.submit' | t }}
        </button>

        <p class="body3 form-error form-error--password hide">{{ "form_errors.password_confirm" | t }}</p>
        <p class="body3 form-error form-error--password-valid hide">{{ "form_errors.password" | t }}</p>
        {%- if form.errors -%}
        <script>
          window.dataLayer.push({
            'event': 'form_error',
            'form': {
              'form_name': 'Reset password',
              'form_validation_errors': '',
              'error_message': ''
            }
          });
        </script>
          <p class="body3 form-error default-errors">
            {%- for field in form.errors -%}
              {%- if form.errors contains 'password_confirmation' -%}
                {{ "form_errors.password_confirm" | t }}
              {%- elsif field == 'password' -%}
                {{ form.errors.translated_fields['password'] | capitalize }} {{ form.errors.messages['password'] }}
              {%- elsif field == 'form' -%}
                {{ form.errors.messages[field] }}
              {%- else -%}
                {{ form.errors.translated_fields[field] | capitalize }}
                {{ form.errors.messages[field] }}
              {%- endif -%}
          {%- endfor -%}
          </p>
        {%- endif -%}

        <p class="body3 recover-form__pass-text">
          {{ 'customer.recover_password.passwords_validation_text' | t }}
        </p>

      {%- endform -%}
    </div>
  </div>

  {%- if image != blank -%}
    <div class="recover-form__image">
      {% render 'image', image: image, class_name: '', preload: true %}
    </div>
  {%- endif -%}
</customer-form>

{% schema %}
{
  "name": "t:sections.main-reset-password.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ]
}
{% endschema %}
