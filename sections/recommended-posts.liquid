{{ 'recommended-posts.min.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
  assign section_bg_color = section.settings.section_bg_color | default: '#FFFFFF'
  assign heading = section.settings.heading
-%}

{%- if section.blocks.size > 0 -%}
  <div class="recommended-posts"
       data-aos="fade-up"
       style="
         --bg-color: {{ section_bg_color }};
         --padding-top-desktop:{{ padding_top_desktop -}}px;
         --padding-bottom-desktop:{{ padding_bottom_desktop -}}px;
         --padding-top-mobile:{{ padding_top_mobile -}}px;
         --padding-bottom-mobile:{{ padding_bottom_mobile -}}px;
         ">
    <div class="page-width">
      {%- if heading -%}
        <h3 class="recommended-posts__heading">{{ heading }}</h3>
      {%- endif -%}

      <div class="recommended-posts__wrapper">
        {%- for block in section.blocks -%}
          {%- assign article = block.settings.article -%}

          {% render 'article-card' article: article, description_truncate: 80, show_date: true %}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Recommended posts",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding top desktop",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding bottom desktop",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding top mobile",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding bottom mobile",
      "default": 20
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Post",
      "limit": 6,
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article"
        }
       ]
    }
  ],
  "presets": [
    {
      "name": "Recommended posts"
    }
  ]
}
{% endschema %}
