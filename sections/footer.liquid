{%- render 'footer', section: section, pro: false -%}

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Background color",
      "default": "#F9F9F9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#383838"
    }
  ],
  "blocks": [
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "newsletter_heading",
          "label": "Heading",
          "default": "Stay up to date with Obagi"
        },
        {
          "type": "richtext",
          "id": "newsletter_description",
          "label": "Description"
        },
        {
          "type": "header",
          "content": "Klaviyo configuration"
        },
        {
          "type": "checkbox",
          "id": "marketing_enable",
          "label": "Enable marketing opt-in",
          "default": true
        },
        {
          "type": "text",
          "id": "klaviyo_list_id",
          "label": "Klaviyo list ID"
        },
        {
          "type": "textarea",
          "id": "success_message",
          "label": "Success message",
          "default": "Keep an eye on your inbox!"
        },
        {
          "type": "textarea",
          "id": "is_subscribed",
          "label": "Is subscribed message",
          "default": "You have already subscribed!"
        },
        {
          "type": "textarea",
          "id": "error_message",
          "label": "Error message",
          "default": "Something went wrong. Try again later."
        }
      ]
    },
    {
      "type": "social",
      "name": "Social",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "instagram_hashtag",
          "label": "Instagram hashtag"
        },
        {
          "type": "checkbox",
          "id": "open_new_page",
          "label": "Instagram hashtag open link in new page"
        },
        {
          "type": "image_picker",
          "id": "instagram_image_1",
          "label": "Instagram image 1"
        },
        {
          "type": "url",
          "id": "instagram_image_link_1",
          "label": "Instagram image link 1"
        },
        {
          "type": "image_picker",
          "id": "instagram_image_2",
          "label": "Instagram image 2"
        },
        {
          "type": "url",
          "id": "instagram_image_link_2",
          "label": "Instagram image link 2"
        },
        {
          "type": "image_picker",
          "id": "instagram_image_3",
          "label": "Instagram image 3"
        },
        {
          "type": "url",
          "id": "instagram_image_link_3",
          "label": "Instagram image link 3"
        },
        {
          "type": "image_picker",
          "id": "instagram_image_4",
          "label": "Instagram image 4"
        },
        {
          "type": "url",
          "id": "instagram_image_link_4",
          "label": "Instagram image link 4"
        },
        {
          "type": "image_picker",
          "id": "mobile_instagram_image",
          "label": "Mobile instagram image"
        },
        {
          "type": "url",
          "id": "mobile_instagram_image_link",
          "label": "Mobile instagram image link"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "limit": 1,
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "Menu"
        },
        {
          "type": "select",
          "id": "mobile_menu_layout",
          "label": "Mobile menu layout",
          "options": [
            {
              "value": "accordion",
              "label": "Accordion"
            },
            {
              "value": "grid",
              "label": "Grid"
            }
          ],
          "default": "accordion"
        }
      ]
    },
    {
      "type": "logo-and-copyright",
      "name": "Logo & Copyright",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 50,
          "max": 250,
          "step": 10,
          "default": 110,
          "unit": "px",
          "label": "Logo width"
        },
        {
          "type": "richtext",
          "id": "copyright",
          "label": "Copyright"
        }
      ]
    },
