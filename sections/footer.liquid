{%- style -%}
  #shopify-section-{{ section.id }} {
    --background-color: var({{ section.settings.bg_color }});
    --link-color: var({{ section.settings.link_color }});
    --link-hover-color: var({{ section.settings.link_hover_color }});
  }

  #shopify-section-{{ section.id }} .ra-accordion-item__header {
    color: var(--link-color);
  }
  #shopify-section-{{ section.id }} .ra-accordion-item__header .ra_icon svg fill {
    color: var(--link-color);
  }
{%- endstyle -%}

<footer class="footer py-8 sm:pb-16 md:py-4 md:px-24 ">
  <div class="container footer__container md:px-0">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-0 md:gap-10">
      {% for block in section.blocks %}
        {% case block.type %}
          {%- comment -%}
            Form, social icons
          {%- endcomment -%}
          {% when 'form' %}
            <div class="footer__col pb-12 py-8 md:py-20 px-6 md:px-0 ">
              {%- render 'ra-icon', icon: 'khy-logo', width: '107px' height: '42px' class: 'footer__logo' -%}
              {% if block.settings.form_title != blank %}
                <div class="footer__form-title">{{ block.settings.form_title }}</div>
              {% endif %}

              {% if block.settings.klaviyo_list_id != blank %}
                <div class="klaviyo-form-{{ block.settings.klaviyo_list_id }}"></div>
              {% endif %}

            </div>
            {%- comment -%}
              Menu
            {%- endcomment -%}
          {% when 'menu' %}
          <div class="footer__col footer__menu flex pt-0 pb-8 md:py-20 flex-col justify-center" >
            <ul
              class="flex justify-around w-full"
              role="list"
              tabindex="-1"
            >
              {%- comment -%}
                desktop menu
              {%- endcomment -%}
              {%- for link in block.settings.menu.links -%}
                <li class="hidden list-none md:flex flex-col font-light mono-16 first:mr-2 uppercase">
                  <a
                    class="uppercase mb-2 leading-4"
                    href="{{ link.url }}"
                    title="{{ link.title }}"
                    aria-label="{{ link.title }}"
                  >
                    {{- link.title | escape -}}
                  </a>
                  {% if link.links.size > 0 %}
                    <ul role="list" tabindex="-1">
                      {% for child in link.links %}
                        <li class="list-none mono-16 font-light flex {% if child.title contains '_' %} ml-6 {% endif %}">
                          <a
                            class="py-2"
                            href="{{ child.url }}"
                            title="{{ child.title }}"
                            aria-label="{{ child.title }}"
                          >
                            {{- child.title | escape | remove: "_" -}}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {% endif %}
                </li>
              {%- endfor -%}

              {%- comment -%}
                mobile menu - accordion
              {%- endcomment -%}
              <div class="md:hidden w-full">
                <ra-accordion>
                  {% for link in block.settings.mobile_menu.links %}
                    {% capture link_content %}
                    {% if link.links.size > 0 %}
                      <ul role="list" tabindex="-1">
                        {% for child in link.links %}
                          <li class="list-none flex {% if child.title contains '_' %} ml-6 {% endif %}">
                            <a class="mono-16 py-2 !no-underline uppercase" href="{{ child.url }}" title="{{ child.title | remove: "_" }}" aria-label="{{ child.title }}">{{ child.title | escape | remove: "_" }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {% endif %}
                  {% endcapture %}
                    {% render 'ra-accordion-item',
                      title: link.title,
                      content: link_content,
                      show_icon: true,
                      class: 'py-6 mono-12'
                    %}
                  {% endfor %}
                </ra-accordion>
              </div>
            </ul>
            {% if section.settings.show_social_icon %}
              <div class="mt-8 md:mt-12">
                {% render 'ra-social-icons' %}
              </div>
            {% endif %}
          </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>

  {%- comment -%}
    Util nav
  {%- endcomment -%}
  {% if section.settings.util_menu != blank %}
    <div class="footer_util w-full pt-4 pb-0 md:pt-0">
      <div class="container footer_util-container">
        <div class="flex flex-row md:flex-row justify-between">
          {% if section.settings.copyright_text != blank %}
            <p class="footer__copyright-text leading-[24px] max-sm:max-w-[166px] mono-12-spaced text-sm uppercase text-left md:text-left md:mb-0 ">
              ©
              <script>
                document.write(new Date().getFullYear());
              </script>
               {{ section.settings.copyright_text }}
            </p>
          {% endif %}
          <ul class="flex uppercase justify-center flex-col md:flex-row text-right md:text-right md:justify-end md:flex-wrap max-sm:pl-0" role="list" tabindex="-1">
            {%- for link in section.settings.util_menu.links -%}
              <li class="list-none">
                <a
                  class="text-sm underline mono-12-spaced no-underline"
                  href="{{ link.url }}"
                  title="{{ link.title }}"
                  aria-label="{{ link.title }}"
                >
                  {{- link.title | escape -}}
                </a>
              </li>
              {% if forloop.last %}
                <li class="list-none">
                  <a href="#" class="ot-sdk-show-settings text-sm underline mono-12-spaced no-underline">Cookies settings</a>
                </li>
              {% endif %}
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  {% endif %}
</footer>

