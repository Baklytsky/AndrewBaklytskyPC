{{ 'component-form.css' | asset_url | stylesheet_tag }}
{{ 'component-rte.css' | asset_url | stylesheet_tag }}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<script src="{{ 'button-gorgias-chat.js' | asset_url }}" defer="defer"></script>

{%- assign heading_contact_block = section.settings.heading_contact_block -%}
{%- assign work_schedule = section.settings.work_schedule -%}
{%- assign phone_number = section.settings.phone_number | replace : '(', '' | replace : ')', '' | replace : '-', '' -%}
{%- assign call_work_schedule = section.settings.call_work_schedule -%}
{%- assign heading_form = section.settings.heading_form -%}
{%- assign description_form = section.settings.description_form -%}
{%- assign klavio_list_id = section.settings.klavio_list_id -%}
{%- assign form_source_name = section.settings.form_source_name -%}

<div class="footer page-width">
  {% if customer %}
    <h2
      class="footer__heading h5">{{- 'sections.footer.heading_with_customer' | t: customer_name: customer.first_name -}}</h2>
  {% else %}
    <h2 class="footer__heading h5">{{- 'sections.footer.heading_without_customer' | t -}}</h2>
  {% endif %}

  <div class="footer__content" data-accordion-collapseble>
    {%- if section.blocks.size > 0 -%}
      <ul class="footer__info-list" role="list">
        {% assign heading_blocks = section.blocks | where: "type", "heading" %}

        {%- for block in heading_blocks -%}
          {%- assign heading = block.settings.heading -%}
          {%- assign heading_handleize = block.settings.heading | handleize -%}
          {%- assign question_blocks = section.blocks | where: "type", "questions" -%}

          {% capture answer_group %}
            {%- for item in question_blocks -%}
              {%- assign group_name = item.settings.type_heading | handleize -%}
              {%- assign question = item.settings.text -%}
              {%- assign answer = item.settings.answer -%}
              {%- assign details_drawer_id = 'answer-' | append: item.id -%}

              {%- if question != blank and answer != blank and heading_handleize == group_name -%}
                <modal-opener class="footer__info-list-question"
                              data-modal="#{{ details_drawer_id }}"
                              role="region">
                  <button type="button"
                          aria-haspopup="dialog"
                          aria-label="{{ question }}">
                    {{ question }}
                  </button>
                </modal-opener>
              {%- endif -%}
            {%- endfor -%}
          {% endcapture %}

          {%- if heading != blank and answer_group != blank -%}
            <li>
              <details class="footer__info-list-wrapper" data-accordion-opener data-keep-open>
                <summary type="button" class="footer__info-list-heading-wrapper" aria-controls="link-{{ heading }}"
                         aria-expanded="false" role="button"
                         {% if answer_group == blank -%}style="cursor: unset"{%- endif -%}>
                  <span class="footer__info-list-heading">{{ heading }}</span>

                  {%- if answer_group != blank -%}
                    <span class="collapsible-plus"></span>
                  {%- endif -%}
                </summary>

                {%- if answer_group != blank -%}
                  <div class="footer__info-list-inner" id="link-{{ heading }}" data-accordion-content>
                    {{ answer_group }}
                  </div>
                {%- endif -%}
              </details>
            </li>
          {%- endif -%}
        {%- endfor -%}

        <modal-dialog class="footer__info-answer-contact-form-wrapper hide-scrollbar"
                      id="footer-contact-form"
                      data-open-with-parent="false"
                      data-direction="left"
                      data-connected-parent-modal="#footer-contact-form-parent">
          <div class="hide-scrollbar"
                        role="dialog"
                        aria-label="{{ heading_form | default : 'Email us' }}"
                        aria-modal="true"
                        tabindex="-1">
            <button id="ModalClose-footer-contact-form-{{ section.id }}"
                    type="button"
                    class="button__modal-close button__modal-close--second-modal"
                    data-keep-overlay-open
                    aria-label="{{ 'accessibility.close' | t }}">
              {% render 'icon-caret' %}
            </button>

            {%- form 'contact', id: 'footer-form' -%}
              <h6 class="footer__info-answer-contact-form-heading">
                {{ heading_form }}
              </h6>
              <div class="footer__info-answer-contact-form-description">
                {{ description_form }}
              </div>

              <div class="form__item">
                <input type="text" class="form__input" data-field="name" name="contact[name]"
                       id="form__input-name-{{ section.id }}"
                       aria-label="{{ 'templates.contact.form.name' | t }}"
                       placeholder="{{ 'templates.contact.form.name' | t }}"
                       {% if customer %}value="{{ customer.name }}"{% endif %}
                       required
                       autocomplete="off">
                <label for="form__input-name-{{ section.id }}">{{ 'templates.contact.form.name' | t }}</label>
              </div>

              <div class="form__item">
                <input type="email" class="form__input" data-field="email" name="contact[email]"
                       id="form__input-email-{{ section.id }}"
                       aria-label="{{ 'templates.contact.form.email' | t }}"
                       placeholder="{{ 'templates.contact.form.email' | t }}"
                       {% if customer %}value="{{ customer.email }}"{% endif %}
                       required
                       autocomplete="off">
                <label for="form__input-email-{{ section.id }}">{{ 'templates.contact.form.email' | t }}</label>
              </div>

              {%- assign option_blocks = section.blocks | where: "type", "option" -%}

              <div class="form__item">
                <custom-select class="form__select">
                  <div class="form__select-btn"
                       type="button" aria-expanded="false" aria-controls="dropdown-{{ section.id }}" role="button">
                    {{ 'templates.contact.form.reason' | t }}
                  </div>

                  <ul class="form__select-dropdown" id="dropdown-{{ section.id }}">
                    {%- for block in option_blocks -%}
                      <li class="form__select-dropdown-option"
                          data-option-value="{{ block.settings.title }}">{{ block.settings.title }}</li>
                    {%- endfor -%}
                  </ul>

                  <label for="form__input-select-{{ section.id }}">{{ 'templates.contact.form.reason' | t }}</label>

                  <select class="form__select-hidden" id="form__input-select-{{ section.id }}" data-field="reason"
                          name="contact[reason]" title="reason" required>
                    <option selected disabled value></option>

                    {%- for block in option_blocks -%}
                      <option value="{{ block.settings.title }}">{{ block.settings.title }}</option>
                    {%- endfor -%}
                  </select>
                </custom-select>
              </div>

              <div class="form__item">
                <input type="tel"
                       class="form__input"
                       data-field="phone"
                       name="contact[phone]"
                       title="999-999-9999"
                       pattern="(?:\d[\s\-\.()xX]*){9,15}"
                       id="form__input-phone-{{ section.id }}"
                       placeholder="{{ 'templates.contact.form.phone' | t }}"
                       {% if customer %}value="{{ customer.phone }}"{% endif %}>
                <label for="form__input-phone-{{ section.id }}">{{ 'templates.contact.form.phone' | t }}</label>
              </div>

              <div class="form__item">
                <input type="text" class="form__input" data-field="order" name="contact[order]"
                       id="form__input-order-{{ section.id }}"
                       aria-label="{{ 'templates.contact.form.order' | t }}"
                       placeholder="{{ 'templates.contact.form.order' | t }}">
                <label for="form__input-order-{{ section.id }}">{{ 'templates.contact.form.order' | t }}</label>
              </div>

              <div class="form__item">
                <textarea name="contact[body]" cols="30" rows="5" class="form__textarea"
                          data-field="message"
                          id="form__input-message-{{ section.id }}"
                          aria-label="{{ 'templates.contact.form.message' | t }}"
                          placeholder="{{ 'templates.contact.form.message' | t }}"
                          required></textarea>
                <label for="form__input-message-{{ section.id }}">{{ 'templates.contact.form.message' | t }}</label>
              </div>

              {%- if form.posted_successfully? -%}
                <p class="form__message--success">
                  {{ 'templates.contact.form.post_success' | t }}
                </p>
              {%- endif -%}

              <button type="submit"
                      class="button button--primary button--full-width"
                      data-email-btn-send>
                {{ 'templates.contact.form.send_btn_label' | t }}
              </button>
            {%- endform -%}
          </div>
        </modal-dialog>

        {%- for item in question_blocks -%}
          {%- assign group_name = item.settings.type_heading | handleize -%}
          {%- assign question = item.settings.text -%}
          {%- assign answer = item.settings.answer -%}
          {%- assign details_drawer_id = 'answer-' | append: item.id -%}

          {%- if question != blank and answer != blank -%}
            <modal-dialog class="footer__info-answer-wrapper  hide-scrollbar"
                          id="{{ details_drawer_id }}">
              <div class="footer__info-answer-inner hide-scrollbar"
                   role="dialog"
                   aria-label="{{ question | escape }}"
                   aria-modal="true"
                   tabindex="-1"
                   id="footer-contact-form-parent">
                <button id="ModalClose-{{ details_drawer_id }}"
                        type="button"
                        class="button__modal-close"
                        aria-label="{{ 'accessibility.close' | t }}">
                  {% render 'icon-close' %}
                </button>

                <div class="rte">
                  {{ answer }}
                </div>

                {%- if email != blank or phone_number != blank or work_schedule != blank -%}
                  <div class="footer__info-answer-contact-wrapper">

                    <footer-gorgias-chat-button data-template-name="{{ template.name }}">
                      {%- if heading_contact_block != blank -%}
                        <span class="footer__info-contact-heading">{{ heading_contact_block }}</span>
                      {%- endif -%}

                      <button class="button button--primary button--full-width" type="button"
                              aria-label="{{ 'templates.contact.form.chat_btn_label' | t }}">
                        {{ 'templates.contact.form.chat_btn_label' | t }}
                      </button>
                    </footer-gorgias-chat-button>

                    {%- if work_schedule != blank -%}
                      <span class="footer__info-answer-contact-work-schedule">{{ work_schedule }}</span>
                    {%- endif -%}

                    <modal-opener data-modal="#footer-contact-form"
                                  role="region">
                      <button type="button"
                              class="button button--secondary-border button--full-width footer__info-answer-contact-open-modal"
                              aria-haspopup="dialog"
                              aria-label="{{ 'templates.contact.form.email_btn_label' | t }}">
                        {{ 'templates.contact.form.email_btn_label' | t }}
                      </button>
                    </modal-opener>

                    {%- if phone_number != blank -%}
                      <div class="footer__info-answer-contact-phone-wrapper">
                        <span>Call us:</span>

                        <a class="footer__info-answer-contact-phone .no-js"
                           href="tel:{{ phone_number }}">{{ phone_number }}</a>
                      </div>
                    {%- endif -%}

                    {%- if call_work_schedule != blank -%}
                      <span class="footer__info-answer-contact-work-schedule--call">{{ call_work_schedule }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </modal-dialog>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <ul id="footer__navigation" class="footer__navigation small-hide" role="list">
      {%- for link in section.settings.menu.links -%}
        <li class="footer__navigation-list">
          <strong class="footer__navigation-link-parent">
            {{ link.title | escape }}
          </strong>

          {%- if link.links != blank -%}
            <ul>
              {%- for childlink in link.links -%}
                <li>
                  {%- assign childlink_title_handleize = childlink.title | handleize -%}

                  {%- if childlink_title_handleize contains 'email' -%}
                    <modal-opener class="footer__menu-item link link--text focus-inset" data-modal="#NewsletterModal"
                                  role="region">
                      <button aria-haspopup="dialog"
                              aria-label="{{ section.settings.title | default: childlink.title }}">
                        <span {%- if link.current %} class="header__active-menu-item"{% endif %}>{{ childlink.title | escape }}</span>
                      </button>
                    </modal-opener>
                  {%- else -%}
                    <a href="{{ childlink.url }}"
                       class="footer__menu-item link link--text focus-inset"{% if link.current %} aria-current="page"{% endif %}>
                      <span {%- if link.current %} class="header__active-menu-item"{% endif %}>{{ childlink.title | escape }}</span>
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    <ul id="footer__navigation" class="footer__navigation list-menu list-menu--inline small-up-hide" role="list">
      {%- for link in section.settings.menu.links -%}
        <li class="footer__navigation-list" {% if forloop.last -%}data-list-last-child{%- endif -%}>
          <details data-accordion-opener>
            <summary type="button" class="footer__info-list-heading-wrapper" aria-controls="link-{{ link.title }}"
                     aria-expanded="false" role="button"
                     {% if link.links.size > 0 -%}style="cursor: unset"{%- endif -%}>
              <strong class="footer__navigation-link-parent">
                {{ link.title | escape }}
              </strong>

              {%- if link.links.size > 0 -%}
                <span class="collapsible-plus"></span>
              {%- endif -%}
            </summary>

            {%- if link.links.size > 0 -%}
              <ul id="link-{{ link.title }}" data-accordion-content>
                {%- for childlink in link.links -%}
                  <li>
                    {%- assign childlink_title_handleize = childlink.title | handleize -%}

                    {%- if childlink_title_handleize contains 'email' -%}
                      <modal-opener class="footer__menu-item link link--text focus-inset" data-modal="#NewsletterModal"
                                    role="region">
                        <button aria-haspopup="dialog"
                                aria-label="{{ section.settings.title | default: 'Newsletter modal opener' }}">
                          <span {%- if link.current %} class="header__active-menu-item"{% endif %}>{{ childlink.title | escape }}</span>
                        </button>
                      </modal-opener>
                    {%- else -%}
                      <a href="{{ childlink.url }}"
                         class="footer__menu-item link link--text focus-inset"{% if link.current %} aria-current="page"{% endif %}>
                        <span {%- if link.current %} class="header__active-menu-item"{% endif %}>{{ childlink.title | escape }}</span>
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </details>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<style>
  .footer__heading,
  .footer__menu-item {
    color: {{ section.settings.footer_heading_color }};
  }

  #shopify-section-footer,
  .footer__heading {
    background-color: {{ section.settings.footer_bg_color }};
    color: {{ section.settings.footer_text_color }};
  }

  .footer__navigation-link-parent {
    border-bottom: 1px solid {{ section.settings.footer_line_color }};
  }

  .footer__info-list li {
    border-bottom: 1px solid {{ section.settings.footer_line_color }};
  }

  @media screen and (max-width: 749px) {
    .footer__navigation-link-parent {
      border: none;
    }

    .footer__navigation-list {
      border-bottom: 1px solid {{ section.settings.footer_line_color }};
    }
  }

</style>

{% comment %}Unknown code start{% endcomment %}
<script src="https://cdn.shopify.com/s/files/1/0245/4798/3420/files/currency.js?v=1649709437" defer="defer"></script>
{% comment %}Unknown code end{% endcomment %}

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "settings": [
    {
      "type": "header",
      "content": "Section settings"
    },
    {
      "type": "color",
      "id": "footer_bg_color",
      "default": "#070707",
      "label": "Background footer color"
    },
    {
      "type": "color",
      "id": "footer_heading_color",
      "default": "#F9F9F9",
      "label": "Footer heading color"
    },
    {
      "type": "color",
      "id": "footer_text_color",
      "default": "#F9F9F9",
      "label": "Footer text color"
    },
    {
      "type": "color",
      "id": "footer_line_color",
      "default": "#303030",
      "label": "Footer text color"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "footer",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Contacts block settings"
    },
    {
      "type": "text",
      "id": "heading_contact_block",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "work_schedule",
      "label": "Work schedule (Chat)"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone number"
    },
    {
      "type": "text",
      "id": "call_work_schedule",
      "label": "Work schedule (Call)"
    },
    {
      "type": "header",
      "content": "Form settings"
    },
    {
      "type": "text",
      "id": "heading_form",
      "label": "Heading form"
    },
    {
      "type": "richtext",
      "id": "description_form",
      "label": "Description form"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "questions",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "type_heading",
          "label": "Group heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Question"
        },
        {
          "type": "html",
          "id": "answer",
          "label": "Answer"
        }
      ]
    },
    {
      "type": "option",
      "name": "Email reason option",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Option for select"
        }
      ]
    }
  ]
}
{% endschema %}
