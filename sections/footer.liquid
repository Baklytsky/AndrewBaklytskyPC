        {
          "type": "link_list",
          "id": "mobile_menu",
          "default": "footer",
          "label": "Select footer mobile menu"
        }
      ]
    },
    {
      "type": "form",
      "name": "Form",
      "settings": [
        {
          "type": "richtext",
          "id": "form_title",
          "default": "<p>Please sign up for our newsletter to<p> <p>receive updates & discounts</p>",
          "label": "Form Title"
        },
        {
          "type": "text",
          "id": "klaviyo_list_id",
