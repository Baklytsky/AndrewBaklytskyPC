{{ 'contact-form.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'contact-form.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-custom-select.min.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading = section.settings.heading
  assign bottom_text = section.settings.bottom_text
  assign info_label_1 = section.settings.info_label_1
  assign info_text_1 = section.settings.info_text_1 | newline_to_br
  assign info_label_2 = section.settings.info_label_2
  assign info_text_2 = section.settings.info_text_2 | newline_to_br
  assign klaviyo_list_id = section.settings.klaviyo_list_id
  assign error_message = section.settings.error_message
  assign success_message = section.settings.success_message
  assign is_subscribed = section.settings.is_subscribed
-%}

<contact-form class="contact-form" data-klaviyo-list-id="{{ klaviyo_list_id }}">
  <div class="page-width contact-form__inner">
    <div class="contact-form__wrapper">
      {%- if heading != blank -%}
        <h2 class="body1 contact-form__heading">{{ heading }}</h2>
      {%- endif -%}

      {%- if klaviyo_list_id != blank -%}
        {%- render 'contact-form-klaviyo',
          blocks: section.blocks,
          id: 'contact-us-page',
          class: 'contact-form__form',
          bottom_text: bottom_text,
          error_message: error_message,
          success_message: success_message,
          is_subscribed: is_subscribed -%}
      {%- else -%}
        {%- render 'contact-form',
          blocks: section.blocks,
          id: 'contact-us-page',
          class: 'contact-form__form',
          bottom_text: bottom_text,
          error_message: error_message,
          success_message: success_message,
          is_subscribed: is_subscribed -%}
      {%- endif -%}

    </div>
    {%- if info_text_1 != blank or info_text_2 != blank -%}
      <div class="contact-form__info">
        {%- if info_text_1 != blank -%}
          <div class="contact-form__info-item">
            {%- if info_label_1 != blank -%}
              <span class="body1 contact-form__info-label">{{ info_label_1 }}</span>
            {%- endif -%}
            <p class="body3 contact-form__info-text">{{ info_text_1 }}</p>
          </div>
        {%- endif -%}

        {%- if info_text_2 != blank -%}
          <div class="contact-form__info-item">
            {%- if info_label_2 != blank -%}
              <span class="body1 contact-form__info-label">{{ info_label_2 }}</span>
            {%- endif -%}
            <p class="body3 contact-form__info-text">{{ info_text_2 }}</p>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</contact-form>

