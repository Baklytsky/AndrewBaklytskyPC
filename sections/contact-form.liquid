<div class="contact md:max-w-[678px] mx-auto">
  <div data-gorgias-contact-form="container"></div>
</div>
<script defer src="https://contact.gorgias.help/api/contact-forms/loader.js?uid=oauacr4b&locale=en-US" data-gorgias-contact-form="script"></script>

{% style %}
  #shopify-section-{{ section.id }} .contact {
    margin-top: {{ section.settings.margin_mobile_top }}rem;
    margin-bottom: {{ section.settings.margin_mobile_bottom }}rem;
  }

  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .contact {
    margin-top: {{ section.settings.margin_desktop_top }}rem;
    margin-bottom: {{ section.settings.margin_desktop_bottom }}rem;
  }
  }
{% endstyle %}

{% schema %}
{
  "name": "Contact Form",
  "settings": [
    {
      "type": "header",
      "content": "Margin Spacing"
    },
    {
      "type": "range",
      "id": "margin_mobile_top",
      "min": 0,
      "max": 20,
      "step": 0.5,
      "unit": "rem",
      "label": "Mobile Margin Top (rem) ",
      "default": 2
    },
    {
      "type": "range",
      "id": "margin_mobile_bottom",
      "min": 0,
      "max": 20,
      "step": 0.5,
      "unit": "rem",
      "label": "Mobile Margin Bottom (rem)",
      "default": 2
    },
    {
      "type": "range",
      "id": "margin_desktop_top",
      "min": 0,
      "max": 20,
      "step": 0.5,
      "unit": "rem",
      "label": "Desktop Margin Top (rem)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_desktop_bottom",
      "min": 0,
      "max": 20,
      "step": 0.5,
      "unit": "rem",
      "label": "Desktop Margin Bottom (rem) ",
      "default": 0
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}