          {
            "type": "checkbox",
            "id": "hide_label",
            "label": "Hide label",
            "default": false
          },
          {
            "type": "checkbox",
            "id": "required",
            "label": "Required",
            "default": false
          }
        ]
      },
      {
        "type": "textarea",
        "name": "Text area",
        "settings": [
          {
            "type": "textarea",
            "id": "title",
            "label": "Label",
            "default": "Enter your message"
          },
          {
            "type": "checkbox",
            "id": "hide_label",
