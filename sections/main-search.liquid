{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- assign show_image_thumbnails = false -%}
{%- assign enable_sorting = section.settings.enable_sorting -%}
{%- assign color_label = 'color,colour,couleur,colore,farbe,색,色,färg,farve' | split: ',' -%}
{%- assign hide_filter_menu = search.metafields.custom.hide_filter_menu -%}
{%- assign products_per_page = section.settings.products_per_page -%}

<div class="template-search spaced-section{% unless search.performed and search.results_count > 0 %} template-search--empty{% endunless %}">
  <div class="template-search__header page-width center">
    {%- if search.performed -%}
      <h1 class="h4">{{ 'templates.search.title' | t }}</h1>
    {%- else -%}
      <h1 class="h4">{{ 'general.search.search' | t }}</h1>
    {%- endif -%}
    <div class="template-search__search">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search">
        <div class="field">
          <input
            class="search__input field__input"
            id="Search-In-Template"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search.search' | t }}"
          >
          <input name="options[prefix]" type="hidden" value="last">
          <input type="hidden" name="type" value="product">
          {%- if settings.predictive_search_enabled -%}
            <div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>
              <div class="predictive-search__loading-state">
                <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                  <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                </svg>
              </div>
            </div>
            
            <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
          {%- endif -%}
          
          <button type="submit" class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
            <svg class="icon icon-search">
              <use xlink:href="#icon-search">
            </svg>
          </button>
        </div>
      </form>
  </div>
</div>


{%- if search.results_count > 0 -%}
  <div id="main-collection">
    {%- if section.settings.swatch_type == 'thumbnails' -%}
      {%- assign show_image_thumbnails = true -%}
    {%- endif -%}
    
    {%- if search.results_count > products_per_page -%}
      <script src="{{ 'clp-load-more.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    
    <div class="collection-wrapper page-width {% if hide_filter_menu %}collection-wrapper--hidden-facets{% endif %}">
      {%- if section.settings.enable_filtering and search.results_count != 0 -%}
        {{ 'component-facets.css' | asset_url | stylesheet_tag }}
        <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

        <modal-opener data-modal="#main-collection-filters-{{ section.id }}" role="region" class="large-up-hide">
          <button aria-haspopup="dialog"
                  aria-label="Filters Opener"
                  class="button button--primary focus-inset button-filter-opener--mobile">
            <span>Filter</span>
            <span>{%- render 'icon' with 'filters' -%}</span>
          </button>
        </modal-opener>
        
        <modal-dialog id="main-collection-filters-{{ section.id }}"
                      class="announcement-modal primary-bg {% if hide_filter_menu %}large-up-hide{% endif %}">
          <div class="announcement-modal-content hide-scrollbar"
               role="dialog"
               aria-label="{{ announcement_heading | escape }}"
               aria-modal="true"
               tabindex="-1">
            <button id="ModalClose-{{ section.id }}"
                    type="button"
                    class="button__modal-close"
                    aria-label="{{ 'accessibility.close' | t }}">
              {% render 'icon-close' %}
            </button>
            <div id="main-collection-filters-{{ section.id }}" data-id="{{ section.id }}" class="main-collection-filters">
              {% render 'facets',
                results: search,
                enable_filtering: section.settings.enable_filtering,
                enable_sorting: enable_sorting,
                hide_color_swatch: section.settings.hide_color_swatch,
                hide_filter_menu: hide_filter_menu
              %}
            </div>
          </div>
        </modal-dialog>
      {%- endif -%}

      {% style %}
        :root {
        {%- if section.index == 1 or request.design_mode -%}
          --clp-wrapper-mt-desktop: 90px;
          --clp-wrapper-mt-mobile: 35px;
        {%- else -%}
          --clp-wrapper-mt-desktop: 40px;
          --clp-wrapper-mt-mobile: 10px;
        {%- endif -%}
        }
      {% endstyle %}
      
      <div class="collection__wrapper">
        {%- if enable_sorting and search.results_count > 0 and section.settings.enable_filtering -%}
          {%- render 'collection-filters',
            results: search,
            section: section,
            hide_filter_menu: hide_filter_menu -%}
        {%- endif -%}
        
        <div id="ProductGridContainer">
          {%- paginate search.results by 1000 -%}
          {%- render 'collection-grid',
            results: search,
            section: section,
            products_per_page: products_per_page,
            paginate: paginate -%}
          {%- endpaginate -%}
        </div>
      </div>
    </div>
  </div>
{% else %}
  <div class="template-search__results collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
    <div class="loading-overlay primary-bg"></div>
    <div class="title-wrapper center">
      <h3 class="title title--primary">
        {{ 'sections.collection_template.empty' | t }}<br>
      </h3>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "swatch_type",
      "options": [
        {
          "value": "thumbnails",
          "label": "Thumbnails"
        },
        {
          "value": "Circles",
          "label": "Circles"
        }
      ],
      "default": "thumbnails",
      "label": "Color swatch types"
    },
    {
      "type": "checkbox",
      "id": "show_product_reviews",
      "default": true,
      "label": "Show product reviews"
    },
    {
      "type": "checkbox",
      "id": "show_product_description",
      "default": true,
      "label": "Show product description"
    },
    {
      "type": "checkbox",
      "id": "show_product_description_metafield",
      "default": false,
      "label": "Show product description from metafield"
    },
    {
      "type": "checkbox",
      "id": "show_product_price",
      "default": true,
      "label": "Show product price"
    },
    {
      "type": "checkbox",
      "id": "show_product_price_range",
      "default": true,
      "label": "Show product price range"
    },
    {
      "type": "checkbox",
      "id": "show_product_badge",
      "default": true,
      "label": "Show product badge"
    },
    {
      "type": "checkbox",
      "id": "show_color_options_size",
      "default": true,
      "label": "Show colors count"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    },
    {
      "type": "checkbox",
      "id": "hide_color_swatch",
      "default": false,
      "label": "Hide color swatch filtering"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 48,
      "step": 3,
      "default": 30,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    }
  ]
}
{% endschema %}
