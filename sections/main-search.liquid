{% liquid
  assign trending = settings.search_trending
  assign popular_products = settings.search_popular_products
%}

<section class="main-search page-width">
  <div class="template-search__header">
    <form action="{{ routes.search_url }}" id="main-search-form" method="get" role="search" class="search search-modal__form">
      <input type="hidden" name="type" value="product">

      <div class="form-field form-field__search">
        <button type="submit" class="btn--reset small-up-hide submit">
          {%- render 'icon' with 'search' -%}
        </button>
        <input class="form-input search__input"
               id="Search-In-Modal-1"
               type="search"
               name="q"
               value="{{ search.terms }}"
               placeholder="{{ 'general.search.search' | t }}"
               role="combobox" aria-expanded="false"
        >
        <label class="field__label visually-hidden" for="Search-In-Modal-1" >{{ 'general.search.search' | t }}</label>
        <input type="hidden" name="options[prefix]" value="last">

        <a href="{{ routes.search_url }}" type="reset" class="a btn--reset search-modal__close small-hide" aria-label="{{ 'accessibility.close' | t }}">
          {%- render 'icon' with 'close' -%}
        </a>
      </div>

      <div class="predictive-search__result predictive-search--header" tabindex="-1" data-predictive-search>
        <div class="predictive-search__loading-state">
          {% render 'icon' with 'spinner' %}
        </div>
      </div>

      <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>

    </form>
  </div>

  {%- if search.performed -%}
    {%- capture result_products -%}
      {% paginate search.results by 1000 %}
        {%- assign hidden_products = 0 -%}

        {%- for item in search.results -%}
          {% if item.object_type == 'product' %}
            {%- if item.tags contains 'dev_product'
              or item.tags contains 'test_product'
              or item.tags contains 'hidden'
              or item.tags contains 'not-allowed' -%}
              {%- assign hidden_products = hidden_products | plus: 1 -%}
              {% continue %}
            {%- endif -%}

            <li id="predictive-search-option-{{ forloop.index }}" class="predictive-search__list-item" role="option" aria-selected="false">
              {%- render 'product-card' product: item -%}
            </li>
          {% elsif item.object_type == 'article' %}
            <li id="predictive-search-option-{{ forloop.index }}" class="predictive-search__list-item" role="option" aria-selected="false">
              {% render 'article-card' article: item, description_truncate: 70 show_date: true, show_author: false %}
            </li>
          {% endif %}
        {%- endfor -%}
      {% endpaginate %}
    {%- endcapture -%}

    {%- if search.results.size > 0 -%}
      <div class="predictive-search-results__header">
        {%- assign results_count = search.results.size | minus: hidden_products | default: 0 -%}

        {%- if hidden_products != 0 -%}
          <script>
            document.title = 'Search: {{ results_count }} results found for "{{ search.terms }}" - Obagi';
          </script>
        {%- endif -%}

        <span class="body3--bold" data-search-live-region-count-value="{{ results_count }}">
          {{ 'templates.search.results_with_count' | t: count: results_count }}
        </span>
        <a href="{{ routes.search_url }}" class="a btn--reset predictive-search-results__clear">
          {{ 'templates.search.clear' | t }}
        </a>
      </div>

      <ul id="predictive-search-results-list" class="predictive-search__results-list list-unstyled" role="listbox" aria-labelledby="predictive-search-products">
        {% render 'ga-product-list-event',  event_type: 'view_item_list', product_list: search.results, list_name: 'Search page', list_id: section.id %}
        {{ result_products }}
      </ul>
    {%- else -%}
      <div class="predictive-search__no-results">
        <p class="h4 no-result__heading">
          {{ 'templates.search.no_results' | t }}
          <span>"{{ search.terms }}"</span>
        </p>

        {%- if settings.search_trending != blank -%}
          <div class="body3 search-modal__trending">
            <p class="body3--bold">{{ 'general.search.trending' | t }}</p>
            {{ settings.search_trending }}
          </div>
        {%- endif -%}

        <a href="{{ settings.no_result_btn_link | default: '/' }}" class="btn btn--{{ settings.no_result_btn_style }}">{{ settings.no_result_btn_text | default: 'Shop all' }}</a>
      </div>
    {%- endif -%}
  {% else %}
    {%- if trending != blank or popular_products != blank -%}
      <div class="search-modal__initial" aria-hidden="false">
        {%- if trending != blank -%}
          <div class="body3 search-modal__trending">
            <p class="body3--bold">{{ 'general.search.trending' | t }}</p>
            {{ trending }}
          </div>
        {%- endif -%}
        {%- if popular_products != blank -%}
          <div class="search-modal__popular">
            <p class="body3--bold">{{ 'general.search.popular_products' | t }}</p>

            <div class="search-modal__popular-products">
              {%- for product in popular_products -%}
                {%- if product != blank -%}
                  {%- render 'product-card' product: product -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

<script type="application/ld+json" data-event-search>
  {
    "search_results_total": "{{ results_count }}",
    "search_term": "{{ search.terms }}"
  }
</script>

<script>
  window.dataLayer.push({
    'event': 'search',
    'search': {
      'search_type': 'Typed',
      'search_results_total' : '{{ results_count }}',
      'search_dropdown_selected': '',
      'search_term': '{{ search.terms }}'
    }
  })

  const search_wrapper = document.querySelector('.main-search');
  search_wrapper.addEventListener('click', (e) => {
    if (e.target.nodeName === 'A' || e.target.nodeName === 'IMG') {
      const count = document.querySelector('[data-search-live-region-count-value]')?.getAttribute('data-search-live-region-count-value') || '';
      const selected_search = e.target.textContent || e.target.alt;
      const searchTerms = document.querySelector('.main-search input[type=search]').value || '';
      window.dataLayer.push({
        "event": "search",
        "search": {
          "search_type": searchTerms ? 'typed' : 'suggested',
          "search_results_total": count,
          "search_dropdown_selected": selected_search.trim(),
          "search_term": searchTerms
        }
      })
    }
  })
</script>


{% schema %}
{
  "name": "Main search",
  "settings": []
}
{% endschema %}
