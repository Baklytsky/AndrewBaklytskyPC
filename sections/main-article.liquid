{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}
{%- assign article_content = article.content -%}

{%- for block in section.blocks -%}
  {%- if block.type == 'slideshow_image' -%}
    {% capture slideshow_snippet %}
      {% render 'image-slideshow-metafields', index: block.id, wrapper_class_name: 'article-template__image-slideshow' %}
    {% endcapture %}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- if article_content contains '[[blog_carousel]]' and slideshow_snippet -%}
  {%- assign article_content = article_content | replace: '[[blog_carousel]]', slideshow_snippet -%}
  {%- assign hide_original_slideshow = true -%}
{%- endif -%}

{%- for block in section.blocks -%}
  {%- case block.type -%}
  {%- when 'article_main' -%}
    <article class="article-template" itemscope itemtype="http://schema.org/BlogPosting">
      <div class="article-template__hero-container">
        <div class="article-template__hero"
             itemprop="image">
          {% render 'image', image: article.image, hide_id: true %}
        </div>
      </div>
    
      <div class="article-template__container-wrapper">
        <div class="article-template__container">
          <header>
            <div class="article-template__header-content">
              {%- for tag in article.tags -%}
                {%- assign tag_downcase = tag | downcase -%}
                {%- assign tag_handle = tag | handle -%}
              
                {%- if tag_downcase contains 'category:' -%}
                  {%- assign tag_count = tag_count | plus: 1 -%}
                  {%- assign tag_name = tag | remove: 'category:' | strip -%}
                
                  <div class="article-template__badge-wrapper">
                    <p class="article-template__badge">
                      {{ tag_name }}
                    </p>
                  </div>
                  {% break %}
                {%- endif -%}
              {%- endfor -%}
            
              <h1 class="article-template__title h4" itemprop="headline">{{ article.title | escape }}</h1>
              {%- if block.settings.blog_show_date -%}
                <p class="article-template__date" itemprop="dateCreated pubdate datePublished">{{ article.published_at | time_tag: format: 'date' }}</p>
              {%- endif -%}
              
              {%- if block.settings.blog_show_author -%}
                <p class="article-template__author" itemprop="author" itemscope itemtype="http://schema.org/Person">
                  <span itemprop="name">{{ article.author }}</span>
                </p>
              {%- endif -%}
              
              {%- if block.settings.blog_show_social_share -%}
                {% render 'social-sharing', share_title: article.title, share_permalink: article.url,
                  share_image: article.image, wrapper_class_name: 'article-template__social-sharing', settings: block.settings %}
              {%- endif -%}
            </div>
          </header>

          <div class="article-template__content article-template__content-{{ article.id }} rte article-rte" itemprop="articleBody">
            {{ article_content }}
          </div>
  
          <script type="application/javascript">
            const content = document.querySelector('.article-template__content-{{ article.id }}');
            const iframesYoutube = content?.querySelectorAll('iframe[src*="youtube"]');
            
            if (iframesYoutube && iframesYoutube.length) {
              iframesYoutube.forEach((el) => {
                const parentElem = el.parentElement;
                if (parentElem !== content && parentElem.children.length === 1) {
                  parentElem.classList.add('video-wrapper');
                }
              });
            }
          </script>
        </div>
      </div>
    </article>
  {%- when 'slideshow_image' -%}
    <div class="article-template__container-wrapper {% if hide_original_slideshow %}hidden{% endif %}">
      <div class="article-template__container-without-padding">
        {% render 'image-slideshow-metafields', index: block.id, wrapper_class_name: 'article-template__image-slideshow' %}
      </div>
    </div>
  {%- when 'video' -%}
    <div class="article-template__container-wrapper">
      <div class="article-template__container">
        {% render 'section-video-metafields', index: block.id, wrapper_class_name: 'article-template__video-section' %}
      </div>
    </div>
  {%- when 'featured_products' -%}
    <div class="article-template__container-wrapper">
      <div class="article-template__container">
        {%- assign assign uniq_id_by_index = 'featured-products' | append: page.handle | md5 | append: section.id  -%}
  
        {% capture config %}
          {
            "slidesPerView": 1,
            "spaceBetween": 24,
            "noSwipingSelector": "label",
            "watchOverflow": true,
            "navigation": {
              "nextEl": ".next-{{ uniq_id_by_index }}",
              "prevEl": ".prev-{{ uniq_id_by_index }}"
            },
            "pagination": {
              "el": ".swiper-pagination-{{ uniq_id_by_index }}",
              "type": "progressbar"
            },
            "breakpoints": {
              "1200": {
                "slidesPerView": 2
              },
              "900": {
                "shortSwipes": false,
                "slidesPerView": 1.5
              }
            }
          }
        {% endcapture %}
        
        {% render 'featured-products-metafields', uniq_id_by_index: uniq_id_by_index, config: config,
          wrapper_class_name: 'article-template__featured-products' %}
      </div>
    </div>
  {%- when 'featured_articles' -%}
    <div class="article-template__container-wrapper">
      <div class="article-template__container">
        {% render 'featured-articles-metafields', index: block.id, config: config,
          wrapper_class_name: 'article-template__featured-articles',
          curent_settings: block.settings %}
      </div>
    </div>
  {%- endcase -%}
{%- endfor -%}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Article",
    "articleBody": {{ article.content | strip_html | json }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ shop.url | append: page.url | json }}
    },
    "headline": {{ article.title | json }},
    {% if article.excerpt != blank %}
      "description": {{ article.excerpt | strip_html | json }},
    {% endif %}
    {% if article.image %}
      {% assign image_size = article.image.width | append: 'x' %}
      "image": [
        {{ article | img_url: image_size | prepend: "https:" | json }}
      ],
    {% endif %}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "author": {
      "@type": "Person",
      "name": {{ article.author | json }}
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    }
  }
  </script>


{% schema %}
{
  "name": "t:sections.main-article.name",
  "tag": "section",
  "class": "article-template-wrapper",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "article_main",
      "name": "Article main",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "blog_show_date",
          "default": true,
          "label": "Show date"
        },
        {
          "type": "checkbox",
          "id": "blog_show_author",
          "default": false,
          "label": "Show author"
        },
        {
          "type": "header",
          "content": "Social share"
        },
        {
          "type": "checkbox",
          "id": "blog_show_social_share",
          "default": false,
          "label": "Show social share"
        },
        {
          "type": "checkbox",
          "id": "blog_show_share_facebook",
          "default": false,
          "label": "Show share facebook"
        },
        {
          "type": "checkbox",
          "id": "blog_show_share_twitter",
          "default": false,
          "label": "Show share twitter"
        },
        {
          "type": "checkbox",
          "id": "blog_show_share_pinterest",
          "default": false,
          "label": "Show share pinterest"
        }
      ]
    },
    {
      "type": "slideshow_image",
      "name": "Slideshow images",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "This section is setup via metafields."
        }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "This section is setup via metafields."
        }
      ]
    },
    {
      "type": "featured_products",
      "name": "Featured products",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "This section is setup via metafields."
        }
      ]
    },
    {
      "type": "featured_articles",
      "name": "Featured articles",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "This section is setup via metafields."
        },
        {
          "type": "checkbox",
          "id": "show_description",
          "default": false,
          "label": "Show description"
        },
        {
          "type": "checkbox",
          "id": "show_date",
          "default": true,
          "label": "Show date"
        },
        {
          "type": "checkbox",
          "id": "show_author",
          "default": false,
          "label": "Show author"
        },
        {
          "type": "checkbox",
          "id": "show_link_to_article",
          "default": false,
          "label": "Show link to article"
        },
        {
          "type": "text",
          "id": "link_to_article_label",
          "label": "Label: link to article"
        }
      ]
    }
  ]
}
{% endschema %}
