{{ 'article.min.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign subheading = article.metafields.main_info.subheading
  assign time_for_reading = article.metafields.main_info.time_for_reading
  assign recommended_product = all_products[article.metafields.main_info.recommended_product]
  assign product_banners = article.metafields.main_info.recommended_products_banner
-%}

<div data-aos="fade-up" class="article-breadcrumbs page-width">
  {% render 'breadcrumbs' %}
</div>

<article class="article-template" itemscope itemtype="http://schema.org/BlogPosting">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when '@app' -%}
        <div data-aos="fade-up" class="page-width">
          {% render block %}
        </div>
      {%- when 'featured_image'-%}
        {%- if article.image -%}
          <div data-aos="fade-up" class="article-template__hero-container page-width" {{ block.shopify_attributes }} data-aos="fade-up">
            <div class="article-template__hero rel" itemprop="image">
              {% render 'image', image: article.image, class_name: 'image-abs-cover', alt: article.image.alt %}
            </div>
          </div>
        {%- endif -%}

        {%- when 'title'-%}
          <header data-aos="fade-up" class="page-width" {{ block.shopify_attributes }} data-aos="fade-up">
            <h1 class="article-template__title h2" itemprop="headline">{{ article.title | escape }}</h1>

            {%- if subheading != blank -%}
              <p class="article-template__subtitle body1">{{ subheading }}</p>
            {%- endif -%}

            <div class="article-template__date-wrapper">
              <div class="article-template__date-wrapper-side">
                {%- if block.settings.blog_show_date -%}
                  <span class="article-template__date block" itemprop="dateCreated pubdate datePublished">
                    {{ 'blogs.article.published' | t }}  {{ article.published_at | time_tag: format: 'date' }}
                  </span>
                {%- endif -%}

                {%- if time_for_reading != blank -%}
                  <span class="article-template__read-time">
                  {{ time_for_reading }}
                </span>
                {%- endif -%}

                {%- if block.settings.blog_show_author -%}
                  <span class="article-template__author block" itemprop="author" itemscope itemtype="http://schema.org/Person">
                  <span itemprop="name">{{ article.author }}</span>
                </span>
                {%- endif -%}
              </div>

              <div class="article-template__date-wrapper-side">
                {% include 'social-sharing', block_settings: block.settings, share_link: article.url, share_title: article.title, share_permalink: article.url, share_image: article.image %}
              </div>
            </div>
          </header>

        {%- when 'content'-%}
          {%- capture new_content -%}
            {%- assign type = "image" -%}
            {%- assign old_local_content = article.content -%}

            {% include 'article-replace-content' %}
          {%- endcapture -%}

          {%- if recommended_product != empty -%}
            {%- capture new_content-%}
              {%- assign type = "product" -%}
              {%- assign old_local_content = new_content -%}

              {% include 'article-replace-content' %}
            {%- endcapture -%}
          {%- endif -%}

          {%- if product_banners != blank -%}
            {%- capture new_content-%}
              {%- assign type = "banners" -%}
              {%- assign old_local_content = new_content -%}

              {% include 'article-replace-content' %}
            {%- endcapture -%}
          {%- endif -%}

          {%- capture new_content-%}
            {%- assign type = "links" -%}
            {%- assign old_local_content = new_content -%}

            {% include 'article-replace-content' %}
          {%- endcapture -%}


          <div class="article-template__content page-width" itemprop="articleBody" {{ block.shopify_attributes }} data-aos="fade-up">
            {{ new_content }}
          </div>
    {%- endcase -%}
  {%- endfor -%}
</article>

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Article",
    "articleBody": {{ article.content | strip_html | json }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ shop.url | append: page.url | json }}
    },
    "headline": {{ article.title | json }},
    {% if article.excerpt != blank %}
      "description": {{ article.excerpt | strip_html | json }},
    {% endif %}
    {% if article.image %}
      {% assign image_size = article.image.width | append: 'x' %}
      "image": [
        {{ article | img_url: image_size | prepend: "https:" | json }}
      ],
    {% endif %}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "author": {
      "@type": "Person",
      "name": {{ article.author | json }}
    },
    "publisher": {
      "@type": "Organization",
      {% if settings.share_image %}
        {% assign image_size = settings.share_image.width | append: 'x' %}
        "logo": {
          "@type": "ImageObject",
          "height": {{ settings.share_image.height | json }},
          "url": {{ settings.share_image | img_url: image_size | prepend: "https:" | json }},
          "width": {{ settings.share_image.width | json }}
        },
      {% endif %}
      "name": {{ shop.name | json }}
    }
  }
  </script>


{% schema %}
{
  "name": "t:sections.main-article.name",
  "tag": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "featured_image",
      "name": "t:sections.main-article.blocks.featured_image.name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "title",
      "name": "t:sections.main-article.blocks.title.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "blog_show_date",
          "default": true,
          "label": "t:sections.main-article.blocks.title.settings.blog_show_date.label"
        },
        {
          "type": "checkbox",
          "id": "blog_show_author",
          "default": false,
          "label": "t:sections.main-article.blocks.title.settings.blog_show_author.label"
        },
        {
          "type": "header",
          "content": "Share links"
        },
        {
          "type": "checkbox",
          "id": "share_link",
          "default": false,
          "label": "Share link"
        },
        {
          "type": "checkbox",
          "id": "share_facebook",
          "default": false,
          "label": "Share facebook"
        },
        {
          "type": "checkbox",
          "id": "share_mail",
          "default": false,
          "label": "Share mail"
        },
        {
          "type": "checkbox",
          "id": "share_twitter",
          "default": false,
          "label": "Share twitter"
        },
        {
          "type": "checkbox",
          "id": "share_pinterest",
          "default": false,
          "label": "Share pinterest"
        }
      ]
    },
    {
      "type": "content",
      "name": "t:sections.main-article.blocks.content.name",
      "limit": 1
    }
  ]
}
{% endschema %}
