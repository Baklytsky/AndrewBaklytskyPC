{%- render 'countdown-timer', section: section -%}

{% schema %}
{
  "name": "Countdown timer",
  "tag": "section",
  "class": "section-countdown",
  "settings": [
    {
      "type": "header",
      "content": "Paddings"
    },
    {
      "type": "range",
      "id": "vertical_padding_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Vertical padding (Desktop)",
      "default": 20
    },
    {
      "type": "range",
      "id": "vertical_padding_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Vertical padding (Mobile)",
      "default": 10
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background",
      "default": "linear-gradient(#000000, #000000)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "justification",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "space-between",
          "label": "Space between"
        },
        {
          "value": "space-evenly",
          "label": "Space evenly"
        }
      ],
      "default": "space-between",
      "label": "Content justification (desktop)"
    },
    {
      "type": "header",
      "content": "Date"
    },
    {
      "type": "paragraph",
      "content": "Expiration date is calculated from the [store primary timezone](https://admin.shopify.com/store/ccdc23/settings/general)."
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "Expiration date",
      "info": "Use the format YYYY-MM-DD HH:MM (hours and minutes are optional). Do not use a date farther than 99 days."
    },
    {
      "type": "select",
      "id": "action",
      "options": [
        {
          "value": "leave",
          "label": "Leave timer at zero"
        },
        {
          "value": "hide",
          "label": "Hide section"
        }
      ],
      "default": "hide",
      "label": "When timer expires..."
    }
  ],
  "presets": [
    {
      "name": "Countdown timer"
    }
  ]
}
{% endschema %}
