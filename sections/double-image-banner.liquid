{{ 'section-double-image-banner.css' | asset_url | stylesheet_tag }}

{% liquid
	assign anchor_link = section.settings.anchor_link
	assign padding_top = section.settings.padding_top
	assign padding_bottom = section.settings.padding_bottom
%}

{%- style -%}
	.double-banner__wrapper {
		padding: {{ padding_top }}px 0 {{ padding_bottom }}px 0;
	}
	@media screen and (max-width: 749px) {
		.double-banner__wrapper {
			padding: calc({{ padding_top }}px / 2) 0 calc({{ padding_bottom }}px / 2) 0;
		}
	}

	#Double-banner-{{ section.id }}::after {
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }

  {%- if section.settings.desktop_text_box_color != blank or section.settings.modile_text_box_color != blank -%}
    {%- if section.settings.desktop_text_box_color != blank -%}
      @media screen and (min-width: 750px) {
        #Double-banner-{{ section.id }} .double-banner__box {
          color: {{ section.settings.desktop_text_box_color }};
        }
      }
    {%- endif -%}

    {%- if section.settings.mobile_text_box_color != blank -%}
      @media screen and (max-width: 749px) {
        #Double-banner-{{ section.id }} .double-banner__box {
          color: {{ section.settings.mobile_text_box_color }};
        }
      }
    {%- endif -%}
  {%- endif -%}
{%- endstyle -%}

<div class="double-banner__wrapper">
	<div id="Double-banner-{{ section.id }}" class="double-banner double-banner__{{ section.settings.desktop_text_box_position }}">
		{%- if section.settings.image != blank -%}
			<div class="double-banner__media media{% if section.settings.image_2 != blank %} double-banner__media-half-right{% endif %}{% if section.settings.image_mobile != blank %} large-hide{% endif %}">
				{% render 'image', image: section.settings.image %}
			</div>
		{%- endif -%}
		{%- if section.settings.image_2 != blank -%}
			<div class="double-banner__media media{% if section.settings.image != blank %} double-banner__media-half-left large-hide{% endif %}{% if section.settings.image_mobile != blank %} large-hide{% endif %}">
				{% render 'image', image: section.settings.image_2 %}
			</div>
		{%- endif -%}
		{%- if section.settings.image_mobile != blank -%}
			<div class="double-banner__media media large-up-hide">
				{% render 'image', image: section.settings.image_mobile %}
			</div>
		{%- endif -%}
		<div class="double-banner__content" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
			<div class="double-banner__box">
				{%- for block in section.blocks -%}
					{%- case block.type -%}
						{%- when 'heading' -%}
							<h2 class="double-banner__heading h2" {{ block.shopify_attributes }}>
								{{ block.settings.heading | escape }}
							</h2>
						{%- when 'text' -%}
							<div class="double-banner__text" {{ block.shopify_attributes }}>
								{{ block.settings.text | escape }}
							</div>
						{%- when 'button' -%}
							{%- if block.settings.button_label != blank -%}
								<a{% if block.settings.button_link == blank %} role="link" aria-disabled="true"{% else %}
									href="{{ block.settings.button_link }}"{% endif %}
									class="double-banner__button button button--{{ block.settings.desktop_button_style }} large-hide"
									{{ block.shopify_attributes }}>
									{{ block.settings.button_label | escape }}
								</a>
								<a{% if block.settings.button_link == blank %} role="link" aria-disabled="true"{% else %}
									href="{{ block.settings.button_link }}"{% endif %}
									class="double-banner__button button button--{{ block.settings.mobile_button_style }} large-up-hide"
									{{ block.shopify_attributes }}>
									{{ block.settings.button_label | escape }}
								</a>
							{%- endif -%}
					{%- endcase -%}
				{%- endfor -%}
			</div>
		</div>
	</div>
</div>

{% schema %}
{
  "name": "Double image banner",
  "tag": "section",
  "class": "section-double-banner page-width",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "First image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Second image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 0
    },
    {
      "type": "select",
      "id": "desktop_text_box_position",
      "label": "Desktop text box position",
      "options": [
        {
          "value": "top-left",
          "label": "Top Left"
        },
        {
          "value": "top-center",
          "label": "Top Center"
        },
        {
          "value": "top-right",
          "label": "Top Right"
        },
        {
          "value": "middle-left",
          "label": "Middle Left"
        },
        {
          "value": "middle-center",
          "label": "Middle Center"
        },
        {
          "value": "middle-right",
          "label": "Middle Right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom Left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom Center"
        },
        {
          "value": "bottom-right",
          "label": "Bottom Right"
        }
      ],
      "default": "middle-left"
    },
    {
      "type": "color",
      "id": "desktop_text_box_color",
      "label": "Desktop text box color",
      "default": "#F9F9F9"
    },
    {
      "type": "header",
      "content": "t:sections.image-banner.settings.header.content"
    },
    {
      "type": "color",
      "id": "mobile_text_box_color",
      "label": "Mobile text box color",
      "default": "#F9F9F9"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Desktop padding top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Desktop padding bottom",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.image-banner.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Image banner",
          "label": "t:sections.image-banner.blocks.heading.settings.heading.label"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.image-banner.blocks.text.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Give customers details about the banner image(s) or content on the template.",
          "label": "t:sections.image-banner.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "Button label",
          "info": "t:sections.image-banner.blocks.buttons.settings.button_label_1.info"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "desktop_button_style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "transparent",
              "label": "Transparent"
            }
          ],
          "default": "primary",
          "label": "Desktop button style"
        },
        {
          "type": "select",
          "id": "mobile_button_style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "transparent",
              "label": "Transparent"
            }
          ],
          "default": "primary",
          "label": "Mobile button style"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Double image banner",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
