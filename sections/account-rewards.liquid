{% liquid
  assign heading = section.settings.heading
  assign image = section.settings.image
  assign text = section.settings.text
  assign bottom_text = section.settings.bottom_text
%}

<div class="account-rewards__inner">
  {%- if heading != blank -%}
     <h3 class="account-rewards__heading">{{ heading }}</h3>
  {%- endif -%}

  {%- if text != blank -%}
    <p class="body1 account-rewards__text">{{ text }}</p>
  {%- endif -%}

  <div class="account-rewards__content">
    {%- if image != blank -%}
      {%- render 'image', image: image, class_name: 'account-rewards__image', preload: true -%}
    {%- endif -%}

    <ul class="account-rewards__list">
      {%- for i in (1..3) -%}
        {%- liquid
          assign step_heading_key = 'step_heading_' | append: i
          assign step_text_key = 'step_text_' | append: i
          assign step_cta_image_1_key = 'step_cta_image_1_' | append: i
          assign step_cta_image_2_key = 'step_cta_image_2_' | append: i
          assign step_cta_url_1__key = 'step_cta_url_1_' | append: i
          assign step_cta_url_2__key = 'step_cta_url_2_' | append: i

          assign step_heading = section.settings[step_heading_key]
          assign step_text = section.settings[step_text_key]
          assign step_cta_image_1 = section.settings[step_cta_image_1_key]
          assign step_cta_image_2 = section.settings[step_cta_image_2_key]
          assign step_cta_url_1 = section.settings[step_cta_url_1__key]
          assign step_cta_url_2 = section.settings[step_cta_url_2__key]
        -%}

        {%- if step_heading != blank or step_text != blank or step_cta_image_1 != blank -%}
          <li class="account-rewards__item">
            <span class="body1 account-rewards__item-index">{{ i }}</span>

            <div class="account-rewards__item-content">
              {%- if step_heading != blank -%}
                <h5 class="account-rewards__item-heading">{{ step_heading }}</h5>
              {%- endif -%}

              {%- if step_text != blank -%}
                <div class="account-rewards__item-text">{{ step_text }}</div>
              {%- endif -%}

              {%- if step_cta_image_1 != blank or step_cta_image_2 != blank -%}
                <div class="account-rewards__item-ctas">
                  {%- if step_cta_image_1 != blank and step_cta_url_1 != blank -%}
                    <a href="{{ step_cta_url_1 }}" target="_blank">{{ step_cta_image_1 }}</a>
                  {%- endif -%}

                  {%- if step_cta_image_2 != blank and step_cta_url_2 != blank -%}
                    <a href="{{ step_cta_url_2 }}" target="_blank">{{ step_cta_image_2 }}</a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </li>
        {%- endif -%}

      {%- endfor -%}
    </ul>
  </div>

  {%- if bottom_text != blank -%}
    <p class="body3 account-rewards__bottom_text">{{ bottom_text }}</p>
  {%- endif -%}
</div>


{% schema %}
{
  "name": "Rewards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "textarea",
      "id": "bottom_text",
      "label": "Bottom text"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Content step 1"
    },
    {
      "type": "text",
      "id": "step_heading_1",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "step_text_1",
      "label": "Text"
    },
    {
      "type": "html",
      "id": "step_cta_image_1_1",
      "label": "CTA SVG 1"
    },
    {
      "type": "url",
      "id": "step_cta_url_1_1",
      "label": "CTA URL 1"
    },
    {
      "type": "html",
      "id": "step_cta_image_2_1",
      "label": "CTA SVG 2"
    },
    {
      "type": "url",
      "id": "step_cta_url_2_1",
      "label": "CTA URL 2"
    },
    {
      "type": "header",
      "content": "Content step 2"
    },
    {
      "type": "text",
      "id": "step_heading_2",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "step_text_2",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Content step 3"
    },
    {
      "type": "text",
      "id": "step_heading_3",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "step_text_3",
      "label": "Text"
    }
  ]
}
{% endschema %}
