{%- assign no_image = section.settings.no_image -%}
{%- assign section_height = section.settings.section_height | append: 'px' -%}
{%- assign mobile_padding_top = section.settings.mobile_padding_top | append: 'rem' -%}
{%- assign mobile_padding_bottom = section.settings.mobile_padding_bottom | append: 'rem' -%}
{%- assign desktop_padding_top = section.settings.desktop_padding_top | append: 'rem' -%}
{%- assign desktop_padding_bottom = section.settings.desktop_padding_bottom | append: 'rem' -%}
{%- assign consider_header_height = section.settings.consider_header_height -%}
{%- assign bg_color = section.settings.bg_color -%}


{% style %}
  #collection__header-{{- section.id }} {
    --section-height: {{ section_height }};
    --mt: {{ mobile_padding_top }};
    --mb: {{ mobile_padding_bottom }};
    --dt: {{ desktop_padding_top }};
    --db: {{ desktop_padding_bottom }};
  {% if consider_header_height %}
    --mt: calc({{ mobile_padding_top }} + 152px);
    --dt: calc({{ desktop_padding_top }} + 152px);
  {% endif %}

  background: {{ bg_color }};
  }
{% endstyle %}


<div id="collection__header-{{- section.id }}"
     style="--section-height: {{ section_height }}; --bg-color: {{ bg_color }};"
     class="collection__header
             min-h-[var(--section-height)]
             mt-[var(--mt)]
             mb-[var(--mb)]
             md:mt-[var(--dt)]
             md:mb-[var(--db)]">
  <div class="collection__header-background absolute w-full min-h-[var(--section-height)]"></div>
  <div class="collection__header-content text-grey-100 relative
    w-full
    min-h-[var(--section-height)]
    flex
    flex-col
    items-start
    justify-end
    ">
    {% if section.settings.collection_title != blank or section.settings.collection_description != blank %}
      <div class="collection__header--copy w-full mx-auto pb-12 px-6 md:px-24 flex
      flex-col
      {% if section.settings.text_position == 'right' %}
        md:items-end
      {% elsif section.settings.text_position == 'left' %}
        md:items-start
      {% elsif section.settings.text_position == 'center' %}
        md:items-center
      {% endif %}
      {% if section.settings.text_alignment_desktop == 'right' %}
        md:text-right
      {% elsif section.settings.text_alignment_desktop == 'left' %}
        md:text-left
      {% elsif section.settings.text_alignment_desktop == 'center' %}
        md:text-center
      {% endif %}
      {% if section.settings.text_alignment_mobile == 'right' %}
        text-right
      {% elsif section.settings.text_alignment_mobile == 'left' %}
        text-left
      {% elsif section.settings.text_alignment_mobile == 'center' %}
        text-center
      {% endif %}
      ">

        {%- capture eyebrow_styles -%}
          {% if section.settings.color_overrides_enabled %}
            color: {{ section.settings.eyebrow_color }};
          {% endif %}
        {%- endcapture -%}

        {% if section.settings.collection_title != blank %}
          <span style="{{ eyebrow_styles }}">{{ section.settings.collection_title }}</span>
        {% endif %}

        {% capture heading_styles %}
          {% if section.settings.color_overrides_enabled %}
            color: {{ section.settings.heading_color }};
          {% endif %}
        {% endcapture %}

        {% if section.settings.heading != blank %}
          <{{ section.settings.heading_level }}
          class="ra-title ra-hero__title {{ section.settings.heading_style }}"
          style="{{ heading_styles }}">
          {{ section.settings.heading }}
          </{{ section.settings.heading_level }}>
        {% endif %}

        {%- capture description_styles -%}
          {% if section.settings.color_overrides_enabled %}
            color: {{ section.settings.description_color }};
          {% endif %}
        {%- endcapture -%}

        {% if section.settings.collection_description != blank %}
          <span class="collection__header--description mono-24" style="{{ description_styles }}">
            {{ section.settings.collection_description }}
          </span>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

<style>
  {%- unless no_image -%}
    #collection__header-{{- section.id }} .collection__header-background {
      background-image: url({{ section.settings.header_image | img_url: 'master' }});
      background-size: cover;
      background-position: top;
    }
    {%- assign header_image_mobile = section.settings.header_image_mobile | default: section.settings.header_image -%}
    @media (max-width: 768px) {
      #collection__header-{{- section.id }} .collection__header-background {
        background-image: url({{ header_image_mobile | img_url: '1536x' }});
      }
    }
  {%- endunless -%}

  @media (min-width: 768px) {
    #collection__header-{{- section.id }} .collection__header--copy h1,
    #collection__header-{{- section.id }} .collection__header--copy .collection__header--description {
      width: {{ section.settings.text_width }}px;
    }
  }

  {% unless section.settings.color_overrides_enabled %}
    #collection__header-{{- section.id }} .collection__header--copy * {
      color: var({{ section.settings.text_color }});
    }
  {% endunless %}


</style>

{% schema %}
{
  "name": "Collection Header",
  "settings": [
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FAFAF9"
    },
    {
      "type": "checkbox",
      "id": "color_overrides_enabled",
      "label": "Use Color Overrides",
      "default": false
    },
    {
      "type": "text",
      "id": "collection_title",
      "label": "Eyebrow Text"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Title Color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Title Level",
      "info": "Choose the semantic H-Tag for this title (Note - please do not update)",
      "options": [{"label":"H1","value":"h1"},{"label":"H2","value":"h2"},{"label":"H3","value":"h3"},{"label":"H4","value":"h4"},{"label":"H5","value":"h5"},{"label":"H6","value":"h6"}],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Title Style",
      "info": "Choose the styling of the header",
      "options": [{"label":"H1","value":"h1"},{"label":"H2","value":"h2"},{"label":"H3","value":"h3"},{"label":"H4","value":"h4"},{"label":"H5","value":"h5"},{"label":"H6","value":"h6"}],
      "default": "h3"
    },
    {
      "type": "richtext",
      "id": "collection_description",
      "label": "Description"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_alignment_desktop",
      "label": "Text Alignment Desktop",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Text Alignment Mobile",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "text_width",
      "label": "Text Width",
      "min": 200,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "default": 400
    },
    {
      "type": "image_picker",
      "id": "header_image",
      "label": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "header_image_mobile",
      "label": "Background Image Mobile"
    },
    {
      "type": "checkbox",
      "id": "no_image",
      "label": "No image"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "checkbox",
      "id": "consider_header_height",
      "label": "Consider Header Height",
      "default": false
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 100,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Section Height",
      "default": 300
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "rem",
      "label": "Mobile Padding Top (rem)",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "rem",
      "label": "Mobile Padding Bottom (rem)",
      "default": 3
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "rem",
      "label": "Desktop Padding Top (rem)",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "rem",
      "label": "Desktop Padding Bottom (rem)",
      "default": 3
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text Color",
      "options": [{"label":"White","value":"--white"},{"label":"Primary","value":"--text-primary"},{"label":"Secondary","value":"--text-secondary"},{"label":"Inverse primary","value":"--text-inverse-primary"},{"label":"Inverse secondary","value":"--text-inverse-secondary"}],
      "default": "--white"
    }
  ],
  "presets": [
    {
      "name": "Collection Header"
    }
  ]
}
{% endschema %}
