{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
	assign anchor_link = section.settings.anchor_link
  assign products_to_show = section.settings.products_to_show
  assign show_product_title = section.settings.show_product_title
  assign show_product_reviews = section.settings.show_product_reviews
  assign show_product_description = section.settings.show_product_description
  assign show_product_description_metafield = section.settings.show_product_description_metafield
  assign show_product_price = section.settings.show_product_price
  assign show_product_price_range = section.settings.show_product_price_range
  assign show_product_badge = section.settings.show_product_badge
  assign show_image_thumbnails = section.settings.show_image_thumbnails
  assign show_slider_arrows = section.settings.show_slider_arrows
  assign hide_slider_arrows_mobile = section.settings.hide_slider_arrows_mobile
  assign show_view_all = section.settings.show_view_all
  assign products_to_display = section.settings.products_to_show
  assign show_slider_pagination = section.settings.show_slider_pagination
  assign product_card_content_color_schema = section.settings.product_card_content_color_schema
	assign padding_top = section.settings.padding_top
	assign padding_bottom = section.settings.padding_bottom
-%}

{%- if section.blocks.size > 0 -%}
	<div class="section-featured-collection__wrapper" style="--padding-top: {{ padding_top }}px;
		--padding-bottom: {{ padding_bottom }}px;">
		<toggle-tabs class="featured-collection__tabs-wrapper" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
			<div class="page-width">
				<ul class="featured-collection__tabs-list featured-collection__tabs-list--{{ product_card_content_color_schema }} hide-scrollbar">
					{%- for block in section.blocks -%}
						{%- if block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
							{%- assign id = block.settings.collection.title | append: forloop.index -%}
							{%- assign hash = id | hmac_sha1: 'featured collection' -%}
							{%- assign tab_text = block.settings.collection_title | default: block.settings.collection.title -%}

							<li {{ block.shopify_attributes }}>
								<button class="featured-collection__tab"
												type="button"
												data-action="toggle-tab"
												aria-controls="tab-{{ hash }}"
												data-selected="{% if forloop.first %}true{% else %}false{% endif %}">
									{{ tab_text }}
								</button>
							</li>
						{%- endif -%}
					{%- endfor -%}
				</ul>
			</div>

			{%- for block in section.blocks -%}
				{%- if block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
					{%- assign id = block.settings.collection.title | append: forloop.index -%}
					{%- assign hash = id | hmac_sha1: 'featured collection' -%}
					{%- assign additional_title = block.settings.additional_title -%}
					{%- assign additional_url = block.settings.additional_url -%}
					{%- assign bg_block = block.settings.bg_block -%}
					{%- assign text_color_block = block.settings.text_color_block -%}


					{% capture config %}
						{
						"slidesPerView": 1.15,
						"spaceBetween": 24,
						"noSwipingSelector": "label",
						"watchOverflow": true,
						"navigation": {
						"nextEl": ".next-{{ section.id }}-{{ forloop.index }}",
						"prevEl": ".prev-{{ section.id }}-{{ forloop.index }}"
						},
						"pagination": {
						"el": ".swiper-pagination-{{ section.id }}-{{ forloop.index }}",
						"type": "progressbar"
						},
						"breakpoints": {
						"1980": {
						"slidesPerView": 2.5,
						"spaceBetween": 36
						},
						"1200": {
						"slidesPerView": 3,
						"spaceBetween": 36
						},
						"900": {
						"shortSwipes": false,
						"slidesPerView": 1.5,
						"spaceBetween": 24
						}
						}
						}
					{% endcapture %}

					<slideshow-swiper id="tab-{{ hash }}"
														class="featured-collection sections-featured-collection rel"
														data-config='{{ config }}'
														{% if show_slider_arrows %}data-arrows-appear="true"{% endif %}
														data-tab="tab-{{ hash }}"
														data-selected="{% if forloop.first %}true{% else %}false{% endif %}"
						{{ block.shopify_attributes }}>
						<div class="swiper page-width rel">
							<ul class="featured-collection__list swiper-wrapper" role="list">
								{%- assign card_class_name = 'featured-collection__product product-card--' | append: product_card_content_color_schema -%}

								{%- for product in block.settings.collection.products limit: products_to_show -%}

									{%- if product.tags contains 'hidden' -%}
										{% continue %}
									{%- endif -%}

									<li class="featured-collection__list-item rel swiper-slide" role="listitem">
										{% render 'product-card',
											product: product,
											hide_variants: false,
											uniq_id: forloop.index,
											show_product_title: show_product_title,
											show_product_reviews: show_product_reviews,
											show_product_description: show_product_description,
											show_product_description_metafield: show_product_description_metafield,
											show_product_price: show_product_price,
											show_product_price_range: show_product_price_range,
											show_product_badge: show_product_badge,
											show_color_options_size: true,
											show_image_thumbnails: show_image_thumbnails,
											custom_class: card_class_name %}
									</li>
								{%- endfor -%}

								{% if additional_title != blank %}
									<li class="featured-collection__list-item rel swiper-slide" role="listitem">
										<div class="featured-collection__additional-block" style="--bg-color-block: {{ bg_block }}; --text-color-block: {{ text_color_block }}">
											{% if additional_url != blank %}
												<a href="{{ additional_url }}" class="featured-collection__additional-block-title full-unstyled-link product-card__title h6">{{ additional_title }}</a>
											{% else %}
												<h3 class="featured-collection__additional-block-title product-card__title h6">{{ additional_title }}</h3>
											{% endif %}
										</div>
									</li>
								{% endif %}
							</ul>
							<div class="swiper-pagination swiper-pagination-{{ section.id }}-{{ forloop.index }} small-up-hide {% unless show_slider_pagination %}hidden{% endunless %}"></div>
						</div>
						{%- if show_slider_arrows -%}
							<div class="swiper-button-next next-{{ section.id }}-{{ forloop.index }} {% if hide_slider_arrows_mobile %}small-hide{% endif %}"></div>
							<div class="swiper-button-prev prev-{{ section.id }}-{{ forloop.index }} {% if hide_slider_arrows_mobile %}small-hide{% endif %}"></div>
						{%- endif -%}
					</slideshow-swiper>
				{%- endif -%}
			{%- endfor -%}
		</toggle-tabs>
	</div>
{%- endif -%}

{% schema %}
{
  "name": "Featured collections",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 4,
      "label": "t:sections.featured-collection.settings.products_to_show.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header.content"
    },
    {
      "type": "select",
      "id": "product_card_content_color_schema",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "white",
          "label": "White"
        }
      ],
      "default": "default",
      "label": "Product card content color schema"
    },
    {
      "type": "checkbox",
      "id": "show_product_title",
      "default": true,
      "label": "Show product title"
    },
    {
      "type": "checkbox",
      "id": "show_product_reviews",
      "default": true,
      "label": "Show product reviews"
    },
    {
      "type": "checkbox",
      "id": "show_product_description",
      "default": true,
      "label": "Show product description"
    },
    {
      "type": "checkbox",
      "id": "show_product_description_metafield",
      "default": false,
      "label": "Show product description from metafield"
    },
    {
      "type": "checkbox",
      "id": "show_product_price",
      "default": true,
      "label": "Show product price"
    },
    {
      "type": "checkbox",
      "id": "show_product_price_range",
      "default": true,
      "label": "Show product price range"
    },
    {
      "type": "checkbox",
      "id": "show_product_badge",
      "default": true,
      "label": "Show product badge"
    },
    {
      "type": "checkbox",
      "id": "show_image_thumbnails",
      "default": true,
      "label": "Show image thumbnails"
    },
    {
      "type": "checkbox",
      "id": "show_slider_arrows",
      "default": true,
      "label": "Show slider arrows"
    },
    {
      "type": "checkbox",
      "id": "hide_slider_arrows_mobile",
      "default": true,
      "label": "Hide slider arrows (mobile)"
    },
    {
      "type": "checkbox",
      "id": "show_slider_pagination",
      "default": false,
      "label": "Show slider pagination (mobile)"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Desktop padding top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Desktop padding bottom",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "text",
          "id": "collection_title",
          "label": "Collection title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.featured-collection.settings.collection.label"
        },
        {
          "type": "header",
          "content": "Additional block settings"
        },
        {
          "type": "text",
          "id": "additional_title",
          "label": "Additional block title",
					"default": "Shop All"
        },
        {
          "type": "url",
          "id": "additional_url",
          "label": "Additional block url"
        },
        {
          "type": "color",
          "id": "bg_block",
          "label": "Additional block background",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "text_color_block",
          "label": "Additional block color",
          "default": "#FFFFFF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured collections"
    }
  ]
}
{% endschema %}
