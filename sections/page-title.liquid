{{ 'section-page-title.css' | asset_url | stylesheet_tag }}

{%- assign heading = section.settings.heading | default: page.title -%}

<div class="hwd__wrapper page-width">
  {%- if heading != blank -%}
    <h1 class="h2 twd__heading">{{ heading }}</h1>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Page title",
  "tag": "section",
  "class": "hwd landing-colors",
  "settings": [],
  "presets": [
    {
      "name": "Page title"
    }
  ]
}
{% endschema %}
