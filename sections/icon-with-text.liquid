{{ 'icon-with-text.min.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_bg_color = section.settings.section_bg_color
  assign section_text_color = section.settings.section_text_color
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign button_style = section.settings.button_style
  assign show_slider_nav = section.settings.show_slider_nav -%}

{%- capture swiper_config -%}
  {
    "slidesPerView": 1.33,
    "spaceBetween": 20,
    {% if show_slider_nav -%}
      "navigation": {
        "nextEl": ".swiper-button-next--{{ section.id }}",
        "prevEl": ".swiper-button-prev--{{ section.id }}"
      },
      "pagination": {
        "el": ".swiper-pagination--{{ section.id }}",
        "type": "progressbar"
      },
    {% endif -%}
      "breakpoints": {
        "1024": {
        "slidesPerView": 3
      },
        "768": {
        "slidesPerView": 1.5
      }
    }
  }
{%- endcapture -%}

<div class="icon-with-text"
     data-aos="fade-up"
     style="--bg-color: {{ section_bg_color }};
       --color: {{ section_text_color }}">

  {%- if heading != blank or subheading != blank or button_label != blank -%}
    <div class="icon-with-text__header page-width">
      {%- if heading != blank -%}
        <h3 class="icon-with-text__header-heading h6">{{ heading }}</h3>
      {%- endif -%}
      {%- if button_label != blank or subheading != blank -%}
        <div class="icon-with-text__header-wrapper">
          {%- if subheading != blank -%}
            <div class="icon-with-text__header-subheading h4">
              {{ subheading | escape | newline_to_br }}
            </div>
          {%- endif -%}
          {%- if button_label != blank -%}
            <a{% if button_link == blank %} role="link" aria-disabled="true" disabled{% else %}
              href="{{ button_link }}"{% endif %}
              class="icon-with-text__header-btn btn btn--{{ button_style }}">
              {{ button_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}

    {%- capture slides -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign icon = block.settings.icon
          assign svg_size = block.settings.svg_size
          assign description = block.settings.description
        -%}

        {%- if icon != blank or description != blank -%}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="icon-with-text__block" style="--svg-size: {{ svg_size | append: '%' }}">
              {%- if icon != blank -%}
                <div class="icon-with-text__block-icon">
                  {{ icon }}
                </div>
              {%- endif -%}
              {%- if description != blank -%}
                <div class="icon-with-text__block-description body1">
                  {{ description }}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

      {%- endfor -%}
    {%- endcapture -%}

  {%- else -%}

    {%- capture slides -%}
      {%- for i in (1..3) -%}
        <div class="swiper-slide">
          <div class="icon-with-text__block">
            <div class="icon-with-text__block-icon-empty"></div>
            <div class="icon-with-text__block-description body1">
              {{ 'icon_with_text.empty_block_description' | t }}
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endcapture -%}

  {%- endif -%}

  {%- render 'slideshow-swiper',
    class_name: 'icon-with-text__slider rel',
    config: swiper_config,
    slides: slides,
    show_slider_nav: show_slider_nav,
    nav_id: section.id -%}
</div>


{% schema %}
{
  "name": "Icon-text blocks",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Background color",
      "default": "#F9F9F9"
    },
    {
      "type": "color",
      "id": "section_text_color",
      "label": "Text color",
      "default": "#383838"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "primary-alt",
          "label": "Primary alternative"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "secondary-alt",
          "label": "Secondary alternative"
        }
      ],
      "default": "secondary"
    },
    {
      "type": "header",
      "content": "Slider settings"
    },
    {
      "type": "checkbox",
      "id": "show_slider_nav",
      "label": "Show slider navigation",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "block",
      "name": "block",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "SVG icon"
        },
        {
          "type": "range",
          "id": "svg_size",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "SVG size",
          "default": 40
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon-text blocks"
    }
  ]
}
{% endschema %}
