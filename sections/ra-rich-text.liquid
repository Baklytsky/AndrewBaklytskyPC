{% style %}
  #shopify-section-{{- section.id -}} {
  --component-bg-color: {{- section.settings.bg_color -}};
  --component-bg-color-md: {{- section.settings.bg_color_md -}};
  --component-bg-opacity: {{ section.settings.bg_opacity | divided_by: 100.00 }};
  --component-fg-color: {{- section.settings.text_color_mobile -}};
  --component-fg-color-md: {{- section.settings.text_color_desktop -}};
  {% if section.settings.padding_y_mobile != 0 %}
  --component-custom-spacing-mobile: {{ section.settings.padding_y_mobile }}px;
  {% endif %}
  {% if section.settings.padding_y_desktop != 0 %}
  --component-custom-spacing-desktop: {{ section.settings.padding_y_desktop }}px;
  {% endif %}
  {% if section.settings.background_image != blank %}
  background-image: url('https:{{ section.settings.background_image | img_url: '800x' }}');;
  {% endif %}

  }
{% endstyle %}

<article class="ra-text-only-banner
  set--spacing-top-{{ section.settings.spacing_top }}
  set--spacing-bottom-{{ section.settings.spacing_bottom }}
  gutter--{{ section.settings.spacing_edge }}
  {% if section.settings.background_image != blank %}
   bg-[--component-bg-image]
  {% endif %}
  {% if section.settings.increased_mobile_spacing %}
   ra-text-only-banner--increased_mobile_padding
  {% endif %}

  {% if section.settings.padding_y_mobile != 0 or section.settings.padding_y_desktop != 0 %}
    ra-text-only-banner--custom-padding
  {% endif %}
  {{ section.settings.custom_selector }}
">
  <div class="ra-text-only-banner__bg-frame absolute w-full h-full top-0 left-0
  {% if section.settings.background_image != blank %}
    backdrop-blur-[50px]
  {% endif %}
  "></div>
  <div class="ra-text-only-banner__bg-frame absolute w-full h-full top-0 left-0 bg-[--component-bg-color] md:bg-[--component-bg-color-md] opacity-[--component-bg-opacity]
  "></div>
  <div class="ra-text-only-banner__details max-width--{{ section.settings.max_width }}">
    <div class="ra-text-only-banner__copy set--h-align-{{ section.settings.horizontal_align }}-sm set--h-align-{{ section.settings.horizontal_align_md }}-md">
    {% comment %} <h3>{{- section.settings.background_image | image_url: '800x' -}} is bg image </h3> {% endcomment %}
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'title' %}
            {% assign title_level = block.settings.title_level %}
            {% if block.settings.title != blank %}
              <{{ title_level }} class="ra-title ra-text-only-banner__title {{ block.settings.title_style }} {% if block.settings.indent_title == true %} ml-[4.2rem] {% endif %}">
                {{ block.settings.title }}
              </{{ title_level }}>
            {% endif %}
          {% when 'subtitle' %}
            {% if block.settings.eyebrow_text != blank %}
              <div class="ra-text-only-banner__subtitle">{{- block.settings.eyebrow_text -}}</div>
            {% endif %}
          {% when 'body_copy' %}
            {% if block.settings.description != blank %}
              <div class="ra-text-only-banner__description {{ block.settings.description_copy_size }} rte ">
                {{- block.settings.description -}}
              </div>
            {% endif %}
          {% when 'block_quote' %}
            {% if block.settings.block_quote != blank %}
              <div class="ra-text-only-banner__description rte w-4/5">
                {% if block.settings.enable_quotes %}
                  {% if block.settings.opening_quote_image != blank %}
                    {% comment %}theme-check-disable ImgWidthAndHeight{% endcomment %}
                    <img class="float-left relative top-[-8px]" loading="eager" src="{{ block.settings.opening_quote_image | image_url: width: 20 }}" />
                  {% else %}
                    {% render 'ra-icon', icon: 'quote-open', size: 'md' width: '16px', height: '16px', color: 'inherit', class: 'top-[-6px]' %}
                  {% endif %}
                {% endif %}
                {{- block.settings.block_quote -}}
                {% if block.settings.enable_quotes %}
                  {% if block.settings.closing_quote_image != blank %}
                    {% comment %}theme-check-disable ImgWidthAndHeight{% endcomment %}
                    <img class="float-right relative bottom-[-18px]" loading="eager" src="{{ block.settings.closing_quote_image | image_url: width: 20 }}" />
                  {% else %}
                    {% render 'ra-icon', icon: 'quote-close', size: 'md' width: '16px', height: '16px', color: 'inherit', class: 'bottom-[-6px]' %}
                  {% endif %}
                {% endif %}
              </div>
            {% endif %}
          {% when 'ctas' %}
            {% liquid
              assign cta_1_text = block.settings.cta_1_text
              assign cta_1_url = block.settings.cta_1_url
              assign open_new_tab_1 = block.settings.open_new_tab_1
              assign cta_js_1 = block.settings.cta_js_1
              assign cta_1_style = block.settings.cta_1_style

              assign cta_2_text = block.settings.cta_2_text
              assign cta_2_url = block.settings.cta_2_url
              assign open_new_tab_2 = block.settings.open_new_tab_2
              assign cta_js_2 = block.settings.cta_js_2
              assign cta_2_style = block.settings.cta_2_style

              assign enable_cta_1 = false
              assign enable_cta_2 = false

              if cta_1_text != blank and cta_1_url != blank
                assign enable_cta_1 = true
              endif

              if cta_2_text != blank and cta_2_url != blank
                assign enable_cta_2 = true
              endif
            %}
            {% if enable_cta_1 or enable_cta_2 %}
              <div class="ra-link-list ra-text-only-banner__link-list">
                {% if enable_cta_1 %}
                  {% render 'ra-button',
                    type: 'a',
                    style: cta_1_style,
                    url: cta_1_url,
                    new_tab: open_new_tab_1,
                    js: cta_js_1,
                    label: cta_1_text,
                    class: 'ra-link-list min-w-[175px]'
                  %}
                {% endif %}
                {% if enable_cta_2 %}
                  {% render 'ra-button',
                    type: 'a',
                    style: cta_2_style,
                    url: cta_2_url,
                    new_tab: open_new_tab_2,
                    js: cta_js_2,
                    label: cta_2_text,
                    class: 'ra-link-list min-w-[175px]'
                  %}
                {% endif %}
              </div>
            {% endif %}
        {% endcase %}
      {% endfor %}


    </div>
  </div>
</article>

{% schema %}
