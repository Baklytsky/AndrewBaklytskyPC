{%- if section.blocks.size > 0 -%}
  {{ 'section-animated-text-columns.css' | asset_url | stylesheet_tag }}

  {%- assign scroll_animation = section.settings.scroll_animation -%}
	{%- assign anchor_link = section.settings.anchor_link -%}
  
  <div class="animated-text-columns {% if section.settings.color_theme == 'black' %}landing-colors{% endif %}" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
    <div class="page-width {% if scroll_animation %}animated-text-columns-wrapper-{{ section.id }}{% endif %}">
      <ul class="animated-tc__list  {% if scroll_animation %}running-tc-animate-{{ section.id }}{% endif %}"  role="list">
        {%- for block in section.blocks -%}
          {%- assign text = block.settings.text -%}
          {%- assign heading = block.settings.heading -%}
        
          {%- if heading != blank and text != blank -%}
            <li class="animated-tc__item">
              {%- if heading != blank -%}
                <h4 class="h2 animated-tc__heading">
                  {{ heading }}
                </h4>
              {%- endif -%}
            
              {%- if text != blank -%}
                <div class="animated-tc__text rte">
                  {{ text }}
                </div>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
  {%- if scroll_animation -%}
    <script>
      (function observerInit() {
        if (window.innerWidth > 750) {
          const transformElement = document.querySelector('.running-tc-animate-{{ section.id }}')
          const container = document.querySelector('.animated-text-columns-wrapper-{{ section.id }}')
          const observer = new IntersectionObserver(onIntersection, {
            root: null,
            threshold: .5
          });

          function onIntersection() {
            window.addEventListener('scroll', onScroll);
          }
          
          function onScroll () {
            const windowAspectRatio = (window.innerHeight / window.innerWidth);
            const scrollPosition = (window.scrollY + window.innerHeight);
            const startPosition = Math.round((transformElement.getBoundingClientRect().top + document.documentElement.scrollTop) + (transformElement.offsetHeight));
            const endPosition = Math.round((startPosition + window.innerHeight) - (transformElement.offsetHeight));
            const length = (endPosition - startPosition - transformElement.offsetHeight) / windowAspectRatio;
            const progress = Math.round((((scrollPosition - startPosition) / length) * -80) / windowAspectRatio) + 60;
            const percentage = Math.min(Math.max(0, progress), 100);
            transformElement.style.transform = `translateX(${ percentage }%)`;
          }

          observer.observe( document.querySelector('.running-tc-animate-{{ section.id }}'));
        }
      })()
    </script>
  {%- endif -%}

{%- endif -%}


{% schema %}
{
  "name": "Animated text columns",
  "max_blocks": 3,
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "select",
      "id": "color_theme",
      "label": "Color theme",
      "options": [
        {
          "value": "black",
          "label": "Black"
        },
        {
          "value": "white",
          "label": "White"
        }
      ],
      "default": "black"
    },
    {
      "type": "checkbox",
      "id": "scroll_animation",
      "label": "Animation on scroll"
    }
  ],
  "blocks": [
    {
      "type": "text-block",
      "name": "Text block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Animated text columns"
    }
  ]
}
{% endschema %}
