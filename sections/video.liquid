{{ 'video-section.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

{%- assign anchor_link = section.settings.anchor_link -%}

{%- if section.settings.video_mp4 != blank and section.settings.video_mp4_bg -%}
  {%- assign video_bg_section = true -%}
{%- endif -%}

<div id="{{ section.id }}" class="video-section__wrapper {% if video_bg_section %}video-section-bg{% endif %} {% if section.settings.color_theme == 'black' %}landing-colors{% endif %} video-section__wrapper-{{ section.id }}">
  <div class="{% unless section.settings.full_width %} page-width{% endunless %}" {% if anchor_link != blank %}id="{{ anchor_link }}"{% endif %}>
    <div class="{% if section.settings.full_width %} page-width{% endif %}">
      <h2 class="video-section__title">{{ section.settings.heading }}</h2>
    </div>
    <noscript>
      <div class="video-section__media">
        <a href="{{ section.settings.video_url }}" class="video-section__poster media media--transparent media--landscape{% if section.settings.cover_image == blank %} video-section__placeholder{% endif %}">
          {%- if section.settings.cover_image != blank -%}
            {% render 'image', image: section.settings.cover_image %}
          {%- else -%}
            {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
          {%- endif -%}
        </a>
      </div>
    </noscript>
    {%- if video_bg_section -%}
      <video class="deferred-media__mp4 deferred-media__bg" loop playsinline autoplay muted title="{{ section.settings.description | escape }}">
        <source src="{{ section.settings.video_mp4 }}" type="video/mp4">
      </video>
      {%- if section.settings.cover_image != blank -%}
        {% render 'image', image: section.settings.cover_image, class_name: 'image-abs-cover'%}
      {%- endif -%}
    {%- else -%}
      <deferred-media class="video-section__media deferred-media no-js-hidden" data-media-id="{{ section.settings.video_url.id }}">
        <button
          id="Deferred-Poster-Modal-{{ section.settings.video_url.id }}"
          class="video-section__poster media deferred-media__poster media--landscape"
          type="button">
          
          {%- if section.settings.cover_image != blank -%}
            {% render 'image', image: section.settings.cover_image %}
          {%- else -%}
            {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
          {%- endif -%}
          <span class="deferred-media__poster-button motion-reduce">
          {%- render 'icon-play' -%}
        </span>
        </button>
        <template>
          {%- if section.settings.video_mp4 == blank -%}
            
            {%- if section.settings.video_url.type == 'youtube' -%}
              <iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?enablejsapi=1&autoplay=1" class="js-youtube" allow="autoplay; encrypted-media" allowfullscreen title="{{ section.settings.description | escape }}"></iframe>
            {%- else -%}
              <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1" class="js-vimeo" allow="autoplay; encrypted-media" allowfullscreen title="{{ section.settings.description | escape }}"></iframe>
            {%- endif -%}
          
          {%- else -%}
            <video class="deferred-media__mp4" loop playsinline controls title="{{ section.settings.description | escape }}">
              <source src="{{ section.settings.video_mp4 }}" type="video/mp4">
            </video>
          {%- endif -%}
        
        </template>
      </deferred-media>
    {%- endif -%}

    {%- if section.settings.video_title != blank or section.settings.video_description != blank -%}
      <div class="video-section__info {% if section.settings.full_width %}page-width{% endif %}">
        {%- if section.settings.video_title != blank -%}
          <h3 class="video-section__info-title h5">
            {{ section.settings.video_title }}
          </h3>
        {%- endif -%}

        {%- if section.settings.video_description != blank -%}
          <p class="video-section__info-description">
            {{ section.settings.video_description }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- for i in (1..2) -%}
      {%- assign text_key = 'checkbox_button_text_' | append: i -%}
      {%- assign url_key = 'checkbox_button_url_' | append: i -%}
      {%- assign btn_url = section.settings[url_key] -%}
      {%- assign btn_text = section.settings[text_key] -%}

      {%- if btn_url != blank and btn_text != blank -%}
        {%- capture buttons -%}
          {{ buttons }}
          <button type="submit"
                  class="button button--secondary video-form__button"
                  data-url="{{ btn_url }}" disabled>
            {{ btn_text }}
          </button>
        {%- endcapture -%}
      {%- endif -%}
    {%- endfor -%}
    
    {%- if section.settings.show_button_checkbox and buttons != blank -%}
      <form action="{{ section.settings.checkbox_button_url }}" id="video-form-{{ section.id }}" class="video-section__form">
        {%- if section.settings.checkbox_text != blank or section.settings.checkbox_content != blank -%}
          <div class="video-section__form-input-wrapper
            {% if section.settings.clickable_content %}video-section__form-input-wrapper-clickable{% endif %}">
            
            {%- if section.settings.checkbox_content != blank -%}
              {{ section.settings.checkbox_content }}
            {%- endif -%}
  
            {%- if section.settings.checkbox_text != blank -%}
              <fieldset>
                <legend class="form__label u-sr-only">{{ section.settings.checkbox_text }}</legend>
                <input type="checkbox" id="video-checkbox-{{ section.id }}" required>
                <label for="video-checkbox-{{ section.id }}">{{ section.settings.checkbox_text }}</label>
              </fieldset>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if buttons -%}
          <div class="video-section__form-buttons-wrapper">
            {{ buttons }}
          </div>
        {%- endif -%}
      </form>
  
      <script>
        (function () {
          const form = document.getElementById('video-form-{{ section.id }}');
          const checkbox = form.querySelector('input');
          const buttons = form.querySelectorAll('button');
          
          form.addEventListener('change', function () {
            checkbox.checked
                ? buttons.forEach(btn => btn.removeAttribute('disabled'))
                : buttons.forEach(btn => btn.setAttribute('disabled', ''));
          });

          buttons.forEach(btn => btn.addEventListener('click', (e) => {
            e.preventDefault();
            form.action = e.target.dataset.url;
            form.submit();
          }))
        })();
      </script>
    {%- endif -%}
  </div>

  {%- unless section.settings.full_width -%}
    {%- style -%}
      @media screen and (max-width: 749px) {
        .video-section__wrapper-{{ section.id }} .video-section__media {
          width: calc(100% + 48px);
          margin-left: -24px;
        }
      }
    {%- endstyle -%}
  {%- endunless -%}
</div>

{% schema %}
{
  "name": "t:sections.video.name",
  "tag": "section",
  "class": "video-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_link",
      "label": "Anchor link"
    },
    {
      "type": "select",
      "id": "color_theme",
      "label": "Color theme",
      "options": [
        {
          "value": "black",
          "label": "Black"
        },
        {
          "value": "white",
          "label": "White"
        }
      ],
      "default": "black"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Video",
      "label": "t:sections.video.settings.heading.label"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.video.settings.cover_image.label"
    },
    {
      "type": "text",
      "id": "video_mp4",
      "info": "Only .mp4 is required for it to work. You can upload videos [here](https://truelinkswear.com/admin/settings/files) to get the url",
      "label": "Video file url .mp4"
    },
    {
      "type": "checkbox",
      "id": "video_mp4_bg",
      "label": "Use mp4 video as a background"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "default": "https:\/\/www.youtube.com\/watch?v=_9VUPq3SxOc",
      "label": "t:sections.video.settings.video_url.label",
      "placeholder": "t:sections.video.settings.video_url.placeholder",
      "info": "Displayed if the 'Video file url .mp4' is not added. Accept Youtube or Vimeo video"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:sections.video.settings.description.label",
      "info": "t:sections.video.settings.description.info"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.video.settings.full_width.label",
      "default": false
    },
    {
      "type": "header",
      "content": "Video info"
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "video_description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Checkbox with button"
    },
    {
      "type": "richtext",
      "id": "checkbox_content",
      "label": "Content"
    },
    {
      "type": "checkbox",
      "id": "clickable_content",
      "label": "Clickable content for checkbox"
    },
    {
      "type": "checkbox",
      "id": "show_button_checkbox",
      "label": "Show button and checkbox",
      "default": false
    },
    {
      "type": "textarea",
      "id": "checkbox_text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "checkbox_button_text_1",
      "label": "Button text (1)"
    },
    {
      "type": "url",
      "id": "checkbox_button_url_1",
      "label": "Button url (1)"
    },
    {
      "type": "text",
      "id": "checkbox_button_text_2",
      "label": "Button text (2)"
    },
    {
      "type": "url",
      "id": "checkbox_button_url_2",
      "label": "Button url (2)"
    }
  ],
  "presets": [
    {
      "name": "Video"
    }
  ]
}
  {% endschema %}
