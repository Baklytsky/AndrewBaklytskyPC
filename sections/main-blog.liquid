{{ 'blog.min.css' | asset_url | stylesheet_tag }}
{{ 'grid.min.css' | asset_url | stylesheet_tag }}
{{ 'page-header.min.css' | asset_url | stylesheet_tag }}

<script src="{{ 'component-page-header.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-show-more.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-custom-select.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-blog-filter.min.js' | asset_url }}" defer="defer"></script>


{%- liquid
  assign menu = section.settings.menu
  assign paginate_by = section.settings.paginate_by | plus: 0
  assign description = blog.metafields.main_info.description
-%}

{%- if menu and menu.links.size > 0 -%}
  {% render 'blog-navigation' link-list: menu %}
{%- endif -%}

{%- if blog.all_tags.size > 0 -%}
  <modal-dialog id="blog-filters-{{ section.id }}">
    <div class="popup blog-filters__modal" data-popup role="dialog" tabindex="-1" aria-modal="true" aria-hidden="true">
      <button class="btn--reset" type="button" data-close-popup>
        {%- render 'icon' with 'close' -%}
      </button>

      <div class="blog-filters__container">
        <div class="blog__filters blog__filters--modal">
          {%- comment -%}
            container for JS insertion
          {%- endcomment -%}
        </div>
      </div>
    </div>
  </modal-dialog>
{%- endif -%}

<div class="blog page-width" data-aos="fade-up">
  {% render 'page-header', description: description %}

  <div class="blog__content-wrapper">
    {%- paginate blog.articles by paginate_by -%}

    {%- if blog.all_tags.size > 0 -%}
      <modal-opener class="small-up-hide">
        <div class="blog__popup-opener link body2"
             id="blog-filters-open"
             aria-controls="#blog-filters-{{ section.id }}"
             aria-haspopup="true"
             aria-expanded="false">
          {% render 'icon' with 'filter' %}
        </div>
      </modal-opener>

      <div class="blog__filters">
        <blog-filter data-modal="blog-filters-{{ section.id }}">
          <div class="blog__filters-title body3--bold">
            {{ 'blogs.blog_page.filters_title' | t }}
          </div>

          <form action="{{ routes.root_url }}" class="blog__filters-form">
            <label tabindex="0" class="blog__filters-form-item">
              <input type="radio"
                     tabindex="-1"
                     name="tags"
                     value="{{ blog.url }}"
                     {% if request.path == blog.url %}checked{% endif %}>
              <span>{{ 'blogs.navigation.tags_link_to_blog' | t }}</span>
            </label>

            {%- for tag in blog.all_tags -%}
              {%- capture tag_url -%} {{- blog.url }}/tagged/{{ tag | handleize -}}{%- endcapture -%}

              <label tabindex="0" class="blog__filters-form-item">
                <input type="radio"
                     tabindex="-1"
                     name="tags"
                     value="{{ tag_url }}"
                     {% if request.path contains tag_url %}checked{% endif %}>
                <span>{{ tag | escape }}</span>
              </label>
            {%- endfor -%}
          </form>

          <button class="btn btn--primary-alt" type="button" data-close-popup>
            {{ 'blogs.blog_page.close_popup_btn' | t }}
          </button>
        </blog-filter>
      </div>
    {%- endif -%}

    <div id="blog-articles" class="blog__articles grid" data-id="{{ section.id }}">
      {%- for article in blog.articles -%}
        <div class="blog__article-wrapper" data-aos="fade-up">
          {%- render 'article-card', article: article, show_date: section.settings.show_date, show_author: section.settings.show_author -%}
        </div>
      {%- endfor -%}

      {%- if paginate.pages > 1 -%}
        {% include 'pagination', paginate: paginate %}
      {%- endif -%}
    </div>
  </div>

  {% endpaginate %}
</div>

{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Blogs list"
    },
    {
      "type": "header",
      "content": "t:sections.main-blog.settings.header.content"
    },
    {
      "type": "range",
      "id": "paginate_by",
      "min": 4,
      "max": 100,
      "step": 3,
      "unit": "Art",
      "label": "Articles per page",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.main-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.main-blog.settings.show_author.label"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main-blog.settings.paragraph.content"
    }
  ]
}
{% endschema %}
