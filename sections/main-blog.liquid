{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

<script src="{{ 'blog-button-load.js' | asset_url }}" defer="defer"></script>

{%- assign tag_count = 0 -%}
{%- assign show_navigation = section.settings.show_navigation -%}

{% capture blog_navigations %}
  <div class="blog-articles__nav-wrapper">
    <div class="blog-articles__nav">
      <blog-button-load
        data-target-container="#blog-articles"
        data-wrapper-siblings-elements=".blog-articles__nav"
        data-history-replace="true"
      >
        <a href="{{ blog.url }}"
           class="{% unless current_tags %}active{% endunless %}">
          All
        </a>
      </blog-button-load>
    
      {%- for tag in blog.all_tags -%}
        {%- assign tag_downcase = tag | downcase -%}
        {%- assign tag_handle = tag | handle -%}
      
        {%- if tag_downcase contains 'category:' -%}
          {%- assign tag_count = tag_count | plus: 1 -%}
          {%- assign tag_name = tag | remove: 'category:' | strip -%}
        
          <blog-button-load
            data-target-container="#blog-articles"
            data-wrapper-siblings-elements=".blog-articles__nav"
            data-history-replace="true"
          >
            <a href="{{ blog.url }}/tagged/{{ tag_handle }}"
               class="{% if current_tags contains tag %}active{% endif %}">
              {{ tag_name }}
            </a>
          </blog-button-load>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{% endcapture %}


{%- paginate blog.articles by 10 -%}
  
  {%- if tag_count > 1 and show_navigation -%}
    {{ blog_navigations }}
  {%- endif -%}

  <div class="main-blog page-width">
    <div id="blog-articles" data-section-id="{{ section.id }}">
      <div class="blog-articles">
        {%- for article in blog.articles -%}
          <div class="blog-articles__article article">
            {%- render 'article-card', article: article, show_date: section.settings.show_date,
              show_author: section.settings.show_author, show_link_to_article: section.settings.show_link_to_article,
              link_to_article_label: section.settings.link_to_article_label, show_description: section.settings.show_description
            -%}
          </div>
        {%- endfor -%}
      </div>
  
      {%- if paginate.next -%}
        <blog-button-load data-target-container="#blog-articles"
                          data-content-add=".blog-articles"
                          data-remove="true"
                          class="blog-articles__load-more"
        >
          <a href="{{ paginate.next.url }}" class="button button--secondary-border">
            Load More
          </a>
        </blog-button-load>
      {%- endif -%}
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_navigation",
      "default": false,
      "label": "Show navigation"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "default": false,
      "label": "Show description"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.main-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.main-blog.settings.show_author.label"
    },
    {
      "type": "checkbox",
      "id": "show_link_to_article",
      "default": false,
      "label": "Show link to article"
    },
    {
      "type": "text",
      "id": "link_to_article_label",
      "label": "Label: link to article"
    }
  ]
}
{% endschema %}
