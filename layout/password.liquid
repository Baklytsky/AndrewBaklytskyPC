<!doctype html>
<html class="no-js full-height" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | img_url: '32x32' }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>{{ shop.name }}</title>

    <meta name="description" content="{{ page_description | escape }}">

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {%- liquid
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', '700'
      assign body_font_semi_bold = settings.type_body_font | font_modify: 'weight', '600'
      assign body_font_medium = settings.type_body_font | font_modify: 'weight', '500'
      assign body_font_regular = settings.type_body_font | font_modify: 'weight', '400'
      assign body_font_light = settings.type_body_font | font_modify: 'weight', '300'
    %}

    {% style %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_semi_bold | font_face: font_display: 'swap' }}
      {{ body_font_medium | font_face: font_display: 'swap' }}
      {{ body_font_regular | font_face: font_display: 'swap' }}
      {{ body_font_light | font_face: font_display: 'swap' }}

      {%- comment -%}
        @font-face {
          font-family: 'Montserrat';
          font-style: normal;
          src: url('{{ "Montserrat-Bold.otf" | asset_url }}') format("opentype");
          font-weight: 700;
          font-display: swap;
        }

        @font-face {
          font-family: 'Montserrat';
          font-style: normal;
          src: url('{{ "Montserrat-SemiBold.otf" | asset_url }}') format("opentype");
          font-weight: 600;
          font-display: swap;
        }

        @font-face {
          font-family: 'Montserrat';
          font-style: normal;
          src: url('{{ "Montserrat-Medium.otf" | asset_url }}') format("opentype");
          font-weight: 500;
          font-display: swap;
        }

        @font-face {
          font-family: 'Montserrat';
          font-style: normal;
          src: url('{{ "Montserrat-Regular.otf" | asset_url }}') format("opentype");
          font-weight: 400;
          font-display: swap;
        }

        @font-face {
          font-family: 'Montserrat';
          font-style: normal;
          src: url('{{ "Montserrat-Light.otf" | asset_url }}') format("opentype");
          font-weight: 300;
          font-display: swap;
        }
      {%- endcomment -%}

      :root {
      --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
      --font-body-style: normal;
      --font-body-weight: 300;

      --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
      --font-heading-style: normal;
      --font-heading-weight: 600;

      --font-size-small: 12px;
      --font-size-base: 14px;
      --font-size-text: 16px;

      --font-size-heading-1: 120px;
      --font-size-heading-2: 60px;
      --font-size-heading-3: 48px;
      --font-size-heading-4: 36px;
      --font-size-heading-5: 24px;
      --font-size-heading-6: 18px;

      --color-base-text: {{ settings.colors_text.red }}, {{ settings.colors_text.green }}, {{ settings.colors_text.blue }};
      --color-lite-text: {{ settings.colors_light_text.red }}, {{ settings.colors_light_text.green }}, {{ settings.colors_light_text.blue }};
      --color-base-background-1: {{ settings.colors_background_1.red }}, {{ settings.colors_background_1.green }}, {{ settings.colors_background_1.blue }};
      --color-base-background-2: {{ settings.colors_background_2.red }}, {{ settings.colors_background_2.green }}, {{ settings.colors_background_2.blue }};
      --color-button-primary-text: {{ settings.colors_button_text_primary.red }}, {{ settings.colors_button_text_primary.green }}, {{ settings.colors_button_text_primary.blue }};
      --color-button-secondary-text: {{ settings.colors_button_text_secondary.red }}, {{ settings.colors_button_text_secondary.green }}, {{ settings.colors_button_text_secondary.blue }};
      --color-button-primary-bg: {{ settings.colors_button_bg_primary.red }}, {{ settings.colors_button_bg_primary.green }}, {{ settings.colors_button_bg_primary.blue }};
      --color-button-secondary-bg: {{ settings.colors_button_bg_secondary.red }}, {{ settings.colors_button_bg_secondary.green }}, {{ settings.colors_button_bg_secondary.blue }};
      --color-border: {{ settings.border_color.red }}, {{ settings.border_color.green }}, {{ settings.border_color.blue }};

      --page-width: {{ settings.page_width }}px;
      --page-width-margin: {% if settings.page_width == '1600' %}2{% else %}0{% endif %}rem;
      }

      *,
      *::before,
      *::after {
        box-sizing: inherit;
      }

      html {
        box-sizing: border-box;
        font-size: var(--font-size-text);
        height: 100%;
      }

      body {
        display: grid;
        grid-template-rows: auto auto 1fr auto;
        grid-template-columns: 100%;
        min-height: 100%;
        margin: 0;
        font-size: var(--font-size-text);
        letter-spacing: normal;
        line-height: 1.6;
        font-family: var(--font-body-family);
        font-style: var(--font-body-style);
        font-weight: var(--font-body-weight);
      }

      @media screen and (min-width: 750px) {
        body {
          font-size: var(--font-size-text);
        }
      }
    {% endstyle %}

    {%- unless settings.type_body_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}
    {%- unless settings.type_header_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_header_font | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}

    {{ 'section-password.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'component-list-social.css' | asset_url | stylesheet_tag }}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <script src="{{ 'libs.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'password-modal.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="password primary-bg">
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {% section 'main-password-header' %}

    <main id="MainContent" class="password-main">
      {{ content_for_layout }}
    </main>
    <footer>
      {% section 'main-password-footer' %}
    </footer>
  </body>
</html>
