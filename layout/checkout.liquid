<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ direction }}" class="{{ checkout_html_classes }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, user-scalable=0">
    <meta name="referrer" content="origin">

    <title>{{ page_title }}</title>

    {{ content_for_header }}

    {{ checkout_stylesheets }}
    {{ checkout_scripts }}


    <style>
      @font-face {
        font-family: 'Styrene B';
        src: url('{{ "StyreneB-Medium-Web.woff2" | asset_url }}') format('woff2'),
        url('{{ "StyreneB-Medium-Web.woff" | asset_url }}') format('woff');
        font-weight: 500;
        font-style: normal;
        font-stretch: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'Styrene B';
        src: url('{{ "StyreneB-Regular-Web.woff2" | asset_url }}') format('woff2'),
        url('{{ "StyreneB-Regular-Web.woff" | asset_url }}') format('woff');
        font-weight: 400;
        font-style: normal;
        font-stretch: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'Styrene B';
        src: url('{{ "StyreneB-Light-Web.woff2" | asset_url }}') format('woff2'),
        url('{{ "StyreneB-Light-Web.woff" | asset_url  }}') format('woff');
        font-weight: 300;
        font-style: normal;
        font-stretch: normal;
        font-display: swap;
      }

      body,h1,h2,h3,h4,h5,h6,p,div,span,input, input::placeholder {
        font-family: 'Styrene B', sans-serif;
      }
    </style>

{%- comment -%}
    <!-- Google Tag Manager (header snippet) -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-MS5BV4S');</script>
    <!-- End Google Tag Manager -->

    {%- assign discounts_titles = '' -%}
    {%- for discount_application in checkout.discount_applications -%}
      {%- assign discounts_titles = discounts_titles | append: ', ' | append: discount_application.title -%}
    {%- endfor -%}

    {%- assign discounts_titles = discounts_titles | remove_first: ', ' -%}

      <script>
        function getGA4ClientId() {
          let cookies = document.cookie.split(';');
          for(let i = 0; i < cookies.length; i++) {
            let cookie = cookies[i].trim();
            if(cookie.indexOf('_ga') == 0) {
              return cookie
            }
          }
          return undefined;
        }

        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-P0QDC3S0DC', {
          'page_referrer': document.referrer || '',
          'ga4_client_id': getGA4ClientId(),
          'event_timestamp': `${Date.now()}`,
          'page_type': '{{ template.name | capitalize }}',
          'd2c_member_id': '{{ customer.id }}',
          'b2b_partner_id': '{{ customer.metafields.professional_info.custom_id }}',
          'b2c_customer_id': ''
        });

      </script>
{%- endcomment -%}
  </head>
  <body>
    {{ skip_to_content_link }}

    <header class="banner" data-header role="banner">
      <div class="wrap">
        {{ content_for_logo }}
      </div>
    </header>

    {{ order_summary_toggle }}
    <div class="content" data-content>
      <div class="wrap">
        <div class="main">
          <header class="main__header" role="banner">
            {{ content_for_logo }}
            {{ breadcrumb }}
            {{ alternative_payment_methods }}
          </header>
          <main class="main__content" role="main">
            {{ content_for_layout }}
          </main>
          <footer class="main__footer" role="contentinfo">
            {{ content_for_footer }}
          </footer>
        </div>
        <aside class="sidebar" role="complementary">
          <div class="sidebar__header">
            {{ content_for_logo }}
          </div>
          <div class="sidebar__content">
            {{ content_for_order_summary }}
          </div>
        </aside>
      </div>
    </div>

    {{ tracking_code }}

    {%- comment -%}
    <!-- Google Tag Manager (body snippet) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MS5BV4S"
                      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    {%- endcomment -%}

    <script>
      window.dataLayer = window.dataLayer || [];
      const itemsData = [
        {% for line_item in checkout.line_items %}
          {%- assign promotion_prop_arr = line_item.properties['_promotion'] | split: ' | ' -%}
          {%- assign promotion_name = promotion_prop_arr[0]-%}
          {%- assign promotion_id = promotion_prop_arr[1]-%}
        {
          "item_id": "{{ line_item.id }}",
          "item_name": "{{ line_item.title }}",
          "coupon": "{{ line_item.line_level_discount_allocations[0].discount_application.title }}",
          "discount": "{{ line_item.line_level_total_discount | money_without_currency }}",
          "index": "{{ forloop.index }}",
          "item_brand": "{{ line_item.product.vendor }}",
          {% for collecton in line_item.product.collections limit: 5 %}
          "item_category{% unless forloop.first %}{{- forloop.index }}{% endunless %}": "{{ collecton.title | strip_html  | remove: '"'}}",
          {% endfor %}
          "item_list_name": "Cart line items list",
          "item_list_id": "cart-line-items",
          "item_variant": "{{ line_item.variant.title }}",
          "price": "{{ line_item.variant.price | money_without_currency }}",
          "quantity": "{{ line_item.quantity }}",
          "product_type": "{{ line_item.product.type }}",
          "promotion_id": "{{ promotion_id }}",
          "promotion_name": "{{ promotion_name }}",
          "creative_name": "",
          "creative_slot": ""
        }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ];

      if (Shopify.Checkout.page === 'thank_you') {
        window.dataLayer.push({ ecommerce: null });
        window.dataLayer.push({
          "event": "add_payment_info",
          "ecommerce": {
            "currency": "{{ shop.currency }}",
            "value": "{{ checkout.total_price | money_without_currency }}",
            "coupon": "{{ discounts_titles }}",
            "discount": "{{ checkout.discounts_amount | money }}",
            "payment_type": "Credit Cart",
            "shipping_tier": "{{ checkout.shipping_method.title }}",
            "items": itemsData
          }
        })

        window.dataLayer.push({ ecommerce: null });
        window.dataLayer.push({
          "event": "purchase",
          "ecommerce": {
            "currency": "{{ shop.currency }}",
            "value": "{{ checkout.total_price | money_without_currency }}",
            "coupon": "{{ discounts_titles }}",
            "discount": "{{ checkout.discounts_amount | money }}",
            "payment_type": "Credit Cart",
            "shipping": "{{ checkout.shipping_method.price | money_without_currency }}",
            "shipping_tier": "{{ checkout.shipping_method.title }}",
            "tax": "{{ checkout.tax_price | money_without_currency }}",
            "transaction_id": "{{ checkout.transactions[0].id }}",
            "items": itemsData
          }
        })
      }

      if (Shopify.Checkout.step === 'payment_method') {
        window.dataLayer.push({ ecommerce: null });
        window.dataLayer.push({
          "event": "add_shipping_info",
          "ecommerce": {
            "currency": "{{ shop.currency }}",
            "value": "{{ checkout.total_price | money_without_currency }}",
            "coupon": "{{ discounts_titles }}",
            "discount": "{{ checkout.discounts_amount | money }}",
            "shipping_tier": "{{ checkout.shipping_method.title }}",
            "items": itemsData
          }
        })
      }

      if (Shopify.Checkout.isOrderStatusPage) {
        window.dataLayer.push({ ecommerce: null });
        window.dataLayer.push({
          "event": "purchase",
          "ecommerce": {
            "currency": "{{ shop.currency }}",
            "value": "{{ checkout.total_price | money_without_currency }}",
            "coupon": "{{ discounts_titles }}",
            "discount": "{{ checkout.discounts_amount | money }}",
            "payment_type": "Credit Cart",
            "shipping": "{{ checkout.shipping_method.price | money_without_currency }}",
            "shipping_tier": "{{ checkout.shipping_method.title }}",
            "tax": "{{ checkout.tax_price | money_without_currency }}",
            "transaction_id": "{{ checkout.transactions[0].id }}",
            "items": itemsData
          }
        })
      }
    </script>

  </body>
</html>
