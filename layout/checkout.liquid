<!doctype html>
<html lang="{{ locale }}" dir="{{ direction }}" class="{{ checkout_html_classes }}">
  <head>
    {%- comment -%}
      GTM-Datalayer
    {%- endcomment -%}
    {% render 'gtm-datalayer', action_step: 'init' %}

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, user-scalable=0"
    >
    <meta name="referrer" content="origin">

    <title>{{ page_title }}</title>

    {{ content_for_header }}

    {{ checkout_stylesheets }}
    {{ checkout_scripts }}


    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-PZVSQF78');</script>
    <!-- End Google Tag Manager -->


    {%- comment -%} Fonts {%- endcomment -%}
    {%- render 'fonts' -%}

    {%- comment -%}
      Styles
    {%- endcomment -%}
    {{ 'main.css' | asset_url | stylesheet_tag }}
    {%- render 'css-variables' -%}
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PZVSQF78"
                      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    {%- comment -%}
      GTM-Datalayer
    {%- endcomment -%}
    {% render 'gtm-datalayer', action_step: 'body-init' %}

    {{ skip_to_content_link }}

    <header class="banner" data-header role="banner">
      <div class="wrap">
        {{ content_for_logo }}
      </div>
    </header>

    {{ order_summary_toggle }}
    <div class="content checkout__wrapper" data-content>
      <div class="wrap">
        <div class="main">
          <header class="main__header" role="banner">
            {{ content_for_logo }}
            {{ breadcrumb }}
            {{ alternative_payment_methods }}
          </header>
          <main class="main__content" role="main">
            {{ content_for_layout }}
          </main>
          <footer class="main__footer" role="contentinfo">
            {{ content_for_footer }}
          </footer>
        </div>
        <aside class="sidebar" role="complementary">
          <div class="sidebar__header">
            {{ content_for_logo }}
          </div>
          <div class="sidebar__content">
            {{ content_for_order_summary }}
          </div>
        </aside>
      </div>
    </div>

    {{ tracking_code }}

    {% liquid
      assign item_count = 0
      for item_quantity in checkout.line_items
        assign item_count = item_count | plus: item_quantity.quantity
      endfor
    %}

    {% if item_count > 10 %}
      <script>
        window.location.href = "/cart";
      </script>
    {% endif %}

    {%- comment -%}
      GTM-Datalayer
    {%- endcomment -%}
    {% render 'gtm-datalayer', action_step: 'checkout-steps' %}



    {%- for item in checkout.line_items -%}
      {% if item.properties._COMPARE_AT_PRICE != blank %}
        <script>
          const lineItemWrapper = document.querySelector('.product[data-variant-id="{{ item.variant_id }}"]')

          if (lineItemWrapper) {
            const priceContainer = lineItemWrapper.querySelector('.product__price');
            const hasSalePrice = lineItemWrapper.querySelector('.product__price del');
            const compareAtPrice = Number({{ item.properties._COMPARE_AT_PRICE }});
            const formattedPrice = '$' + (compareAtPrice / 100).toFixed(2);

            if (!hasSalePrice) {
              const html = `<del class="order-summary__small-text skeleton-while-loading--sm">${formattedPrice}</del><br>`
              priceContainer.insertAdjacentHTML('afterbegin', html)
            }
          }

        </script>
      {% endif %}
    {%- endfor -%}
  </body>
</html>
