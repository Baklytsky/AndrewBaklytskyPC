  <script>
    window.Shopify = window.Shopify || {theme: {id: {{ theme.id }}, role: '{{ theme.role }}' } };
    window._template = {
        directory: "{{ template.directory }}",
        name: "{{ template.name }}",
        suffix: "{{ template.suffix }}"
    }
  </script>
  <script src="https://cdn.intelligems.io/e950ab76d874.js"></script>
  <!-- end Intelligems -->

    {% include 'kiwiSizing' %}

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | img_url: '32x32' }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {% render 'css-variables' %}

    <link rel="preload" href="{{ 'base.css' | asset_url }}" as="style">
    <link rel="preload" href="{{ 'swiper.css' | asset_url }}" as="style">
		<link rel="preload" href="{{ 'quick-view.css' | asset_url }}" as="style">
    <link rel="preload" href="{{ 'component-product-card-mini.css' | asset_url }}" as="style">
    <link rel="preload" href="{{ 'component-loading-overlay.css' | asset_url }}" as="style">
    <link rel="preload" href="{{ 'component-product-reviews.css' | asset_url }}" as="style">


    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'swiper.css' | asset_url | stylesheet_tag }}
		{{ 'quick-view.css' | asset_url | stylesheet_tag }}
    {{ 'component-product-card-mini.css' | asset_url | stylesheet_tag }}
    {{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
    {{ 'component-product-reviews.css' | asset_url | stylesheet_tag }}

    <link rel="preload" href="{{ 'libs.min.js' | asset_url }}" as="script">
    <link rel="preload" href="{{ 'global.js' | asset_url }}" as="script">
    <link rel="preload" href="{{ 'swiper.min.js' | asset_url }}" as="script">
    <link rel="preload" href="{{ 'slideshow.js' | asset_url }}" as="script">
    <link rel="preload" href="{{ 'product-card-mini.js' | asset_url }}" as="script">
		<link rel="preload" href="{{ 'product-form.js' | asset_url }}" as="script">
		<link rel="preload" href="{{ 'product-media.js' | asset_url }}" as="script">
		<link rel="preload" href="{{ 'product-notify-modal.js' | asset_url }}" as="script">

		<script src="{{ 'libs.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'swiper.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'slideshow.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-card-mini.js' | asset_url }}" defer="defer"></script>
		<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
		<script src="{{ 'product-media.js' | asset_url }}" defer="defer"></script>
		<script src="{{ 'product-notify-modal.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    {%- if template.name == 'product' -%}
      {%- render 'product-redirects' -%}
    {%- endif -%}

    {%- unless settings.type_body_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}
    {%- unless settings.type_header_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_header_font | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- if settings.predictive_search_enabled -%}
      <link rel="stylesheet" href="{{ 'component-predictive-search.css' | asset_url }}" media="print" onload="this.media='all'">
    {%- endif -%}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>

    <!-- Begin Clarity Asynchronous Code -->
    <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "bjkn3bvcru");
    </script>
    <!-- End Clarity Asynchronous Code -->

    <script async type="text/javascript" src="https://a.klaviyo.com/media/js/onsite/onsite.js" ></script>
    <script type="text/javascript" async="" src="https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=XyRtPP"></script>

    {% include 'sales-motivator-init' %}

    <!-- pixel -->
    <script type="text/javascript">
            var etPixelId = 'F7KqCtZggXQHv4XMm';
            var etPixel = document.createElement('img');
            etPixel.src = '//pixel.locker2.com/image/' + etPixelId + '.png?cb=' + Math.round(new Date().getTime());
            etPixel.setAttribute("referrerpolicy", "no-referrer-when-downgrade"); document.addEventListener('DOMContentLoaded',
            function() { document.body.appendChild(etPixel); }, false);
    </script>
    <!-- End pixel -->

    {% include "loyaltylion" %}

    <!-- Start Vibe Code -->
    <script>
      !function(v,i,b,e,c,o){if(!v[c]){var s=v[c]=function(){s.process?s.process.apply(s,arguments):s.queue.push(arguments)};s.queue=[],s.b=1*new Date;var t=i.createElement(b);t.async=!0,t.src=e;var n=i.getElementsByTagName(b)[0];n.parentNode.insertBefore(t,n)}}(window,document,"script","https://s.vibe.co/vbpx.js","vbpx");
      vbpx('init','RWdWml');
      vbpx('event', 'page_view');
    </script>
    <!-- End Vibe Code -->

    <!-- Start Top Quality Badge Code -->
    <script id='merchantWidgetScript' src="https://www.gstatic.com/shopping/merchant/merchantwidget.js" defer></script>
    <script type="text/javascript">
      merchantWidgetScript.addEventListener('load', function () {
        merchantwidget.start({
          position: 'LEFT_BOTTOM',
          sideMargin: 20,
          bottomMargin: 20,
          mobileSideMargin: 10,
          mobileBottomMargin: 10
        });
      });
    </script>
    <!-- End Top Quality Badge Code -->


  </head>
  {%- assign page_background_color = page.metafields.general-settings.background_color -%}

  <body class="primary-bg template-{{ template }}"
        data-header-menu="false"
        style="
          {%- if template.name == 'page' and page_background_color != blank -%}
            --color-background--template: {{ page_background_color | color_extract: 'red' }}, {{ page_background_color | color_extract: 'green' }}, {{ page_background_color | color_extract: 'blue' }};
          {%- endif -%}
          ">
    <!-- Google Tag Manager (noscript) -->
      <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MW957R2" height="0" width="0" style="display:none;visibility:hidden"></iframe>
      </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- BigSur 10.1.24 - PC -->
    <script src="https://bigsur.ai/plugin/js/static.js" async></script>
    <!-- End BigSur 10.1.24 - PC -->
    
    {% if template contains 'customers/account' or template contains 'customers/order' %}
      <script src="{{ 'jquery-3.6.0.min.js' | asset_url }}" defer="defer"></script>
      <script src="https://app.accentuate.io/dist/proxy.js" defer="defer"></script>
    {% endif %}

    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ "accessibility.skip_to_text" | t }}
    </a>

    <modal-overlay id="ModalOverlay" class="ModalOverlay" aria-hidden="true" aria-labelledby="ModalOverlay"></modal-overlay>
    {%- case settings.announcement_layout -%}
    {%- when 'announcement-scrolling-bar' -%}
      {% section 'announcement-scrolling-bar' %}
    {%- else -%}
      {% section 'announcement-bar' %}
    {%- endcase -%}

    {% comment %}{% section 'header' %}{% endcomment %}
		{% section 'header-b' %}
    {% section 'newsletter' %}
    {% section 'popup' %}
    {% section 'customer-account' %}
		{% render 'quick-view-popup' %}
    {% render 'cart-popup' %}
		{% render 'mobile-search-modal' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- unless template.name == 'account' or template.name == 'page'-%}
      {% section 'text-blocks' %}
    {%- endunless -%}

    {% section 'footer' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
    </ul>

    {%- assign initials_payment_product_type_label = 'Payment for initials' | handleize -%}
    {%- assign initials_payment_product = settings.pdp_initials_payment_product -%}

    {%- if initials_payment_product.first_available_variant -%}
      {%- assign initials_payment_product_type = initials_payment_product.type | handleize -%}
      {%- if initials_payment_product_type == initials_payment_product_type_label -%}
        {%- assign initials_payment_product = initials_payment_product.first_available_variant.id -%}
      {%- endif -%}
    {%- endif -%}

    <script>
      window.shopUrl = '{{ shop.url }}';
      window.moneyFormat = {{ shop.money_format | json }};
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_js: '/cart.js',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };

      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`
      }

      window.variantStrings = {
        atc: `{{ 'products.product.add_to_cart' | t }}`,
        preorder: `{{ 'products.product.preorder_button_label' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
        lastChance: `{{ 'products.product.last_chance_label' | t }}`,
      }

      window.accessibilityStrings = {
        shareSuccess: `{{ 'general.share.success_message' | t }}`,
      }

      window.formStrings = {
        sendMessage: `{{ 'templates.contact.form.send_btn_label' | t }}`,
        signUp: `{{ 'templates.contact.form.sign_up_label' | t }}`,
        errorMessage: `{{ 'templates.contact.form.error_btn_label' | t }}`
      }

      window.pdp = {
        payment_for_initials_type: `{{ 'Payment for initials' | handleize }}`,
        payment_for_initials_id: `{{ initials_payment_product }}`
      }

      window.recipient_form = {
        errorMessage: `{{ 'recipient.form.error_message' | t }}`
      }
      window.isIosDevice = typeof window !== 'undefined' && window.navigator && window.navigator.platform && (/iP(ad|hone|od)/.test(window.navigator.platform) || window.navigator.platform === 'MacIntel' && window.navigator.maxTouchPoints > 1);
    </script>

    {%- if settings.predictive_search_enabled -%}
      <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {% render 'junip-store-key' %}

    <script src="https://unpkg.com/@loophq/onstore-sdk@latest/dist/loop-onstore-sdk.js"></script>
    <script>
      LoopOnstore.init({
        key: "e919be617bb56d2b69f2c60d969cc75f1c6d3992",
        attach: ".cart-checkout"
      });
    </script>

    <!--Gorgias Chat Widget Start-->
    <script id="gorgias-chat-widget-install-v3" src="https://config.gorgias.chat/bundle-loader/01GYCBQVTFMX9EP6AY4N5VGNBP?source=shopify1click"></script>
    <script id="gorgias-chat-shopify-install">!function(_){_.SHOPIFY_PERMANENT_DOMAIN="{{shop.permanent_domain}}",_.SHOPIFY_CUSTOMER_ID="{{customer.id}}",_.SHOPIFY_CUSTOMER_EMAIL="{{customer.email}}"}(window||{});</script>
    <!--Gorgias Chat Widget End-->
  {% include 'adroll' %}
</body>
</html>
