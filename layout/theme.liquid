<!doctype html>
  <html class="no-js" lang="{{ request.locale.iso_code }}">
    <head>
      {%- render 'direct-link-access-checker' -%}
      {%- render 'head-meta' -%}
      <title>{{ page_title }}</title>

      <!-- Google Tag Manager -->
      <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
            new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
          'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-PZVSQF78');</script>
      <!-- End Google Tag Manager -->


      {%- render 'gtm-datalayer', action_step: 'init' -%}
      {%- render 'script-tags' -%}
      {%- render 'vendor-scripts' -%}
      {%- render 'ra-language' -%}

      {% if settings.enable_internationalization %}
        {%- section 'ra-countries' -%}
      {% endif %}

      {%- comment -%} Fonts {%- endcomment -%}
      {%- render 'fonts' -%}

      {% comment %}
      <link rel="stylesheet" href="https://use.typekit.net/uuq0jfz.css">
      {% endcomment %}

      {{ 'main.css' | asset_url | preload_tag: as: 'style' }}
      {{ 'main.css' | asset_url | stylesheet_tag }}

      {%- render 'css-variables' -%}
      {%- render 'icon-store' -%}
      {{ content_for_header }}

  {% render "globale-js" %}
  {% render "global-settings" %}
  {% render "currency-data-js" %}
</head>

    {%- assign password_protected_page = false -%}

    {% if template.name == 'collection' %}
      {%- assign password = collection.metafields.custom.password_access_only -%}

      {%- if password != blank -%}
        {%- assign password_protected_page = true -%}
      {%- endif -%}

    {% elsif template.name == 'product' %}

      {% for collection in product.collections %}
        {%- assign password = collection.metafields.custom.password_access_only -%}

        {%- if password != blank -%}
          {%- assign password_protected_page = true -%}
          {%- break -%}
        {%- endif -%}
      {% endfor %}

    {% endif %}

    {%- if request.design_mode -%}
      {%- assign password_protected_page = false -%}
    {%- endif -%}

    <body class="template__{{- template.name -}}" {% if password_protected_page %} data-password-protection="true" {% endif %}>
      <!-- Google Tag Manager (noscript) -->
      <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PZVSQF78"
                        height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
      <!-- End Google Tag Manager (noscript) -->

      {% render 'gtm-datalayer', action_step: 'body-init' %}

      {% if template.name == 'cart' %}
        {% render 'gtm-datalayer', action_step: 'view-cart' %}
      {% elsif template.name == 'product' %}
        {% render 'gtm-datalayer', action_step: 'view-item' %}
      {% endif %}

      {% sections 'header-group' %}

      <main id="main-content" role="main" tabindex="-1">
        {%- if password_protected_page -%}
          {%- render 'password-protection' -%}
        {%- endif -%}
        {{ content_for_layout }}
      </main>

      {% section 'footer' %}

      {% render 'ra-login-modal' %}

      {% comment %}theme-check-disable ParserBlockingScriptTag{% endcomment %}
      {{ 'main.js' | asset_url | preload_tag: as: 'script' }}
      {{ 'main.js' | asset_url | script_tag }}

      {% liquid
        assign vip_customer = false

        if customer and customer.tags contains "VIP"
          assign vip_customer = true
        endif
      %}

      {% unless template.name == 'cart' %}
        {% capture cart_settings %}{%- render 'cart-settings' -%}{% endcapture %}
        {% capture empty_cart_settings %}{%- render 'empty-cart-settings' -%}{% endcapture %}
        {% capture product_badge_json %}{%- render 'product-badge-settings' -%}{% endcapture %}
        <div data-vue-root="CartInline">
          <cart-inline
            :settings="{{- cart_settings | escape | strip -}}"
            :product-badge-settings="{{- product_badge_json | escape | strip -}}"
            :empty-cart-settings="{{- empty_cart_settings | escape | strip -}}"
            order-limit="{{ 'general.order_limit_cart' | t }}"
            order-limit-checkout-button="{{ 'general.order_limit_checkout_button' | t }}"
            :vip-customer="{{ vip_customer }}"
            waitlist-text="{{ settings.waitlist_text | default: 'Coming Soon - Join Waitlist' }}"
            sold-out-text="{{ settings.sold_out_badge_title }}"
            bis-text="{{ settings.bis_text | default: 'Back In Stock' }}"
            pre-order-text="{{ settings.pre_order_text }}"
          />
        </div>
      {% endunless %}

      {%- if settings.sale_event_tooltip_klaviyo_id != blank and settings.enable_sale_event -%}
        <script>
          document.addEventListener("click", (e) => {
            if (e.target.closest('[data-sale-event-tooltip]')) {
              e.preventDefault();
              window._klOnsite = window._klOnsite || [];
              window._klOnsite.push(["openForm", {{ settings.sale_event_tooltip_klaviyo_id | json }}]);
            }
          })
        </script>
      {%- endif -%}
      {%- if settings.show_klarna_afterpay_message_on_pdp and template.name == 'product' -%}
        <script src="https://js.squarecdn.com/square-marketplace.js" async></script>
      {%- endif -%}


    </body>
  </html>
