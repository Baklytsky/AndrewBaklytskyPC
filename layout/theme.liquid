{%- include 'customer-status' -%}

<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
    <meta name="theme-color" content="">

    {%- if [request.page_type].metafields.custom.noindex -%}
      <meta name="robots" content="noindex, nofollow">
    {%- endif -%}

    {%- assign custom_canonical_url = canonical_url -%}

    {%- if [request.page_type].metafields.custom.canonical_url != blank -%}
      {%- assign custom_canonical_url = [request.page_type].metafields.custom.canonical_url -%}
    {%- endif -%}

    <link rel="canonical" href="{{ custom_canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if product -%}
      {%- if product.tags contains 'dev_product'
        or product.tags contains 'test_product'
        or product.tags contains 'hidden'
        or product.tags contains 'not-allowed' -%}
        <meta name="robots" content="noindex">
      {%- endif -%}
    {%- endif -%}

    {%- assign direct_link_access = [request.page_type].metafields.custom.direct_link_access | default: false -%}

    {%- if request.design_mode -%}
      {%- assign direct_link_access = false -%}
    {%- endif -%}

    {%- if direct_link_access -%}
      <script>
        if (document.referrer && document.referrer.includes(window.location.hostname)) {
          window.location.href = '/';
        }
      </script>
    {%- endif -%}

    <!--begin Convert Experiences code-->
    <script type="text/javascript">var _conv_page_type = "{{
    request.page_type }}";var _conv_category_id = "{{ collection.id }}";var _conv_category_name = "{{
    collection.title }}";var _conv_product_sku = "{{ product.selected_variant.sku }}";var _conv_product_name =
    "{{ product.title }}";var _conv_product_price = "{{ product.price_min | money_without_currency }}";var
    _conv_customer_id = "{{ customer.id }}";var _conv_custom_v1 = "{{ product.tags.first }}";var
    _conv_custom_v2= "{{ collection.current_type }}";var _conv_custom_v3 = "{{ cart.item_count }}";var
    _conv_custom_v4 = "{{ cart.total_price | money_without_currency }}";</script><script type="text/javascript" src="//cdn-4.convertexperiments.com/js/10034870-10034364.js"></script>
    <!--end Convert Experiences code-->

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {%- render 'css-variables' -%}

    {{ 'theme.min.css' | asset_url | preload_tag: as: 'style' }}
    {{ 'theme.min.css' | asset_url | stylesheet_tag }}

    {%- unless request.design_mode -%}
      {{ 'aos.min.css' | asset_url | preload_tag: as: 'style' }}
      {{ 'aos.min.css' | asset_url | stylesheet_tag }}
      {{ 'aos.min.js' | asset_url | preload_tag: as: 'script' }}
      <script src="{{ 'aos.min.js' | asset_url }}" defer="defer"></script>
    {%- endunless -%}

    {{ 'vendor.min.js' | asset_url | preload_tag: as: 'script' }}
    {{ 'theme.min.js' | asset_url | preload_tag: as: 'script' }}
    <script src="{{ 'vendor.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'theme.min.js' | asset_url }}" defer="defer"></script>

    {%- if template.directory == 'customers' -%}
      <link rel="preload" href="{{ 'jquery-3.6.0.min.js' | asset_url }}" as="script">
      <link rel="preload" href="https://app.accentuate.io/dist/proxy.js" as="script">

      <script src="{{ 'jquery-3.6.0.min.js' | asset_url }}" defer="defer"></script>
      <script src="https://app.accentuate.io/dist/proxy.js" defer="defer"></script>
    {%- endif -%}

    {%- render 'customer-redirect', customer_status: customer_status -%}

    {{ content_for_header }}

    {%- if template.name == 'product' -%}
      {%- render 'product-redirects' -%}
    {%- endif -%}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    if (Shopify.designMode) {
      document.documentElement.classList.add('shopify-design-mode');
    }

    </script>
    <!-- Google Tag Manager (header snippet) -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MS5BV4S');</script>
    <!-- End Google Tag Manager -->

    <script>
      function getGA4ClientId() {
        let cookies = document.cookie.split(';');
        for(let i = 0; i < cookies.length; i++) {
          let cookie = cookies[i].trim();
          if(cookie.indexOf('_ga') == 0) {
            return cookie
          }
        }
        return undefined;
      }

      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}


      gtag('js', new Date());

      gtag('config', 'G-P0QDC3S0DC', {
        'page_referrer': document.referrer || '',
        'ga4_client_id': getGA4ClientId(),
        'event_timestamp': `${Date.now()}`,
        'page_type': '{{ template.name | capitalize }}',
        'd2c_member_id': '{{ customer.id }}',
        'b2b_partner_id': '{{ customer.metafields.professional_info.custom_id }}',
        'b2c_customer_id': ''
      });

    </script>

    <meta name="p:domain_verify" content="ad6cbf94a131b5041c9b2877ed8ccd4e"/>
  </head>

  <body class="template-{{ template }}">
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ "accessibility.skip_to_text" | t }}
    </a>

    <div class="page-overlay" aria-hidden="true">
      <span class="visually-hidden">{{ "accessibility.page_overlay" | t }}</span>
    </div>

    {% section 'announcement-bar' %}

    {%- if template contains 'professional'
      or template contains 'account' and customer_status == 'Partner'
      or template contains 'account' and customer_status == 'Premier Partner' -%}
      {% section 'header-pro' %}
    {%- else -%}
      {% section 'header' %}
    {%- endif -%}
    {% section 'main-cart' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {%- liquid
        assign show_policies_page = false

        for link in linklists[settings.policies_linklist].links

          if link.url == request.path
            assign show_policies_page = true
            break
          endif

        endfor -%}

      {%- if request.path contains '/policies/' or show_policies_page -%}
        {%- render 'policy', content: content_for_layout -%}
      {%- else -%}
        {{ content_for_layout }}
      {%- endif -%}
    </main>

  {% section 'seo-footer' %}
  {% section 'obagi-event-images' %}

  {%- if template contains 'professional'
    or template contains 'account' and customer_status == 'Partner'
    or template contains 'account' and customer_status == 'Premier Partner' -%}
    {% section 'footer-pro' %}
  {%- else -%}
    {% section 'footer' %}
  {%- endif -%}

  <ul hidden>
    <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
    <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
  </ul>

  {% include 'global-variables' %}

  {% render 'afterpay' %}

  <!-- Google Tag Manager (body snippet) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MS5BV4S"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <script>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      'event': 'pageview',
      'event_timestamp': `${Date.now()}`,
      'page': {
        'page_type': '{{ template.name | capitalize }}',
        'page_location': window.location.href,
        'page_referrer': document.referrer || ''
      },
      'user': {
        'logged_in_status': '{% if customer %}Logged in{% else %}Logged out{% endif %}',
        'ga4_client_id': '',
        'premier_point_total': '',
        'user_skin_type': '',
        'user_skin_concern': '',
        'quiz_results': '',
        'customer': {
          'd2c_member_id': '{{ customer.id }}',
          'b2b_partner_id': '{{ customer.metafields.professional_info.custom_id }}',
          'b2c_customer_id': '',
          'b2b_specialty': '',
          'b2b_role': '',
          'b2b_city': '',
          'b2b_state': '',
          'b2b_registration_reason': ''
        }
      }
    });

    if (window.location.pathname !== '/challenge') {
      const loggedIn = localStorage.getItem('loggedIn');
      if (loggedIn) {
        localStorage.removeItem('loggedIn');
        window.dataLayer.push({
          'event': 'login',
          'user': {
            'customer': {
              'd2c_member_id': '{{ customer.id }}',
              'b2b_partner_id': '{{ customer.metafields.professional_info.custom_id }}',
              'b2c_customer_id': ''
            }
          }
        });
      }
    }
  </script>

  <!-- CRITEO START -->
{% render 'criteo-tracking' %}
<!-- CRITEO END -->

  <!-- Klaviyo Add to Cart Tracking Pixel -->
  {% if product %}
    <script>
      window.addEventListener('load', function() {
        var _learnq = window._learnq || [];
        function addedToCart() {
          fetch(`${window.location.origin}/cart.js`)
            .then(res => res.clone().json().then(data => {
              var cart = {
                total_price: data.total_price/100,
                $value: data.total_price/100,
                total_discount: data.total_discount,
                original_total_price: data.original_total_price/100,
                items: data.items
              }
              if (item !== 'undefined') {
                cart = Object.assign(cart, item)
              }
              if (klAjax) {
                _learnq.push(['track', 'Added to Cart', cart]);
                klAjax = false;
              }
            }))
        };
        (function (ns, fetch) {
          ns.fetch = function() {
            const response = fetch.apply(this, arguments);
            response.then(res => {
              if (`${window.location.origin}/cart/add.js`
                .includes(res.url)) {
                addedToCart()
              }
            });
            return response
          }
        }(window, window.fetch));
        var klAjax = true;
        var atcButtons = document.querySelectorAll("form[action*='/cart/add'] button[type='submit']");
        for (var i = 0; i < atcButtons.length; i++) {
          atcButtons[i].addEventListener("click", function() {
            if (klAjax) {
              _learnq.push(['track', 'Added to Cart', item]);
              klAjax = false;
            }
          })
        }
      });
    </script>
  {% endif %}
  <!-- End Klaviyo Add to Cart Tracking Pixel -->

  <!-- load BV loader -->
  <script async src="https://apps.bazaarvoice.com/deployments/obagi/main_site/production/en_US/bv.js" defer></script>
  <!-- End load BV loader -->

  <!-- Microsoft Clarity -->
  <script type="text/javascript">
    (function (c, l, a, r, i, t, y) {
      c[a] = c[a] || function () {
        (c[a].q = c[a].q || []).push(arguments)
      };
      t = l.createElement(r);
      t.async = 1;
      t.src = "https://www.clarity.ms/tag/" + i;
      y = l.getElementsByTagName(r)[0];
      y.parentNode.insertBefore(t, y);
    })(window, document, "clarity", "script", "lyrfhs7uvp");
  </script>
  <!-- End Microsoft Clarity -->

  <!-- Start of TrueVault Polaris Code Block -->
  <script src="https://polaris.truevaultcdn.com/static/pc/CA5WMRIZ7/polaris.js">
  </script>
  <!-- End of TrueVault Polaris Code Block -->
</body>
</html>

