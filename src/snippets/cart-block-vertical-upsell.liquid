{%- doc -%}
  Renders vertical product list or upsell products on Cart page and Cart drawer

  @param {object} block - Block object (required)

  @example
  {% render 'cart-block-vertical-upsell', block: block %}
{%- enddoc -%}

{%- liquid
  assign product_count = block.settings.product_list.count

  assign onboarding_count = 6
  assign is_onboarding = false
  if product_count == 0 and request.design_mode
    assign is_onboarding = true
  endif

  capture product_list
    if is_onboarding
      for i in (1..onboarding_count)
        render 'upsell-product', upsell_product: blank, unique_id: block.id, is_compact: true, instant_add: true, is_vertical: true, onboarding: true
      endfor
    else
      for product in block.settings.product_list
        render 'upsell-product', upsell_product: product, unique_id: block.id, is_compact: true, instant_add: true, is_vertical: true, show_available_upsell_only: true
      endfor
    endif
  endcapture

  assign color_scheme = 'color-' | append: block.settings.color_scheme
-%}

{%- if request.design_mode or product_count > 0 and product_list != blank or is_onboarding -%}
  <div class="cart__widget cart__widget--upsell cart__widget--upsell-vertical {{ color_scheme }}">
    {%- if block.settings.title != blank -%}
      <div class="cart__widget__title subheading">
        <span>{{ block.settings.title }}</span>
      </div>
    {%- endif -%}

    <div class="cart__widget__content">
      <upsell-block
        class="cart__widget__content__inner"
        data-upsell-block-id="{{ block.id }}"
      >
        {{- product_list -}}
      </upsell-block>
    </div>
  </div>
{%- endif -%}
