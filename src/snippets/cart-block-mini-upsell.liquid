{%- doc -%}
  Renders mini product upsell block with slider functionality for Cart drawer

  @param {object} block - Block object (required)

  @example
  {% render 'cart-block-mini-upsell', block: block %}
{%- enddoc -%}

{%- liquid
  assign product_count = block.settings.product_list.count
  assign show_slider = false
  assign onboarding_count = 3
  assign is_onboarding = false

  if product_count == 0 and request.design_mode
    assign is_onboarding = true
    assign show_slider = true
  elsif product_count > 1
    assign show_slider = true
  endif

  assign color_scheme = 'color-' | append: block.settings.color_scheme
-%}

{%- capture product_list -%}
  {%- if is_onboarding -%}
    {%- comment -%} Render onboarding products {%- endcomment -%}
    {%- for i in (1..onboarding_count) -%}
      <swiper-slide>
        {%- render 'upsell-product', upsell_product: blank, unique_id: block.id, is_compact: true, is_mini_upsell: true, onboarding: true -%}
      </swiper-slide>
    {%- endfor -%}
  {%- else -%}
    {%- for product in block.settings.product_list limit: 3 -%}
      {%- capture upsell_product -%}
        {%- render 'upsell-product', upsell_product: product, unique_id: block.id, is_compact: true, is_mini_upsell: true, show_available_upsell_only: true -%}
      {%- endcapture -%}

      {%- if upsell_product != blank -%}
        {%- if show_slider -%}
          <swiper-slide>
            {{- upsell_product -}}
          </swiper-slide>
        {%- else -%}
          {{- upsell_product -}}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if request.design_mode or product_count > 0 and product_list != blank or is_onboarding -%}
  <div class="cart__widget cart__widget--upsell cart__widget--upsell-mini {{ color_scheme }}">
    {%- if block.settings.title != blank or show_slider -%}
      <div class="cart__widget__title subheading">
        {% if block.settings.title != blank %}
          <span>{{ block.settings.title }}</span>
        {% endif %}

        {%- if show_slider -%}
          <div class="swiper-navigation-static">
            <div class="{{ block.id }}--button swiper-button-prev">
              {{ 'icon-nav-arrow-left.svg' | inline_asset_content }}
            </div>
            <div class="{{ block.id }}--button swiper-button-next">
              {{ 'icon-nav-arrow-right.svg' | inline_asset_content }}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cart__widget__content">
      <upsell-block
        class="cart__widget__content__inner"
        data-upsell-block-id="{{ block.id }}"
        {%- if show_slider -%}
          data-upsell-has-slider="true"
        {%- endif -%}
      >
        {%- if show_slider -%}
          <div class="swiper">
            <swiper-container
              class="swiper-wrapper"
              loop="true"
              grab-cursor="true"
              autoplay="false"
              space-between="10px"
              {%- if show_slider %}
                navigation="true"
                navigation-prev-el=".{{ block.id }}--button.swiper-button-prev"
                navigation-next-el=".{{ block.id }}--button.swiper-button-next"
              {% endif -%}
            >
              {{- product_list -}}
            </swiper-container>
          </div>
        {%- else -%}
          {{- product_list -}}
        {%- endif -%}
      </upsell-block>
    </div>
  </div>
{%- endif -%}
