<!-- /snippets/social-icon.liquid -->

{% comment %}
  Renders a social icon because render can't accept strings as variables

  Accepts:
  - filename: {String} name of icon

  Usage:
  {% render 'header-icon', filename: 'icon-bag' %}
{% endcomment %}

{%- case filename -%}
  {%- when 'icon-bag' -%}
    {%- render 'icon-bag' -%}
{%- endcase -%}
