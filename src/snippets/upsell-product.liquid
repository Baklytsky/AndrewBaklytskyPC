{%- doc -%}
  Renders a product card with quick add button for upsell products

  @param {object} upsell_product - Product object (required)

  @param {boolean} [upsell_quick_add_hide=false] - Show/hide quick add button

  @param {string} [upsell_description] - Description text
  @param {string} [upsell_description_font_size] - Font size for description
  @param {string} [upsell_modifier] - Modifier class
  @param {string} [upsell_button_text] - Button text
  @param {string} [unique_id] - Unique ID for the product upsell

  @param {boolean} [is_compact=false] - Is compact - used on Cart/Cart drawer and Article Sidebar
  @param {boolean} [is_mini_upsell=false] - Is mini upsell - used for mini product upsell blocks
  @param {boolean} [is_vertical=false] - Is vertical layout - used for vertical product upsell blocks
  @param {boolean} [show_available_upsell_only=false] - Show available upsell only
  @param {boolean} [instant_add=false] - Enable instant add for single option products
  @param {boolean} [onboarding=false] - Onboarding mode

  @example
  {% render 'upsell-product',
    upsell_product: product,
    upsell_quick_add_hide: false,
    upsell_description: 'Description',
    upsell_description_font_size: 'h5',
    upsell_modifier: 'product-upsell--modifier',
    upsell_button_text: 'Add to cart',
    is_compact: false,
    is_mini_upsell: false,
    is_vertical: false,
    show_available_upsell_only: false,
    instant_add: false,
    onboarding: false
  %}
{%- enddoc -%}

{%- liquid
  assign upsell_modifier = upsell_modifier | default: ''
  assign upsell_button_text = 'products.general.upsell_add_to_cart' | t
  assign upsell_quick_add_hide = upsell_quick_add_hide | default: false
  assign upsell_description = upsell_description | default: ''
  assign upsell_description_font_size = upsell_description_font_size | default: ''
  assign is_compact = is_compact | default: false
  assign is_mini_upsell = is_mini_upsell | default: false
  assign is_vertical = is_vertical | default: false
  assign instant_add = instant_add | default: false
  assign render_quick_add_template = false

  if upsell_product == blank
    assign show_upsell = false
    assign upsell_error = true
  endif

  if request.design_mode or upsell_product != blank
    assign show_upsell = true
  endif

  assign upsell_variant = upsell_product.selected_or_first_available_variant
  assign upsell_variant_image = upsell_variant.featured_media | default: upsell_product.featured_media.preview_image

  if settings.currency_code_enable
    assign upsell_variant_price = upsell_variant.price | money_with_currency
    assign upsell_variant_compare_at_price = upsell_variant.compare_at_price | money_with_currency
  else
    assign upsell_variant_price = upsell_variant.price | money
    assign upsell_variant_compare_at_price = upsell_variant.compare_at_price | money
  endif

  assign unique_id = unique_id | default: section.id
  assign unique = unique_id | append: '-' | append: upsell_product.id
  assign product_form_id = 'productFormUpsell--' | append: unique

  assign sibling_color = upsell_product.metafields.theme.sibling_color.value | default: upsell_product.metafields.theme.sibling_colour.value | default: upsell_product.metafields.theme.siblings_color.value | default: upsell_product.metafields.theme.siblings_colour.value | default: upsell_product.metafields.theme.siblings_colors.value | default: upsell_product.metafields.theme.siblings_colours.value

  assign show_available_upsell_only = show_available_upsell_only | default: false
  assign all_variants_soldout = true

  for option in upsell_product.options_with_values
    for option_value in option.values
      if option_value.available
        assign all_variants_soldout = false
        break
      endif
    endfor
  endfor

  if all_variants_soldout
    assign upsell_quick_add_hide = true
  endif

  if show_available_upsell_only and all_variants_soldout
    assign show_upsell = false
  endif

  assign product_title = 'products.general.upsell_error_title' | t
  assign product_info = 'products.general.upsell_error_info' | t

  if onboarding
    assign show_upsell = true
    assign upsell_error = true
    assign product_title = 'products.general.choose_product' | t
    assign product_info = 'products.general.product_info' | t
  endif

  comment
    Determine if instant add should be enabled
    - Product must have more than 1 variant
    - Product must have exactly 1 option (not default variant)
    - instant_add parameter must be true
  endcomment
  assign enable_instant_add = false
  assign is_color_option = false
  assign is_native_swatch_option = false
  assign is_swatch_option = false
  assign single_option = null

  if instant_add and upsell_product.variants.size > 1 and upsell_product.options.size == 1
    assign enable_instant_add = true
    assign single_option = upsell_product.options_with_values.first

    comment
      Check if the single option is a color option by looking for swatches
    endcomment
    if settings.enable_swatches
      for value in single_option.values
        if value.swatch
          assign is_native_swatch_option = true
          break
        endif
      endfor

      comment
        Also check if option name matches color translations
      endcomment
      assign swatch_translation = 'general.swatches.color' | t
      assign translation_string = swatch_translation | remove: '  ' | replace: ', ', ',' | replace: ' ,', ',' | replace: ',', '____' | handle | replace: '____', ',' | append: ',' | prepend: ','
      assign option_name_handle_separator = single_option.name | handle | prepend: ',' | append: ','
      if translation_string contains option_name_handle_separator
        assign is_swatch_option = true
      endif

      if is_native_swatch_option or is_swatch_option
        assign is_color_option = true
      endif
    endif
  endif

  capture holder_classes
    echo 'product-upsell__holder'
    if upsell_error
      echo ' product-upsell__holder--onboarding'
    endif
    if is_compact
      echo ' product-upsell__holder--compact'
    elsif upsell_quick_add_hide == false
      echo ' product-upsell__holder--button'
    endif
    if is_mini_upsell
      echo ' product-upsell__holder--mini'
    endif
    if is_vertical
      echo ' product-upsell__holder--vertical'
    endif
  endcapture
-%}

{%- if show_upsell -%}
  {%- capture open_quick_add_drawer_button -%}
    <button
      class="product-upsell__btn btn btn--medium btn--primary btn--outline"
      type="button"
      data-quick-add-btn
      data-quick-add-modal-handle="{{ upsell_product.handle }}"
    >
      <span class="btn__text">{{ upsell_button_text }}</span>

      <span class="btn__loader">
        <svg height="18" width="18" class="svg-loader">
          <circle r="7" cx="9" cy="9" />
          <circle stroke-dasharray="87.96459430051421 87.96459430051421" r="7" cx="9" cy="9" />
        </svg>
      </span>

      <span class="btn__added">&nbsp;</span>
    </button>
  {%- endcapture -%}

  <quick-add-product>
    <div
      class="{{ holder_classes }}"
      data-quick-add-holder="{{ upsell_product.id }}"
    >
      <div data-cart-errors-container class="product-upsell__errors"></div>

      <div class="product-upsell{% if upsell_modifier != '' %} {{ upsell_modifier }}{% endif %}">
        <div class="product-upsell__image">
          {%- if upsell_error -%}
            <div
              class="product-upsell__image__thumb svg-placeholder{% if settings.show_image_bg != 'none' %} show-gray-bg{% endif %}"
              role="img"
            >
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- else -%}
            <a
              href="{{ upsell_product.url }}"
              class="product-upsell__image__link"
              aria-label="{{ upsell_product.title | strip_html | escape }}"
            >
              <div class="product-upsell__image__thumb{% if settings.show_image_bg != 'none' %} show-gray-bg{% endif %}">
                {%- render 'image',
                  image: upsell_variant_image,
                  widths: '120, 180, 240, 300, 360',
                  width: '240',
                  sizes: '120px',
                  cover: true
                -%}
              </div>
            </a>
          {%- endif -%}
        </div>

        <div class="product-upsell__content">
          {%- if upsell_error -%}
            <p class="product-upsell__title h3">{{ product_title }}</p>

            {%- if sibling_color != blank -%}
              <p class="product-upsell__variant-title h4">{{ 'general.siblings.label' | t }}: {{ sibling_color }}</p>
            {%- endif -%}

            <p class="product-upsell__variant-title h4">{{ product_info }}</p>

            {%- if onboarding and upsell_quick_add_hide == false -%}
              <div class="product-upsell__actions">
                <button
                  class="product-upsell__btn btn btn--medium btn--primary btn--outline"
                  type="button"
                >
                  <span class="btn__text">{{ upsell_button_text }}</span>
                </button>
              </div>
            {%- endif -%}
          {%- else -%}
            <a href="{{ upsell_product.url }}" class="product-upsell__link">
              <p class="product-upsell__title h3">{{ upsell_product.title | strip_html }}</p>

              {%- unless sibling_color == blank or upsell_product.title contains sibling_color -%}
                <p class="product-upsell__variant-title h4">{{ 'general.siblings.label' | t }}: {{ sibling_color }}</p>
              {%- endunless -%}

              {%- if upsell_product.variants.size == 1 and upsell_variant.title != 'Default Title' -%}
                <p class="product-upsell__variant-title h4">
                  {{ upsell_variant.title | replace: '/', '<span>&nbsp;</span>' }}
                </p>
              {%- endif -%}

              <p class="product-upsell__price{% if upsell_variant.compare_at_price > upsell_variant.price %} sale{% endif %}">
                <span class="new-price">
                  {%- if upsell_variant.price == 0 -%}
                    {{ 'general.money.free' | t }}
                  {%- else -%}
                    {{ upsell_variant_price }}
                  {%- endif -%}
                </span>

                {%- if upsell_variant.compare_at_price > upsell_variant.price -%}
                  <span class="old-price">{{ upsell_variant_compare_at_price }}</span>
                {%- endif -%}

                {%- if upsell_variant.unit_price -%}
                  {%- capture unit_price_separator -%}
                    <span aria-hidden="true">/</span>
                    <span class="visually-hidden">{{ 'general.accessibility.unit_price_separator' | t }}&nbsp;</span>
                  {%- endcapture -%}

                  {%- capture unit_price_base_unit -%}
                    {% if upsell_variant.unit_price_measurement.reference_value != 1 %}
                      {{ upsell_variant.unit_price_measurement.reference_value }}
                    {% endif %}
                    {{ upsell_variant.unit_price_measurement.reference_unit }}
                  {%- endcapture -%}

                  <br>

                  <span class="visually-hidden visually-hidden--inline">
                    {{- 'products.product.unit_price_label' | t -}}
                  </span>

                  <span class="unit">
                    {{ upsell_variant.unit_price | money }}
                    {{ unit_price_separator }}
                    {{ unit_price_base_unit }}
                  </span>
                {% endif -%}
              </p>
            </a>

            {%- if all_variants_soldout -%}
              <span class="product-upsell__out-of-stock">{{ 'products.general.upsell_out_of_stock' | t }}</span>
            {%- endif -%}

            {%- if upsell_description != '' -%}
              <div class="product-upsell__description{% if upsell_description_font_size != '' %} {{ upsell_description_font_size }}{% endif %}">
                {{ upsell_description }}
              </div>
            {%- endif -%}

            {%- if enable_instant_add and upsell_quick_add_hide == false -%}
              {%- comment -%}
                Variations:
                  1. Instant add: when product has more than 1 variant but only 1 option:
                    - render a form with a direct add to cart button
                    - display a variant selector (either swatches radio inputs or a dropdown) after the product price
                  2. When "Collection style > Text only":
                    - display swatches count after the product price
                    - render a button that opens the quick add drawer
              {%- endcomment -%}
              {%- liquid
                assign total_values = single_option.values.size
                assign limited_count = 4
                assign swatches_left = total_values | minus: limited_count
                assign count_text = 'collections.general.colors_with_count.other' | t
                if total_values == 1
                  assign count_text = 'collections.general.colors_with_count.one' | t
                endif
              -%}

              {%- capture swatches_count_markup -%}
                <span class="product-upsell__swatches-count">
                  <span>
                    {{ total_values }}
                    {{ count_text }}
                  </span>
                </span>
              {%- endcapture -%}

              {%- if is_color_option and settings.collection_swatch_style == 'text' -%}
                {%- comment -%} Text only swatches {%- endcomment -%}
                <div class="product-upsell__form product-upsell__form--instant-add">
                  <div class="product-upsell__variant-selector product-upsell__variant-selector--{{ settings.collection_swatch_style }}">
                    {{- swatches_count_markup -}}
                  </div>

                  <div class="product-upsell__actions">
                    {{- open_quick_add_drawer_button -}}
                  </div>
                </div>

                {%- assign render_quick_add_template = true -%}
              {%- else -%}
                {%- comment -%} Instant add {%- endcomment -%}
                {%- form 'product',
                  upsell_product,
                  id: product_form_id,
                  class: 'product-upsell__form product-upsell__form--instant-add',
                  data-instant-add-form: ''
                -%}
                  <input type="hidden" name="id" value="{{ upsell_variant.id }}" data-variant-id>

                  {% comment %} Form ID must match value in product-form.liquid {% endcomment %}
                  <input
                    type="hidden"
                    form="{{ product_form_id }}"
                    name="properties[{{ 'general.siblings.label' | t }}]"
                    value="{{ sibling_color }}"
                  >

                  {%- comment -%} Variant selector {%- endcomment -%}
                  <div
                    class="product-upsell__variant-selector product-upsell__variant-selector--{{ settings.collection_swatch_style }}"
                    data-variant-selector
                  >
                    {%- if is_color_option -%}
                      {%- comment -%} Color swatches {%- endcomment -%}
                      {%- if settings.collection_swatch_style == 'text-slider' -%}
                        {{- swatches_count_markup -}}
                      {%- endif -%}

                      <native-scrollbar>
                        <div class="selector-wrapper__scrollbar radio__buttons radio__buttons--top" data-scrollbar>
                          {%- for value in single_option.values -%}
                            {%- liquid
                              assign swatch_value = null
                              if value.swatch
                                if value.swatch.image
                                  assign image_url = value.swatch.image | image_url: width: 40
                                  assign swatch_value = 'url(' | append: image_url | append: ')'
                                elsif value.swatch.color
                                  assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
                                endif
                              else
                                assign swatch_value = value | handle
                              endif

                              capture swatch_style
                                if is_swatch_option
                                  assign swatch_handle = value | handle
                                  echo '--swatch: var(--' | append: swatch_handle | append: ');'
                                elsif is_native_swatch_option and swatch_value != null and swatch_value != ''
                                  echo '--swatch: ' | append: swatch_value | append: ';'
                                endif
                              endcapture

                              assign value_handle = value | strip_html | escape | handle | append: '-' | append: forloop.index
                              assign input_id = product_form_id | append: '-swatch-' | append: value_handle
                              assign variant_for_value = null
                              for variant in upsell_product.variants
                                if variant.options[0] == value
                                  assign variant_for_value = variant
                                  break
                                endif
                              endfor
                            -%}

                            {%- unless settings.collection_swatch_style == 'limited'
                              and forloop.index > limited_count
                            -%}
                              <tooltip-component
                                data-tooltip="{{ value | escape | capitalize }}"
                                class="swatches swatch__button swatch__button--{{ settings.swatch_style }} swatch-{{ value | handle }}"
                                {%- if swatch_style != '' -%}
                                  style="{{ swatch_style }}"
                                {%- endif -%}
                              >
                                <input
                                  type="radio"
                                  form="{{ product_form_id }}"
                                  data-single-option-selector
                                  data-index="option1"
                                  name="options[{{ single_option.name | escape }}]-{{ unique }}"
                                  value="{{ value | escape }}"
                                  id="{{ input_id }}"
                                  data-variant-id="{{ variant_for_value.id }}"
                                  {% if value == upsell_variant.options[0] %}
                                    checked
                                  {% endif %}
                                >
                                <label for="{{ input_id }}" data-swatch="{{ value | escape }}">
                                  <span class="visually-hidden">{{ value }}</span>
                                </label>
                              </tooltip-component>
                            {%- endunless -%}
                          {%- endfor -%}

                          {%- if settings.collection_swatch_style == 'limited' and swatches_left > 0 -%}
                            <a
                              href="#"
                              class="swatch-limited"
                              data-quick-add-btn
                              data-quick-add-modal-handle="{{ upsell_product.handle }}"
                            >
                              <span class="btn__text">+{{ swatches_left }}</span>

                              <span class="btn__loader">
                                <svg height="18" width="18" class="svg-loader">
                                  <circle r="7" cx="9" cy="9" />
                                  <circle stroke-dasharray="87.96459430051421 87.96459430051421" r="7" cx="9" cy="9" />
                                </svg>
                              </span>
                            </a>

                            {%- assign render_quick_add_template = true -%}
                          {%- endif -%}
                        </div>

                        {%- if settings.collection_swatch_style == 'text-slider'
                          or settings.collection_swatch_style == 'slider'
                        -%}
                          <div class="selector-wrapper__actions">
                            <button
                              type="button"
                              class="radio__fieldset__arrow radio__fieldset__arrow--prev"
                              data-scrollbar-arrow-prev
                            >
                              {%- render 'icon-nav-arrow-left' -%}
                              <span class="visually-hidden">{{ 'products.general.see_all' | t }}</span>
                            </button>
                            <button
                              type="button"
                              class="radio__fieldset__arrow radio__fieldset__arrow--next"
                              data-scrollbar-arrow-next
                            >
                              {% render 'icon-nav-arrow-right' %}
                              <span class="visually-hidden">{{ 'products.general.see_all' | t }}</span>
                            </button>
                          </div>
                        {%- endif -%}
                      </native-scrollbar>
                    {%- else -%}
                      {%- comment -%} Dropdown selector {%- endcomment -%}
                      <div class="product-upsell__dropdown" data-dropdown>
                        <popout-select class="select-popout select-popout--small" data-variant-change>
                          <button
                            type="button"
                            class="select-popout__toggle"
                            aria-expanded="false"
                            aria-controls="{{ product_form_id }}-select-{{ single_option.name | handle }}"
                            aria-labelledby="{{ product_form_id }}-select-{{ single_option.name | handle }}-label"
                            data-popout-toggle
                          >
                            <span data-popout-toggle-text>{{ upsell_variant.options[0] }}</span>
                            {%- render 'icon-nav-arrow-down' -%}
                          </button>

                          <ul
                            id="{{ product_form_id }}-select-{{ single_option.name | handle }}"
                            class="select-popout__list"
                            data-popout-list
                          >
                            {%- for option_value in single_option.values -%}
                              <li class="select-popout__item{% if option_value.selected %} is-active{% endif %}">
                                <a
                                  class="select-popout__option"
                                  href="#"
                                  {% if option_value.selected %}
                                    aria-current="true"
                                  {% endif %}
                                  data-value="{{ option_value | escape }}"
                                  data-variant-id="{{ option_value.variant.id }}"
                                  data-popout-option
                                >
                                  <span>{{ option_value }}</span>
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>

                          <input
                            form="{{ product_form_id }}"
                            type="hidden"
                            name="options[{{ single_option.name | escape }}]-{{ unique }}"
                            value="{{ upsell_variant.options[0] | escape }}"
                            data-popout-input
                            data-single-option-selector
                            data-index="option1"
                          >
                        </popout-select>
                      </div>
                    {%- endif -%}
                  </div>

                  <div class="product-upsell__actions">
                    <button
                      id="ProductSubmitButton-{{ section_id }}"
                      class="product-upsell__btn btn btn--medium btn--primary btn--outline"
                      type="submit"
                      name="add"
                      data-quick-add-btn
                      data-add-to-cart
                      {% unless upsell_variant.available %}
                        disabled="disabled"
                      {% endunless %}
                    >
                      <span class="btn__text">{{ upsell_button_text }}</span>

                      <span class="btn__loader">
                        <svg height="18" width="18" class="svg-loader">
                          <circle r="7" cx="9" cy="9" />
                          <circle stroke-dasharray="87.96459430051421 87.96459430051421" r="7" cx="9" cy="9" />
                        </svg>
                      </span>

                      <span class="btn__added">&nbsp;</span>
                    </button>
                  </div>
                {%- endform -%}
              {%- endif -%}
            {%- endif -%}

            {%- unless upsell_quick_add_hide or enable_instant_add -%}
              <div class="product-upsell__actions">
                {%- if upsell_product.variants.size == 1 -%}
                  {%- comment -%} Single variant: direct add to cart {%- endcomment -%}
                  {%- form 'product', upsell_product, id: product_form_id, class: 'product-upsell__form' -%}
                    <input type="hidden" name="id" value="{{ upsell_variant.id }}">

                    {% comment %} Form ID must match value in product-form.liquid {% endcomment %}
                    <input
                      type="hidden"
                      form="{{ product_form_id }}"
                      name="properties[{{ 'general.siblings.label' | t }}]"
                      value="{{ sibling_color }}"
                    >

                    <button
                      id="ProductSubmitButton-{{ section_id }}"
                      class="product-upsell__btn btn btn--medium btn--primary btn--outline"
                      type="submit"
                      name="add"
                      data-quick-add-btn
                      data-add-to-cart
                      {% unless upsell_variant.available %}
                        disabled="disabled"
                      {% endunless %}
                    >
                      <span class="btn__text">{{ upsell_button_text }}</span>

                      <span class="btn__loader">
                        <svg height="18" width="18" class="svg-loader">
                          <circle r="7" cx="9" cy="9" />
                          <circle stroke-dasharray="87.96459430051421 87.96459430051421" r="7" cx="9" cy="9" />
                        </svg>
                      </span>

                      <span class="btn__added">&nbsp;</span>
                    </button>
                  {%- endform -%}
                {%- else -%}
                  {%- comment -%} Multiple options: open the Quick add drawer {%- endcomment -%}
                  {{- open_quick_add_drawer_button -}}

                  {%- assign render_quick_add_template = true -%}
                {%- endif -%}
              </div>
            {%- endunless -%}
          {%- endif -%}
        </div>
      </div>

      {%- if render_quick_add_template -%}
        {%- render 'product-quick-add-modal-template', product_id: upsell_product.id, unique: unique -%}
      {%- endif -%}
    </div>
  </quick-add-product>
{%- endif -%}
