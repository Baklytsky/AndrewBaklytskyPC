{% comment %}
  Renders product variant options

  Accepts:
  - product: {Object} product object.
  - product_form_id: {String} product form id.
  - option: {Object} current product_option object.
  - picker_type: {String} type of picker to display
  - is_theme_swatch_option: {Boolean} is it a theme swatch
  - is_native_swatch_option: {Boolean} is it a native swatch

  Usage:
  {% render 'product-variant-options',
    product: product,
    product_form_id: product_form_id,
    option: option,
    picker_type: picker_type,
    is_theme_swatch_option: is_theme_swatch_option,
    is_native_swatch_option: is_native_swatch_option
  %}
{% endcomment %}

{%- assign uniq_id = 'Product-' | append: product.id | append: '-' | append: product.handle -%}

{%- if picker_type == 'dropdown' -%}
  <ul
    id="{{ uniq_id }}-select-{{ option.name | handle }}"
    class="select-popout__list"
    data-popout-list
    data-scroll-lock-scrollable
  >
{%- else -%}
  <div class="radio__buttons" data-variant-buttons>
{%- endif -%}

{%- for value in option.values -%}
  {% render 'product-variant-option',
    product: product,
    product_form_id: product_form_id,
    index: forloop.index0,
    value: value,
    option: option,
    picker_type: picker_type,
    is_theme_swatch_option: is_theme_swatch_option,
    is_native_swatch_option: is_native_swatch_option
  %}
{%- endfor -%}
{%- if picker_type == 'dropdown' -%}
  </ul>
  {%- liquid
    assign selected_option_value_id = ''
    assign selected_option_product_url = ''
    for val in option.values
      if val.selected
        assign selected_option_value_id = val.id
        assign selected_option_product_url = val.product_url
        break
      endif
    endfor
  -%}
  <input
    form="{{ product_form_id }}"
    type="hidden"
    name="options[{{ option.name | escape }}]-{{ uniq_id }}"
    id="{{ input_id }}"
    value="{{ option.selected_value | escape }}"
    data-popout-input
    data-index="option{{ option.position }}"
    data-option-value-id="{{ selected_option_value_id }}"
    data-product-url="{{ selected_option_product_url }}"
  >
{%- else -%}
  </div>
{%- endif -%}
