{%- doc -%}
  Renders order product list or upsell products on Cart page and Cart drawer

  @param {object} block - Block object (required)

  @example
  {% render 'cart-block-upsell', block: block %}
{%- enddoc -%}

{%- liquid
  assign upsell_auto_open = block.settings.upsell_auto_open

  capture product_list
    for product in block.settings.product_list
      render 'upsell-product', upsell_product: product, is_compact: true
    endfor
  endcapture
-%}

{%- if request.design_mode or block.settings.product_list.count > 0 and product_list != blank -%}
  <details
    class="cart__widget cart__widget--products accordion"
    {% if upsell_auto_open and product_list != blank %}
      open="true"
    {% endif %}
    data-collapsible
  >
    <summary class="cart__widget__title" data-collapsible-trigger>
      {{ block.settings.title }}

      {%- render 'icon-nav-arrow-down' -%}
    </summary>

    <div
      class="cart__widget__content"
      {% if upsell_auto_open and product_list != blank %}
        style="height: auto;"
      {% endif %}
      data-collapsible-body
    >
      <div class="cart__widget__content__inner" data-collapsible-content>
        <div class="cart__widget__products">
          {{ product_list }}
        </div>
      </div>
    </div>
  </details>
{%- endif -%}
