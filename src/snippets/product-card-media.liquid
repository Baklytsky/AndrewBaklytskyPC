{%- liquid
  assign double_img = false
  if product.media[1].preview_image and settings.image_hover_enable
    assign double_img = true
  endif
-%}

{%- liquid
  if settings.show_siblings
    capture siblings_line_item_props
      render 'product-grid-item-siblings', part: 'line-item-props', product: product
    endcapture
    capture siblings_image
      render 'product-grid-item-siblings', part: 'image', product: product
    endcapture
  endif
-%}

{%- capture over_image_content -%}
  {%- liquid
    assign product_tags = product.tags | join: ',' | append: ','
    assign preorder = false
    assign is_preorder_meta = false
    assign on_sale = false
    assign sold_out = false
    assign badge = ''
    assign badge_new = ''
    assign badge_soldout = ''
    assign badge_content = ''

    if settings.show_custom_badge
      if product.metafields.theme.badge != blank and product.metafields.theme.badge.type == 'single_line_text_field'
        assign badge = product.metafields.theme.badge.value
      endif

      if badge == '' and product_tags contains '_badge_'
        assign badge = product_tags | split: '_badge_'
        assign badge = badge[1] | split: ',' | first | replace: '_', ' '
      endif
    endif

    if settings.show_preorder_badge
      if product.metafields.theme.preorder.type == 'boolean' and product.metafields.theme.preorder.value == true
        assign is_preorder_meta = true
      endif

      if product_tags contains '_preorder' or is_preorder_meta
        assign preorder = true
      endif
    endif

    if product.compare_at_price > product.price and settings.sale_tags_enable
      assign on_sale = true
    endif

    unless product.available
      assign sold_out = true
    endunless

    if settings.show_automatic_new_badge
      assign product_created_timestamp = product.created_at | date: '%s' | plus: 0
      assign days_in_seconds = settings.badge_new_date_limit | times: 24 | times: 60 | times: 60
      assign current_date_timestamp = "now" | date: '%s'
      assign check_date_timestamp = current_date_timestamp | minus: days_in_seconds

      if product_created_timestamp > check_date_timestamp
        assign badge_new = 'products.product.new' | t
      endif
    endif

    if settings.show_sold_out_badge and sold_out
      assign badge_soldout = 'products.product.sold_out' | t
    endif
  -%}

  {%- if badge != '' or badge_new != '' or badge_soldout != '' -%}
    {%- capture badge_content -%}
      <span class="badge-box{% if badge_new != '' %} badge-box--new{% elsif badge_soldout != '' %} badge-box--sold{% endif %}"
        data-aos="fade"
        data-aos-delay="{{ aos_delay }}"
        data-aos-anchor="{{ aos_anchor }}">
        {%- if badge_soldout != '' -%}
          {{ badge_soldout }}
        {%- elsif badge_new != '' -%}
          {{ badge_new }}
        {%- else -%}
          {{ badge }}
        {%- endif -%}
      </span>
    {%- endcapture -%}
  {%- elsif preorder and sold_out == false -%}
    {%- capture badge_content -%}
      <span class="badge-box badge-box--preorder"
        data-aos="fade"
        data-aos-delay="{{ aos_delay }}"
        data-aos-anchor="{{ aos_anchor }}">{{ 'products.product.pre_order' | t }}</span>
    {%- endcapture -%}
  {%- elsif on_sale and sold_out == false -%}
    {%- capture badge_content -%}
      <span
        class="badge-box badge-box--sale"
        data-aos="fade"
        data-aos-delay="{{ aos_delay }}"
        data-aos-anchor="{{ aos_anchor }}"
      >
        {{ 'products.product.on_sale' | t }}

        {%- if settings.show_saving_badge -%}
          {%- liquid
            assign price_difference = product.compare_at_price | minus: product.price
            assign discount = price_difference | money_without_trailing_zeros

            if settings.currency_code_enable
              assign discount = price_difference | money_with_currency
            endif

            if settings.saving_badge_type == 'percentage'
              assign percent_off = price_difference | times: 1.00 | divided_by: product.compare_at_price | times: 100
              assign discount = percent_off | floor | append: '%'
            endif
          -%}
          &bull; {{ discount }} {{ 'products.product.off' | t }}
        {%- endif -%}
      </span>
    {%- endcapture -%}
  {%- endif -%}

  {%- if badge_content != '' -%}
    <div class="badge-box-container {{ settings.badge_alignment }} {{ settings.badge_font_size }}">
      {{ badge_content }}
    </div>
  {%- endif -%}

  {%- if current_variant -%}
    {%- if bundle_product or bundle_template -%}
      {%- capture bundle_code -%}
        {%- assign unique = section.id | append: '-' | append: product.id -%}

        <script type="application/json" data-bundle-json>
          {
            "product": {{ product | json }},
            "variant": {{ product.selected_or_first_available_variant | json }}
          }
        </script>

        <quick-add-product>
          <div class="quick-add__holder" data-quick-add-holder="{{ product.id }}">
            <button class="quick-add__button caps"
              type="button"
              aria-label="{{ 'products.general.quick_add' | t }}"
              data-bundle-product-button="{{ product.id }}"
              data-bundle-product-url="{{ product.url }}"
              {% if product.has_only_default_variant == false and product.variants.size > 1 %}
                data-quick-add-btn
                data-quick-add-modal-handle="{{ product.handle }}"
              {% endif %}
            >
              <span class="btn__text">
                {{ 'products.general.add_bundle' | t }}
              </span>
              <span class="btn__bag"></span>
              <span class="btn__added">&nbsp;</span>
              <span class="btn__loader">
                <svg height="18" width="18" class="svg-loader">
                  <circle r="7" cx="9" cy="9" />
                  <circle stroke-dasharray="87.96459430051421 87.96459430051421" r="7" cx="9" cy="9" />
                </svg>
              </span>
            </button>

            {%- unless product.has_only_default_variant -%}
              {%- render 'product-quick-add-modal-template', product_id: product.id, unique: unique -%}
            {%- endunless -%}
          </div>
        </quick-add-product>
      {%- endcapture -%}
    {%- endif -%}

    {%- if bundle_template -%}
      <template data-bundle-item-template>
        {{ bundle_code }}
      </template>
    {%- endif -%}

    {%- if bundle_product -%}
      {{ bundle_code }}
    {%- elsif settings.quickview_enable -%}
      {%- liquid
        assign has_preorder_meta = false
        assign has_preorder_tag = false

        if current_variant.available and product.metafields.theme.preorder.type == 'boolean' and product.metafields.theme.preorder.value == true
          assign has_preorder_meta = true
        endif

        if current_variant.available and product.tags contains '_preorder'
          assign has_preorder_tag = true
        endif

        if has_preorder_meta or has_preorder_tag
          assign preorder_name = 'products.product.sale_type' | t | strip_html | escape
          assign preorder_value = 'products.product.pre_order' | t | strip_html | escape
        endif

        assign unique = section.id | append: '-' | append: product.id
      -%}

      <quick-add-product data-bundle-item-replace>
        <div class="quick-add__holder" data-quick-add-holder="{{ product.id }}">
          {%- if product.variants.size == 1 -%}
            {%- assign product_form_id = 'ProductForm--' | append: unique -%}
            {%- form 'product', product, id: product_form_id -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

              {{- siblings_line_item_props -}}

              {%- if preorder_value != blank -%}
                <input
                  type="hidden"
                  name="properties[{{ preorder_name }}]"
                  value="{{ preorder_value }}">
              {%- endif -%}

              <button class="quick-add__button caps"
                type="submit"
                name="add"
                aria-label="{{ 'products.general.quick_add' | t }}"
                data-add-to-cart
              >
                <span class="btn__text">
                  {%- if preorder -%}
                    {{ 'products.product.pre_order' | t }}
                  {%- else -%}
                    {{ 'products.general.quick_add' | t }}
                  {%- endif -%}
                </span>
                <span class="btn__bag"></span>
                <span class="btn__added">&nbsp;</span>
                <span class="btn__loader">
                  <svg height="18" width="18" class="svg-loader">
                    <circle r="7" cx="9" cy="9" />
                    <circle stroke-dasharray="87.96459430051421 87.96459430051421" r="7" cx="9" cy="9" />
                  </svg>
                </span>
                <span class="btn__error" data-message-error>&nbsp;</span>
              </button>
            {%- endform -%}
          {%- else -%}
            <button class="quick-add__button caps"
              type="button"
              aria-label="{{ 'products.general.quick_add' | t }}"
              data-quick-add-btn
              data-quick-add-modal-handle="{{ product.handle }}"
            >
              <span class="btn__text">
                {%- if preorder -%}
                  {{ 'products.product.pre_order' | t }}
                {%- else -%}
                  {{ 'products.general.quick_add' | t }}
                {%- endif -%}
              </span>
              <span class="btn__bag"></span>
              <span class="btn__added">&nbsp;</span>
              <span class="btn__loader">
                <svg height="18" width="18" class="svg-loader">
                  <circle r="7" cx="9" cy="9" />
                  <circle stroke-dasharray="87.96459430051421 87.96459430051421" r="7" cx="9" cy="9" />
                </svg>
              </span>
            </button>
          {%- endif -%}

          {%- unless product.has_only_default_variant -%}
            {%- render 'product-quick-add-modal-template', product_id: product.id, unique: unique -%}
          {%- endunless -%}
        </div>
      </quick-add-product>
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture image_animations -%}
  data-aos="img-in"
  data-aos-delay="{{ aos_delay }}"
  data-aos-anchor="{{ aos_anchor }}"
{%- endcapture -%}

<div
  class="product-item__image{% if double_img %} double__image{% endif %}{% if settings.show_image_bg != 'none' %} show-gray-bg{% endif %}"
  data-product-image
>
  <a
    class="product-link"
    href="{{ product_url }}"
    aria-label="{{ product.title | strip_html | escape }}"
    data-product-link="{{ product_url }}"
  >
    {%- if product.media.size > 0 -%}
      <div class="product-item__bg" data-product-image-default>
        {%- liquid
          assign fetchpriority = 'auto'
          assign preload = false
          if index <= eager_images_limit
            assign fetchpriority = 'high'
            assign preload = true
          endif

          capture featured_image
            render 'image', image: product.featured_media.preview_image, aspect_ratio: aspect_ratio, sizes: sizes, widths: widths, loading: loading, fetchpriority: fetchpriority, preload: preload, attributes: image_animations, cover: true
          endcapture
        -%}

        {{ featured_image }}

        {%- if settings.enable_color_swatches and current_variant -%}
          {%- assign image_inner_empty = true -%}
          {%- assign variant_images = '' -%}
          {%- for variant in product.variants -%}
            {%- if variant.featured_image != blank -%}
              {%- comment -%}
                Prevent duplicated variant images to be rendered
              {%- endcomment -%}
              {%- unless variant_images contains variant.featured_image -%}
                {%- liquid
                  assign variant_images = variant_images | append: variant.featured_image | append: ', '
                  assign image_inner_empty = false
                  assign variant_title = variant.title | replace: '"', "'"
                -%}

                <div class="product-item__bg__inner" data-variant-title="{{ variant_title }}">
                  {%- render 'image',
                    image: variant.featured_image,
                    aspect_ratio: aspect_ratio,
                    sizes: sizes,
                    widths: widths,
                    cover: true,
                    loading: 'lazy',
                    fetchpriority: 'high'
                  -%}
                </div>
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if image_inner_empty -%}
            &nbsp;
          {%- endif -%}
        {%- else -%}
          &nbsp;
        {%- endif -%}
      </div>

      {%- if double_img -%}
        <div class="product-item__bg__under{% if product.media[1].media_type == 'video' or product.media[1].media_type == 'external_video' %} deferred-media{% endif %}">
          {%- if product.media[1].media_type == 'video' or product.media[1].media_type == 'external_video' -%}
            {%- liquid
              case product.media[1].media_type
                when 'video'
                  echo product.media[1] | media_tag: image_size: '1024x1024', class: 'media-video', autoplay: true, loop: true, controls: false, preload: 'none', muted: true
                when 'external_video'
                  if product.media[1].host == 'youtube'
                    echo product.media[1] | external_video_url: autoplay: true, playsinline: true, loop: true, playlist: product.media[1].external_id, controls: false, mute: true, showinfo: false | external_video_tag: loading: 'lazy', data-host: product.media[1].host
                  else
                    echo product.media[1] | external_video_url: autoplay: true, playsinline: true, loop: true, controls: false, muted: true | external_video_tag: data-host: product.media[1].host
                  endif
              endcase
            -%}
          {%- else -%}
            {%- render 'image',
              image: product.media[1].preview_image,
              aspect_ratio: aspect_ratio,
              sizes: sizes,
              widths: widths,
              cover: true,
              loading: 'lazy',
              fetchpriority: 'high'
            -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- else -%}
      {%- comment -%} Show Empty image if product has no media {%- endcomment -%}
      <div class="product-item__bg image--empty" data-product-image-default></div>
    {%- endif -%}

    {{- siblings_image -}}
  </a>

  {{ over_image_content }}
</div>
