{% comment %}
  Renders Free shipping message

  Accepts:
  - block: {Object} Block object (required)
  - show_wheel: {Boolean} Show progress wheel
  - show_progress_bar: {Boolean} Show progress bar
  - is_cart_drawer: {Boolean} Is cart drawer

  Usage:
  {% render 'free-shipping', message: block.settings.message, show_wheel: true, show_progress_bar: false, is_cart_drawer: false %}
{% endcomment %}

{%- liquid
  assign message = block.settings.message
  assign show_message = false
  if message != blank
    assign show_message = true
  endif
-%}

{%- if show_message -%}
  {%- liquid
    assign promo_2 = settings.free_shipping_promotion_2
    assign promo_center_limit = settings.free_gift_limit | default: 0
    assign free_shipping_limit = settings.free_shipping_limit
    assign limit_promo_center = promo_center_limit | plus: 0
    assign limit = free_shipping_limit | plus: 0
    assign limit_currency_promo_center = limit_promo_center | times: 100.0
    assign limit_currency = limit | times: 100
    assign subtotal_without_currency = cart.total_price | plus: 0 | divided_by: 100
    assign percent = limit | minus: subtotal_without_currency | times: 100.0 | divided_by: limit
    assign percent = 100 | minus: percent
    assign percent_promo_center = limit_promo_center | times: 100.0 | divided_by: limit

    if settings.currency_code_enable
      assign limit_currency_promo_center = limit_currency_promo_center | minus: cart.total_price | money_with_currency
      assign limit_currency = limit_currency | minus: cart.total_price | money_with_currency
    else
      assign limit_currency_promo_center = limit_currency_promo_center | minus: cart.total_price | money_without_trailing_zeros
      assign limit_currency = limit_currency | minus: cart.total_price | money_without_trailing_zeros
    endif

    capture left_to_spend
      echo '<span data-left-to-spend>' | append: limit_currency | append: '</span>'
    endcapture
    assign left_to_spend_message = left_to_spend

    if promo_2
      capture left_to_spend_promo
        echo '<span data-left-to-spend-promo>' | append: limit_currency_promo_center | append: '</span>'
      endcapture

      assign left_to_spend_message = left_to_spend_promo
    endif

    assign message = message | replace: '||amount||', left_to_spend_message
    assign qualified_shipping_message = ''

    if promo_2
      assign qualified_shipping_message = 'cart.general.qualified_shipping_message_promos' | t
    else
      assign qualified_shipping_message = 'cart.general.qualified_shipping_message' | t
    endif

    capture free_shipping_classes
      if is_cart_drawer
        echo 'drawer__message '
      endif

      if template.name == 'cart'
        echo 'cart__message '
      endif

      echo 'free-shipping'

      if align_text != blank
        echo ' ' | append: align_text
      endif

      if subtotal_without_currency >= limit and qualified_shipping_message != blank
        echo ' is-success'
      endif
    endcapture
  -%}

  <div
    class="{{ free_shipping_classes }}{% if promo_2 and percent > percent_promo_center %} is-active{% endif %}"
    data-free-shipping="{% if qualified_shipping_message != blank %}true{% else %}false{% endif %}"
    data-free-shipping-limit="{{ limit }}"
    {% if promo_2 %}
      data-promo-center-limit="{{ limit_promo_center }}"
    {% endif %}
  >
    {%- if show_wheel -%}
      <div class="free-shipping__graph" data-progress-graph style="--stroke-dashoffset: 87.96459430051421;">
        <svg height="18" width="18" viewBox="0 0 18 18">
          <circle r="7" cx="9" cy="9" />
          <circle class="free-shipping__graph-progress" stroke-dasharray="87.96459430051421 87.96459430051421" r="7" cx="9" cy="9" />
        </svg>
      </div>
    {%- endif -%}

    {%- if qualified_shipping_message != blank -%}
      <span class="free-shipping__success-message">{{ qualified_shipping_message }}</span>
    {%- endif -%}

    <span class="free-shipping__default-message">
      {{ message }}
    </span>

    {%- if promo_2 and settings.free_shipping_promotion_text_2 != blank -%}
      <span class="free-shipping__promo-message">
        {{ settings.free_shipping_promotion_text_2 | replace: '||amount||', left_to_spend }}
      </span>
    {%- endif -%}

    {%- if show_progress_bar -%}
      {%- if settings.free_shipping_icon_1 -%}
        {%- liquid
          assign icon_1 = ''
          assign icon_size = settings.free_shipping_icon_size_1
          assign icon_image = settings.free_shipping_icon_image_1
          capture icon_style
            echo '--icon-size: ' | append: icon_size | append: 'px;'
          endcapture
        -%}

        {%- capture icon_1 -%}
          <div
            class="icon__animated icon__animated--{{ section.id }}-{{ block.id }}{% if icon_image != blank %} icon__animated--image{% endif %}"
          >
            {%- liquid
              if icon_image
                assign icon_width = icon_size
                assign icon_width_retina = icon_width | times: 2
                assign icon_sizes = icon_width | append: 'px'
                assign icon_widths = icon_width | append: ', ' | append: icon_width_retina

                render 'image', image: icon_image, width: icon_width_retina, sizes: icon_sizes, widths: icon_widths
              else
                render 'animated-icon', filename: settings.free_shipping_icon_name_1
              endif
            -%}
          </div>
        {%- endcapture -%}
      {%- endif -%}

      {%- if settings.free_shipping_icon_2 -%}
        {%- liquid
          assign icon_2 = ''
          assign icon_size_2 = settings.free_shipping_icon_size_2
          assign icon_image_2 = settings.free_shipping_icon_image_2
          capture icon_style_2
            echo '--icon-size: ' | append: icon_size_2 | append: 'px;'
          endcapture
        -%}

        {%- capture icon_2 -%}
          <div
            class="icon__animated icon__animated--{{ section.id }}-{{ block.id }}{% if icon_image_2 != blank %} icon__animated--image{% endif %}"
          >
            {%- liquid
              if icon_image_2
                assign icon_width_2 = icon_size_2
                assign icon_width_retina_2 = icon_width_2 | times: 2
                assign icon_sizes_2 = icon_width_2 | append: 'px'
                assign icon_widths_2 = icon_width_2 | append: ', ' | append: icon_width_retina_2

                render 'image', image: icon_image_2, width: icon_width_retina_2, sizes: icon_sizes_2, widths: icon_widths_2
              else
                render 'animated-icon', filename: settings.free_shipping_icon_name_2
              endif
            -%}
          </div>
        {%- endcapture -%}
      {%- endif -%}

      <div class="free-shipping__progress-holder{% if promo_2 %} free-shipping__progress-holder--multiple{% endif %}">
        <div class="free-shipping__box free-shipping__box--left">&nbsp;</div>

        {%- if promo_2 -%}
          <div
            class="free-shipping__box free-shipping__box--center"
            style="--promo-center-position: {{ percent_promo_center }}%;{% if icon_style != '' %} {{ icon_style }}{% endif %}"
            data-promo-center
          >
            {%- if icon_1 != '' -%}
              {{ icon_1 }}
            {%- endif -%}
          </div>
        {%- endif -%}

        <div
          class="free-shipping__box free-shipping__box--right"
          {% if icon_style_2 != '' %}
            style="{{ icon_style_2 }}"
          {% endif %}
        >
          {%- if promo_2 -%}
            {{ icon_2 }}
          {%- elsif icon_1 != '' -%}
            {{ icon_1 }}
          {%- endif -%}
        </div>

        <progress
          class="free-shipping__progress-bar"
          data-progress-bar
          value="{{ percent }}"
          max="100"
        ></progress>
      </div>
    {%- endif -%}

    <div class="confetti">
      <span class="confetti__dot confetti__dot--1"></span>
      <span class="confetti__dot confetti__dot--2"></span>
      <span class="confetti__dot confetti__dot--3"></span>
      <span class="confetti__dot confetti__dot--4"></span>
      <span class="confetti__dot confetti__dot--5"></span>
      <span class="confetti__dot confetti__dot--6"></span>
    </div>
  </div>
{%- endif -%}
