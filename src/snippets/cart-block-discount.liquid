{% comment %}
  Renders discount on Cart page and Cart drawer

  Accepts:
  - block: {Object} Block object (required)

  Usage:
  {% render 'cart-block-discount', block: block %}
{% endcomment %}

{%- liquid
  assign discount_codes = ''
  if cart.cart_level_discount_applications.size > 0
    for discount in cart.cart_level_discount_applications
      assign discount_codes = discount_codes | append: ',' | append: discount.title
    endfor
  endif
-%}

<details
  class="cart__widget accordion"
  data-collapsible
>
  <summary class="cart__widget__title" data-collapsible-trigger>
    {{ block.settings.title }}

    {%- render 'icon-plus' -%}
    {%- render 'icon-minus' -%}
  </summary>

  <div class="cart__widget__content" data-collapsible-body>
    <div class="cart__widget__content__inner" data-collapsible-content>
      <label for="cart-discount" class="visually-hidden">{{ block.settings.title }}</label>

      <input
        type="text"
        id="cart-discount"
        class="cart__field"
        placeholder="{{ placeholder_field }}"
        aria-label="{{ placeholder_field }}"
        data-cart-discount-field
      >

      <button
        class="btn btn--full btn--primary btn--solid"
        data-cart-discount-button="{{ discount_codes }}"
      >
        <span>Apply</span>
      </button>
    </div>
  </div>
</details>
