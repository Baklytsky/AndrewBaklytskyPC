{%- liquid
  assign stacked = stacked | default: false
  assign link_url_primary = block.settings.link_primary
  assign link_text_primary = block.settings.link_text_primary
  assign link_url_secondary = block.settings.link_secondary
  assign link_text_secondary = block.settings.link_text_secondary

  assign button_style_primary = block.settings.button_style_primary
  if button_style_primary == 'btn--text' and block.settings.show_arrow_primary
    assign button_style_primary = button_style_primary | append: ' btn--text-no-underline'
  endif

  assign button_style_secondary = block.settings.button_style_secondary
  if button_style_secondary == 'btn--text' and block.settings.show_arrow_secondary
    assign button_style_secondary = button_style_secondary | append: ' btn--text-no-underline'
  endif
-%}

{%- if link_text_primary != '' or link_text_secondary != '' -%}
  <div
    class="hero__button-group{% if stacked %} hero__button-group--stacked{% endif %}"
    {{ block.shopify_attributes }}
  >
    {%- if link_text_primary != '' -%}
      {%- assign animation_order = animation_order | plus: 1 -%}

      <div
        class="hero__button"
        data-aos="hero"
        data-aos-anchor="#{{ section.id }}"
        data-aos-order="{{ animation_order }}"
      >
        <a
          class="btn {{ button_style_primary }} {{ block.settings.button_size_primary }} {{ block.settings.button_type_primary }}"
          href="{{ link_url_primary | default: '#!' }}"
        >
          <span>{{ link_text_primary | escape }}</span>

          {%- if block.settings.show_arrow_primary -%}
            {% render 'icon-arrow-right' %}
          {%- endif -%}
        </a>
      </div>
    {%- endif -%}

    {%- if link_text_secondary != '' -%}
      {%- assign animation_order = animation_order | plus: 1 -%}

      <div
        class="hero__button"
        data-aos="hero"
        data-aos-anchor="#{{ section.id }}"
        data-aos-order="{{ animation_order }}"
      >
        <a
          class="btn {{ button_style_secondary }} {{ block.settings.button_size_secondary }} {{ block.settings.button_type_secondary }}"
          href="{{ link_url_secondary | default: '#!' }}"
        >
          <span>{{ link_text_secondary | escape }}</span>

          {%- if block.settings.show_arrow_secondary -%}
            {% render 'icon-arrow-right' %}
          {%- endif -%}
        </a>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
