{% comment %}
  Renders a swatch input component.
  Accepts:
  - id: {String} unique input id
  - type: {String} input type. Accepts 'radio' or 'checkbox', defaults to 'radio' (optional)
  - name: {String} input name,
  - value: {ProductOptionValueDrop} input value
  - swatch: {SwatchDrop} the swatch drop
  - product_form_id: {String} id of the form associted with the input
  - checked: {Boolean} default checked status
  - disabled: {Boolean} default disabled status (optional)
  - visually_disabled: {Boolean} style the swatch as disabled, but leave the input enabled (optional)
  - help_text: {String} additional content to render inside the label (optional)
  - additional_props: {String} additional properties to attach to the input (optional)
  - is_theme_swatch_option: {Boolean} is it a theme swatch
  - is_native_swatch_option: {Boolean} is it a native swatch
  - is_bundle: {Boolean} If it is bundle (optional)

  Usage:
   {% render 'swatch-input',
      id: input_id,
      name: input_name,
      value: input_value,
      swatch: swatch,
      is_theme_swatch_option: is_theme_swatch_option,
      is_native_swatch_option: is_native_swatch_option,
      product_form_id: product_form_id,
      checked: checked
    %}
{% endcomment %}
{%- liquid
  assign swatch_value = null
  if is_bundle
    assign option_name_with_value = option.name | append: '####' | append: value | append: '@@@@'
    assign swatch_value = meta_swatches | split: option_name_with_value | last | split: '$$$$' | first
  else
    if value.swatch
      if value.swatch.image
        assign image_url = value.swatch.image | image_url: width: 96
        assign swatch_value = 'url(' | append: image_url | append: ')'
      elsif value.swatch.color
        assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
      endif
    else
      assign swatch_value = value | handle
    endif
  endif

  capture swatch_style
    if is_theme_swatch_option
      assign swatch_handle = value | handle
      echo '--swatch: var(--' | append: swatch_handle | append: ')'
    elsif is_native_swatch_option and swatch_value != null and swatch_value != ''
      echo '--swatch: ' | append: swatch_value | append: ';'
    endif
  endcapture
-%}

<tooltip-component
  is_theme_swatch_option="{{is_theme_swatch_option}}"
  is_native_swatch_option="{{is_native_swatch_option}}"
  data-tooltip="{{ value | escape | capitalize }}"
  class="
    swatch__button
    swatch__button--{{ settings.swatch_style }}
    swatch__button swatch-{{ value | handle }}
    {% if sale %} sale{% endif %}
    swatches
  "
  {%- if swatch_style != '' -%}
    style="{{ swatch_style }}"
  {%- endif -%}
>
  <input
    type="{{ type | default: 'radio' }}"
    id="{{ id }}"
    name="{{ name }}"
    value="{{ value }}"
    form="{{ product_form_id }}"
    class="swatch-input__input{% if visually_disabled %} visually-disabled{% endif %}"
    {% if checked %}
      checked
    {% endif %}
    {% if disabled %}
      disabled
    {% endif %}
    {% if additional_props %}
      {{ additional_props }}
    {% endif %}
  >
  <label
    for="{{ id }}"
    title="{{ value }}"
    class="swatch-input__label"
  >
    {{ help_text }}
  </label>
</tooltip-component>
