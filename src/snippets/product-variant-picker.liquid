{%- liquid
  assign uniq_id = unique | append: 'product-' | append: product.id | append: '-'
  assign hide_labels_class = ''
  assign current_variant = product.selected_or_first_available_variant
  assign enable_size_chart = enable_size_chart | default: false
  assign show_size_chart = false
  assign tags_string = product.tags | join: ','
  assign size_separator = '_size_'
  assign specific_pages = ''
  assign form_style = settings.form_style
  assign is_bundle = is_bundle | default: false
  assign featured_product = featured_product | default: false
  assign bundle_separator_open = '('
  assign bundle_separator_close = ')'
  assign meta_products = ''
  assign meta_product_details = ''
  assign meta_swatches = ''
  assign size_style = block.settings.size_chart_style
  assign specific_pages = ''

  if block.settings.info_page != blank
    assign size_translation = 'general.size_chart.size' | t
    assign info_page = pages[block.settings.info_page]
  endif

  if tags_string contains size_separator
    for tag in product.tags
      if tag contains size_separator
        assign page_handle = tag | split: size_separator | last | split: ',' | first
        assign specific_pages = specific_pages | append: page_handle | append: ','
      endif
    endfor
  endif
-%}

{%- if is_bundle -%}
  {%- for item in product.metafields.theme_modules.bundle_products.value -%}
    {%- assign item_current_variant = item.first_available_variant -%}
    {%- assign item_featured_image = item.featured_image -%}
    {%- assign item_url = item.url | within: collection -%}
    {%- assign item_featured_image_string = '' -%}
    {%- if item_featured_image != blank -%}
      {%- assign item_featured_image_string = item_featured_image | image_url: width: 240 -%}
    {%- endif -%}

    {%- assign meta_product_details = meta_product_details
      | append: '$$$$'
      | append: item.title
      | append: '####'
      | append: item_featured_image_string
      | append: '@@@@'
      | append: item_url
    -%}

    {%- unless featured_product -%}
      {%- capture meta_products -%}
        {{ meta_products }}

        <div class="card-bundle">
          <div class="card-bundle__image">
            <a href="{{ item_url }}">
              {%- render 'image',
                image: item_featured_image,
                widths: '150, 300, 450, 600',
                width: '300',
                sizes: '150px'
                aspect_ratio: 1
              -%}
            </a>
          </div>

          <div class="card-bundle__content">
            <span class="card-bundle__title">
              <a href="{{ item_url }}" class="card-bundle__link">
                {{ item.title }}
              </a>
            </span>

            <div class="card-bundle__price">
              {%- render 'price', product: item -%}
            </div>
          </div>
        </div>
      {%- endcapture -%}
    {%- endunless -%}

    {%- if settings.enable_swatches -%}
      {%- for option in item.options_with_values -%}
        {%- for value in option.values -%}
          {%- if value.swatch -%}
            {%- assign option_name_meta = item.title
              | append: ' '
              | append: bundle_separator_open
              | append: option.name
              | append: bundle_separator_close
            -%}
            {%- liquid
              if value.swatch.image
                assign image_url = value.swatch.image | image_url: width: 96
                assign swatch_value = 'url(' | append: image_url | append: ')'
              elsif value.swatch.color
                assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
              endif
            -%}

            {%- assign meta_swatches = meta_swatches
              | append: '$$$$'
              | append: option_name_meta
              | append: '####'
              | append: value
              | append: '@@@@'
              | append: swatch_value
            -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- capture size_chart -%}
  {%- if enable_size_chart -%}
    {%- if block.settings.info_page != blank or specific_pages != '' -%}
      {%- liquid
        assign show_size_chart = true
        assign specific_pages_arr = specific_pages | split: ','
      -%}

      {%- capture size_chart_text -%}
        {%- case size_style -%}
          {%- when 'text' -%}
            <span class="radio__legend__link__label">
              {{- 'general.size_chart.title' | t -}}
            </span>

          {%- when 'ruler' -%}
            <span class="btn-size-chart">
              {%- render 'icon-size-guide' -%}
            </span>

          {%- when 'question' -%}
            <span class="btn-size-chart">
              {%- render 'icon-get-help' -%}
            </span>
        {%- endcase -%}{%- endcapture -%}

      {%- capture size_button_text -%}
        <a href="{{ info_page.url }}" data-popup-open class="radio__legend__link body-x-small{% if product.has_only_default_variant %} size-popup-link{% endif %} text-link">
          <span class="radio__legend__link__label">
            {{ size_chart_text }}
          </span>
        </a>
      {%- endcapture -%}

      {%- capture size_button_options -%}
        <a href="{{ info_page.url }}" data-popup-open class="radio__legend__link body-x-small{% if product.has_only_default_variant %} size-popup-link{% endif %}{% if size_style == 'text' %} text-link{% endif %}">
          {{ size_chart_text }}
        </a>
      {%- endcapture -%}

      {%- capture size_chart_link -%}
        {%- render 'stylesheet', name: 'tabs.css', blocking: true -%}

        <popup-component>
          {% comment %}
            <size-chart-button></size-chart-button> will be replaced by size_button_options markup
          {% endcomment %}
          <size-chart-button></size-chart-button>

          <dialog class="product-modal" aria-hidden="true" inert data-scroll-lock-required>
            <form method="dialog">
              <button class="visually-hidden" aria-label="{{ 'general.accessibility.close' | t }}"></button>
            </form>

            <div class="product-modal__outer">
              <div class="product-modal__content small" data-scroll-lock-scrollable>
                <button type="button" class="product-modal__close" data-popup-close aria-label="{{ 'general.accessibility.close' | t }}">
                  {%- render 'icon-close' -%}
                </button>

                <tabs-component class="rte product-tabs">
                  {%- liquid
                    assign tabs_navigation = ''
                    assign tabs = ''
                    assign has_current = false
                    assign number_tabs = 0
                  -%}

                  {%- for page_handle in specific_pages_arr -%}
                    {%- assign page_size_chart = pages[page_handle] -%}

                    {%- if page_size_chart.title != blank -%}
                      {%- capture tabs_navigation -%}
                        {{ tabs_navigation }}

                        <li class="tab-link tab-link-{{ forloop.index0 }}{% if forloop.index == 1 %} current{% endif %}" data-tab="{{ forloop.index0 }}" tabindex="0">
                          <span>{{ page_size_chart.title }}</span>
                        </li>
                      {%- endcapture -%}

                      {%- capture tabs -%}
                        {{ tabs }}

                        <div class="tab-content tab-content-{{ forloop.index0 }}{% unless has_current %} current{% endunless %}">
                          {{ page_size_chart.content }}
                        </div>
                      {%- endcapture -%}

                      {%- assign has_current = true -%}
                    {%- endif -%}
                  {%- endfor -%}

                  {%- if info_page -%}
                    {%- assign number_tabs = specific_pages_arr.size -%}

                    {%- capture tabs_navigation -%}
                      {{ tabs_navigation }}

                      <li class="tab-link tab-link-{{ number_tabs }}" data-tab="{{ number_tabs }}" data-lock-scroll tabindex="0">
                        <span>{{ info_page.title }}</span>
                      </li>
                    {%- endcapture -%}

                    {%- capture tabs -%}
                      {{ tabs }}

                      <div class="tab-content tab-content-{{ number_tabs }}{% unless has_current %} current{% endunless %}">
                        {{ info_page.content }}
                      </div>
                    {%- endcapture -%}

                    {%- assign has_current = true -%}
                  {%- endif -%}

                  {%- if specific_pages_arr.size > 1 -%}
                    <native-scrollbar class="tabs__head product-tabs__head">
                      <ul class="tabs product-tabs-title" data-scrollbar data-scrollbar-slider data-scroll-lock-scrollable>
                        {{ tabs_navigation }}
                      </ul>

                      <button type="button" class="tabs__arrow tabs__arrow--prev" data-scrollbar-arrow-prev disabled>
                        {%- render 'icon-nav-arrow-left' -%}
                        <span class="visually-hidden">{{ 'products.general.see_all' | t }}</span>
                      </button>

                      <button type="button" class="tabs__arrow tabs__arrow--next" data-scrollbar-arrow-next disabled>
                        {%- render 'icon-nav-arrow-right' -%}
                        <span class="visually-hidden">{{ 'products.general.see_all' | t }}</span>
                      </button>
                    </native-scrollbar>
                  {%- endif -%}

                  {%- if tabs != '' -%}
                    {{ tabs }}
                  {%- endif -%}
                </tabs-component>
              </div>
            </div>
          </dialog>
        </popup-component>
      {%- endcapture -%}
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture product_variant_options -%}
  {%- if settings.show_labels == false -%}
    {%- assign hide_labels_class = ' variant__labels--hide' -%}
  {%- endif -%}

  {%- capture form_fields -%}
    {%- unless product.has_only_default_variant -%}
      {%- assign options_html = '' -%}
      <div class="product__selectors">
        {%- for option in product.options_with_values -%}
          {%- liquid
            assign current_value = current_variant.options[forloop.index0]
            assign option_name = option.name
            assign option_title = option_name | split: bundle_separator_open | last | split: bundle_separator_close | first | strip
            assign option_product_name = option_name | split: bundle_separator_open | first | strip
            assign next_option = product.options_with_values[forloop.index]
            assign next_option_product_name = next_option.name | split: bundle_separator_open | first | strip
            assign prev_index = forloop.index0 | minus: 1
            assign prev_option = product.options_with_values[prev_index]
            assign prev_option_product_name = prev_option.name | split: bundle_separator_open | first | strip
            assign option_name_string = ''
            assign option_product_splitter = option_product_name | append: '####'
            assign option_product_details = meta_product_details | split: option_product_splitter | last | split: '$$$$' | first | split: '@@@@'
            assign option_product_image = option_product_details | first
            assign option_product_url = option_product_details | last

            if forloop.first
              assign prev_option_product_name = ''
            endif

            if forloop.last
              assign next_option_product_name = ''
            endif

            if is_bundle
              assign option_name = option_title
              if option_product_name != prev_option_product_name
                assign option_name_string = option_product_name
              endif
            else
              assign option_name_string = option.name
            endif

            assign option_name_handle_separator = option_name | handle | prepend: ',' | append: ','

            comment
              Determine if current option matches size handle translations
            endcomment
            assign is_size_option = false
            assign size_translation = 'general.size_chart.size' | t
            assign translation_string_size = size_translation | remove: '  ' | replace: ', ', ',' | replace: ' ,', ',' | replace: ',', '____' | handle | replace: '____', ',' | append: ',' | prepend: ','

            if translation_string_size contains option_name_handle_separator
              assign is_size_option = true
            endif

            comment
              Determine if current option matches swatch handle translations
            endcomment
            assign is_native_swatch_option = false
            assign is_theme_swatch_option = false

            if settings.enable_swatches
              for value in option.values
                if value.swatch
                  assign is_native_swatch_option = true
                  break
                endif
              endfor

              if is_bundle and meta_swatches contains option.name
                assign is_native_swatch_option = true
              endif

              assign swatch_translation = 'general.swatches.color' | t
              assign translation_string = swatch_translation | remove: '  ' | replace: ', ', ',' | replace: ' ,', ',' | replace: ',', '____' | handle | replace: '____', ',' | append: ',' | prepend: ','
              if translation_string contains option_name_handle_separator
                assign is_theme_swatch_option = true
              endif
            endif

            assign picker_type = 'button'
            if is_native_swatch_option or is_theme_swatch_option
              assign picker_type = 'swatch'
            elsif settings.variant_boxes == false
              assign picker_type = 'dropdown'
            endif

            capture fieldset_class
              if settings.variant_boxes or is_native_swatch_option or is_theme_swatch_option
                echo 'radio__fieldset'

                if is_native_swatch_option or is_theme_swatch_option
                  echo ' radio__fieldset--swatches'
                endif
              else
                echo 'select__fieldset'
              endif
            endcapture
          -%}

          {%- capture options_html -%}
            {{ options_html }}

            <div
              class="selector-wrapper{% if settings.variant_boxes and is_size_option %} selector-wrapper--size{% elsif settings.variant_boxes or is_theme_swatch_option %} selector-wrapper--fullwidth{% endif %}"
              data-variant-buttons
              {% if is_bundle %}
                data-option-position="{{ option.position }}"
              {% endif %}
            >
              {%- if picker_type == 'swatch' -%}
                <fieldset class="product-form__input">
                  {% render 'product-variant-options',
                    product: product,
                    product_form_id: product_form_id,
                    option: option,
                    block: block,
                    picker_type: picker_type,
                    is_theme_swatch_option: is_theme_swatch_option,
                    is_native_swatch_option: is_native_swatch_option,
                    is_bundle: is_bundle
                  %}
                </fieldset>
              {%- elsif picker_type == 'button' -%}
                <fieldset class="product-form__input">
                  {% render 'product-variant-options',
                    product: product,
                    product_form_id: product_form_id,
                    option: option,
                    block: block,
                    picker_type: picker_type,
                    is_bundle: is_bundle
                  %}
                </fieldset>
              {%- elsif picker_type == 'dropdown' -%}
                <div class="select__fieldset">
                  <popout-select class="select-popout product-form__input">
                    <button
                      type="button"
                      class="select-popout__toggle"
                      aria-expanded="false"
                      aria-controls="{{ uniq_id }}-select-{{ option.name | handle }}"
                      aria-labelledby="{{ uniq_id }}-select-{{ option.name | handle }}-label"
                      data-select-soldout=" - {{ 'products.product.sold_out' | t }}"
                      data-select-unavailable=" - {{ 'products.product.unavailable' | t }}"
                      data-popout-toggle
                    >
                      <span data-popout-toggle-text>{{ option.selected_value }}</span>
                      {%- render 'icon-nav-arrow-down' -%}
                    </button>

                    {% render 'product-variant-options',
                      product: product,
                      product_form_id: product_form_id,
                      option: option,
                      block: block,
                      picker_type: picker_type
                    %}

                    <span class="svg-wrapper">
                      {{- 'icon-caret.svg' | inline_asset_content -}}
                    </span>
                  </popout-select>
                </div>
              {%- endif -%}
            </div>
          {%- endcapture -%}

          {%- unless is_bundle and option_product_name == prev_option_product_name -%}
            <div class="selector-wrapper{% if settings.variant_boxes and is_size_option %} selector-wrapper--size{% elsif settings.variant_boxes %} selector-wrapper--fullwidth{% endif %}"
              {% unless is_bundle %}
                data-option-position="{{ option.position }}"
              {% endunless %}
            >
              <fieldset
                {% if featured_product and is_bundle and option_product_image != blank %}
                  class="product__selectors__columns"
                {% endif %}
              >
                <div class="{{ fieldset_class }}">
                  {%- if featured_product and is_bundle and option_product_image != blank -%}
                    {%- liquid
                      capture option_product_image_srcset
                        render 'image-srcset', image_url: option_product_image, widths: '120, 240, 360, 480', image_width: 240
                      endcapture
                    -%}

                    <div class="product__selectors__image lazy-image is-loading">
                      <a href="{{ option_product_url }}">
                        <img
                          src="{{ option_product_image }}"
                          class="is-loading"
                          loading="lazy"
                          sizes="120px"
                          srcset="{{ option_product_image_srcset }}"
                          alt="{{ option_name | strip_html }}"
                        >
                      </a>
                    </div>
                  {%- endif -%}

                  {%- if form_style == 'modern' -%}
                    <div class="fieldset__column fieldset__column--aside">
                  {%- endif -%}
          {%- endunless -%}

          <legend class="radio__legend{% if is_size_option and size_chart_link %} radio__legend--size{% endif %}">
            <span class="radio__legend__label{% if size_style == 'text' %} radio__legend__label--text{% endif %}" id="{{ uniq_id }}-select-{{ option.name | handle }}-label">
              {%- if option_name_string != '' -%}
                <span class="radio__legend__option-name">
                  {%- if is_bundle -%}
                    <a href="{{ option_product_url }}">
                      {{ option_name_string }}
                    </a>
                  {%- else -%}
                    {{ option_name_string }}
                  {%- endif -%}
                </span>
              {%- endif -%}

              {%- if is_size_option -%}
                {{- size_chart_link | replace: '<size-chart-button></size-chart-button>', size_button_options -}}
              {%- endif -%}

              {%- if settings.show_labels -%}
                <small class="radio__legend__value">
                  {% if is_bundle %}{{ option_name }}: {% endif %}
                  <span data-option-value="{{ option.position }}">{{ current_value }}</span>
                </small>
              {%- endif -%}
            </span>
          </legend>

          {%- if form_style == 'classic' -%}
            {{ options_html }}
            {%- assign options_html = '' -%}
          {%- endif -%}

          {%- unless is_bundle and option_product_name == next_option_product_name -%}
                  {%- if form_style == 'modern' -%}
                    </div>

                    <div class="fieldset__column fieldset__column--content">
                      {{ options_html }}
                      {%- assign options_html = '' -%}
                    </div>
                  {%- endif -%}
                </div>
              </fieldset>
            </div>
          {%- endunless -%}
        {%- endfor -%}
      </div>

      {%- if meta_products != '' -%}
        <div class="product-selectors__products product-cards">
          <div class="product-cards__title body-medium">
            {{ 'products.general.bundle_products' | t }}
          </div>

          <div class="product-cards__items">
            {{ meta_products }}
          </div>
        </div>
      {%- endif -%}
    {%- endunless -%}
  {%- endcapture -%}

  {{- form_fields -}}

  {%- if product.selling_plan_groups.size > 0 and block.settings.subscriptions_enable_selectors -%}
    {%- render 'subscription-form', product: product, product_form_id: product_form_id -%}

    {% comment %} Delete the following line to block the theme from updating subscription prices {% endcomment %}
    <span data-subscription-watch-price></span>
  {%- endif -%}
{%- endcapture -%}

{%- if product_variant_options != blank -%}
  <div
    class="product__block{% if settings.show_lines %} product__block--lines{% endif %} product__form__holder block-padding"
    {{ block_style }}
    {{ block.shopify_attributes }}
    {% if animation_name %}
      data-animation="{{ animation_name }}"
      data-animation-delay="{{ animation_delay }}"
    {% endif %}
  >
    <div class="product__form__outer{{ hide_labels_class }}">
      <variant-selects
        id="variant-selects-{{ section.id }}"
        data-section="{{ section.id }}"
        {{ block.shopify_attributes }}
      >
        {{ product_variant_options }}

        <script type="application/json" data-selected-variant>
          {{ product.selected_or_first_available_variant | json }}
        </script>
      </variant-selects>
    </div>
  </div>
{%- endif -%}

{%- if request.design_mode and product_variant_options == blank -%}
  <div {{ block.shopify_attributes }}></div>
{%- endif -%}
