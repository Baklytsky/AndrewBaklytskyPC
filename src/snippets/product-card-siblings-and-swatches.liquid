{%- comment -%} Color swatches {%- endcomment -%}
{% liquid
  assign shopify_attributes = shopify_attributes | default: ''
  assign index = index | default: 1
  assign block_index = block_index | default: 1

  assign is_onboarding = false
  if product == empty
    assign is_onboarding = true
  endif
-%}

{%- if is_onboarding -%}
  {%- render 'product-card-swatches-onboarding', index: index, block_index: block_index -%}

  {%- break -%}
{%- endif -%}

{%- if settings.enable_swatches and settings.show_grid_swatches -%}
  {%- liquid
    assign has_colors = false
    assign swatch_translation = 'general.swatches.color' | t
    assign swatch_labels = swatch_translation | append: ',' | split: ','
    assign swatch_count = 0
    assign count_string_one = 'collections.general.colors_with_count.one' | t
    assign count_string_other = 'collections.general.colors_with_count.other' | t
  -%}

  {%- capture swatches -%}
    {%- for label in swatch_labels -%}
      {%- assign sanitized_label = label | lstrip | rstrip -%}
      {%- assign option = product.options_by_name[sanitized_label] -%}

      {%- if option and option.values.size > 0 -%}
        {%- assign has_colors = true -%}
        {%- assign swatch_count = option.values.size -%}
        {%- capture swatch_values -%}
          {%- for value in option.values -%}
            {%- liquid
              assign swatch_value = nil
              if value.swatch
                if value.swatch.image
                  assign image_url = value.swatch.image | image_url: width: 48
                  assign swatch_value = 'url(' | append: image_url | append: ')'
                elsif value.swatch.color
                  assign swatch_value = value.swatch.color
                endif
              endif
              if swatch_value == nil
                assign swatch_value = value | handle
              endif
            -%}
            {{- value -}}: {{- swatch_value -}}
            {%- unless forloop.last -%}, {%- endunless -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- if swatch_values != blank -%}
          <native-scrollbar class="radio__fieldset radio__fieldset--swatches radio__fieldset--pgi" data-grid-swatch-fieldset>
            <grid-swatch
              class="selector-wrapper__scrollbar"
              data-scrollbar
              data-swatch-handle="{{ product.handle }}"
              data-swatch-label="{{ label }}"
              data-swatch-values="{{ swatch_values | strip_html | escape }}"
            >
              {%- for option in product.options_with_values -%}
                {%- assign swatch_color_label = 'general.swatches.color' | t -%}
                {%- if swatch_color_label contains option.name -%}
                  {%- liquid
                    assign count = option.values.size
                    assign limit = 2048

                    if count > 5 and settings.collection_swatch_style == 'limited'
                      assign sibling_swatches_left = count | minus: 5
                      assign limit = 5
                    endif
                    if count > 3
                      assign mobile_swatches_left = count | minus: 3
                    endif
                  -%}

                  {%- if settings.collection_swatch_style != 'text' -%}
                    {%- for option_value in option.values limit: limit -%}
                      {%- if option_value.swatch.image -%}
                        {%- assign swatch = option_value.swatch.image | image_url: width: 48 | prepend: 'url(' | append: ')' -%}
                      {%- elsif option_value.swatch.color -%}
                        {%- assign swatch = option_value.swatch.color -%}
                      {%- else -%}
                        {%- assign swatch = option_value | handleize | prepend: 'var(--' | append: ');' -%}
                      {%- endif -%}

                      {%- assign swatch_style = '--swatch: ' | append: swatch | append: ';' -%}
                      {%- assign animation_delay = forloop.index0 | times: 100.0 | divided_by: 1250.0 -%}
                      {%- assign swatch_style = swatch_style | append: '--animation-delay: ' | append: animation_delay | append: 's;' -%}

                      <tooltip-component
                        class="swatches swatch__button swatch__button--{{ settings.swatch_style }} swatch-{{ option_value.name | handleize }}{% if bundle_product %} swatch__button--bundle{% endif %}"
                        data-swatch-button
                        data-tooltip="{{ option_value }}"
                        data-swatch-variant="{{ option_value.variant.id }}"
                        data-swatch-variant-name="{{ product.id }}-{{ option_value.variant.id }}-{{ option_value | handle }}"
                        data-swatch-image="{{ option_value.variant.featured_media.preview_image.src }}"
                        data-variant="{{ option_value.variant.id }}"
                        style="{{ swatch_style }}"
                      >
                        {%- unless bundle_product -%}
                          <a class="swatch__link" href="{{ product.url }}?variant={{ option_value.variant.id }}">
                            <span class="visually-hidden">{{ option_value }}</span>
                          </a>
                        {%- else -%}
                          <span class="swatch__link">
                            <span class="visually-hidden">{{ option_value }}</span>
                          </span>
                        {%- endunless -%}
                      </tooltip-component>
                    {%- endfor -%}

                    {%- if settings.collection_swatch_style == 'limited' and sibling_swatches_left > 0 -%}
                      <div class="swatch-limited desktop">{{ '+' | append: sibling_swatches_left }}</div>
                    {%- endif -%}
                    {%- if settings.collection_swatch_style == 'limited' and mobile_swatches_left > 0 -%}
                      <div class="swatch-limited mobile">{{ '+' | append: mobile_swatches_left }}</div>
                    {%- endif -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </grid-swatch>

            {%- if settings.collection_swatch_style == 'text-slider' or settings.collection_swatch_style == 'slider' -%}
              <div class="selector-wrapper__actions">
                <button
                  type="button"
                  class="radio__fieldset__arrow radio__fieldset__arrow--prev"
                  disabled
                  data-scrollbar-arrow-prev
                >
                  {%- render 'icon-nav-arrow-left' -%}
                  <span class="visually-hidden">{{ 'products.general.see_all' | t }}</span>
                </button>
                <button
                  type="button"
                  class="radio__fieldset__arrow radio__fieldset__arrow--next"
                  disabled
                  data-scrollbar-arrow-next
                >
                  {% render 'icon-nav-arrow-right' %}
                  <span class="visually-hidden">{{ 'products.general.see_all' | t }}</span>
                </button>
              </div>
            {%- endif -%}
          </native-scrollbar>
        {%- endif -%}

        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
{%- endif -%}

{%- comment -%} Siblings {%- endcomment -%}
{% liquid
  if settings.show_siblings
    capture siblings_html
      render 'product-card-siblings', part: 'html', product: product, shopify_attributes: shopify_attributes
    endcapture
  endif
-%}

{%- comment -%} Conditional rendering {%- endcomment -%}
{%- liquid
  assign render_siblings = false
  assign render_swatches = false
  if has_colors == true
    assign render_swatches = true
  endif
  if siblings_html != blank
    assign render_siblings = true
  endif
-%}

{%- case part -%}
  {%- when 'html' -%}
    {%- if render_siblings -%}
      {{ siblings_html }}
    {%- elsif render_swatches -%}
      <div
        class="product-card__swatches__holder product-card__swatches__holder--{{ settings.swatch_style }} product-card__swatches__holder--{{ settings.collection_swatch_style }}"
        {{ shopify_attributes }}
      >
        {{ swatches }}

        {%- if settings.collection_swatch_style == 'text' or settings.collection_swatch_style == 'text-slider' -%}
          <span class="product-card__swatches__count">
            <span data-swatch-count>
              {{- swatch_count }}
              {{ swatch_count | pluralize: count_string_one, count_string_other -}}
            </span>
          </span>
        {%- else -%}
          <span class="product-card__swatches__count">
            <span data-swatch-count>&nbsp;</span>
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- when 'check-siblings' -%}
    {{- render_siblings -}}
  {%- when 'check-swatches' -%}
    {{- render_swatches -}}
{%- endcase -%}
