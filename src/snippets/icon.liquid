{%- doc -%}
  Renders named and styled SVG icons

  @param {string} name - The name of the icon
  @param {string} style - The style of the icon (regular, light)

  @example
  {% render 'icon', name: 'list' %}
  {% render 'icon', name: 'list', style: 'regular' %}
  {% render 'icon', name: 'list', style: 'light' -%}
{%- enddoc -%}

{%- liquid
  assign icon_key = name | default: '' | strip
  assign icon_style = style | default: 'regular' | strip

  capture icon_html
    if icon_style == 'regular' or icon_style == blank
      render 'icons-regular', name: icon_key
    endif

    if icon_style == 'light'
      render 'icons-light', name: icon_key
    endif
  endcapture

  unless icon_html contains 'class='
    assign icon_class = 'icon icon-' | append: name
    assign icon_html | replace: '<svg', '<svg class="' | append: icon_class | append: '"'
  endif
-%}

{{- icon_html -}}