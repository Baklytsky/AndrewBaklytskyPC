{% liquid
  assign render_siblings = render_siblings | default: false
  assign render_swatches = render_swatches | default: false
%}

<div
  class="product-information"
  style="--swatch-size: var(--swatch-size-filters);"
  data-product-information
>
  <div class="product-item__info grid-item__content {{ settings.product_grid_font_size }}">
    {% if children != blank %}
      {{ children }}
    {% else %}
      <a class="product-link" href="{{ product_url }}" data-product-link="{{ product_url }}">
        <p class="product-item__title">{{ product.title | strip_html | escape }}</p>

        <div class="product-item__price__holder">
          {% render 'product-card-cutline', product: product, render_siblings: render_siblings %}

          <div class="product-item__price" data-product-price>
            {%- render 'product-grid-price', product: product, current_variant: current_variant -%}
          </div>
        </div>
      </a>

      {%- if render_siblings or render_swatches -%}
        {% render 'product-card-siblings-and-swatches',
          product: product,
          render_siblings: render_siblings,
          render_swatches: render_swatches
        %}
      {%- endif -%}
    {% endif %}
  </div>
</div>
