{% liquid
  assign children = children | default: ''
  assign shopify_attributes = shopify_attributes | default: ''
  assign current_variant = product.first_available_variant
  assign product_url = product.url | within: collection
%}

<div
  class="product-card__content grid-item__content {{ settings.product_grid_font_size }}"
  style="--swatch-size: var(--swatch-size-filters);"
  data-product-information
  {{ shopify_attributes }}
>
  {% if children != blank %}
    {{ children }}
  {% else %}
    <a class="product-card__link" href="{{ product_url }}" data-product-link="{{ product_url }}">
      <p class="product-card__title">{{ product.title | strip_html | escape }}</p>

      <div class="product-card__price__holder">
        {% render 'product-card-cutline', product: product %}

        <div class="product-card__price" data-product-price>
          {%- render 'product-card-price', product: product, current_variant: current_variant -%}
        </div>
      </div>
    </a>

    {% render 'product-card-siblings-and-swatches', product: product, part: 'html' %}
  {% endif %}
</div>
