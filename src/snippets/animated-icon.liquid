<!-- /snippets/animated-icon.liquid -->

{% comment %}
  Renders an icon because render can't accept strings as variables

  Accepts:
  - filename: {String} name of icon

  Usage:
  {% render 'animated-icon', filename: block.settings.icon_name %}
{% endcomment %}

{%- liquid
  assign icon_name = filename | default: ''

  if icon_name contains 'icon-'
    case icon_name
    when 'icon-domestic-love'
      assign icon_name = 'heart-straight'
    when 'icon-favs'
      assign icon_name = 'heart'
    when 'icon-gift-cards'
      assign icon_name = 'gift'
    when 'icon-shipping'
      assign icon_name = 'package'
    when 'icon-bag'
      assign icon_name = 'shopping-bag'
    when 'icon-search'
      assign icon_name = 'magnifying-glass'
    when 'icon-lock'
      assign icon_name = 'lock-simple'
    when 'icon-minus'
      assign icon_name = 'minus-circle'
    when 'icon-minus-circle'
      assign icon_name = 'minus-circle'
    when 'icon-plus'
      assign icon_name = 'plus-circle'
    when 'icon-plus-circle'
      assign icon_name = 'plus-circle'
    when 'icon-user'
      assign icon_name = 'user'
    when 'icon-warning-sign'
      assign icon_name = 'warning-circle'
    when 'icon-shield'
      assign icon_name = 'lock-simple'
    when 'icon-trophy'
      assign icon_name = 'trophy'
    when 'icon-chat'
      assign icon_name = 'phone'
    when 'icon-reload'
      assign icon_name = 'arrow-circle-up-right'
    when 'icon-exchange'
      assign icon_name = 'package'
  endcase

  case icon_name
    when 'heart-straight', 'heart', 'gift', 'package', 'shopping-bag', 'magnifying-glass', 'lock-simple', 'minus-circle', 'plus-circle', 'user', 'warning-circle', 'trophy', 'phone', 'arrow-circle-up-right'
      render 'icon', name: icon_name
    when 'icon-a11y'
      render 'icon-a11y'
    when 'icon-fit'
      render 'icon-fit'
    when 'icon-breathable'
      render 'icon-breathable'
    when 'icon-chat'
      render 'icon-chat'
    when 'icon-clean-beauty'
