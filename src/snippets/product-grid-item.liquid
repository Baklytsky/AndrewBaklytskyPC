{% comment %}
  Renders list of products in grid layout

  Accepts:
  - product: {Object} product (required)
  - animation_delay: {Int} animation timing for load
  - index: element index in the loop
  - block_index: index of the block in Tab collections section
  - sizes: Image sizes
  - attributes: Accept html attributes
  - modifier_class: Accept custom class

  Usage:
  {% render 'product-grid-item', product: product, index: index, sizes: image_sizes, attributes: '', modifier_class: '' %}
{% endcomment %}

{%- liquid
  if settings.product_grid_center
    assign alignment_class = 'product-item--centered'
  else
    assign no_padding_class = ' product-item--no-padding'

    if settings.grid_style == 'compact' or settings.grid_override and settings.grid_gap_horizontal < 1
      assign no_padding_class = ''
    endif

    assign alignment_class = 'product-item--left' | append: no_padding_class
  endif

  assign hidden_product = false
  if product.tags contains 'hide'
    assign hidden_product = true
  endif

  # passed attributes and modifiers for the 'product-item' element
  assign attributes = attributes | default: ''
  assign modifier_class = modifier_class | default: ''
  # variables needed for "product-card-media" snippet
  assign animation_delay = animation_delay | default: 0
  assign aos_delay_default = animation_delay | times: 100
  assign index = index | default: 1
  assign bundle_product = bundle_product | default: false
  assign bundle_template = bundle_template | default: false
  assign sizes = sizes | default: ''
  assign block_index = block_index | default: 1
  # define "item_unique"
  capture item_unique
    echo 'product-item--' | append: section.id | append: '-' | append: product.id
  endcapture
-%}

{%- unless hidden_product -%}
  <product-item
    class="grid-item product-item {{ alignment_class }}{% if modifier_class != '' %} {{ modifier_class }}{% endif %}"
    id="{{ item_unique }}"
    data-grid-item
    data-url="{{ product.url }}"
    data-swap-id="true"

    {{ attributes }}
  >
    {% render 'product-card-media',
      product: product,
      animation_delay: animation_delay,
      index: index,
      block_index: block_index,
      bundle_product: bundle_product,
      bundle_template: bundle_template,
      sizes: sizes
    %}
    {% render 'product-card-content', product: product %}
  </product-item>
{%- endunless -%}
