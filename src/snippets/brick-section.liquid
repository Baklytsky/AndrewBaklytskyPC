{%- doc -%}
  Renders a wrapper "Brick section"

  @param {section} section - The section object
  @param {string} children - The children of the section
{%- enddoc -%}

{%- liquid
  assign image = section.settings.image
  assign layout = section.settings.layout
  assign width = section.settings.width
  assign height = section.settings.height
  assign mobile_height = section.settings.mobile_height
  assign reverse_blocks = section.settings.reverse_blocks
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign show_placeholder = section.settings.show_placeholder

  assign animation_anchor = 'brickSection--' | append: section.id
  assign animation_order = 0

  capture style
    echo '--PT: ' | append: padding_top | append: 'px;'
    echo '--PB: ' | append: padding_bottom | append: 'px;'
  endcapture

  capture sizes
    if image
      echo '(min-width: 750px) 50vw, 100vw'
    else
      echo '(min-width: 750px) 50vw, 100vw'
    endif
  endcapture

  assign item_sizes_padding_desktop = '100px'
  assign item_sizes_padding_tablet = '60px'
  if settings.grid_style == 'compact'
    assign item_sizes_padding_desktop = '64px'
    assign item_sizes_padding_tablet = '44px'
  endif

  capture alignment
    echo ' align--middle-center'
  endcapture
-%}

{%- capture section_media -%}
  {%- liquid
    assign image_desktop_height = height
    assign image_mobile_height = mobile_height
    assign image_aspect_ratio = ''
  -%}

  {%- if image != blank -%}
    <div class="brick__block__image"
      data-slide="1"
    >
      {%- render 'image-hero', aspect_ratio: image_aspect_ratio, image: image, sizes: sizes, desktop_height: image_desktop_height, mobile_height: image_mobile_height -%}
    </div>
  {%- endif -%}

  {%- if image == blank and show_placeholder -%}
    <div class="brick__block__image">
      {%- render 'image-hero' sizes: sizes, desktop_height: height, mobile_height: mobile_height -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

{{ 'brick-section.css' | asset_url | stylesheet_tag }}

<section
  id="brickSection--{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="brick-section"
  class="brick-section section-padding{{ alignment }} {{ color_scheme }}"
>
  <div class="brick__section{% if layout == 'is-reversed' %} brick__section--reversed{% endif %}{% if reverse_blocks %} brick__section--reversed-mobile{% endif %} {{ width }} {{ height }} {{ mobile_height }}">
    <div class="brick__block brick__block--images">
      {%- if image != blank or show_placeholder -%}
        {{ section_media }}
      {%- elsif request.design_mode -%}
        <div class="brick__section-missing-metafield-image">
          {{ 'products.general.missing_metafield_image' | t }}
        </div>
      {%- endif -%}
    </div>

    {%- if children != blank -%}
      <div class="brick__block brick__block--text">
        <div class="brick__block__text flex-layout-column">
          {{ children }}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>
