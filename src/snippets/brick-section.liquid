{%- doc -%}
  Renders a wrapper "Brick section"

  @param {section} section - The section object
  @param {string} children - The children of the section
{%- enddoc -%}

{%- liquid
  assign image = section.settings.image
  assign layout = section.settings.layout
  assign width = section.settings.width
  assign height = section.settings.height
  assign mobile_height = section.settings.mobile_height
  assign reverse_blocks = section.settings.reverse_blocks
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign show_placeholder = section.settings.show_placeholder

  assign animation_anchor = 'brickSection--' | append: section.id
  assign animation_order = 0

  capture style
    echo '--PT: ' | append: padding_top | append: 'px;'
    echo '--PB: ' | append: padding_bottom | append: 'px;'
  endcapture

  capture sizes
    unless settings.grid_override
      assign width_normal = '1100px'
      assign width_normal_wide = '80vw'

      if settings.grid_style == 'compact'
        assign layout_outer = '32px'
        assign layout_outer_medium = '22px'
        assign layout_outer_small = '16px'
      elsif settings.grid_style == 'classic'
        assign layout_outer = '50px'
        assign layout_outer_medium = '30px'
        assign layout_outer_small = '16px'
      elsif settings.grid_style == 'tight'
        assign layout_outer = '16px'
        assign layout_outer_medium = '16px'
        assign layout_outer_small = '16px'
      elsif settings.grid_style == 'wide'
        assign layout_outer = '80px'
        assign layout_outer_medium = '60px'
        assign layout_outer_small = '30px'
      endif
    else
      assign width_normal = settings.page_width | times: settings.section_width_normal | divided_by: 100 | append: 'px'
      assign width_normal_wide = width_normal

      assign layout_outer = '50px'
      assign layout_outer_medium = '30px'
      assign layout_outer_small = '16px'

      if settings.grid_gap_horizontal == 0
        assign layout_outer = '32px'
        assign layout_outer_medium = '22px'
        assign layout_outer_small = '16px'
      endif
    endunless

    if children != blank
      if width == 'wrapper--full-padded'
        echo '(min-width: 990px) calc(50vw - ' | append: layout_outer | append: ' * 2), (min-width: 750px) calc(50vw - ' | append: layout_outer_medium | append: ' * 2), calc(100vw - ' | append: layout_outer_small | append: ' * 2)'
      elsif width == 'wrapper'
        echo '(min-width: 1400px) calc(min(50vw, ' | append: width_normal_wide | append: ' / 2) - ' | append: layout_outer | append: ' * 2), (min-width: 750px) calc(min(50vw, ' | append: width_normal | append: ' / 2) - ' | append: layout_outer_medium | append: ' * 2), calc(100vw - ' | append: layout_outer_small | append: ' * 2)'
      else
        echo '(min-width: 750px) 50vw, 100vw'
      endif
    else
      if width == 'wrapper--full-padded'
        echo '(min-width: 990px) calc(100vw - ' | append: layout_outer | append: ' * 2), (min-width: 750px) calc(100vw - ' | append: layout_outer_medium | append: ' * 2), calc(100vw - ' | append: layout_outer_small | append: ' * 2)'
      elsif width == 'wrapper'
        echo '(min-width: 1400px) calc(min(100vw, ' | append: width_normal_wide | append: ') - ' | append: layout_outer | append: ' * 2), (min-width: 750px) calc(min(100vw, ' | append: width_normal | append: ') - ' | append: layout_outer_medium | append: ' * 2), calc(100vw - ' | append: layout_outer_small | append: ' * 2)'
      else
        echo '100vw'
      endif
    endif
  endcapture
-%}

{%- capture section_media -%}
  {%- liquid
    assign image_desktop_height = height
    assign image_mobile_height = mobile_height
    assign image_aspect_ratio = ''
  -%}

  {%- if image != blank -%}
    <div class="brick__block__image">
      {%- render 'image-hero', aspect_ratio: image_aspect_ratio, image: image, sizes: sizes, desktop_height: image_desktop_height, mobile_height: image_mobile_height -%}
    </div>
  {%- endif -%}

  {%- if image == blank and show_placeholder -%}
    <div class="brick__block__image">
      {%- render 'image-hero' sizes: sizes, desktop_height: height, mobile_height: mobile_height -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

{{ 'brick-section.css' | asset_url | stylesheet_tag }}

<section
  id="brickSection--{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="brick-section"
  class="brick-section section-padding {{ color_scheme }}"
>
  <div class="brick__section{% if layout == 'is-reversed' %} brick__section--reversed{% endif %}{% if reverse_blocks %} brick__section--reversed-mobile{% endif %} {{ width }} {{ height }} {{ mobile_height }}">
    <div class="brick__block brick__block--images">
      {%- if image != blank or show_placeholder -%}
        {{ section_media }}
      {%- elsif request.design_mode -%}
        <div class="brick__section-missing-metafield-image">
          {{ 'products.general.missing_metafield_image' | t }}
        </div>
      {%- endif -%}
    </div>

    {%- if children != blank -%}
      <div class="brick__block brick__block--text">
        <div class="brick__block__text">
          <div class="brick-column-layout">
            {{ children }}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>
