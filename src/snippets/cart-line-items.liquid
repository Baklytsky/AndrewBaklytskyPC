{%- liquid
  assign line_items_bundle = ''
  assign line_items_bundle_counter = 0
  assign animation_name = animation_name | default: 'cart-items-fade'
  assign animation_delay_increment = 50
  assign animation_delay = animation_delay | default: 0
  assign animation_delay_bundle = animation_delay
  assign bundle_opened = false
  assign bundle_price = 0
  assign bundle_price_compare = 0
  assign bundle_keys = ''
  assign line_items_collections = null
  assign line_items_tags = null
  assign line_items_products = null
  assign line_items_rewards = null
  assign line_items_gifts = null
  assign buy_promo_meta_name = settings.carbon_app_id | append: '--buy-x-get-y'
  assign buy_promo_meta = shop.metafields[buy_promo_meta_name]
  assign gwp_promo_meta_name = settings.carbon_app_id | append: '--gwp-tiers'
  assign gwp_promo_meta = shop.metafields[gwp_promo_meta_name]
-%}

{%- comment -%}
  Capture line items
{%- endcomment -%}

{%- for line_item in cart.items -%}
  {%- liquid
    assign line_items_products = line_items_products | append: ',' | append: line_item.product_id
    assign line_items_collections = line_items_collections | concat: line_item.product.collections
    assign line_items_tags = line_items_tags | concat: line_item.product.tags
    assign line_item_final_price = line_item.final_price
    assign line_item_variant_compare_at_price = line_item.variant.compare_at_price
    assign line_item_original_price = line_item.original_price
    assign line_item_unit_price = line_item.unit_price | money
    assign line_item_reward = false
    assign line_item_gift = false

    assign bundle_unique_id = line_item.properties._bundle_unique_id
    assign bundle_id = bundle_unique_id | split: '_' | first
    assign prev_index = forloop.index0 | minus: 1
    assign next_index = forloop.index0 | plus: 1
    assign prev_line_item = cart.items[prev_index]
    assign next_line_item = cart.items[next_index]
    assign next_line_item_bundle_unique_id = next_line_item.properties._bundle_unique_id
    assign next_line_item_bundle_id = next_line_item_bundle_unique_id | split: '_' | first

    if bundle_opened == false and bundle_unique_id != blank
      assign bundle_opened = true
      assign bundle_id_number = bundle_id | plus: 0
      assign bundle_collection = line_item.product.collections | where: 'id', bundle_id_number | first
      assign bundle_name = bundle_collection.title
      assign bundle_url = bundle_collection.url
      assign bundle_image = bundle_collection.image
    endif

    if bundle_opened
      assign bundle_price = bundle_price | plus: line_item_final_price
      assign bundle_keys = bundle_keys | append: ',' | append: line_item.key
      assign animation_delay = animation_delay | plus: animation_delay_increment
    else
      assign animation_delay_bundle = animation_delay | plus: animation_delay_increment
    endif

    if line_item.properties._reward == 'reward'
      assign line_item_reward = true
      assign line_items_rewards = line_items_rewards | append: ',' | append: line_item.key
    endif

    if line_item.properties._gift == 'gift'
      assign line_item_gift = true
      assign line_items_gifts = line_items_gifts | append: ',' | append: line_item.key
    endif
  -%}

  {%- if bundle_opened -%}
    {%- assign line_items_bundle_counter = line_items_bundle_counter | plus: 1 -%}
    {%- capture line_items_bundle -%}
      {{ line_items_bundle }}

      <div class="cart__item__sub">
        <div class="cart__item__sub__image{% unless line_item.image %} image--empty{% endunless %}">
          <a
            href="{{ line_item.url }}"
            aria-label="{{ line_item.title | escape }}"
            {% if settings.show_image_bg != 'none' %}
              class="show-gray-bg"
            {% endif %}
          >
            {%- if line_item.image -%}
              <div class="lazy-image is-loading">
                {{
                  line_item.image
                  | image_url: width: 60
                  | image_tag:
                    widths: '30, 60, 90, 120, 150, 180, 210, 240, 270, 300, 330, 360',
                    sizes: '30px',
                    class: 'is-loading',
                    loading: 'lazy'
                }}
              </div>
            {%- endif -%}
          </a>
        </div>

        <div class="cart__item__sub__content">
          <h5 class="cart__item__sub__title">
            <a href="{{ line_item.url }}">
              {{- line_item.product.title | strip_html -}}
            </a>
          </h5>

          {%- unless line_item.product.has_only_default_variant -%}
            <p class="cart__item__sub__options">
              {%- for option in line_item.options_with_values -%}
                {%- unless forloop.first -%}
                  <span> | </span>
                {%- endunless -%}
                <span>{{ option.value }}</span>
              {%- endfor -%}
            </p>
          {%- endunless -%}
        </div>
      </div>
    {%- endcapture -%}
  {%- else -%}
    <div
      class="cart__item{% if forloop.last %} cart__item--no-border{% endif %}"
      data-item="{{ line_item.key }}"
      data-item-index="{{ forloop.index }}"
      data-item-title="{{ line_item.title | strip_html }}"
      data-animation="{{ animation_name }}"
      data-animation-delay="{{ animation_delay }}"
      {%- assign animation_delay = animation_delay | plus: animation_delay_increment -%}
    >
      <div class="cart__item__image{% unless line_item.image %} image--empty{% endunless %}">
        <a
          href="{{ line_item.url }}"
          aria-label="{{ line_item.title | escape }}"
          {% unless line_item.image %}
            tabindex="-1"
          {% endunless %}
          {% if settings.show_image_bg != 'none' %}
            class="show-gray-bg"
          {% endif %}
        >
          {%- if line_item.image -%}
            <div class="lazy-image is-loading">
              {{
                line_item.image
                | image_url: width: 180
                | image_tag: widths: '90, 180, 270, 360', sizes: '90px', class: 'is-loading', loading: 'lazy'
              }}
            </div>
          {%- endif -%}
        </a>
      </div>

      <div class="cart__item__content">
        <div class="cart__item__content-inner">
          {%- if settings.show_cart_vendor -%}
            <p class="cart__item__text cart__item__text--vendor">{{ line_item.vendor }}</p>
          {%- endif -%}

          <h4 class="cart__item__title">
            <a href="{{ line_item.url }}">
              {{- line_item.product.title | strip_html -}}
            </a>
          </h4>

          <p class="cart__price">
            {%- liquid
              assign discounted = false
              assign sale = false
              assign sale_compared_price = 0

              if line_item_original_price > line_item_final_price
                assign discounted = true
              endif

              if line_item_variant_compare_at_price > line_item_final_price
                assign sale = true
              endif
            -%}

            <span class="cart__price__row">
              <span class="cart__price__inner">
                {%- if sale or discounted -%}
                  <ins>
                    {%- if line_item_final_price == 0 -%}
                      {{ 'general.money.free' | t }}
                    {%- else -%}
                      {{- line_item_final_price | money -}}
                    {%- endif -%}
                  </ins>
                {%- else -%}
                  {%- if line_item_final_price == 0 -%}
                    {{ 'general.money.free' | t }}
                  {%- else -%}
                    {{- line_item_final_price | money -}}
                  {%- endif -%}
                {%- endif -%}

                {%- if sale and discounted == false -%}
                  {%- liquid
                    assign sale_compared_price = line_item_variant_compare_at_price
                    if bundle_opened
                      assign bundle_price_compare = bundle_price_compare | plus: line_item_variant_compare_at_price
                    endif
                  -%}
                  <del>{{- line_item_variant_compare_at_price | money -}}</del>
                {%- endif -%}

                {%- if discounted -%}
                  {%- liquid
                    assign sale_compared_price = line_item_original_price
                    if bundle_opened
                      assign bundle_price_compare = bundle_price_compare | plus: line_item_original_price
                    endif
                  -%}
                  <del>{{- line_item_original_price | money -}}</del>
                {%- endif -%}
              </span>

              {%- if sale or discounted -%}
                <span class="cart__price__save">
                  <span>{{- 'cart.general.save' | t -}}</span>
                  {{ sale_compared_price | minus: line_item_final_price | money }}
                </span>
              {%- endif -%}
            </span>

            {%- if line_item.unit_price -%}
              {%- capture unit_price_separator -%}
                <span aria-hidden="true">/</span><span class="visually-hidden">{{ 'general.accessibility.unit_price_separator' | t }}&nbsp;</span>
              {%- endcapture -%}

              {%- capture unit_price_base_unit -%}
                {%- if line_item.unit_price_measurement.reference_value != 1 -%}
                  {{- line_item.unit_price_measurement.reference_value -}}
                {%- endif -%}

                {{- line_item.unit_price_measurement.reference_unit -}}
              {%- endcapture -%}

              <span class="cart__price__row">
                <span class="line__price line__price--unit">
                  <small class="visually-hidden">{{ 'products.product.unit_price' | t }}</small>

                  <small>
                    {{- line_item_unit_price -}}
                    {{- unit_price_separator -}}
                    {{- unit_price_base_unit -}}
                  </small>
                </span>
              </span>
            {%- endif -%}
          </p>
        </div>

        <div class="cart__item__content-bottom">
          <div class="cart__item__meta">
            {%- liquid
              capture line_item_cutline
                if settings.show_cart_tagline
                  if line_item.product.metafields.theme.tagline != blank and line_item.product.metafields.theme.tagline.type == 'single_line_text_field'
                    assign line_item_title_downcase = line_item.product.title | strip_html | escape | downcase
                    assign cutline_downcase = line_item.product.metafields.theme.tagline.value | downcase

                    unless line_item_title_downcase contains cutline_downcase
                      echo line_item.product.metafields.theme.tagline.value
                    endunless
                  elsif line_item.product.metafields.theme.cutline != blank and line_item.product.metafields.theme.cutline.type == 'single_line_text_field'
                    assign line_item_title_downcase = line_item.product.title | strip_html | escape | downcase
                    assign cutline_downcase = line_item.product.metafields.theme.cutline.value | downcase

                    unless line_item_title_downcase contains cutline_downcase
                      echo line_item.product.metafields.theme.cutline.value
                    endunless
                  endif
                endif
              endcapture

              assign properties_html = ''
              assign property_size = line_item.properties | size
            -%}

            {%- if line_item_cutline != blank -%}
              <p class="cart__item__text cart__item__text--cutline">{{ line_item_cutline }}</p>
            {%- endif -%}

            {%- if property_size > 0 -%}
              {%- assign sale_type = 'products.product.sale_type' | t -%}

              {%- for p in line_item.properties -%}
                {%- assign property_first_char = p.first | slice: 0 -%}

                {%- if p.last != blank and property_first_char != '_' -%}
                  {%- if p.first == sale_type -%}
                    <p class="cart__item__selected-options">
                      <span>
                        {%- if p.last contains '/uploads/' -%}
                          <a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
                        {%- else -%}
                          {{ p.last }}
                        {%- endif -%}
                      </span>
                    </p>
                  {%- else -%}
                    {%- capture properties_html -%}
                      {{ properties_html }}

                      <p class="cart__item__property">
                        <strong>{{ p.first }}: </strong>

                        <span>
                          {%- if p.last contains '/uploads/' -%}
                            <a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
                          {%- else -%}
                            {{ p.last }}
                          {%- endif -%}
                        </span>
                      </p>
                    {%- endcapture -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            {%- unless line_item.product.has_only_default_variant -%}
              {%- if line_item.product.metafields.theme_modules.is_bundle -%}
                <div class="cart__item__subs">
                  {%- for bundle_sub in line_item.product.metafields.theme_modules.bundle_products.value -%}
                    {%- liquid
                      unless bundle_opened
                        assign animation_delay_bundle = animation_delay | plus: animation_delay_increment
                      endunless

                      assign bundle_sub_variants_string = ''
                      assign bundle_sub_image = bundle_sub.featured_image
                      assign bundle_sub_selected_options = ''
                      assign bundle_separator_open = '('
                      assign bundle_separator_close = ')'

                      for line_item_option in line_item.options_with_values
                        for bundle_sub_option in bundle_sub.options_with_values
                          assign bundle_sub_option_name = bundle_sub.title | append: ' ' | append: bundle_separator_open | append: bundle_sub_option.name | append: bundle_separator_close

                          if line_item_option.name == bundle_sub_option_name
                            assign bundle_sub_variants_string = bundle_sub_variants_string | append: '@@@@' | append: line_item_option.value
                            break
                          endif
                        endfor
                      endfor

                      if bundle_sub_variants_string != ''
                        assign bundle_sub_variants = bundle_sub_variants_string | remove_first: '@@@@' | split: '@@@@' | join: ' / '
                        assign bundle_sub_variant = bundle_sub.variants | where: 'title', bundle_sub_variants | first
                        assign bundle_sub_selected_options = bundle_sub_variants | replace: ' / ', ' | '

                        if bundle_sub_variant.featured_image != blank
                          assign bundle_sub_image = bundle_sub_variant.featured_image
                        endif
                      endif
                    -%}

                    <div
                      class="cart__item__sub"
                    >
                      <div class="cart__item__sub__image{% unless bundle_sub_image %} image--empty{% endunless %}">
                        <a
                          href="{{ bundle_sub.url }}"
                          aria-label="{{ bundle_sub.title | escape }}"
                          {% if settings.show_image_bg != 'none' %}
                            class="show-gray-bg"
                          {% endif %}
                        >
                          {%- if bundle_sub_image -%}
                            <div class="lazy-image is-loading">
                              {{
                                bundle_sub_image
                                | image_url: width: 60
                                | image_tag:
                                  widths: '30, 60, 90, 120, 150, 180, 210, 240, 270, 300, 330, 360',
                                  sizes: '30px',
                                  class: 'is-loading',
                                  loading: 'lazy'
                              }}
                            </div>
                          {%- endif -%}
                        </a>
                      </div>

                      <div class="cart__item__sub__content">
                        <h5 class="cart__item__sub__title">
                          <a href="{{ bundle_sub.url }}">
                            {{- bundle_sub.title | strip_html -}}
                          </a>
                        </h5>

                        {%- if bundle_sub_selected_options != '' -%}
                          <p class="cart__item__sub__options">{{ bundle_sub_selected_options }}</p>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <p class="cart__item__selected-options">
                  {%- for option in line_item.options_with_values -%}
                    {%- unless forloop.first -%}
                      <span> | </span>
                    {%- endunless -%}
                    <span>{{ option.value }}</span>
                  {%- endfor -%}
                </p>
              {%- endif -%}
            {%- endunless -%}

            {%- if line_item.selling_plan_allocation -%}
              <p class="cart__item__text cart__item__text--selling-plan">
                <span>{{ line_item.selling_plan_allocation.selling_plan.name }}</span>
              </p>
            {%- endif -%}

            {%- if properties_html != '' -%}
              {{ properties_html }}
            {%- endif -%}
          </div>

          {%- unless bundle_opened or line_item_reward or line_item_gift -%}
            <quantity-input class="cart__quantity-counter">
              {%- assign quantity = line_item.quantity -%}

              {%- if line_item.variant.inventory_policy == 'deny'
                and line_item.variant.inventory_management != null
                and line_item.variant.inventory_quantity < quantity
              -%}
                {%- assign quantity = line_item.variant.inventory_quantity -%}
              {%- endif -%}
              <a
                class="cart__item__remove"
                href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity=0"
                data-item-remove
                data-id="{{ line_item.key }}"
                title="{{ 'cart.general.remove' | t }}"
              >
                {%- render 'icon-trash' -%}
              </a>

              <popout-select class="select-popout select-popout--small{% if quantity >= 10 %} is-hidden{% endif %}">
                <button
                  type="button"
                  class="select-popout__toggle"
                  aria-expanded="false"
                  aria-controls="{{ line_item.key }}-select-quantity"
                  aria-labelledby="{{ line_item.key }}-select-quantity-label"
                  data-popout-toggle
                >
                  <span data-popout-toggle-text>{{ quantity }}</span>
                  {%- render 'icon-nav-arrow-down' -%}
                </button>

                <ul
                  id="{{ line_item.key }}-select-quantity"
                  class="select-popout__list"
                  data-popout-list
                  data-scroll-lock-scrollable
                >
                  {%- for idx in (1..10) -%}
                    <li class="select-popout__item{% if forloop.index == quantity %} is-active{% endif %}">
                      <a
                        class="select-popout__option"
                        href="#"
                        {% if forloop.index == quantity %}
                          aria-current="true"
                        {% endif %}
                        data-value="{{ forloop.index }}"
                        data-popout-option
                      >
                        <span>
                          {{ forloop.index }}
                          {% if forloop.last %}+{% endif %}
                        </span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </popout-select>

              <div class="cart__quantity">
                <button
                  class="cart__quantity-minus"
                  type="button"
                  name="decrease"
                  title="{{ 'cart.general.decrease_quantity_label' | t }} - {{ line_item.product.title | strip_html }}"
                >
                  {%- render 'icon-minus' -%}
                </button>

                <input
                  class="cart__quantity-field"
                  type="number"
                  id="updates_{{ line_item.key }}"
                  name="updates[]"
                  data-id="{{ line_item.key }}"
                  value="{{ quantity }}"
                  title="{{ 'cart.general.quantity_field_label' | t }} - {{ line_item.product.title | strip_html }}"
                  pattern="[0-9]*"
                  data-popout-input
                >

                <button
                  class="cart__quantity-plus"
                  type="button"
                  name="increase"
                  title="{{ 'cart.general.increase_quantity_label' | t }} - {{ line_item.product.title | strip_html }}"
                >
                  {%- render 'icon-plus' -%}
                </button>
              </div>
            </quantity-input>
          {%- endunless -%}
        </div>
      </div>

      {%- if line_item_original_price > line_item_final_price -%}
        {%- for discount in line_item.line_level_discount_allocations -%}
          <p class="cart__discount">
            {%- assign discount_price = discount.amount | money -%}

            <span>
              {{-
                'cart.general.discount_label_html'
                | t: amount: discount_price, title: discount.discount_application.title
              -}}
            </span>
          </p>
        {%- endfor -%}
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if bundle_opened and next_line_item_bundle_id == blank or next_line_item_bundle_unique_id != bundle_unique_id -%}
    <div
      class="cart__item"
      data-animation="{{ animation_name }}"
      data-animation-delay="{{ animation_delay_bundle }}"
      data-bundle-cart-item="{{ bundle_id }}"
      data-item="{{ line_item.key }}"
      data-item-index="{{ forloop.index }}"
      data-item-title="{{ line_item.title | strip_html }}"
    >
      {%- assign animation_delay = animation_delay | plus: animation_delay_increment -%}
      {%- assign animation_delay_bundle = animation_delay_bundle | plus: animation_delay_increment -%}

      <div class="cart__item__image{% unless bundle_image %} image--empty{% endunless %}">
        <a
          href="{{ bundle_url }}"
          aria-label="{{ bundle_name | escape }}"
          {% unless bundle_image != blank %}
            tabindex="-1"
          {% endunless %}
          {% if settings.show_image_bg != 'none' %}
            class="show-gray-bg"
          {% endif %}
        >
          {%- if bundle_image -%}
            <div class="lazy-image is-loading">
              {{
                bundle_image
                | image_url: width: 180
                | image_tag: widths: '90, 180, 270, 360', sizes: '90px', class: 'is-loading', loading: 'lazy'
              }}
            </div>
          {%- endif -%}
        </a>
      </div>

      <div class="cart__item__content">
        <div class="cart__item__content-inner">
          <h4 class="cart__item__title">
            <a href="{{ bundle_url }}">
              {{- bundle_name | strip_html -}}
            </a>
          </h4>

          <p class="cart__price">
            <span class="cart__price__row">
              <span class="cart__price__inner">
                {%- if bundle_price_compare > bundle_price -%}
                  <ins>{{ bundle_price | money }}</ins>

                  <del>{{ bundle_price_compare | money }}</del>
                {%- else -%}
                  {{ bundle_price | money }}
                {%- endif -%}
              </span>

              {%- if bundle_price_compare > bundle_price -%}
                <span class="cart__price__save">
                  <span>{{- 'cart.general.save' | t -}}</span>
                  {{ bundle_price_compare | minus: bundle_price | money }}
                </span>
              {%- endif -%}
            </span>
          </p>
        </div>

        <div class="cart__item__content-bottom">
          <div class="cart__item__meta">
            <div class="cart__item__subs">
              {{ line_items_bundle }}
            </div>
          </div>

          <a
            class="cart__item__remove"
            href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity=0"
            data-bundle-cart-remove="{{ bundle_keys | remove_first: ',' }}"
            data-id="{{ line_item.key }}"
            title="{{ 'cart.general.remove' | t }}"
          >
            {%- render 'icon-trash' -%}
          </a>
        </div>
      </div>
    </div>

    {%- liquid
      assign bundle_opened = false
      assign bundle_price = 0
      assign bundle_price_compare = 0
      assign bundle_keys = ''
      assign line_items_bundle = ''
      assign bundle_animation_timing = line_items_bundle_counter | times: animation_delay_increment
      assign line_items_bundle_counter = 0
      assign animation_delay = animation_delay | minus: bundle_animation_timing
    -%}
  {%- endif -%}
{%- endfor -%}

{%- if buy_promo_meta != blank or gwp_promo_meta != blank -%}
  {%- liquid
    assign line_items_collections = line_items_collections | uniq
    assign line_items_tags = line_items_tags | uniq
    assign line_items_products = line_items_products | remove_first: ',' | split: ','
    assign line_items_rewards = line_items_rewards | remove_first: ',' | split: ','
    assign line_items_gifts = line_items_gifts | remove_first: ',' | split: ','
  -%}

  <script type="application/json" data-cart-json>
    {
      "price": {{ cart.total_price | plus: 0 | json }},
      "products": {{ line_items_products | json }},
      "collections": {{ line_items_collections | json }},
      "tags": {{ line_items_tags | json }},
      "meta": {
        {%- if buy_promo_meta != blank -%}
          "reward": {
            "rewards": {{ line_items_rewards | json }},
            "config": {{ buy_promo_meta | json }}
          }{%- if gwp_promo_meta != blank -%},{%- endif -%}
        {%- endif -%}
        {%- if gwp_promo_meta != blank -%}
          "gift": {
            "gifts": {{ line_items_gifts | json }},
            "config": {{ gwp_promo_meta | json }}
          }
        {%- endif -%}
      }
    }
  </script>
{%- endif -%}
