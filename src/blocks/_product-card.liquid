{% liquid
  assign product = closest.product

  capture item_unique
    echo 'product-card--' | append: section.id | append: '-' | append: product.id
  endcapture
-%}

{% capture children %}
  {% content_for 'blocks', closest.product: product %}
{% endcapture %}

{% render 'product-card', children: children, product: product, item_unique: item_unique %}

{% schema %}
{
  "name": "Product card",
  "tag": null,
  "blocks": [
    {
      "type": "_product-card-media"
    },
    {
      "type": "_product-card-content"
    },
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Product card",
      "category": "Product"
    }
  ]
}
{% endschema %}
