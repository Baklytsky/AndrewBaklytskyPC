{%- liquid
  assign title = block.settings.title
  assign subheading = block.settings.subheading
  assign has_heading = false
  assign content = block.settings.content
  assign image = block.settings.image
  assign image_size = 80

  if title != blank or subheading != blank
    assign has_heading = true
  endif
-%}

{%- if has_heading and content != blank -%}
  <collapsible-elements
    class="accordion-element block-padding"
    single="true"
    data-collapsible-element
    data-aos="hero"
    data-aos-anchor="{{ section.id }}"
    data-aos-order="auto"
    style="--block-padding-bottom: {{ block.settings.padding_bottom }}px;"
    id="{{ block.id }}"
    {{ block.shopify_attributes }}
  >
    <details
      class="accordion"
      data-collapsible
    >
      <summary
        class="accordion__title"
        data-collapsible-trigger
      >
        {%- if image != blank -%}
          <div
            class="accordion__title-image accordion__title-image--circle"
            style="--image-size: {{ image_size }}px;"
          >
            {%- liquid
              assign image_width = image_size
              assign image_width_retina = image_width | times: 2
              assign image_sizes = image_width_retina | append: 'px'
              assign image_widths = image_width | append: ', ' | append: image_width_retina

              render 'image', image: image, width: image_width_retina, sizes: image_sizes, widths: image_widths, cover: true
            -%}
          </div>
        {%- endif -%}

        <div class="accordion__title__text">
          {%- if title != blank -%}
            <h4 class="accordion__title__heading heading-small">
              {{ title }}
            </h4>
          {%- endif -%}

          {%- if subheading != blank -%}
            <p class="accordion__title__subheading body-small">
              {{ subheading }}
            </p>
          {%- endif -%}
        </div>

        {%- render 'icon', name: 'caret-down' -%}
      </summary>

      <div class="accordion__body rte" data-collapsible-body>
        <div class="accordion__content" data-collapsible-content>
          {{ content }}
        </div>
      </div>
    </details>
  </collapsible-elements>
{%- elsif request.design_mode -%}
  <div {{ block.shopify_attributes }}>No content added</div>
{%- endif -%}

{% schema %}
{
  "name": "Image accordion",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Subheading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Text",
      "default": "<p>Share details about your shipping policies, item returns, or customer service.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "160 x 160px .svg recommended. [Learn more](http://presidiodev.com/link/headlands/images)"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Bottom",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Image accordion"
    }
  ]
}
{% endschema %}
