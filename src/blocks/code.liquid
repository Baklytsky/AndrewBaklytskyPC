<div
  class="hero__custom-code"
  data-aos="hero"
  data-aos-anchor="{{ section.id }}"
  data-aos-order="auto"
  {{ block.shopify_attributes }}
>
  {{ block.settings.code }}
</div>

{% schema %}
{
  "name": "Custom code",
  "tag": null,
  "settings": [
    {
      "type": "liquid",
      "id": "code",
      "label": "Custom code",
      "default": "<p>Once you write some custom code, it will render right here.</p>"
    }
  ],
  "presets": [
    {
      "name": "Custom code"
    }
  ]
}
{% endschema %}
