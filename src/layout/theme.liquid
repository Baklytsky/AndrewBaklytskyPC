<!doctype html>
<html class="js supports-no-cookies no-touch" lang="{{ request.locale.iso_code }}">
  <head>
    {%- render 'head' -%}

    {{ content_for_header }}
  </head>

  <body
    id="{{ page_title | handle }}"
    class="template-{{ template.name | handle }}{% if customer %} customer-logged-in{% endif %}{% if settings.animations_enable %} aos-initialized{% endif %}"
    data-animations="{{ settings.animations_enable }}"
  >
    <a class="in-page-link visually-hidden skip-link" data-skip-content href="#MainContent">
      {{- 'general.accessibility.skip_to_content' | t -}}
    </a>

    <div class="header-group">
      {% sections 'header-group' %}
    </div>

    <div class="overlay-group">
      {% sections 'overlay-group' %}
    </div>

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <div class="pre-footer-group">
      {% sections 'pre-footer-group' %}
    </div>

    <footer class="footer-group">
      {% sections 'footer-group' %}
    </footer>

    {%- if settings.enable_color_swatches -%}
      {% render 'template-swatch' %}
    {%- endif -%}

    {% render 'zoom-pswp' %}

    <!-- Paste third party scripts or marketing code below this comment line -->

    <!-- And above this comment line ======================================= -->
  </body>
</html>
