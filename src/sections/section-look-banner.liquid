        },
        {
          "value": "body-medium",
          "label": "Medium"
        },
        {
          "value": "body-large",
          "label": "Large"
        },
        {
          "value": "body-x-large",
          "label": "Extra large"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "text-left",
