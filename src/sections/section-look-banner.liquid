<!-- /sections/section-look-banner.liquid -->

{%- liquid
  assign unique = 'LookBanner--' | append: section.id
  assign image_desktop = section.settings.image
  assign section_width = section.settings.width
  assign aspect_ratio_desktop = section.settings.aspect_ratio_desktop
  assign heading = section.settings.title
  assign heading_font_size = section.settings.heading_font_size
  assign text = section.settings.text
  assign text_font_size = section.settings.text_font_size
  assign text_alignment = section.settings.text_alignment
  assign image_mobile = section.settings.image_mobile
  assign aspect_ratio_mobile = section.settings.aspect_ratio_mobile
  assign hotspot_color = section.settings.hotspot_color
  assign hotspot_bg = section.settings.hotspot_bg
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign blocks_size = section.blocks.size
  assign arrow_style = settings.arrow_style
  assign line_thickness = settings.line_thickness
  assign animations_enabled = settings.animations_enable
  assign hotspot_markup = ''

  if section_width == 'wrapper--full-padded'
    assign sizes = '(min-width: 1024px) calc(100vw - 2 * 60px), calc(100vw - 2 * 20px)'
  endif
  if section_width == 'wrapper--full'
    assign sizes = '100vw'
  endif
-%}

{%- for block in section.blocks -%}
  {%- liquid
    assign product = all_products[block.settings.product]
    if product != blank
      assign hotspot_title = product.title | strip_html | escape
      assign hotspot_image = product.featured_image
      assign hotspot_price = product.price
      assign hotspot_compare_price = product.compare_at_price
      assign hotspot_url = product.url | within: collection
    else
      assign hotspot_title = 'home_page.onboarding.product_title' | t
      assign hotspot_image = blank
      assign hotspot_price = 9900
      assign hotspot_compare_price = 0
      assign hotspot_url = '#!'
    endif

    assign is_on_sale = false
    if hotspot_compare_price > hotspot_price
      assign is_on_sale = true
    endif

    assign aria_label = 'shop_the_look_banner.pagination' | t: current: forloop.index, total: blocks_size

    assign position_x_desktop = block.settings.position_x_desktop
    assign position_y_desktop = block.settings.position_y_desktop
    assign position_x_mobile = block.settings.position_x_mobile
    assign position_y_mobile = block.settings.position_y_mobile
    assign info_bubbles_position_desktop = block.settings.info_bubbles_position_desktop
    assign info_bubbles_position_mobile = block.settings.info_bubbles_position_mobile

    capture typography_adjustment
      assign adjustment = settings.base_font_size | default: 16 | times: 0.075
      echo ' --adjust-title: ' | append: adjustment | append: ';'
    endcapture

    capture hotspot_positions
      echo ' --hotspot-x-lg: ' | append: position_x_desktop | append: '%;'
      echo ' --hotspot-y-lg: ' | append: position_y_desktop | append: '%;'
      echo ' --hotspot-x-sm: ' | append: position_x_mobile | append: '%;'
      echo ' --hotspot-y-sm: ' | append: position_y_mobile | append: '%;'
    endcapture

    capture info_bubble_styles
      render 'look-bubbles', info_bubbles_position_desktop: info_bubbles_position_desktop, info_bubbles_position_mobile: info_bubbles_position_mobile
    endcapture
  -%}

  {%- capture hotspot_elements -%}
    <div class="hotspot">
      <span class="hotspot__icon"></span>
      <span class="hotspot__line"></span>
      <div class="hotspot__info-bubble">
        <div class="hotspot__content">
          <div class="hotspot__product-image">
            {%- render 'image',
              image: hotspot_image,
              width: 60,
              sizes: '30px',
              widths: '30, 60, 90'
            -%}
          </div>
          <div class="hotspot__product-details">
            <h4 class="hotspot__product-title h5">
              {{ hotspot_title }}
            </h4>
            <p class="hotspot__product-price body-x-small">
              <span class="{% if is_on_sale %}hotspot__product-price-sale{% endif %}">{{ hotspot_price | money }}</span>

              {% if is_on_sale -%}
                <span class="hotspot__product-compare-price">
                  {{- hotspot_compare_price | money -}}
                </span>
              {%- endif -%}
            </p>
          </div>
          <div class="hotspot__product-actions">
            <quick-add-product>
              <div data-quick-add-holder="{{ product.id }}">
                {%- if product.variants.size == 1 -%}
                  {%- assign product_form_id = 'ProductForm-' | append: unique -%}
                  {%- form 'product', product, id: product_form_id -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

                    <button class="btn btn--small btn--secondary btn--outline"
                      id="ProductSubmitButton-{{ section_id }}"
                      type="submit"
                      name="add"
                      aria-label="{{ 'products.general.quick_add' | t }}"
                      data-add-to-cart
                    >
                      <span class="btn__text">
                        {{- 'products.general.add' | t -}}
                      </span>
                      <span class="btn__added">&nbsp;</span>
                      <span class="btn__loader">
                        <svg height="18" width="18" class="svg-loader">
                          <circle r="7" cx="9" cy="9" />
                          <circle stroke-dasharray="87.96459430051421 87.96459430051421" r="7" cx="9" cy="9" />
                        </svg>
                      </span>
                      <span class="btn__error" data-message-error>&nbsp;</span>
                    </button>
                  {%- endform -%}
                {%- else -%}
                  <button class="btn btn--small btn--secondary btn--outline"
                    type="button"
                    aria-label="{{ 'products.general.quick_add' | t }}"
                    data-quick-add-btn
                    data-quick-add-modal-handle="{{ product.handle }}"
                  >
                    <span class="btn__text">{{- 'products.general.add' | t -}}</span>
                    <span class="btn__added">&nbsp;</span>
                    <span class="btn__loader">
                      <svg height="18" width="18" class="svg-loader">
                        <circle r="7" cx="9" cy="9" />
                        <circle stroke-dasharray="87.96459430051421 87.96459430051421" r="7" cx="9" cy="9" />
                      </svg>
                    </span>
                  </button>
                {%- endif -%}

                {%- unless product.has_only_default_variant -%}
                  {%- render 'product-quick-add-modal-template', product_id: product.id, unique: unique -%}
                {%- endunless -%}
                </div>
            </quick-add-product>
          </div>
        </div>
      </div>
    </div>
  {%- endcapture -%}

  {%- capture hotspot_markup -%}
    {{ hotspot_markup }}

    <div id="hotspotItem--{{ block.id }}"
      class="hotspot-item"
      style="{{ typography_adjustment }} {{ hotspot_positions }} {{ info_bubble_styles }}"
      data-aos="fade"
      data-aos-order="{{ forloop.index | plus: 1 }}"
      data-aos-anchor="{{ unique }}"
      {% if forloop.first %}aria-current="true"{% endif %}
    >
      <a href="{{ hotspot_url }}"
        class="hotspot__button"
        aria-label="{{ aria_label | strip_html | escape }}"
        {{ block.shopify_attributes }}
      >
        {{- hotspot_elements -}}
      </a>
    </div>
  {%- endcapture -%}
{%- endfor -%}

{%- render 'stylesheet', name: 'section-look-banner.css' -%}
{%- render 'stylesheet', name: 'hotspots.css' -%}

{%- style -%}
  #{{ unique }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
  }

  {% if hotspot_bg.alpha != 0.0 and hotspot_bg != '' -%}
    #{{ unique }} .hotspot { --bg: {{ hotspot_bg }}; }
  {%- endif -%}

  {% if hotspot_color.alpha != 0.0 and hotspot_color != '' -%}
    #{{ unique }} .hotspot__button { --accent: {{ hotspot_color }}; }
  {%- endif -%}
{%- endstyle -%}

<section
  id="{{ unique }}"
  class="look-banner section-padding {{ color_scheme }}"
>
  <div class="{{ section_width }}">
    <div class="look-banner__wrapper {{ text_alignment }}">
      {%- if heading != blank or text != blank or blocks_size > 0 -%}
        {%- assign animation_order = 0 -%}
        {%- assign animation_anchor = 'LookBannerHead--' | append: section.id -%}

        {%- unless heading == blank and text == blank -%}
          <div id="LookBannerHead--{{ section.id }}" class="look-banner__head">
            {%- if heading != blank -%}
              {%- liquid
                assign animation_order = animation_order | plus: 1
                assign heading_tag = 'h2'

                unless section.settings.heading_tag == 'automatic' or section.settings.heading_tag == blank
                  assign heading_tag = section.settings.heading_tag
                endunless
              -%}

              <{{ heading_tag }}
                class="look-banner__heading hero__title {{ heading_font_size }}"
                data-aos="hero"
                data-aos-anchor="{{ animation_anchor }}"
                data-aos-order="{{ animation_order }}"
              >
                {{- heading -}}
              </{{ heading_tag }}>
            {%- endif -%}

            {%- if text != blank -%}
              {%- assign animation_order = animation_order | plus: 1 -%}

              <div
                class="look-banner__rte hero__rte {{ text_font_size }}"
                data-aos="hero"
                data-aos-anchor="{{ animation_anchor }}"
                data-aos-order="{{ animation_order }}"
              >
                {{- text -}}
              </div>
            {%- endif -%}
          </div>
        {%- endunless -%}
      {%- endif -%}

      <div class="look-banner__hero">
        <div class="look-banner__image">
          {%- assign animation_order = animation_order | at_least: 1 -%}
          {%- render 'image-hero',
            image_desktop: image_desktop,
            image_mobile: image_mobile,
            sizes: sizes,
            widths: '294, 336, 385, 422, 588, 654, 672, 770, 844, 900, 1236, 1308, 1540, 1688, 1800, 2472',
            modifier: 'aspect-ratio',
            animation_delay: animation_order,
            aspect_ratio: aspect_ratio_desktop,
            aspect_ratio_mobile: aspect_ratio_mobile,
            parallax_disable: true
          -%}
        </div>

        <div class="look-banner__hotspots">
          {{ hotspot_markup }}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
