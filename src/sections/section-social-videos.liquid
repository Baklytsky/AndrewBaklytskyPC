      "id": "popup_text",
      "label": "Text",
      "default": "In this video"
    },
    {
      "type": "select",
      "id": "popup_text_font_size",
      "label": "Text size",
      "default": "body-small",
      "options": [
        {
          "value": "body-x-small",
          "label": "Extra small"
        },
        {
          "value": "body-small",
          "label": "Small"
        },
        {
          "value": "body-medium",
          "label": "Medium"
        },
        {
          "value": "body-large",
          "label": "Large"
        },
        {
          "value": "body-x-large",
          "label": "Extra large"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color palette",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
