{%- liquid
  assign animation_anchor = 'SocialVideos--' | append: section.id
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign heading = section.settings.heading
  assign text = section.settings.text
  assign aspect_ratio = 1.0 | divided_by: section.settings.aspect_ratio
  assign popup_text = section.settings.popup_text
  assign close_label = 'general.accessibility.close' | t
-%}

{%- capture style -%}
  --PT: {{ section.settings.padding_top }}px;
  --PB: {{ section.settings.padding_bottom }}px;
{%- endcapture -%}

{%- render 'stylesheet', name: 'section-social-videos.css' -%}
{%- render 'stylesheet', name: 'modal.css', async: true -%}

<div
  class="social-videos section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="social-videos"
  style="{{ style }}"
>
  <div class="wrapper--full">
    {%- if heading != blank or text != blank -%}
      <div class="hero__content__wrapper {{ section.settings.text_alignment }}">
        <div class="hero__content">
          {%- if heading != blank -%}
            {%- assign animation_order = animation_order | plus: 1 -%}
            <h2
              class="hero__title {{ section.settings.heading_font_size }}"
              data-aos="hero"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-order="{{ animation_order }}"
            >
              {{- heading -}}
            </h2>
          {%- endif -%}

          {%- if text != blank -%}
            {%- assign animation_order = animation_order | plus: 1 -%}
            <div
              class="hero__description {{ section.settings.text_font_size }}"
              data-aos="hero"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-order="{{ animation_order }}"
            >
              {{- text -}}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- assign animation_order = animation_order | plus: 1 -%}
    <div
      class="social-videos__content"
      data-aos="hero"
      data-aos-anchor="{{ animation_anchor }}"
      data-aos-order="{{ animation_order }}"
    >
      {%- if section.blocks.size > 0 -%}
        <div class="swiper">
          <swiper-container
            loop="false"
            slides-per-view="1.6"
            grab-cursor="true"
            navigation="true"
            navigation-prev-el=".{{ section.id }}--button.swiper-button-prev"
            navigation-next-el=".{{ section.id }}--button.swiper-button-next"
            breakpoints='{"480": {"slidesPerView": 2.4}, "750": {"slidesPerView": 4}, "990": {"slidesPerView": 6}}'
          >
            {%- for block in section.blocks -%}
              {%- liquid
                assign product_list = block.settings.products
                assign video = block.settings.video
                assign popup_id = section.id | append: '-popup-' | append: forloop.index
                assign popup_prev_id = null
                assign popup_next_id = null

                unless forloop.first
                  assign prev_index = forloop.index | minus: 1
                  assign popup_prev_id = section.id | append: '-popup-' | append: prev_index
                endunless

                unless forloop.last
                  assign next_index = forloop.index | plus: 1
                  assign popup_next_id = section.id | append: '-popup-' | append: next_index
                endunless

                capture video_poster
                  render 'image', image: video.preview_image, alt: video.alt, aspect_ratio: aspect_ratio, aspect_ratio_mobile: aspect_ratio, placeholder: 'product-1'
                endcapture
              -%}

              <swiper-slide
                class="social-video__item"
                data-index="{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
                <popup-component
                  id="{{ popup_id }}"
                  class="social-video__modal{% if product_list == empty and request.design_mode == false %} social-video__modal--video-only{% endif %}"
                >
                  <button
                    class="social-video__button"
                    type="button"
                    data-popup-open
                  >
                    {{- video_poster -}}
                    {%- render 'icon-play-video' -%}
                  </button>

                  <dialog class="dialog modal__overlay" aria-hidden="true" inert data-scroll-lock-required>
                    <form method="dialog">
                      <button class="visually-hidden" aria-label="{{ close_label }}"></button>
                    </form>

                    <button
                      type="button"
                      class="modal__close modal__nav-button desktop"
                      data-popup-close
                      aria-label="{{ close_label }}"
                    >
                      {%- render 'icon-close' -%}
                    </button>

                    <div class="modal__body">
                      <button
                        type="button"
                        class="modal__close modal__nav-button mobile"
                        data-popup-close
                        aria-label="{{ close_label }}"
                      >
                        {%- render 'icon-close' -%}
                      </button>

                      <button
                        type="button"
                        class="modal__prev modal__nav-button desktop"
                        data-popup-prev="{{ popup_prev_id }}"
                        aria-label="{{ 'general.pagination.prev' | t }}"
                        {% if forloop.first %}
                          disabled
                        {% endif %}
                      >
                        {%- render 'icon-nav-arrow-left' -%}
                      </button>

                      <button
                        type="button"
                        class="modal__next modal__nav-button desktop"
                        data-popup-next="{{ popup_next_id }}"
                        {% if forloop.last %}
                          disabled
                        {% endif %}
                        aria-label="{{ 'general.pagination.next' | t }}"
                      >
                        {%- render 'icon-nav-arrow-right' -%}
                      </button>
                      <div
                        class="modal__inner grid{% if product_list == empty and request.design_mode == false %} grid--1{% else %} grid--2{% endif %}"
                        data-scroll-lock-scrollable
                      >
                        <div class="social-video__media">
                          {%- if video != null -%}
                            <script src="{{ 'video-background.js' | asset_url }}" defer="defer"></script>

                            <div
                              class="video-background image-height image-height--mobile"
                              style="--aspect-ratio: {{ aspect_ratio }};"
                            >
                              <div class="video__poster">
                                {{ video_poster }}
                              </div>

                              <video-background
                                class="video__player is-loading"
                                data-video-player
                                data-video-id="{{ section.id }}-video-background"
                              >
                                <template data-video-template>
                                  {{
                                    video
                                    | video_tag:
                                      autoplay: true,
                                      image_size: '1085x',
                                      loop: true,
                                      muted: true,
                                      controls: false
                                  }}

                                  <div class="social-video__button" data-video-hover-pause>
                                    {%- render 'icon-pause-video' -%}
                                  </div>
                                </template>
                              </video-background>
                            </div>
                          {%- else -%}
                            <div
                              class="video-background image-height image-height--mobile"
                              style="--aspect-ratio: {{ aspect_ratio }};"
                            >
                              <iframe
                                class="social-video__onboarding-video"
                                src="https://www.youtube.com/embed/_9VUPq3SxOc?autoplay=1&mute=1&loop=1&playlist=_9VUPq3SxOc&controls=0&playsinline=1"
                                allow="autoplay; encrypted-media"
                                allowfullscreen
                                loading="lazy"
                                frameborder="0"
                              ></iframe>
                            </div>
                          {%- endif -%}
                        </div>

                        {%- if product_list != empty -%}
                          <div class="social-video__products" data-scroll-lock-scrollable>
                            {%- if popup_text != blank -%}
                              <div class="modal__heading subheading text-center {{ section.settings.popup_text_font_size }}">
                                {{ popup_text }}
                              </div>
                            {%- endif -%}

                            {%- for product_item in product_list -%}
                              {% render 'product-card', product: product_item %}
                            {%- endfor -%}
                          </div>
                        {%- elsif request.design_mode -%}
                          <div class="social-video__products" data-scroll-lock-scrollable>
                            {%- if popup_text != blank -%}
                              <div class="modal__heading subheading text-center {{ section.settings.popup_text_font_size }}">
                                {{ popup_text }}
                              </div>
                            {%- endif -%}

                            {%- for i in (1..3) -%}
                              {% render 'product-card', product: null, index: i %}
                            {%- endfor -%}
                          </div>
                        {%- endif -%}
                      </div>
                    </div>
                  </dialog>
                </popup-component>
              </swiper-slide>
            {%- endfor -%}
          </swiper-container>

          <div class="{{ section.id }}--button swiper-button-prev">
            {%- render 'icon-nav-arrow-left' -%}
          </div>
          <div class="{{ section.id }}--button swiper-button-next">
            {%- render 'icon-nav-arrow-right' -%}
          </div>
        </div>
      {%- else -%}
        {%- render 'no-blocks' -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Social videos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's inside?"
