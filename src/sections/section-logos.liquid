{%- doc -%}
  Dependencies:
  - CSS: logos.css
  - JS:  logos-slider.js
  - Snippets: swiper-loader, image, no-blocks
{%- enddoc -%}

{%- liquid
  assign logo_opacity_default = section.settings.logo_opacity | default: 100
  assign logo_opacity = logo_opacity_default | times: 0.01
  assign show_slider_text = false
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign enable_slider = section.settings.enable_heading_slider
  assign animation_anchor = 'Logos--' | append: section.id
  assign animation_order = 1
  assign scroll_to_logo_label = 'general.accessibility.scroll_to_logo' | t
-%}

{%- render 'stylesheet', name: 'section-logos.css' -%}

<script src="{{ 'logos-slider.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #Logos--{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
    --logo-opacity: {{ logo_opacity }};
  }
{%- endstyle -%}

{%- if section.settings.title != blank -%}
  {%- capture heading -%}
    <h2 class="logos__title subheading"
      data-aos="hero"
      data-aos-anchor="{{ animation_anchor }}"
      data-aos-order="{{ animation_order }}"
    >
      {{ section.settings.title }}
    </h2>
  {%- endcapture -%}
{%- endif -%}

{%- for block in section.blocks -%}
  {%- capture slides -%}
    {{ slides }}

    {%- liquid
      assign logo = block.settings.logo
      assign logo_width = block.settings.logo_width
      assign sizes = logo_width | append: 'px'
      assign width = logo_width | times: 2
      assign width_retina = logo_width | times: 2
      assign widths = '100, 120, 140, 160, 180, 200, 240, 280, 320, 360, ' | append: logo_width | append: ', ' | append: width_retina
      assign link = block.settings.link

      if block.settings.text != blank and section.settings.enable_heading_slider
        assign show_slider_text = true
      endif
    -%}

    <swiper-slide
      class="logos__slide"
      data-index="{{ forloop.index0 }}"
      {{ block.shopify_attributes }}
    >
      {%- if enable_slider -%}
        <button
          class="logos__slide__link"
          type="button"
          aria-label="{{ scroll_to_logo_label }}"
        >
      {%- endif -%}

      {%- if link != blank and enable_slider == false -%}
        <a class="logos__slide__link" href="{{ link }}" aria-label="{{ logo.alt | strip_html | escape }}">
      {%- endif -%}

      <div class="logos__logo">
        {%- if logo != blank -%}
          <div
            class="logos__img"
            style="width: {{ logo_width }}px; height: {{ logo_width | divided_by: logo.aspect_ratio }}px;"
          >
            {%- render 'image', image: logo, sizes: sizes, width: width, widths: widths, show_backfill: false -%}
          </div>
        {%- else -%}
          <div class="logos__img svg-placeholder" style="width: {{ logo_width }}px; height: {{ logo_width }}px;">
            {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      {%- if link != blank and enable_slider == false -%}
        </a>
      {%- endif -%}

      {%- if enable_slider -%}
        </button>
      {%- endif -%}
    </swiper-slide>
  {%- endcapture -%}

  {%- capture contents -%}
    {{ contents }}

    <swiper-slide
      class="logos__slide"
      data-index="{{ forloop.index0 }}"
      {{ block.shopify_attributes }}
    >
      {%- if block.settings.text != blank -%}
        <div class="logos__slide__text {{ block.settings.text_font_size }}">
          {{- block.settings.text -}}
        </div>
      {%- endif -%}
    </swiper-slide>
  {%- endcapture -%}
{%- endfor -%}

<logos-slider
  id="Logos--{{ section.id }}"
  class="logos swiper section-padding{% if enable_slider %} logos-press{% endif %} {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="logos"
>
  <div class="logos__wrapper">
    {{ heading }}

    {%- if section.blocks.size > 0 -%}
      {%- assign animation_order = animation_order | plus: 1 -%}
      <div
        class="logos__slider__outer"
        data-aos="hero"
        data-aos-anchor="{{ animation_anchor }}"
        data-aos-order="{{ animation_order }}"
      >
        <div
          class="logos__slider"
          {% if request.design_mode %}
            data-block-scroll
          {% endif %}
        >
          {%- liquid
            assign initial_index = 0
            assign remainder = section.blocks.size | modulo: 2
            if remainder == 0
              assign initial_index = section.blocks.size | divided_by: 2 | minus: 1
            else
              assign initial_index = section.blocks.size | minus: 1 | divided_by: 2
            endif
            assign autoplay = section.settings.autoplay
            assign autoplay_delay = 0
            if autoplay
              assign autoplay_delay = section.settings.autoplay_delay | times: 1000
            endif
          -%}

          <swiper-container
            data-slider-logos
            loop="false"
            centered-slides="true"
            slides-per-view="5"
            effect="coverflow"
            coverflow-effect-slide-shadows="false"
            coverflow-effect-rotate="0"
            initial-slide="{{ initial_index }}"
            {%- if autoplay %}
              autoplay="{{ autoplay }}"
              autoplay-delay="{{ autoplay_delay }}"
              autoplay-disable-on-interaction="false"
            {%- endif -%}
          >
            {{ slides }}
          </swiper-container>
        </div>
      </div>
    {%- else -%}
      {%- render 'no-blocks' -%}
    {%- endif -%}

    {%- if show_slider_text -%}
      {%- assign animation_order = animation_order | plus: 1 -%}

      <div
        class="logos__slider-text wrapper"
        data-aos="hero"
        data-aos-anchor="{{ animation_anchor }}"
        data-aos-order="{{ animation_order }}"
      >
        <swiper-container
          data-slider-text
          loop="false"
          slides-per-view="1"
          initial-slide="{{ initial_index }}"
          effect="fade"
          fade-effect-cross-fade="true"
        >
          {{- contents -}}
        </swiper-container>
      </div>
    {%- endif -%}
  </div>
</logos-slider>

{% schema %}
{
  "name": "Logos",
  "max_blocks": 25,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_heading_slider",
      "label": "Enable heading slider",
      "default": false
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Inactive logo opacity",
      "unit": "%",
      "min": 5,
      "max": 100,
      "step": 5,
      "default": 60
    },
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 4,
      "max": 15,
      "step": 1,
      "unit": "sec",
      "label": "Change slides every",
      "default": 8
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Subheading",
      "default": "As seen in"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "logo-item",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "360 x 360px .svg recommended"
        },
        {
          "type": "range",
          "id": "logo_width",
          "label": "Width",
          "unit": "px",
          "min": 100,
          "max": 180,
          "step": 10,
          "default": 100
        },
        {
          "type": "header",
          "content": "Link",
          "info": "Applies if 'enable heading slider' is disabled"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Quote"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Header",
          "default": "Include a brief quote from a brand that loves your products"
        },
        {
          "type": "select",
          "id": "text_font_size",
          "label": "Header size",
          "info": "Applies only when content in Text field is set to Paragraph.",
          "default": "body-x-large",
          "options": [
            {
              "value": "body-x-small",
              "label": "Extra small"
            },
            {
              "value": "body-small",
              "label": "Small"
            },
            {
              "value": "body-medium",
              "label": "Medium"
            },
            {
              "value": "body-large",
              "label": "Large"
            },
            {
              "value": "body-x-large",
              "label": "Extra large"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logos",
      "category": "Image",
      "settings": {
        "enable_heading_slider": false
      },
      "blocks": [
        {
          "type": "logo-item"
        },
        {
          "type": "logo-item"
        },
        {
          "type": "logo-item"
        },
        {
          "type": "logo-item"
        },
        {
          "type": "logo-item"
        }
      ]
    },
    {
      "name": "Press",
      "category": "Image",
      "settings": {
        "enable_heading_slider": true
      },
      "blocks": [
        {
          "type": "logo-item"
        },
        {
          "type": "logo-item"
        },
        {
          "type": "logo-item"
        },
        {
          "type": "logo-item"
        },
        {
          "type": "logo-item"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside", "footer"]
  }
}
{% endschema %}
