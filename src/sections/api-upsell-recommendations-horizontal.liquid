{%- doc -%}
  API endpoint section for fetching product recommendations rendered as horizontal upsell products.
  Used by cart-upsell-recommendations.js for AI-powered recommendations.

  URL params (handled by Shopify):
  - product_id: Product ID to get recommendations for
  - limit: Maximum number of recommendations
  - intent: 'related' or 'complementary'

  @example
  Fetch: /recommendations/products?product_id=123&limit=4&intent=related&section_id=api-upsell-recommendations-horizontal
{%- enddoc -%}

<template data-api-upsell-recommendations>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    {%- for product in recommendations.products -%}
      {%- liquid
        assign hidden_product = false
        if product.tags contains 'hide'
          assign hidden_product = true
        endif

        comment
          Skip unavailable products for upsells
        endcomment
        assign all_variants_soldout = true
        for variant in product.variants
          if variant.available
            assign all_variants_soldout = false
            break
          endif
        endfor
      -%}

      {%- unless hidden_product or all_variants_soldout -%}
        <div data-upsell-item data-product-id="{{ product.id }}">
          {%- render 'upsell-product',
            upsell_product: product,
            unique_id: product.id,
            is_compact: true,
            instant_add: true,
            show_available_upsell_only: true
          -%}
        </div>
      {%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
</template>

