    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Primary image",
      "info": "2000 x 1400px .jpg recommended. [Learn more](http://presidiodev.com/link/carbon/images)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Secondary image",
      "info": "Displays both images at a 50% width. 2000 x 1400px .jpg recommended. [Learn more](http://presidiodev.com/link/carbon/images)"
    },
    {
      "type": "select",
      "id": "image_width",
      "label": "Image width",
