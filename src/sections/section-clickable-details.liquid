<!-- /sections/section-clickable-details.liquid -->
{%- liquid
  assign heading = section.settings.heading
  assign text = section.settings.text
  assign image_width = section.settings.image_width
  assign image = section.settings.image
  assign aspect_ratio = image.aspect_ratio_desktop | default: 1.3
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign hotspot_color = section.settings.hotspot_color
  assign hotspot_bg = section.settings.hotspot_bg
  assign hotspot_contents_mobile = ''

  capture typography_adjustment
    assign adjustment = settings.base_font_size | default: 16 | times: 0.075
    echo ' --adjust-title: ' | append: adjustment | append: ';'
  endcapture

  assign sizes = '(min-width: 1024px) calc(1100px * ' | append: image_width | times: 0.01 | append: '), calc(100vw - 2 * 20px)'
-%}

{%- render 'stylesheet', name: 'section-clickable-details.css' -%}

<script data-script-inline src="{{ 'section-clickable-details.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #IndexClickableDetails--{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
  }

  {%- if hotspot_bg != 'rgba(0,0,0,0)' and hotspot_bg != '' -%}
    #IndexClickableDetails--{{ section.id }} .hotspot { --bg: {{ hotspot_bg }}; }
  {%- endif -%}

  {%- if hotspot_color != 'rgba(0,0,0,0)' and hotspot_color != '' -%}
    #IndexClickableDetails--{{ section.id }} .hotspot__button { --accent: {{ hotspot_color }}; }
  {%- endif -%}
{%- endstyle -%}

<section
  id="IndexClickableDetails--{{ section.id }}"
  class="clickable-details section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="look"
  data-section-assets='
    {
      "css": [
        "{{ 'sections.css' | asset_url }}"
      ],
      "js": [
        "{{ 'sections.js' | asset_url }}"
      ]
    }
  '
>
  <div class="wrapper">
    {%- if heading != blank or text != blank -%}
      <div class="hero__content__wrapper text-center">
        <div class="hero__content">
          {%- if heading != blank -%}
            {%- assign animation_order = animation_order | plus: 1 -%}
            <h2
              class="hero__title {{ section.settings.heading_font_size }}"
              data-aos="hero"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-order="{{ animation_order }}"
            >
              {{- heading -}}
            </h2>
          {%- endif -%}

          {%- if text != blank -%}
            {%- assign animation_order = animation_order | plus: 1 -%}
            <div
              class="hero__description {{ section.settings.text_font_size }}"
              data-aos="hero"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-order="{{ animation_order }}"
            >
              {{- text -}}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <clickable-details class="look__product" style="--image-width: {{ image_width }}%;">
      <div class="look__image-container">
        {%- render 'image-hero',
          image: image,
          sizes: sizes,
          widths: '294, 336, 385, 422, 588, 654, 672, 770, 844, 900, 1236, 1308, 1540, 1688, 1800, 2472',
          modifier: 'aspect-ratio',
          aspect_ratio: aspect_ratio,
          parallax_disable: true
        -%}

        <div class="hotspots">
          {%- for block in section.blocks -%}
            {%- liquid
              assign target = 'hotspot-' | append: forloop.index | append: section.id
              assign position_x = block.settings.position_x
              assign position_y = block.settings.position_y
              assign hotspot_title = block.settings.heading
              assign hotspot_text = block.settings.text
              assign info_bubbles_position = block.settings.info_bubbles_position

              capture hotspot_postions
                echo ' --position-x: ' | append: position_x | append: '%;'
                echo ' --position-y: ' | append: position_y | append: '%;'
              endcapture

              capture info_bubble_styles
                render 'look-bubbles', info_bubbles_position_desktop: info_bubbles_position
              endcapture
            -%}

            {%- capture hotspot_content -%}
              {%- if hotspot_title != blank -%}
                <h4 class="hotspot__title heading-small">{{ hotspot_title }}</h4>
              {%- endif -%}
              {%- if hotspot_text != blank -%}
                <div class="hotspot__text body-small">{{ hotspot_text }}</div>
              {%- endif -%}
            {%- endcapture -%}

            {%- capture hotspot_content_mobile -%}
              <div class="hotspot__content-mobile frame__item{% if forloop.first %} is-selected{% endif %}" id="{{ target }}">
                <div class="hotspot__content-toggleable">
                  {{ hotspot_content }}
                </div>
              </div>
            {%- endcapture -%}

            {%- assign hotspot_contents_mobile = hotspot_contents_mobile | append: hotspot_content_mobile -%}

            <div
              id="hotspotItem--{{ block.id }}"
              class="hotspot-item"
              style="{{ typography_adjustment }} {{ hotspot_postions }} {{ info_bubble_styles }}"
              data-aos="fade"
              data-aos-order="{{ forloop.index | plus: 1 }}"
              data-aos-anchor="IndexClickableDetails--{{ section.id }}"
            >
              <button
                type="button"
                class="hotspot__button{% if forloop.first %} is-selected{% endif %}"
                data-target="{{ target }}"
                aria-label="Click to toggle content"
                {{ block.shopify_attributes }}
              >
                <div class="hotspot">
                  <span class="hotspot__icon-toggle">
                    {%- render 'animated-icon', filename: 'icon-plus' -%}
                    {%- render 'animated-icon', filename: 'icon-minus' -%}
                  </span>

                  <div class="hotspot__info-bubble">
                    <div class="hotspot__content">
                      {{ hotspot_content }}
                    </div>
                  </div>
                </div>
              </button>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="look__contents mobile">
        <div class="frame">
          {{ hotspot_contents_mobile }}
        </div>
      </div>
    </clickable-details>
  </div>
</section>

