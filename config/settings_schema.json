      },
      {
        "type": "header",
        "content": "Free shipping in cart"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Threshold"
      },
      {
        "type": "text",
        "id": "free_shipping_message",
        "label": "Message",
        "info": "Use {{difference}} to denote the remaining amount needed."
      },
      {
        "type": "paragraph",
        "content": "Final message"
      },
      {
        "type": "text",
        "id": "cart_tiered_message_final",
        "label": "Message"
      },
      {
        "type": "header",
        "content": "Preorder in cart"
      },
      {
        "type": "text",
        "id": "only_preorder_products_message",
        "label": "Message",
        "info": "This message is displayed if there are only preorder products in cart."
      },
      {
        "type": "text",
        "id": "without_preorder_products_message",
        "label": "Message",
        "info": "This message is displayed if there are no preorder products in cart. Use {{date}} to display delivery date."
      },
      {
        "type": "text",
        "id": "preorder_and_default_products_first_message",
        "label": "Top Message",
        "info": "This message is displayed if there are both preorder and regular products in cart. Use {{date}} to display delivery date."
      },
      {
        "type": "text",
        "id": "preorder_and_default_products_second_message",
        "label": "Bottom Message",
        "info": "This message is displayed if there are both preorder and regular products in cart. Use {{date}} to display delivery date."
      }
    ]
