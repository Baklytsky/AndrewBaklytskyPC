    "164303764197a54241": {
      "type": "text-list",
      "blocks": {
        "da681735-d90f-4a07-8d86-1e01bb55ca14": {
          "type": "text",
          "settings": {
            "heading": "We're here to modernize the golf experience",
            "item_text": "We believe golfers deserve better shoes that fit their lifestyle."
          }
        },
        "cb7193c5-4f1d-4f9f-99c5-ae36cb3971cb": {
          "type": "text",
          "settings": {
            "heading": "We believe a life well-lived pursues it’s passions",
            "item_text": "So we design golf shoes and products that are as versatile as your lifestyle, passions and pursuits. Footwear that holds up to your everyday needs and exceeds expectations while you pursue par."
          }
        },
        "0a30c8b9-453c-4fe0-b315-7a56b214e69c": {
          "type": "text",
          "settings": {
            "heading": "We honor legacy while we create our own",
            "item_text": "We are a product of our sport - to that end we give reverence to the past while creating the future. We’re here to step golf into a future where all are welcome."
          }
        }
      },
      "block_order": [
        "da681735-d90f-4a07-8d86-1e01bb55ca14",
