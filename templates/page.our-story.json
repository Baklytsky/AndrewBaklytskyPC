    "16427773156cfb0fab": {
      "type": "image-with-text-carousel",
      "blocks": {
        "dcefc989-6769-4774-90bd-093263ac48ab": {
          "type": "carousel-item",
          "settings": {
            "item_image": "shopify:\/\/shop_images\/Screen_Shot_2022-02-28_at_5.58.45_PM.png",
            "heading": "2009",
            "item_subheading": "An Idea is Born",
            "item_text": "Over a coffee table, some links golf, and maybe a few Guinness - a group of innovators decided the world was missing one thing they all craved: a golf shoe designed for the walking golfer."
          }
        },
        "d8d80099-ffa2-4fed-98ec-2d80ee96cf55": {
          "type": "carousel-item",
          "settings": {
            "item_image": "shopify:\/\/shop_images\/Screen_Shot_2022-02-28_at_5.46.13_PM.png",
            "heading": "2010",
            "item_subheading": "Finally, a Comfortable Golf Shoe",
            "item_text": "TRUE releases the TRUE Tour (T1) - the first ever minimalist, wide, zero drop golf shoe and the industry welcomes the concept, turning TRUE into a global footwear brand overnight."
          }
        },
        "073cea83-22cd-4168-ad19-8abbc3bbb079": {
          "type": "carousel-item",
          "settings": {
            "item_image": "shopify:\/\/shop_images\/TRUE_mem_8_x_10___B_W-17.jpg",
            "heading": "2012",
            "item_subheading": "First TRUE Win on Tour",
            "item_text": "Ryan Moore wins his first tournament in the TRUE Proto, the Justin Timberlake Shriners Open - the same day a TRUE co-founder runs a marathon in the same sole."
          }
        },
        "71d3c8aa-00af-4e93-883d-5ade9697b29e": {
          "type": "carousel-item",
          "settings": {
            "item_image": "shopify:\/\/shop_images\/TRUE_mem_8_x_10___B_W-13.jpg",
            "heading": "2016",
            "item_subheading": "TRUE At the Ryder Cup",
            "item_text": "Ryan Moore makes Ryder Cup history by winning the clinching point for Team USA, in TRUE style, rocking a pair of custom made TRUE Classix - featuring a flag embellishment and red sole."
          }
        },
        "cb8c8d32-9436-413f-89d2-839a44a75170": {
          "type": "carousel-item",
          "settings": {
            "item_image": "shopify:\/\/shop_images\/Screen_Shot_2022-02-28_at_5.44.26_PM.png",
            "heading": "2017",
            "item_subheading": "The Original is Re-Mastered",
            "item_text": "Bringing the first TRUE style back to life through a modern aesthetic, improved waterproof system and premium leather materials - an iconic TRUE came back to the market looking and feeling better than ever."
          }
        },
        "c02ac18e-71b1-45fd-a379-e3cd01fea168": {
          "type": "carousel-item",
          "settings": {
            "item_image": "shopify:\/\/shop_images\/TRUE_mem_8_x_10___B_W-23.jpg",
            "heading": "2019",
            "item_subheading": "Ten Year Anniversary",
            "item_text": "A decade since our inception, TRUE celebrates 10 years in footwear innovation by releasing our 10-Year Anniversary OG1, selling out in minutes."
          }
        },
        "0ced02d8-9cb0-475d-822e-938a530b2879": {
          "type": "carousel-item",
          "settings": {
            "item_image": "shopify:\/\/shop_images\/Screen_Shot_2022-02-28_at_5.39.10_PM.png",
            "heading": "2020",
            "item_subheading": "Project 2020 - a New Generation of TRUE",
            "item_text": "Lux and All Day Knit II enter the scene with a bold new style, performance and unprecedented comfort. Now cult-favorites, these styles are here to stay with hundreds of thousands of pairs sold worldwide."
          }
        }
      },
