    "164277524413f8f5f7": {
      "type": "animated-text-columns",
      "blocks": {
        "60db7782-bdf6-4647-8c95-b78f750833b3": {
          "type": "text-block",
          "settings": {
            "heading": "500k+",
            "text": "<p>TRUE Customers worldwide are enjoying the walk, with millions of rounds played in comfort.<\/p>"
          }
        },
        "6646e598-ac97-4827-8520-15bce1e2fde2": {
          "type": "text-block",
          "settings": {
            "heading": "4.85",
            "text": "<p>Average rating on more than 5,000+ reviews. Our customers have validated our product, making it the highest rated footwear in the industry.<\/p>"
          }
        },
        "d4be32a3-450f-4ba3-b1e3-75c1c9f3614d": {
          "type": "text-block",
          "settings": {
            "heading": "Dozens",
            "text": "<p>Of professional golfers lace up our shoes every week at the highest level of competition<\/p>"
          }
        }
      },
      "block_order": [
