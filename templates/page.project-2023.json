    "cc7cacc1-9946-4bad-874f-a87cb9eea41e": {
      "type": "text-blocks",
      "blocks": {
        "427750d2-85ed-4028-9b88-6df483cf6ab6": {
          "type": "text_block",
          "settings": {
            "heading": "",
            "text": "<p>We're allowing you to order future releases right here, right now. The styles showcased are the entirety of our Summer 2023 Golf Collection - these styles are slotted for release dates between 5\/24-6\/29, but VIP's can order them now. We air freighted in a small batch of pairs so you could enjoy the walk all summer. Availability is limited and available on a first come first serve basis. All product is in warehouse and will be shipped according to standard shipping procedures (within 1-4 business days depending on demand). No waiting, no worrying - just select your new pair and get to the course.<\/p><p>-<\/p><p><em>Women's sizing will be available in Ripstop V2 and FS-02 Mixed Media during their public debut in June. <\/em><\/p><p><em>Thank you for your patience.<\/em><\/p>",
            "link": "",
            "button_text_1": "",
            "button_link_1": "",
            "button_type_1": "primary",
