    "a62af90f-829d-4a78-91f8-8ae56a803c54": {
      "type": "text-blocks",
      "blocks": {
        "5ae8ad57-a518-4dc5-b784-d2e013aba3bc": {
          "type": "text_block",
          "settings": {
            "heading": "",
            "text": "<p>Continuing the TRUE tradition of venturing off the beaten path, we’ve teamed up with the uber-talented artist SLOTH to bring you a limited collection of art inspired apparel featuring tees, hats, and more. All gear features the ‘Chill Sloth’ artwork on an embroidered felt patch with a raised cotton-chenille construction with a nod to the custom artwork designed for this endeavor. Read more about SLOTH, Timmy Ham, and the inspiration behind the collaboration below. Don’t forget to snag your gear while you can; these are poised to move quick.<\/p>",
            "link": "",
            "button_text_1": "",
            "button_link_1": "",
            "button_type_1": "primary",
            "button_text_2": "",
            "button_link_2": "",
            "button_type_2": "primary"
          }
        }
      },
      "block_order": [
        "5ae8ad57-a518-4dc5-b784-d2e013aba3bc"
      ],
