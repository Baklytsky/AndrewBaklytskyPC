    "fd1f19de-9258-4183-8b37-a70891372c65": {
      "type": "image-with-text",
      "blocks": {
        "09deb070-4b84-48c5-8355-441f57b66d09": {
          "type": "iwt_block",
          "settings": {
            "heading": "",
            "text": "<h3>WHO IS SLOTH<\/h3><p><br\/>SLOTH originated in 2007 by Timmy Ham. SLOTH started off as Timmy Ham’s artist ‘Tag’ and over the course of 15 years it has evolved into a lifestyle brand.<br\/><br\/>Arizona Based Local Award Winning Professional Illustrator and Visual Designer has a passion to create art, communities and content. Timmy Ham AKA SLOTH has been a full time artist for 12 years and worked with all sorts of major Fortune 500 companies. Timmy has a style that brings bright bold colors and a vibe that will make anyone smile, along with his super powers that bring art and community together for a common good.<\/p>",
            "button_label": "",
            "button_link": "",
            "button_style": "secondary",
            "image": "shopify:\/\/shop_images\/True_x_Sloth-Lifestyle6.jpg",
            "layout": "image_first"
          }
        },
        "template--14500757864577__fd1f19de-9258-4183-8b37-a70891372c65-168676447721882d42-0": {
          "type": "iwt_block",
          "settings": {
            "heading": "",
            "text": "<h3>THE COLLAB<\/h3><p><br\/>“I really fell in love with TRUE 3 years ago and have been following along with what TRUE had been up to and when the timing was right, we got connected. With this capsule collaboration I really wanted to bring something totally unique and different to the golf scene with style and colors. I also go by SLOTH and my whole ethos is slow and steady wins the race and I really think that fits so perfectly to the sport of golf. Also the idea to chill out and smell the roses kind of vibe.”<\/p>",
            "button_label": "",
            "button_link": "",
            "button_style": "secondary",
            "image": "shopify:\/\/shop_images\/True_x_Sloth-Lifestyle2.jpg",
            "layout": "text_first"
          }
        },
        "767b4454-40b7-4950-8434-06b36e9c74bc": {
          "type": "iwt_block",
          "settings": {
            "heading": "",
            "text": "<h3>BEHIND THE SCENES<\/h3><p><br\/>Learn more about SLOTH and the limited collection capsule in our latest blog post. What inspired this drop? How did we come to meet? All your questions, and potentially more - answered. <\/p>",
            "button_label": "Learn More",
            "button_link": "shopify:\/\/blogs\/enjoy-series\/true-x-sloth",
            "button_style": "secondary",
            "image": "shopify:\/\/shop_images\/True_x_Sloth-Lifestyle9_ffd1104d-2d1a-4b8d-9c9b-d0d2ba9c6e30.jpg",
            "layout": "image_first"
          }
        }
      },
