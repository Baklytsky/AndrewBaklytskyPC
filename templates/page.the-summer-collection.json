        "text_block_6Kx9E8": {
          "type": "text_block",
          "settings": {
            "heading": "",
            "text": "<p>Welcome to the TRUE linkswear Summer Collection, where adventure meets unparalleled comfort and style. As the sun shines brighter and the days grow longer, it's time to gear up with footwear that's as ready for the great outdoors as you are. Our summer lineup is crafted with the spirit of exploration in mind, blending top-tier performance with breathable, lightweight materials. Whether you're navigating rugged trails or strolling along sandy beaches, our shoes are designed to keep you moving with confidence and ease.<\/p>",
            "link": "",
            "button_text_1": "",
            "button_link_1": "",
            "button_type_1": "primary",
            "button_text_2": "",
            "button_link_2": "",
