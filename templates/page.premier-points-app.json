    "2032327d-170d-4f07-8049-2468c5a5cba9": {
      "type": "faq",
      "blocks": {
        "0a5969d5-e16e-4652-a371-55a04ee8b2ba": {
          "type": "accordion",
          "settings": {
            "category": "Obagi Premier Points Redemption",
            "question": "Can my free product(s) ship to a different address than the one I have on file?",
            "answer": "Yes, you will be able to confirm or update your preferred shipping address when you redeem your Obagi Premier Points for product."
          }
        },
        "f8ab35d7-0988-43a6-94a9-fece1e29e2bf": {
          "type": "accordion",
          "settings": {
            "category": "Obagi Premier Points Redemption",
            "question": "How long does it take my product to ship?",
            "answer": "Your free product(s) will be sent out for free using standard shipping. You can expect to receive your product in approximately 7-10 business days."
          }
        },
        "38dae7ae-16a4-4502-a6e1-0571067862cf": {
          "type": "accordion",
          "settings": {
            "category": "General Questions",
            "question": "When will I start earning points?",
            "answer": "Instantly! Start earning points as soon as you log your first Obagi purchase on the app."
          }
        },
        "accordion_7WDzxd": {
          "type": "accordion",
          "settings": {
            "category": "",
            "question": "",
            "answer": ""
          }
        },
        "8645237b-a180-48f2-9c28-1a84e883ca79": {
          "type": "accordion",
          "settings": {
            "category": "General Questions",
            "question": "What participating products count toward Obagi Premier Points?",
            "answer": "We offer more than 60 participating products for purchase at this time. Obagi Premier Points can be earned only from purchases of the following products in a physician's office:\n<br>Obagi Nu-Derm<sup>®<\/sup>, Obagi-C<sup>®<\/sup> Rx, ELASTIDERM<sup>®<\/sup>, CLENZIderm M.D.\n<sup>™<\/sup>,\nProfessional-C<sup>®<\/sup>, Obagi360<sup>®<\/sup>,  Obagi Hydrate<sup>®<\/sup>, SUZANOBAGIMD, Blue Peel RADIANCE<sup>®<\/sup>, and Sun Shield<sup>™<\/sup>. All other Obagi products are excluded from the program."
          }
        },
        "343160b1-5a6b-4a5e-911d-00a86f1d1821": {
          "type": "accordion",
          "settings": {
            "category": "General Questions",
            "question": "What are the participating products I can redeem for free within Obagi Premier Points?",
            "answer": "The following participating products are currently available to redeem for free:\n\n<br>\n<br><strong>TIER 200<\/strong>\n\n<br>Obagi Nu-Derm<sup>®<\/sup> Gentle Cleanser 6.7 fl Oz (198 mL)\n\n<br>Obagi Nu-Derm<sup>®<\/sup> Foaming Gel 6.7 fl oz (198 mL)\n\n﻿﻿<br>Obagi Nu-Derm<sup>®<\/sup> Toner 6.7 fl oz (198 mL)\n\n﻿﻿<br>Obagi-C<sup>®<\/sup> C-Cleansing Gel 6.0 fl oz (177 mL)\n\n<br>Obagi360<sup>®<\/sup> Exfoliating Cleanser 5.1 fl oz (150 mL)\n\n<br>\n<br><strong>TIER 300<\/strong>\n\n<br>Obaqi360<sup>®<\/sup> HydraFactor Broad Spectrum SPF 30 2.5 oz (75 g)\n<br>﻿﻿Obagi360<sup>®<\/sup> Retinol 0.5 1.0 oz (28 g)\n<br>Obagi360<sup>®<\/sup> Retinol 1.0 1.0 Oz (28 g)\n<br>Obagi Hydrate<sup>®<\/sup> 1.7 oz (48 g)\n<br>﻿﻿Sun Shield Matte Broad Spectrum SPF 50 3.0 oz (85 g)\n\n<br>\n<br><strong>TIER 400<\/strong>\n﻿﻿<br>Obagi Nu-Derm Exfoderm<sup>®<\/sup> 2.0 oz (57 g)\n<br>Obagi Nu-Derm<sup>®<\/sup> Exfoderm Forte 2.0 oz (57 g)\n<br>Obagi-C C-Exfoliating Day Lotion 2.0 oz (57 g)\n<br>﻿﻿Professional-C<sup>™<\/sup>m Suncare 1.7 Oz (48 g)\n<br>﻿﻿Obagi Hydrate<sup>®<\/sup> Luxe<sup>®<\/sup> 1.7 oz (48 g)\n\n<br>\n<br><strong>TIER 500<\/strong>\n<br>ELASTIDERM<sup>®<\/sup> Eye Cream 0.5 oz (15 g)\n<br>ELASTIDERM<sup>®<\/sup> Eye Serum 0.47 fl oz (14 mL)\n<br>Professional-C<sup>®<\/sup> Serum 15% 1.0 fl oz (30 mL)\n<br>﻿﻿Professional-C Eye Brightener 0.5 fl oz (15 mL)\n<br>Professional-C<sup>®<\/sup> Peptide Complex 1.0 fl oz (30 mL)"
          }
        },
        "9ceb8f08-86d4-4af9-8d2d-54a3592ad4bc": {
          "type": "accordion",
          "settings": {
            "category": "General Questions",
            "question": "How often are these redeemable participating products changes or updated?",
            "answer": "Redeemable participating products will be reviewed and may change every 6 months. However, should products become low on inventory, Obagi reserves the right to remove products as necessary."
          }
        },
        "d475814d-4f72-44f8-9945-48986bb21f32": {
          "type": "accordion",
          "settings": {
            "category": "General Questions",
            "question": "How do I access my account?",
            "answer": "You can acess your account directly from your smartphone using the mobile app."
          }
        },
        "92082266-cb6f-4a1e-ae8c-05e51656f187": {
          "type": "accordion",
          "settings": {
            "category": "General Questions",
            "question": "How can I find a participating provider?",
            "answer": "In your Obagi Premier Points app, go to the Find Obagi screen. Search by physician name or zip code to locate an Obagi physician using the Automatic Geo Location feature."
          }
        },
        "40a8a2f5-a269-4f49-962b-88b7e669a79e": {
          "type": "accordion",
          "settings": {
            "category": "General Questions",
            "question": "Do my points ever expire? Can they be reinstated if they do?",
            "answer": "Your points never expire!"
          }
        },
        "392b68fe-726d-4497-b214-7407cd671a28": {
          "type": "accordion",
          "settings": {
            "category": "General Questions",
            "question": "Is there a maximum number of points I can accumulate per year?",
            "answer": "No, there is no maximum."
          }
        },
        "a9e88300-679b-4084-b789-24832990c45e": {
          "type": "accordion",
          "settings": {
            "category": "General Questions",
            "question": "Are joint accounts available for family and friends?",
            "answer": "No, only one account per person is allowed."
          }
        },
        "0d5a4e52-47b8-43a1-9a3c-1950275cf74b": {
          "type": "accordion",
          "settings": {
            "category": "General Questions",
            "question": "Do I have to stay with the same skin care provider\/physician?",
            "answer": "You can earn points any time you purchase eligible Obagi products from any participating physician's office."
          }
        },
        "4a2a2f39-d800-42be-91dd-45b53c51ea56": {
          "type": "accordion",
          "settings": {
            "category": "Obagi Premier Points Customer Service",
            "question": "Where can I go for assistance?",
            "answer": "If you experience any technical issues with the Obagi Premier Points app, please contact PremierPoints@obagi.com.\n<br>\n<br>\nFor customer service issues (eg, my product did not ship, etc), please contact 1-800-636-7546 option 6."
          }
        },
        "3e2dca16-1e96-4fe6-9a56-e3a42df7fff6": {
          "type": "accordion",
          "settings": {
            "category": "Accumulating Obagi Premier Points",
            "question": "How do I earn points?",
            "answer": "You can earn points instantly by making a qualifying Obagi purchase from a participating Obagi physician's office."
          }
        },
        "d58b8c38-3bcc-4935-a664-76252f8d1867": {
          "type": "accordion",
          "settings": {
            "category": "Accumulating Obagi Premier Points",
            "question": "How do I receive points?",
            "answer": "Once your purchase is made, you can scan the product barcode(s) or manually select products to load the points into your account. Once the products are logged, your physician or office staff member will scan a QR code unique to the physician's office to confirm the purchase. The app will guide you through this process each time you make a purchase."
          }
        },
        "b9bd75ba-8446-4b60-b4b2-8026724eb550": {
          "type": "accordion",
          "settings": {
            "category": "Accumulating Obagi Premier Points",
            "question": "Do online purchases qualify for Obagi Premier Points?",
            "answer": "If an Obagi product is purchased through another site besides Obagi.com or through a participating Obagi physician's office, the purchase will not qualify for the program."
          }
        },
        "8bb9e2d8-0580-4cd7-9c34-751c3c9d3857": {
          "type": "accordion",
          "settings": {
            "category": "Accumulating Obagi Premier Points",
            "question": "What do I do if there is no barcode located on my product to scan?",
            "answer": "If there is no barcode, click on the \"manually Select Products\" link. Select the product line from the drop-down menu and then select the product."
          }
        },
        "3959069a-e507-4e8b-afb9-1210b9c7ea92": {
          "type": "accordion",
          "settings": {
            "category": "Accumulating Obagi Premier Points",
            "question": "Can I transfer my points to someone else?",
            "answer": "No, points transfers are not allowed at this time."
          }
        }
      },
