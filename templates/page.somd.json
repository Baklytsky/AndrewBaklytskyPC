        "text_column_Ae74dp": {
          "type": "text_column",
          "settings": {
            "title": "CLEANSE",
            "description": "Proper skin cleansing is essential for removing oil buildup, makeup, and environmental pollutants. Cleansing the skin and removing these pollutants increases the efficacy of a skin care regimen and set the stage for enhanced results.",
            "content_alignment_mobile": "center"
          }
        },
        "text_column_RecQmK": {
          "type": "text_column",
          "settings": {
            "title": "PROTECT",
            "description": "Skin is exposed to harmful ultraviolet radiation (UVR), visible light (including HEV), and infrared radiation (IR) on a daily basis, regardless of climate or geographic location. Protecting the skin is the most proactive step you can take to minimize the visible signs of aging.",
            "content_alignment_mobile": "center"
          }
        },
        "text_column_QiXETt": {
          "type": "text_column",
          "settings": {
            "title": "RENEW",
            "description": "Complete the cycle by incorporating a \"renew\" step into a skin care routine. Our scientifically formulated products will repair and rejuvenate aging and damaged skin, revealing a healthy-looking and more radiant glow.",
            "content_alignment_mobile": "center"
          }
        }
      },
