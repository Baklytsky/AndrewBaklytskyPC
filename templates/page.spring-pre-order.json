          "settings": {
            "image": "shopify:\/\/shop_images\/Dead_Golfer-On_Course-90.jpg",
            "heading": "small batch\nquantities",
            "description": "Like all good things, quantites are limited; so snag your favorites while supplies last. Like the Dead Golfer, items will be 86'ed before you know it.",
