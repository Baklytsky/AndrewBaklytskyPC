          "settings": {
            "image": "shopify:\/\/shop_images\/TRUE_STUDIO_10840.jpg",
            "heading": "",
            "subheading": "",
            "overlay_description": "",
            "overlay_heading": "LUX Polo",
            "overlay_product_1": "true-lux-polo",
            "overlay_product_2": "",
            "overlay_product_3": "",
            "overlay_text": "Minimalist design, maximum comfort - the Lux Polo is the softest shirt you will ever wear. Built using SuperNatural Materials that offer unrivaled performance and a modern aesthetic so it can transcend the course. The athletic modern cut looks great on or off the links as the polo drapes naturally for a casual, yet tailored looking fit. Our ultra premium Lux Polo blend features a sustainable mix of industry leading Tencel® (45%), Repreve® Recycled Polyester (50%) and Spandex (5%) for maximum comfort and movement. Minimalist tonal high density logo prints at the wearers back left shoulder and right sleeve."
          }
        },
