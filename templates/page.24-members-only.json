        "text_block_J6F79K": {
          "type": "text_block",
          "settings": {
            "heading": "",
            "text": "<p>Golf is a game where membership cannot be purchased through status or financial means, only love for the game. This \"MEMBERS ONLY\" collection represents our commitment to making golf more inclusive and we invite you to join us and become a lifetime member of the game.<br\/><br\/>The limited edition \"MEMBERS ONLY\" collection includes new releases of the Original 1.2, FS-01 Premium Leather, and FS-Slides available in men’s and women’s alike. Each pair of shoes comes shipped in a limited edition reusable shoe bag with a reversible \"MEMBERS ONLY\" leather head cover, pouch, and microfiber golf towel.  Act quick, LE’s tend to sell out fast.<\/p>",
            "link": "",
            "button_text_1": "",
            "button_link_1": "",
            "button_type_1": "primary",
            "button_text_2": "",
