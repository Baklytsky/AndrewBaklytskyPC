    "157f817f-0401-4937-8ec9-08313f108d11": {
      "type": "text-with-button",
      "blocks": {
        "ce9fd67d-2538-421c-a053-8f54149dfb52": {
          "type": "text",
          "settings": {
            "text": "<p>Join team TRUE in Chandler, Arizona for 3 rounds of casual and competitive tournament style golf with food, drinks, and an abundance of good vibes. The field is limited to the first 60 teams, so secure your spot while they last. The package price is ALL INCLUSIVE and takes care of lodging, food, golf, and more. All you have to worry about? Getting your team together and getting down to Chandler, AZ for an event that will be remembered.<br\/><br\/><\/p>"
          }
        },
        "ec572293-9d60-4373-abdf-0d2839946ac6": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Date:<\/strong> Saturday, May 6th through Monday, May 8th<br\/><strong>Location: <\/strong>Whirlwind Golf Club and Casino in Chandler, Arizona<br\/><strong>Format:<\/strong> 3 Rounds of 2Man Best Ball + 1 Round of Individual Skins<br\/><strong>Cost:<\/strong> $900 - $1,300 per person (airfare not included)<br\/><br\/><strong>What’s Included: <\/strong><br\/><br\/>+ 2 Nights at the Whirlwind Golf Club and Casino<br\/>+ 4 Rounds of golf at Whirlwind Golf Club<br\/>+ Saturday night catered dinner<br\/>+ TRUE swag kit ($200+ in value)<br\/>+ Hosted happy hours<br\/>+ Individual competitions and prizes<br\/>+ Meet and greet with team TRUE<br\/>+ Entry does NOT include mandatory $150 cash entry for skins games<br\/>+ Available for Men & Women<br\/>+ 30 Day Cancellation Notice<br\/><br\/><\/p>"
          }
        },
        "e098995f-f020-40f6-9ea5-6eb53feb6189": {
          "type": "text",
          "disabled": true,
          "settings": {
            "text": "<p>Join team TRUE in beautiful Chandler, Arizona for 3 rounds of casual, tournament style golf with food, drinks, and an abundance of good vibes. The field is limited to the first 60 teams, so secure your spot while they last. The package price is ALL INCLUSIVE and takes care of lodging, food, golf, and more. All you have to worry about? Getting your team together and down to Chandler, AZ for an event you won’t soon forget.<\/p>"
          }
        },
        "73fdf941-0572-4c46-90f6-c0411caba4ae": {
          "type": "button",
          "settings": {
            "button_text": "Register Now",
            "button_url": "https:\/\/www.golfgenius.com\/register?league_id=8955760824840918684",
            "button_style": "primary",
            "button_attr": ""
          }
        },
        "d4392613-fa31-4119-bd55-f06e4672fe26": {
          "type": "text",
          "settings": {
            "text": "<p><br\/><br\/>Questions? Concerns? Reach out to our Tournament Director, Scott Chastain (<a href=\"mailto:scott.chastain@truelinkswear.com\" target=\"_blank\" title=\"mailto:scott.chastain@truelinkswear.com\">scott.chastain@truelinkswear.com<\/a>), with all inquiries and we’ll respond ASAP. See you in Arizona! <\/p>"
          }
        }
      },
