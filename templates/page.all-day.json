    "166421817238f4e120": {
      "type": "heading-with-text",
      "settings": {
        "section_bg_color": "#f9f9f9",
        "section_text_color": "#000000",
        "heading": "All Day Series",
        "text": "<p>The All Day Family was designed for your active lifestyle – from the links to everyday adventures. Built to be our most athletic fit to date, the All Day Series was engineered to keep you comfortable, stable and moving.<\/p>"
      }
    },
    "166422016392649db3": {
      "type": "image-with-content",
      "disabled": true,
      "settings": {
        "color_theme": "white",
        "image": "shopify:\/\/shop_images\/UPDATEDMENS-FS-01-_1.jpg",
        "image_position_desktop": "left",
        "image_position_mobile": "top",
        "heading": "MEN'S FS-01",
        "text": "At first glance the FS-01 appears like just a fresh and well achieved take on a timeless classic - until you slide it on. The out-of-the-bag comfort is reminiscent of your favorite running shoe, while the proprietary rubber cup construction lends you the durability of a workboot.",
        "quote": "",
        "author": "",
        "btn_text": "Shop Now",
        "btn_link": "shopify:\/\/products\/true-future-staples-01"
      }
    },
    "16642216021d6e92de": {
      "type": "image-with-content",
      "disabled": true,
      "settings": {
        "color_theme": "white",
        "image": "shopify:\/\/shop_images\/Womens-Rose-Profile.jpg",
        "image_position_desktop": "right",
        "image_position_mobile": "top",
        "heading": "WOMEN'S FS-01",
        "text": "We can honestly say that this is not only our most comfortable shoe yet, but the durability and style makes this rank as one of our all time favorites. Removing the traditional glues and lasting boards used in sneaker construction, our proprietary system puts our WANDERLUX cushion directly under foot, making this one of the most distinctive, and unforgettable feeling shoes in our history.",
        "quote": "",
        "author": "",
        "btn_text": "Shop Now",
        "btn_link": "shopify:\/\/products\/true-womens-future-staples-01"
      }
    },
