      "blocks": {
        "6b72bea2-5216-4dd4-829b-7fce27e8e133": {
          "type": "heading",
          "settings": {
            "heading": "At Obagi, we believe skin care is about more than “correcting” or even “preventing;” it’s about unleashing your skin’s full potential. We are dedicated to developing scientifically backed, clinical-quality formulations to promote healthy, future-facing skin so you can greet the future with confidence. Innovation is everywhere, the key is to look in the right places. Our philosophy is to meticulously develop transformational products and rigorously test them to ensure every face is cared for, everywhere.",
            "heading_mob": "",
            "heading_font_size": "h5"
          }
        }
      },
