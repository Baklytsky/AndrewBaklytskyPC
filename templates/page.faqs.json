    "704d96f8-7b6f-450c-b7b5-97536e67600e": {
      "type": "accordion",
      "blocks": {
        "52e378d2-987e-4e2b-8949-bc65bb4ab51d": {
          "type": "accordion-item",
          "settings": {
            "title": "WHAT IS YOUR SHIPPING POLICY?",
            "item_content": "<p>Orders may take up to 2 business days to process before shipping.<br/>\t\t\t\t\t\t\t\t\t\t\t\t\t<br/>We offer free standard shipping on U.S. orders over $150 and free express shipping for international orders over $200. </p><p>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<br/>We have the following shipping options available in the U.S.\t<br/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<br/>Standard Shipping - 4 to 6 business days: $8\t\t<br/>\t\t\t\t\t\t\t\t\t\t\t<br/>Expedited Shipping -  3 business days: $19\t<br/>\t\t\t\t\t\t\t\t\t\t\t\t<br/>Overnight Shipping - Order by 1 pm PST. Delivery in 1 to 2 Business Days: $28\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<br/><br/>For orders under $200, international shipping rates vary.</p>"
          }
        },
        "45b3378c-9c02-4d8a-ab78-8602c9069593": {
          "type": "accordion-item",
          "settings": {
            "title": "WHAT IF MY PACKAGE HAS BEEN LOST OR STOLEN?",
            "item_content": "<p>If your order has been marked as delivered, but cannot be located, please contact our Customer Service team via email at <a href=\"mailto:support@khy.com\" title=\"mailto:support@khy.com\">support@khy.com </a>for assistance.</p>"
          }
        },
        "4187a62b-0288-461c-8af6-4bc2313273ef": {
          "type": "accordion-item",
          "settings": {
            "title": "WHERE IS MY ORDER?",
            "item_content": "<p>Once an order is placed, please allow 2-3 business days for the order to be packed and shipped from our warehouse. Upon shipment, you will receive an email with your tracking information so you may track the package online. Please allow up to 7 business days for the package to arrive to you from the day your order is shipped.</p>"
          }
        },
        "a0164042-471e-4aac-9219-d2111afb8c26": {
          "type": "accordion-item",
          "settings": {
            "title": "HOW CAN I TRACK MY ORDER?",
            "item_content": "<p>You can track your order with the tracking link provided in your shipment notification email or by logging in to your account on <a href=\"https://khy.com\" title=\"https://khy.com\">khy.com</a>. <br/><br/>Orders containing multiple items may arrive in multiple shipments with a unique tracking number for each package.</p>"
          }
        },
        "accordion_item_NafH8p": {
          "type": "accordion-item",
          "settings": {
            "title": "WHAT IS ROUTE INSURANCE?",
            "item_content": "<p>Route is a service that offers protection for your Khy order. When you add Route Package Protection at checkout, you can easily file claims for lost, stolen, or damaged packages. Depending on the situation, you may be eligible for a reorder or refund. </p><p>If you encounter a delivery issue with your Route protected package please contact support@khy.com or visit claims.route.com within 30 days to utilize this coverage. ﻿Route does not offer coverage after 30 days of an order delivery date.</p><p>Each time you add Route Package Protection to your order, Route donates to support an agroforestry initiative that removes CO₂ from the air and promotes a flourishing ecosystem.</p><p>Note: If you choose to place your order without Route insurance, Khy is not liable for any lost, stolen, or damaged items during shipping.</p>"
          }
        },
        "accordion_item_W37Ynt": {
          "type": "accordion-item",
          "settings": {
            "title": "WHAT SHOULD I DO IF MY ORDER ARRIVES DAMAGED?",
            "item_content": "<p>If you added Route Protection to your order, please click <a href=\"http://claims.route.com\"><span style=\"text-decoration:underline\">here</span></a> to file a claim. </p><p>If your order was not insured with Route Protection, please email <a href=\"mailto:support@khy.com\"><span style=\"text-decoration:underline\">support@khy.com</span></a> for assistance. </p>"
          }
        },
        "accordion_item_Arqi3p": {
          "type": "accordion-item",
          "settings": {
            "title": "ORDER WAS MARKED AS DELIVERED BUT I DIDN'T RECEIVE IT",
            "item_content": "<p>If you added Route Protection to your order, please click <a href=\"http://claims.route.com\"><span style=\"text-decoration:underline\">here</span></a> to file a claim. </p><p>If your order was not insured with Route Protection, please email <a href=\"mailto:support@khy.com\"><span style=\"text-decoration:underline\">support@khy.com</span></a> for assistance. </p>"
          }
        },
        "accordion_item_3kK6gz": {
          "type": "accordion-item",
          "settings": {
            "title": "WHAT SHOULD I DO IF MY ORDER IS LOST OR STOLEN?",
            "item_content": "<p>If you added Route Protection to your order, please click <a href=\"http://claims.route.com\"><span style=\"text-decoration:underline\">here</span></a> to file a claim. </p><p>If your order was not insured with Route Protection, please email <a href=\"mailto:support@khy.com\"><span style=\"text-decoration:underline\">support@khy.com</span></a> for assistance. </p>"
          }
        },
        "accordion_item_N4BzGT": {
          "type": "accordion-item",
          "settings": {
            "title": "CAN I SHIP TO A PO BOX, APO OR FPO?",
            "item_content": "<p>Please select Standard Shipping when shipping to a PO Box, APO/FPO, U.S. Territory, Alaska, or Hawaii. Delivery times will vary, as these shipments may require additional transit time. </p>"
          }
        }
      },
