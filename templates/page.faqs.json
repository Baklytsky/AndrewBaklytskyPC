    "ed2611c9-2c92-4adc-b53c-0c26ec504bb3": {
      "type": "accordion",
      "blocks": {
        "701ab40a-1d3e-462a-a635-3446c0ebad26": {
          "type": "accordion-item",
          "settings": {
            "title": "DO YOU SHIP INTERNATIONALLY?",
            "item_content": "<p>Yes, international customers can browse and shop our website in their local currency by selecting their country from the dropdown menu located at bottom of site.</p>"
          }
        },
        "28f70edd-70ac-4a06-95bb-cc5a687c3d6b": {
          "type": "accordion-item",
          "settings": {
            "title": "CAN I RETURN AN INTERNATIONAL ORDER?",
            "item_content": "<p>Yes, please visit our international returns portal <a href=\"https://web.global-e.com/Returns/Portal/mZwn \" title=\"https://web.global-e.com/Returns/Portal/mZwn \">here.</a></p>"
          }
        },
        "cd83b02d-78ab-4960-9a1a-1a9fa7770a6f": {
          "type": "accordion-item",
          "settings": {
            "title": "ARE DUTIES AND TAXES INCLUDED?",
            "item_content": "<p>Once you have selected the country that you will be shipping to, all prices will include relevant taxes and duties. There will be no additional charges upon delivery.</p>"
          }
        },
        "8ba1f1c9-84f7-471c-bffc-1852b11fe461": {
          "type": "accordion-item",
          "settings": {
            "title": "CONTACT US",
            "item_content": "<p>Our Customer Service Team is available Monday-Friday from 9 am to 6 pm PST, we are closed on weekends and U.S. federal holidays.\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<br/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<br/>EMAIL: <a href=\"mailto:support@khy.com\" title=\"mailto:support@khy.com\">support@khy.com\t</a>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</p><p>\t\t\t\t\t\t\t\t\t\t\t\tPlease note that refunds can take up to 3-5 business days to appear on your bank account due to varying processing times of financial institutions.</p>"
          }
        }
      },
