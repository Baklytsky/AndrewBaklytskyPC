    "text_blocks_DiKPfX": {
      "type": "text-blocks",
      "blocks": {
        "text_block_iPEANj": {
          "type": "text_block",
          "settings": {
            "heading": "EASIER ON",
            "text": "<p>Complementing the wide toe box fit - OG Cush has a comfort tongue access system accommodating easy entry.<br\/><br\/>→<\/p>",
            "link": "",
            "button_text_1": "",
            "button_link_1": "",
            "button_type_1": "primary",
            "button_text_2": "",
            "button_link_2": "",
            "button_type_2": "primary"
          }
        },
        "text_block_PyzYpe": {
          "type": "text_block",
          "settings": {
            "heading": "COMFIER RIDE",
            "text": "<p>The zero drop platform features an all new Wanderlux foam cushioning marrying comfort & minimalism.<br\/><br\/>→<\/p>",
            "link": "",
            "button_text_1": "",
            "button_link_1": "",
            "button_type_1": "primary",
            "button_text_2": "",
            "button_link_2": "",
            "button_type_2": "primary"
          }
        },
        "text_block_t6xCh3": {
          "type": "text_block",
          "settings": {
            "heading": "WEAR EVERYWHERE",
            "text": "<p>The first OG built to take you beyond the course, our new rubber tread is as versatile as your lifestyle.<br\/><br\/>→<\/p>",
            "link": "",
            "button_text_1": "",
            "button_link_1": "",
            "button_type_1": "primary",
            "button_text_2": "",
            "button_link_2": "",
