    "text_with_button_NmB7Aq": {
      "type": "text-with-button",
      "blocks": {
        "text_4FniwK": {
          "type": "text",
          "settings": {
            "text": "<h5>JOURNEY WITH US TO ZERO DROP PERFECTION<br\/><br\/><\/h5>"
          }
        },
        "text_NyYUX8": {
          "type": "text",
          "settings": {
            "text": "<p>We launched the Original in 2017 and its natural zero drop, wide toe box has been renowned for its distinct approach - still in a class entirely of its own when it comes to modern, natural footwear. With over 200,000 pairs sold worldwide, we've utilized your feedback (along with our TOUR Ambassadors) to develop an even more cushioned, comfortable barefoot walking experience. <br\/><strong><br\/>Meet the OG Cush.<\/strong><\/p>"
          }
        }
      },
      "block_order": [
        "text_4FniwK",
        "text_NyYUX8"
      ],
      "settings": {
        "bg_color": "#f9f9f9",
        "text_color": ""
      }
