{%- form 'contact', id: 'contact-us-page', class: 'contact-form__form',  data-form-name: "Contact us" -%}
  <input type="hidden" name="form_type" value="contact">
  <input type="hidden" name="utf8" value="✓">
  {% for block in blocks %}
    {%- assign values = block.settings.values | split: ','  | uniq -%}
    {%- assign required = '' -%}

    {%- if block.settings.required -%}
      {%- assign required = 'required' -%}
    {%- endif -%}

    {% case block.type %}

    {% when 'form_type' %}
      <input type="hidden" name="contact[form-type]" value="{{ block.settings.title }}">

    {% when 'email' %}
      <div class="custom-form__block form-field" {{ block.shopify_attributes }}>
        <label for="Form-{{ section.id }}-{{ forloop.index0 }}" class="form-label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ block.settings.title }}</label>
        <input type="email"  class="form-input" id="Form-{{ section.id }}-{{ forloop.index0 }}" name="contact[email]" placeholder="{{ block.settings.title }}" autocorrect="off" autocapitalize="off" required />
      </div>

    {% when 'text' %}
      <div class="custom-form__block form-field" {{ block.shopify_attributes }}>
        <label for="Form-{{ section.id }}-{{ forloop.index0 }}" class="form-label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ block.settings.title }}</label>
        <input type="text" class="form-input" id="Form-{{ section.id }}-{{ forloop.index0 }}" name="contact[{{ block.settings.title | handleize | default: 'text' }}]" placeholder="{{ block.settings.title }}" autocapitalize="words" value="" {{ required }}/>
      </div>

    {% when 'textarea' %}
      <div class="custom-form__block form-field" {{ block.shopify_attributes }}>
        <label for="Form-{{ section.id }}-{{ forloop.index0 }}" class="form-label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ block.settings.title }}</label>
        <textarea rows="7" class="form-textarea" id="Form-{{ section.id }}-{{ forloop.index0 }}" class="contactFormMessage" name="contact[{{ block.settings.title | handleize | default: 'textarea' }}]" placeholder="{{ block.settings.title }}" {{ required }}></textarea>
      </div>

    {% when 'phone' %}
      <div class="custom-form__block form-field" {{ block.shopify_attributes }}>
        <label for="Form-{{ section.id }}-{{ forloop.index0 }}" class="form-label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ block.settings.title }}</label>
        <input type="tel"
               id="Form-{{ section.id }}-{{ forloop.index0 }}"
               class="form-input"
               title="999-999-9999"
               pattern="(?:\d[\s\-\.()xX]*){9,15}"
               name="contact[telephone]"
               placeholder="{{ block.settings.title }}"
               value=""
          {{ required }}/>
      </div>

    {% when 'name' %}
      <div class="custom-form__block form-field" {{ block.shopify_attributes }}>
        <label  for="Form-{{ section.id }}-{{ forloop.index0 }}" class="label--hidden">{{ block.settings.title }}</label>
        <input type="text" class="contactFormText" id="Form-{{ section.id }}-{{ forloop.index0 }}" name="contact[{{ block.settings.title | handleize | default: 'name' }}]" placeholder="{{ block.settings.title }}" autocapitalize="words" value="" {{ required }}/>
      </div>

    {% when 'radio' %}
      {%- if values.size > 0 -%}
        {%- assign index = forloop.index0 -%}

        <fieldset class="custom-form__block form-field--group form-field" {{ block.shopify_attributes }}>
          {% if block.settings.title != blank %}
            <legend class="form-label custom-form__label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ block.settings.title }}</legend>
          {% endif %}

          {%- for value in values -%}
            <div class="form-field--group-item">
              <input type="radio" id="Form-{{ section.id }}-{{ index }}-{{ forloop.index0 }}" class="form__radio visually-hidden" name="contact[{{ block.settings.title | handleize | default: 'radio' }}]" {% if forloop.first %}checked{% endif %} value="{{ value }}" {{ required }}>
              <label for="Form-{{ section.id }}-{{ index }}-{{ forloop.index0 }}">{{ value }}</label>
            </div>
          {%- endfor -%}
        </fieldset>
      {%- endif -%}
    {% when 'select' %}
      {%- if values.size > 0 -%}
        <fieldset class="custom-form__block form-field" {{ block.shopify_attributes }}>
          <div class="small-up-hide">
            {% if block.settings.title != blank %}
              <label for="Form-{{ section.id }}-{{ forloop.index0 }}" class="form-label custom-form__label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ block.settings.title }}</label>
            {% endif %}
            <select id="Form-{{ section.id }}-{{ forloop.index0 }}" class="form__select {% if required != blank %}form__select--required{% endif %}" {{ required }} name="contact[{{ block.settings.title | handleize | default: 'select' }}]" data-original-select>
              <option value="" disabled selected>{{ block.settings.title }}</option>
              {%- for value in values -%}
                <option value="{{ value }}">{{ value }}</option>
              {%- endfor -%}
            </select>
          </div>

          <div class="small-hide">
            {% if block.settings.title != blank %}
              <label for="Form-{{ section.id }}-{{ forloop.index0 }}-custom" class="form-label custom-form__label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ block.settings.title }}</label>
            {% endif %}

            <custom-select class="form-select body3 form-select-alternative">
              <button type="button" class="btn--reset form-select__btn" tabindex="0" aria-expanded="false" aria-controls="dropdown-day-{{ section.id }}-{{ forloop.index }}">
                <span class="form-select__btn-text">{{ block.settings.title }}</span>

                {%- render 'icon' with 'arrow-down' -%}
              </button>

              <ul class="form-select__dropdown hide-scrollbar" id="dropdown-day-{{ section.id }}-{{ forloop.index }}" style="display: none;">
                {%- for value in values -%}
                  <li class="form-select__dropdown-option a" aria-selected="false"  data-option-value="{{ value }}">
                    <button type="button" class="btn--reset form-select__dropdown-button body3">{{ value }}</button>
                  </li>
                {%- endfor -%}
              </ul>

              <input name="contact[{{ block.settings.title | handleize | default: 'select' }}]" data-custom-select-input id="Form-{{ section.id }}-{{ forloop.index0 }}-custom" type="hidden" class="form__input-hidden {% if required != blank %}form__select--required{% endif %}" value="" {{ required }}>
            </custom-select>

          </div>
        </fieldset>
      {%- endif -%}


    {% when 'checkbox' %}
      <div class="custom-form__block form-field form-field__checkbox" {{ block.shopify_attributes }}>
        {{ form.set_as_default_checkbox | replace: '<input', '<input class="form__checkbox"' }}
        <input type="checkbox" id="Form-{{ section.id }}-{{ forloop.index0 }}" class="form__checkbox" name="contact[{{ block.settings.title | handleize | default: 'radio' }}]" {% if block.settings.checked %}checked{% endif %} {{ required }}>
        <label for="Form-{{ section.id }}-{{ forloop.index0 }}" class="form-label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ block.settings.text | default: block.settings.title }}</label>
      </div>

    {% when 'province_select' %}
      <div class="custom-form__block form-field small-up-hide">
        <label for="address-province-new" class="form-label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ block.settings.title | default: 'Province' }}</label>

        <select class="account__addresses-select province form__select"
                id="address-province-new"
                name="contact[{{ block.settings.title | handleize | default: 'Province' }}]"
                data-original-select
                data-default=""
                autocomplete="address-level1"
                {{ required }}>
        </select>
      </div>

      <div class="custom-form__block form-field small-hide hidden" id="address-form-custom-province-new">
        <label for="address-province-new-custom" class="form-label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ block.settings.title | default: 'Province' }}</label>

        <custom-select class="form-select body3 form-select-alternative small-hide">
          <button type="button" class="btn--reset form-select__btn" tabindex="0" aria-expanded="false" aria-controls="dropdown-province-{{ section.id }}">
            <span class="form-select__btn-text">{{ block.settings.title | default: 'Province' }}</span>
            <span class="form-select__dropdown-option--label"></span>
            {%- render 'icon' with 'arrow-down' -%}
          </button>
          <ul class="form-select__dropdown hide-scrollbar" id="dropdown-province-{{ section.id }}" style="display: none;">

          </ul>
          <input name="contact[{{ block.settings.title | handleize | default: 'Province' }}]"
                 id="address-province-custom-new"
                 type="hidden"
                 class="address-form__hidden-input form__input-hidden"
                 value=""
                 data-default=""
                 data-custom-select-input>
        </custom-select>
      </div>

    {% when 'country_select' %}
      <div class="custom-form__block form-field small-up-hide">
        <label for="address-country-new" class="form-label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ block.settings.title | default: 'Country' }}</label>
        <select id="address-country-new"
                class="country form__select"
                name="contact[{{ block.settings.title | handleize | default: 'Country' }}]"
                data-original-select
                data-address-country-select
                data-default=""
                data-form-id="{{ section.id }}"
                autocomplete="country">
          {{ all_country_option_tags | remove: '<option value="---" data-provinces="[]">---</option>' }}
        </select>
      </div>

      <div class="custom-form__block form-field small-hide">
        <label for="address-province-custom-new" class="form-label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ block.settings.text | default: block.settings.title }}</label>

        <custom-select class="form-select body3 form-select-alternative address-custom-select">
          <button type="button" class="btn--reset form-select__btn" tabindex="0" aria-expanded="false" aria-selected="true" aria-controls="dropdown-country-{{ section.id }}">
            <span class="form-select__btn-text">United States</span>
            <span class="form-select__dropdown-option--label"></span>
            {%- render 'icon' with 'arrow-down' -%}
          </button>
          <ul class="form-select__dropdown hide-scrollbar" id="dropdown-country-{{ section.id }}" style="display: none;">
            {{ all_country_option_tags | remove: '<option value="---" data-provinces="[]">---</option>' | replace: '<option', '<li class="form-select__dropdown-option a" aria-selected="false">
                  <button type="button" class="btn--reset form-select__dropdown-button body3"' | replace: 'value', 'data-option-value' | replace: '</option>', '</button></li>' }}
          </ul>
          <input name="contact[{{ block.settings.title | handleize | default: 'Country' }}]"
                 id="address-province-custom-new"
                 type="hidden"
                 class="form__input-hidden address-form__country-input"
                 data-select-province="#address-form-custom-province-new"
                 value="United States"
                 data-default="United States"
                 data-custom-select-input
                 {{ required }}>
        </custom-select>
      </div>
    {% endcase %}
  {% endfor %}

  <div class="form-field form-field__submit">
    <input type="submit" class="btn btn--primary-alt" value="{{ 'templates.contact.form.send' | t }}">
  </div>

  {%- if form.errors -%}
    <p class="body3 form-error">
      {{ form.errors | default_errors }}
    </p>

    <script>
      window.dataLayer.push({
      'event': 'form_error',
        'form': {
        'form_name': 'Contact us',
          'form_validation_errors': '',
          'error_message': ''
        }
      });
    </script>
  {%- endif -%}

  {% if form.posted_successfully? %}
    <script>
      window.dataLayer.push({
      'event': 'form_complete',
        'form': {
          'form_name': 'Contact us',
        }
      })
    </script>
    <p class="body3 form-success">
      {%- if success_message != blank -%}
        {{ success_message }}
      {%- else -%}
        {{ 'templates.contact.form.post_success' | t }}
      {%- endif -%}
    </p>
  {% endif %}

  {% if error_message != blank %}
    <div class="body3 form-error form-klaviyo__error hide">
      {{ error_message }}
    </div>
  {% endif %}

  {% if success_message != blank %}
    <div class="body3 form-success form-klaviyo__success hide">
      {{ success_message }}
    </div>
  {% endif %}

  {% if is_subscribed != blank %}
    <div class="body3 form-success form-klaviyo__is-subscribed hide">
      {{ is_subscribed }}
    </div>
  {% endif %}

  <p class="body3 form-error form-error--email hide">{{ "form_errors.email" | t }}</p>

  <div class="form-field form-field__required-label">
    <span class="body3 form-label">{{ 'templates.contact.form.required' | t }}</span>
  </div>
  {%- if bottom_text != blank -%}
    <p class="body3 form-label contact-form__bottom-text">{{ bottom_text }}</p>
  {%- endif -%}
{% endform %}
