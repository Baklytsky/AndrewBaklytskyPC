
{% comment %}
    Player Controls
    Only Works for Vimeo
{% endcomment %}

    {% liquid
    assign has_desktop_video = false
    assign has_mobile_video = false
    assign video_controls_mobile = block.settings.video_controls_mobile
    assign video_controls_desktop = block.settings.video_controls_desktop

    assign video_embed_mobile = block.settings.background_video_embed_mobile
    assign video_embed_desktop = block.settings.background_video_embed_desktop
    assign video_file_mobile = block.settings.background_video_file_mobile
    assign video_file_desktop = block.settings.background_video_file_desktop

    if video_embed_mobile != blank or video_file_mobile != blank
        assign has_mobile_video = true

       if video_embed_mobile != blank
         case video_embed_mobile.type
          when 'youtube'
            assign mobile_video_type = "youtube"
          when 'vimeo'
            assign mobile_video_type = "vimeo"
         endcase
      endif

      if video_file_mobile != blank
        assign mobile_video_type = "default"
      endif
    endif

    if video_embed_desktop != blank or video_file_desktop != blank
        assign has_desktop_video = true

        if video_embed_desktop != blank
          case video_embed_desktop.type
            when 'youtube'
              assign desktop_video_type = "youtube"
            when 'vimeo'
              assign desktop_video_type = "vimeo"
          endcase
        endif

        if video_file_desktop != blank
          assign desktop_video_type = "default"
        endif
    endif
    %}

{% if has_desktop_video == true or has_mobile_video == true %}
    <div class="ra-hero__player-controls
    {% if has_mobile_video == false %}
        hidden
    {% else%}
        flex
    {% endif %}
    {% if has_desktop_video == true %}
        md:flex
    {% endif %}
    h-[43px] w-auto flex-row gap-[10px]">

        {% comment %}
          Desktop Controls
        {% endcomment %}

      {%- if video_controls_desktop -%}
        <div class="ra-hero__player-button ra-hero__player-control-video h-full w-[43px] !hidden md:!flex"
             active="false" block-id="{{ block.id }}"
             view="desktop"
             data-type="{{ desktop_video_type }}">
