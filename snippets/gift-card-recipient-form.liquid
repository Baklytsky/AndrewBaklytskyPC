{% comment %}
  Renders gift card recipient form.
  Accepts:
  - product: {Object} product object.
  - form: {Object} the product form object.
  - product_form_id: {String} the product form id.
  - id: {String} section id
  - block: {Object} block object.

  Usage:
{%- render 'gift-card-recipient-form',
  product: product,
  form: form,
  product_form_id: product_form_id,
  id: section.id,
  block: block -%}
{% endcomment %}

{%- liquid
  assign show_recipient_name = block.settings.show_recipient_name
  assign show_message_to_recipient = block.settings.show_message_to_recipient
  assign show_recipient_send_on_date = block.settings.show_recipient_send_on_date
-%}

<div class="customer">
  {%- assign gift_card_recipient_control_flag = 'items[0][properties][__shopify_send_gift_card_to_recipient]' -%}
  <script src="{{ 'recipient-form.js' | asset_url }}" defer="defer"></script>

  <recipient-form class="recipient-form" data-section-id="{{ id }}">
    <details data-accordion-opener data-keep-open class="product-recipient">
      <summary type="button" class="product-recipient__btn" aria-expanded="false" role="button">
        <span class="product-recipient__title">{{ 'recipient.form.checkbox' | t }}</span>
        <span class="product-recipient__checkbox"></span>
      </summary>

      <div class="product-recipient__inner" data-accordion-content>
        <input id="Recipient-checkbox-{{ id }}"
               type="hidden"
               value="on"
               name="{{ gift_card_recipient_control_flag }}"
               form="{{ product_form_id }}" data-recipient-element disabled>

        <input type="hidden"
               name="items[0][properties][__shopify_offset]"
               value=""
               id="Recipient-timezone-offset-{{ id }}"
               form="{{ product_form_id }}" data-recipient-element disabled>

        <div class="form__item">
          <input  class="form__input"
                  id="Recipient-email-{{ id }}"
                  type="email"
                  placeholder="{{ 'recipient.form.email' | t }}"
                  name="items[0][properties][Recipient email]"
                  value="{{ form.email }}"
                  required
                  form="{{ product_form_id }}" data-recipient-element disabled>
          <label for="Recipient-email-{{ id }}">{{ 'recipient.form.email' | t }}</label>
        </div>

        {%- if show_recipient_name -%}
          <div class="form__item">
            <input  class="form__input"
                    id="Recipient-name-{{ id }}"
                    type="text"
                    placeholder="{{ 'recipient.form.name' | t }}"
                    name="items[0][properties][Recipient name]"
                    value="{{ form.name }}"
                    required
                    form="{{ product_form_id }}" data-recipient-element disabled>
            <label for="Recipient-name-{{ id }}">{{- 'recipient.form.name_label' | t -}}</label>
          </div>
        {%- endif -%}

        {%- if show_message_to_recipient -%}
          <div class="form__item">
            <textarea rows="3"
                      cols="30"
                      id="Recipient-message-{{ id }}"
                      class="form__textarea"
                      name="items[0][properties][Message]"
                      maxlength="200"
                      placeholder="{{ 'recipient.form.message' | t }}"
                      aria-label="{{ 'recipient.form.max_characters' | t: max_chars: 200 }} {{ 'recipient.form.message_label' | t  }}"
                      form="{{ product_form_id }}"
                      data-recipient-element disabled>{{- form.message -}}</textarea>
            <label for="Recipient-message-{{ id }}">{{ 'recipient.form.message' | t }}</label>
          </div>
        {%- endif -%}

        {%- if show_recipient_send_on_date -%}
          <div class="form__item">
            <input class="form__input"
                   autocomplete="send_on"
                   type="date"
                   id="Recipient-send-on-{{ id }}"
                   name="items[0][properties][Send on]"
                   placeholder="{{ 'recipient.form.send_on' | t }}"
                   pattern="\d{4}-\d{2}-\d{2}"
                   value="{{ form.send_on }}"
                   min="{{ 'now' | date: '%Y-%m-%d' }}"
                   required
                   form="{{ product_form_id }}" data-recipient-element disabled>
            <label for="Recipient-send-on-{{ id }}">{{ 'recipient.form.send_on' | t }}</label>
          </div>
        {%- endif -%}
      </div>
    </details>

    <style>
      [data-section-id="{{ id }}"] input[type="date"]::-webkit-datetime-edit-day-field,
      [data-section-id="{{ id }}"] input[type="date"]::-webkit-datetime-edit-month-field,
      [data-section-id="{{ id }}"] input[type="date"]::-webkit-datetime-edit-year-field {
        opacity: var(--field-opacity, 0.3);
      }

      [data-section-id="{{ id }}"] input[type="date"].has-value {
        --field-opacity: 1;
      }
    </style>
  </recipient-form>
</div>