{% comment %}
  Accepts:
  - return_to: {String} After login return link (optional)
  - login_heading: {String} Heading (optional)
  - login_text: {String} Login form prof text (optional)

  Usage:
{%- render 'customer-login-form', return_to: link, login_text: text-%}
{% endcomment %}

{%- liquid
  unless return_to
    assign return_to = routes.account_url
  endunless
-%}

<customer-form class="customer-login">
  {%- form 'customer_login', return_to: return_to, data-form-name: "Customer login" -%}
    <h1 class="h4 login-form__heading" tabindex="-1">
      {%- if login_heading != blank -%}
        {{ login_heading }}
      {%- else -%}
        {{ 'customer.login_page.sign_in' | t }}
      {%- endif -%}
    </h1>

    <div class="form-field">
      <input
        type="email"
        name="customer[email]"
        id="CustomerEmail"
        autocomplete="email"
        autocorrect="off"
        autocapitalize="off"
        {% if form.errors contains 'form' %}
          aria-invalid="true"
        {% endif %}
        placeholder="{{ 'customer.login_page.username' | t }}"
        class="form-input"
        required
      >
      <label for="CustomerEmail" class="visually-hidden">
        {{ 'customer.login_page.username' | t }}
      </label>
    </div>

    {%- if form.password_needed -%}
      <div class="form-field">
        <input
          type="password"
          value=""
          name="customer[password]"
          id="CustomerPassword"
          autocomplete="current-password"
          {% if form.errors contains 'form' %}
            aria-invalid="true"
          {% endif %}
          placeholder="{{ 'customer.login_page.password' | t }}"
          class="form-input"
          required
        >
        <label for="CustomerPassword" class="visually-hidden">
          {{ 'customer.login_page.password' | t }}
        </label>
      </div>
    {%- endif -%}

    <button type="submit" class="btn btn--primary-alt customer-login__submit">
      {{ 'customer.login_page.sign_in' | t }}
    </button>

    <div class="customer-errors">
      <p class="body3 form-error form-error--email hide">{{ "form_errors.email" | t }}</p>
      <p class="body3 form-error form-error--password-length hide">{{ "form_errors.password_length" | t }}</p>

      {%- if form.errors -%}
        <div class="body3 form-error login-form-error">
          {{ form.errors | default_errors }}
        </div>

        <script>
          window.dataLayer.push({
            'event': 'user_entry_error'
          })

          window.dataLayer.push({
            'event': 'form_error',
            'form': {
              'form_name': 'Customer login',
              'form_validation_errors': 'Email, Password',
              'error_message': 'Incorrect email or password.'
            }
          });
        </script>
      {%- endif -%}
    </div>

    {%- if recover_success == true -%}
      <div class="body3 form-success" tabindex="-1" autofocus>
        {{ 'customer.recover_password.success' | t }}
      </div>
    {%- endif -%}

    <a href="#recover" class="login-form__recover-link">
      {{ 'customer.login_page.forgot_password' | t }}
    </a>

    {%- if login_text != blank -%}
      <div class="login-form__prof-text">
        {{ login_text }}
      </div>
    {% endif %}
  {%- endform -%}
</customer-form>

