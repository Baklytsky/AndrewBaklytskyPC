{%- if customer.orders_count > 0 -%}
  <ul class="account-orders__list">
    {% paginate customer.orders by 5 %}
      {%- for order in customer.orders -%}
        {%- if settings.enable_premier_points -%}

          {%- for line_item in order.line_items -%}
            {%- liquid

              if line_item.fulfillment
                assign tracking_url = line_item.fulfillment.tracking_url
                assign tracking_number = line_item.fulfillment.tracking_number
              endif
            -%}

          {%- endfor -%}
        {%- endif -%}

        <li class="account-orders__item">
          <accordion-element class="accordion">
            <div class="accordion__item">
              <div role="button" aria-expanded="false" class="btn--reset accordion__button"
                   aria-controls="content-{{ forloop.index }}-{{ section.id }}"
                   id="accordion-button-{{ forloop.index }}-{{ section.id }}">
                <div class="account-orders__item-info">
                  <p class="h6 account-orders__date">{{ order.created_at | date: '%B %e, %Y' }}</p>
                  <h4 class="h5">{{ 'customer.orders.order_number' | t: number: order.order_number }}</h4>
                </div>

                <span class="accordion__icons block a">
                  {% render 'icon' with 'plus-small' %}
                  {% render 'icon' with 'minus-small' %}
              </span>
              </div>

              {%- if order.cancelled -%}
                <p class="body3 account-orders__status">
                  <span>{{ 'customer.order.cancelled' | t }}</span>
                  <span>{{ order.cancelled_at |  date: '%m/%d' }}</span>
                </p>
              {%- else -%}
                <p class="body3">
                  {% if order.fulfillment_status == 'complete' or order.fulfillment_status == ' fulfilled' %}
                    {{- 'customer.order.order_complete' | t -}}

                    {%- if tracking_number != blank and tracking_url != blank -%}
                      : <a href="{{ tracking_url }}" target="_blank" class="account-orders__item-tracking-number">{{ tracking_number }}</a>
                    {%- endif -%}
                  {% elsif  order.fulfillment_status == 'partial' or order.fulfillment_status == 'unfulfilled' %}
                    {{- 'customer.order.order_processing' | t -}}
                  {%- else -%}
                    {{ order.fulfillment_status_label }}
                  {% endif %}
                </p>
              {%- endif -%}

              {%- if order.financial_status == 'refunded' or order.financial_status == 'voided' or order.financial_status == 'partially_refunded' -%}
                <p class="body3 account-orders__status">
                  <span>{{ order.financial_status_label }}</span>
                  <span>{{ order.total_refunded_amount | money }}</span>
                </p>
              {% endif %}


              <div id="content-{{ forloop.index }}-{{ section.id }}"
                   aria-labelledby="accordion-button-{{ forloop.index }}-{{ section.id }}"
                   class="account-orders__item-content"
                   style="display: none">

                <div class="account__order-inner">
                  {%- liquid
                    assign total_premier_points = 0 -%}
                  {%- for line_item in order.line_items -%}
                    {%- liquid
                      assign pre_order = false
                      assign pre_order_date = line_item.variant.metafields.custom.pre_order_date | date: "%m/%d"
                      assign pre_order_date_in_sec = current_variant.metafields.custom.pre_order_date | date: "%s" | plus: 0
                      assign now_date = 'now' | date: "%m/%d"
                      assign now_date_in_sec = 'now' | date: "%s" | plus: 0
                      assign current_variant = line_item.variant
                      assign line_item_product = all_products[line_item.product.handle]
                      if pre_order_date != blank and pre_order_date_in_sec > now_date_in_sec
                        assign pre_order = true
                      endif

                      assign discountsAmmount = 0
                      for discount_allocation in line_item.discount_allocations
                        assign discountsAmmount = discountsAmmount | plus: discount_allocation.amount
                      endfor

                      assign line_item_unit_discount = discountsAmmount | divided_by: line_item.quantity

                      assign line_item_unit_final_price = line_item.original_price | minus: line_item_unit_discount | money_without_currency | round
                      assign line_item_line_round_price = line_item_unit_final_price | times: line_item.quantity

                      assign current_variant_price = line_item.original_line_price | minus: discountsAmmount | money_without_currency
                      assign line_points_value = line_item_line_round_price | times: settings.points_coefficient
                      assign total_premier_points = total_premier_points | plus: line_points_value
                      assign final_line_price = line_item.original_line_price | minus: discountsAmmount

                      assign not_allowed_product = false

                      for tag in line_item_product.tags
                        if tag contains "not-allowed"
                          assign not_allowed_product = true
                          break
                        endif
                      endfor
                    -%}

                    {%- if pre_order != blank -%}
                      <div class="account-orders__product-preorder body3">{{ 'customer.order.preorder_ship' | t: date: pre_order_date }}</div>
                    {%- endif -%}

                    <div class="account-orders__product">
                      {%- if line_item.image != blank -%}
                        <div class="account-orders__product-image">
                          <div class="image-abs-wrapper">
                            {%- render 'image', image: line_item.image, class_name: 'image-abs-cover', small_size: true -%}

                            {%- if line_item_product != blank and not_allowed_product == false -%}
                              <a href="{{ line_item.url }}" class="image-abs-cover"><span class="visually-hidden">{{ line_item.title }}</span></a>
                            {%- endif -%}
                          </div>
                        </div>
                      {%- endif -%}

                      <div class="account-order__product-info">
                        <div class="account-order__product-title">
                          <div>
                            <div class="account-order__product-collections">
                              {%- render 'product-featured-collections', product: line_item.product, class: 'body4' -%}
                            </div>

                            <a href="{{ line_item.url }}" class="body3 body3--bold  {% if line_item_product == blank or not_allowed_product %}link-disabled{% endif %}">
                              {{ line_item.product.title }}
                            </a>
                          </div>

                          {% if line_item_product != blank and current_variant.available and not_allowed_product == false %}
                            <product-form class="order-product-form">
                              {%- form 'product', line_item.product, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                                {%- liquid
                                  assign pre_order = false
                                  assign pre_order_date = current_variant.metafields.custom.pre_order_date | date: "%B %d, %Y"
                                  assign now_date = 'now' | date: "%B %d, %Y"

                                  if pre_order_date != blank and pre_order_date > now_date
                                    assign pre_order = true
                                  endif
                                -%}
                                <input type="hidden" name="id" value="{{ current_variant.id }}">
                                <input type="hidden" name="quantity" value="{{ line_item.quantity }}">
                                {%- if line_item.selling_plan_allocation -%}
                                  <input type="hidden" name="selling_plan" value="{{ line_item.selling_plan_allocation.selling_plan }}">
                                {%- endif -%}

                                {%- if pre_order -%}
                                  <input type="hidden" class="pre-order--{{ current_variant.id }}" name="properties[Pre-Order]" value="{{ pre_order_date }}">
                                {%- endif -%}
                                <button type="submit" name="add" class="btn--reset a account-order__product-buy">
                                  {{ 'customer.order.buy_it_again' | t }}
                                </button>
                                <div class="product-form__error-message-wrapper" role="alert" hidden data-error-wrapper>
                                  <span class="product-form__error-message form-error" data-error-message></span>
                                </div>
                              {%- endform -%}

                              <script type="application/json"
                                      class="current-variant-json">
                                {{ current_variant | json }}
                              </script>
                              <script type="application/ld+json"
                                      class="current-variant-state">
                                {
                                  "preorder": {{ pre_order | default: false }}
                                }
                              </script>
                            </product-form>
                          {%- endif -%}
                        </div>

                        {%- unless line_item.product.has_only_default_variant -%}
                          <div class="account-order__product-variant body3">{{ line_item.variant.title }}</div>
                        {%- endunless -%}

                        {%- if line_item.selling_plan_allocation -%}
                          <div class="account-order__product-variant body3">{{ line_item.selling_plan_allocation.selling_plan.name }}</div>
                        {%- endif -%}
                        <div class="account-order__product-info-footer">
                          <div class="account-order__product-info-points">
                            <div class="account-order__product-quantity body3">{{ 'customer.order.quantity' | t }} {{ line_item.quantity }}</div>

                            {%- if line_points_value > 0 and settings.enable_premier_points -%}
                              <div class="body3 body3--bold account-order__product-points points--{{ section.id }} body3--bold">
                                {{ 'customer.order.premier_points' | t: premier_points: line_points_value }}
                              </div>
                            {%- endif -%}
                          </div>

                          <div class="account-order__product-price">
                            {%- if line_item.final_line_price == 0 -%}
                              <span class="price__regular">{{ 'customer.order.product_free' | t }}</span>
                            {%- else -%}
                              {%- if final_line_price != line_item.original_line_price -%}
                                <s class="price__sale">{{ line_item.original_line_price | money }}</s>
                              {%- endif -%}
                              <span class="price__regular">{{ final_line_price | money }}</span>
                            {%- endif -%}
                          </div>
                        </div>
                      </div>
                    </div>
                  {%- endfor -%}

                  <div class="account-order__summary">
                    {% liquid
                      assign order_subtotal_price = order.subtotal_price | money_without_currency | round
                      assign order_points_value = order_subtotal_price | times: settings.points_coefficient
                    %}

                    {%- if total_premier_points > 0 and settings.premier_points_enabled -%}
                      <div class="body3 body3--bold account-order__summary-points points--{{ section.id }} body3--bold">
                        {{ 'customer.order.premier_points' | t: premier_points: total_premier_points }}
                      </div>
                    {%- endif -%}
                    <ul class="account-order__values body3">
                      <li class="account-order__values-item">
                        <span>{{ 'customer.order.subtotal' | t }}</span>
                        <span>{{ order.subtotal_price | money }}</span>
                      </li>
                      {%- if order.total_discounts != 0 -%}
                        <li class="account-order__values-item discount">
                          <span>{{ 'customer.order.discount' | t }}</span>
                          <span>-{{ order.total_discounts | money }}</span>
                        </li>
                      {%- endif -%}

                      <li class="account-order__values-item">
                        <span>{{ 'customer.order.tax' | t }}</span>
                        <span>{{ order.tax_price | money }}</span>
                      </li>

                      <li class="account-order__values-item">
                        <span>{{ 'customer.order.shipping' | t }}</span>
                        {%- if order.shipping_price == 0 -%}
                          <span>{{ 'customer.order.shipping_free' | t }}</span>
                        {%- else -%}
                          <span>{{ order.shipping_price | money }}</span>
                        {%- endif -%}
                      </li>

                      <li class="account-order__values-item">
                        <span>{{ 'customer.order.total' | t }}</span>
                        <span>{{ order.total_price | money }}</span>
                      </li>
                    </ul>
                  </div>

                  <div class="account-order__address">
                    <div class="h6">{{ 'customer.order.shipping_address' | t }}</div>
                    <div class="body3 account-order__address-inner">
                      {{ order.shipping_address | format_address }}
                    </div>
                  </div>
                </div>

              </div>
            </div>
          </accordion-element>
        </li>
      {% endfor %}

      {%- if paginate.pages > 1 -%}
        {%- if paginate.parts.size > 0 -%}
          {%- liquid
            assign current_page_from = paginate.current_offset | plus: 1
            assign current_page_to = paginate.current_offset | plus: paginate.page_size
          -%}
          <div class="pagination pagination-orders body3" aria-label="{{ 'general.pagination.label' | t }}">
            <div class="pagination__info">{{ current_page_from }}–{{ current_page_to }} {{ 'customer.order.paginate_orders' | t: orders_size: paginate.items }}</div>

            <div class="pagination__buttons">
              <a href="{{ paginate.previous.url }}" data-id="{{ section.id }}"  class="pagination__button pagination__button-prev clickable-icon js-orders-pagination-button" aria-label="{{ 'general.pagination.previous' | t }}" {%- unless paginate.previous -%}disabled{% endunless %}>
                {% render 'icon' with 'arrow-left-large' %}
              </a>

              <a href="{{ paginate.next.url }}" data-id="{{ section.id }}" class="pagination__button pagination__button-next clickable-icon js-orders-pagination-button" aria-label="{{ 'general.pagination.next' | t }}" {%- unless paginate.next -%}disabled{% endunless %}>
                {% render 'icon' with 'arrow-right-large' %}
              </a>
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </ul>
{%- else -%}
  <div class="h4 account-orders__empty text-body-base">
    {{ 'customer.orders.none' | t }}
  </div>
{%- endif -%}
