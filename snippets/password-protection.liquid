<div class="py-[200px] px-[24px] w-full min-h-[100vh] relative flex flex-col justify-center loading" data-ra-pass-wrapper>
  {%- liquid
    assign bg_image = settings.password_bg_image
    assign bg_image_mobile = settings.password_bg_image_mobile
    assign overlay_opacity = settings.password_image_overlay | divided_by: 100.00
    assign color = settings.password_color
    assign title = settings.password_title
    assign title_level = settings.password_title_level
    assign title_style = settings.password_title_style
    assign description = settings.password_description
    assign placeholder = settings.password_placeholder
    assign button_label = settings.password_button_label
    assign error_message = settings.password_error_message
    assign custom_liquid = settings.password_custom_liquid
  -%}
    <div class="pass-image-overlay image-abs-cover bg-[#000000] z-[1]"></div>

  {%- if bg_image or bg_image_mobile -%}
    {%- assign desk_image_class = "image-abs-cover z-[-1] pass-bg-image" -%}

    {%- if bg_image_mobile -%}
      {%- assign desk_image_class = "image-abs-cover z-[-1] pass-bg-image hidden md:block" -%}
      <img src="{{ bg_image_mobile | image_url }}"
           class="image-abs-cover z-[-1] md:hidden pass-bg-image"
           alt="{{ bg_image_mobile.alt | default: title }}">
    {%- endif -%}

    <img src="{{ bg_image | image_url }}"
         class="{{ desk_image_class }}"
         alt="{{ bg_image.alt | default: title }}">
  {%- endif -%}

  <ra-pass-block
    class="block max-w-[500px] mx-auto relative z-[2]"
    {% if template.name == 'collection' %}data-ra-collection="{{ collection.handle }}"{% endif %}>

    <div class="khySpinner mx-auto"></div>

    <form class="flex flex-col gap-[10px]">

    {%- if title != blank -%}
    <{{ title_level }}
      class="ra-title ra-hero__title text-center {{ title_style }}"
      style="{{ heading_styles }}">
      {{ title | newline_to_br }}
    </{{ title_level }}>
    {%- endif -%}

    {%- if description != blank -%}
      <div class="pass-description rte text-center">{{ description }}</div>
    {%- endif -%}

    <div class="pass-form flex flex-col align-middle gap-[10px] my-[20px] md:flex-row">
      <label for="pass" class="w-full relative">
        <input type="password"
               id="ra-pass"
               name="pass"
               placeholder="{{ placeholder }}"
               min="3"
               required
               class="text-center md:text-left" />
        <span class="pass-toggle">Show</span>
      </label>
      <button class="btn btn-lg btn-primary btn-block max-w-[100%] md:max-w-[140px]">{{ button_label }}</button>
    </div>

    <div class="message-block hidden text-center">{{ error_message }}</div>

    {%- if custom_liquid != blnk -%}
      <div class="pass-custom-liquid">
        {{ custom_liquid }}
      </div>
    {%- endif -%}

    </form>

    <script type="application/json" data-ra-pass>
      [
        {%- if template.name == 'collection' -%}
          {%- assign password = collection.metafields.custom.password_access_only -%}
          {%- assign hash = password | sha1 -%}

          {%- capture data -%}
          {
            "handle": "{{ collection.handle }}",
            "hash": "{{ hash }}"
          }
          {%- endcapture -%}

        {%- elsif template.name == 'product' -%}

          {%- for collection in product.collections -%}
            {%- assign password = collection.metafields.custom.password_access_only -%}

            {%- if password != blank -%}
              {%- assign hash = password | sha1 -%}

              {%- capture data -%}
              {{ data }}{%- if data != blank -%},{%- endif -%}
              {
                "handle": "{{ collection.handle }}",
                  "hash": "{{ hash }}"
              }
              {%- endcapture -%}

            {%- endif -%}
          {%- endfor -%}

        {%- endif -%}

        {{ data }}
      ]
    </script>
  </ra-pass-block>

  <style>
    [data-ra-pass-wrapper].loading form,
    [data-ra-pass-wrapper].loading .pass-image-overlay,
    [data-ra-pass-wrapper].loading .pass-bg-image,
    [data-ra-pass-wrapper] .khySpinner {
      display: none;
    }

    [data-ra-pass-wrapper].loading .khySpinner {
      display: block;
    }

    .pass-image-overlay {
      opacity: {{ overlay_opacity }};
    }

    ra-pass-block {
      font-family: "Monument Grotesk Regular", sans-serif !important;
      color: {{ color }} !important;
    }

    ra-pass-block form {
      input {
        box-sizing: border-box;
        border-radius: 12px;
        padding: 0 46px 0 16px;
        width: 100%;
        height: 50px;
        font-size: 16px;
        -webkit-text-size-adjust: 100%;
        letter-spacing: 0;
        border: 1px solid #000000;
        outline: none;
        font-weight: 500;
        color: rgb(30, 30, 30) !important;
        background-color: rgb(248, 248, 248);
      }

      input::placeholder {
        font-size: 16px !important;
        font-weight: 500 !important;
        color: rgb(30, 30, 30) !important;
      }

      .pass-toggle {
        position: absolute;
        top: 50%;
        right: 10px;
        transform: translateY(-50%);
        cursor: pointer;
        font-size: 12px;
        letter-spacing: 1px;
        color: #000000 !important;
      }

      input:hover,
      input:focus {
        border-color: #000000 !important;
      }

      button {
        background: #000000;
        border-radius: 12px;
        border-style: none;
        border-color: #000000;
        border-width: 2px;
        color: #ffffff;
        font-size: 16px;
        font-weight: 300;
        letter-spacing: 1px;
        line-height: 1.6;
        white-space: normal;
        padding-top: 0;
        padding-bottom: 0;
        text-align: center;
        word-break: break-word;
        align-self: flex-end;
        cursor: pointer;
        pointer-events: auto;
        height: 50px;
        width: 100%;
      }
    }

    .pass-description,
    .pass-custom-liquid {
      font-size: 14px;
      line-height: 1.6;
      letter-spacing: 0;
    }

    .pass-description p,
    .pass-custom-liquid p,
    .message-block,
    .message-block p {
      font-size: 14px;
      line-height: 1.6;
      letter-spacing: 0;
    }

    .pass-description a,
    .pass-custom-liquid a {
      text-decoration: underline;
      cursor: pointer;
    }

    .pass-description ul,
    .pass-description ol {
      text-align: left;
    }
  </style>
</div>
