{% comment %}
  Renders facets (filtering and sorting)

  Accepts:
  - results: {Object} Collection or Search object
  - enable_filtering: {Boolean} Show filtering when true
  - enable_sorting: {Boolean} Show sorting when true
  - filter_type: {String} Type of filter

  Usage:
{% render 'facets', results: collection, enable_filtering: true, enable_sorting: true, filter_type: 'vertical' %}
{% endcomment %}

{%- assign sort_by = results.sort_by | default: results.default_sort_by -%}
{%- assign total_active_values = 0 -%}
{%- assign current_collection_name = '' -%}

{%- if results.url -%}
  {%- assign results_url = results.url -%}
{%- else -%}
  {%- assign terms = results.terms | escape -%}
  {%- assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by -%}
{%- endif -%}

{%- capture facets_results -%}
  {%- if results.filters != empty and results.filters.size > 0 -%}

    {% comment %} -------------------results------------------ {% endcomment %}
    {% assign counter_result = 0 %}

    <div class="facets__results-wrapper active-facets">
      <div class="facets__results-list">
        {%- assign activeFilters = '' -%}

        {%- for filter in results.filters -%}
          {%- assign filter_label  = filter.label | handleize -%}
          {%- assign filter_url_to_remove  = filter.url_to_remove -%}

          {%- if filter.type == 'price_range' -%}
            {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
              {%- assign counter_result = counter_result | plus: 1 -%}

              <facet-remove class="facets__results-item facets__results-item-{{ counter }}" >
                <a href="{{ filter.url_to_remove }}" class="active-facets__button body3">
                  <span class="active-facets__button-inner">
                    {%- if filter.min_value.value -%}{{ filter.min_value.value | money }}{%- else -%}{{ 0 | money }}{%- endif -%}-{%- if filter.max_value.value -%}{{ filter.max_value.value | money }}{%- else -%}{{ filter.range_max | money }}{%- endif -%}
                  </span>

                  {% render 'icon', icon: 'close-small' %}
                  <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                </a>
              </facet-remove>
            {%- endif -%}
          {%- elsif filter.active_values.size > 0 and filter_label != 'availability' -%}
            {%- for value in filter.active_values -%}
              {%- assign counter_result = counter_result | plus: 1 -%}
              {%- assign activeFilters = activeFilters | append: value.label | append: ' ' -%}
              <facet-remove class="facets__results-item facets__results-item-{{ counter }}" data-active-category="{{ filter.label }}" data-active-value="{{ value.label }}">
                <a href="{{ value.url_to_remove }}" class="active-facets__button body3">
                  <span class="active-facets__button-inner">{{ value.label | escape }}</span>
                  {% render 'icon', icon: 'close-small' %}
                  <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                </a>
              </facet-remove>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}

        <facet-remove class="active-facets__button-remove-wrapper medium-up-hide js-filter" data-index="3">
          {% if counter_result > 0 %}
            <a href="{{ results_url }}" class="active-facets__button-remove facets__clear body3 {%- if counter_result == 0 %} visibility-hidden{% endif -%}">
              <span>{{ 'products.facets.clear' | t }}</span>
            </a>
          {% endif %}
        </facet-remove>
      </div>

      <div class="facets__heading-wrapper">
        <h5 class="facets__heading medium-hide body3 body3--bold ">
          {{ 'products.facets.filter_by_label' | t }} {%- if counter_result > 0 %} ({{ counter_result }}){%- endif -%}
        </h5>

        {%- if counter_result > 0 %}
          <facet-remove class="facets__results-item facets__results-item-{{ counter }}">
            <a href="{{ collection.url | sort_by: collection.sort_by }}" class="facets__clear body3" data-active-filters="{{ activeFilters }}">
              <span>{{ 'products.facets.clear' | t }}</span>

              <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
            </a>
          </facet-remove>
        {%- endif -%}
      </div>
    </div>
  {% endif %}
{%- endcapture -%}

<div class="facets-container">
  <facet-filters-form class="facets">
    <form id="FacetFiltersForm" class="facets__form">
      {%- if results.terms -%}
        <input type="hidden" name="q" value="{{ results.terms | escape }}">
        <input name="options[prefix]" type="hidden" value="last">
      {%- endif -%}

      {% if enable_filtering %}
        <div id="FacetsWrapperDesktop" class="facets__wrapper facets__wrapper--horizontal">
          {%- assign collections_arr = collection.metafields.navigation.collection_list -%}

          <div class="facets-inner--collections-list hide-scrollbar">
            {% if collections_list.links.size > 0 %}
              <ul class="facets-inner__list-horizontal">
                {% for link in collections_list.links %}
                  {% if  collection.url == link.url %}
                    {%- assign current_collection_name = link.title | handleize -%}
                  {% endif %}

                  <li class="list-menu__item facets__item body1 {% if collection.url == link.url %} active {% endif %}">
                    <a tabindex="0" href="{{ link.url }}">{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>

          {% comment %} -------------------sorting------------------ {% endcomment %}
          <div class="facet-filters__wrapper  {% if results.filters.size < 1 %} facet-filters__wrapper--only-sort {% endif %}">
            {% if results.filters.size > 0 %}
              <div class="facet-filters__modal-opener-wrapper medium-up-hide">
                <modal-opener>
                  <button
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-controls="#popup-modal-{{ section.id }}"
                    data-open-modal
                    class="facet-filters__modal-opener-btn btn--reset">
                    {% render 'icon' with 'filter' %}
                  </button>
                </modal-opener>

                {% comment %} -------------------results-clear_all------------------ {% endcomment %}

                <div id="FilterCount" class="active-facets__button-counter" data-index="3">
                  {%- if counter_result > 0 -%} ({{ counter_result }}) {% endif -%}
                </div>
              </div>
            {% endif %}

            <div class="product-count" role="status">
              <div class="product-count__text">
               <span id="ProductCount">
                 {{ results.products_count }} {{ results.products_count | pluralize: 'products.facets.product_count_simple.one', 'products.facets.product_count_simple.other' | t }}
               </span>
              </div>
            </div>

            {%- if enable_sorting -%}
            <div class="facet-filters">
              <div class="facet-filters__field">
                <div class="select">
                  {%- assign sort_by = results.sort_by | default: results.default_sort_by -%}
                  {%- assign feature_option = results.sort_options | where: 'value', sort_by -%}

                  {% if feature_option[0].name == blank %}
                    {%- assign feature_option = results.sort_options | where: 'value', Featured  -%}
                  {% endif %}

                    <custom-select class="form-select facet-filters__sort body3">
                      <button type="button" class="btn--reset form-select__btn a" tabindex="0" aria-expanded="false" aria-controls="dropdown-{{ section.id }}">
                        <span class="form-select__btn-text-label"> {{ 'products.facets.sort_by_label' | t }}</span>
                        <span class="form-select__btn-text">
                          {{ feature_option[0].name | escape | replace: 'Best selling', 'Featured' | replace: 'Price, low to high', 'Price: Low to High' | replace: 'Price, high to low', 'Price: High to Low' | replace: 'Date, new to old', 'Newest' }}
                        </span>

                       {%- render 'icon' with 'arrow-down' -%}
                      </button>

                    <ul class="form-select__dropdown" id="dropdown-{{ section.id }}" style="display: none;">
                      <li class="form-select__dropdown-option form-select__dropdown-option--label body3 body3--bold btn--reset">
                        {{ 'products.facets.sort_by_label' | t }}
                      </li>

                      {%- for option in results.sort_options -%}
                        {%- if option contains 'price-ascending' or option contains 'price-descending' or option contains 'Date, new to old' or option contains 'Best selling' -%}
                          <li class="form-select__dropdown-option a"
                              data-option-value="{{ option.value | escape }}" {% if option.value == sort_by %} aria-selected="true"{% else %} aria-selected="false"{% endif %}>
                            <button type="button" class="btn--reset form-select__dropdown-button body3 ">
                              {{ option.name | escape | replace: 'Best selling', 'Featured' | replace: 'Price, low to high', 'Price: Low to High' | replace: 'Price, high to low', 'Price: High to Low' | replace: 'Date, new to old', 'Newest' }}
                            </button>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>

                    <input  name="sort_by"
                            id="SortBy"
                            aria-describedby="a11y-refresh-page-message"
                            type="hidden"
                            class="form__input-hidden"
                            data-sort-by-input="true"
                            value="{{ feature_option[0].name | escape }}">
                  </custom-select>
                </div>
              </div>
            </div>
          {%- endif -%}
          </div>
        </div>

        {% if results.filters.size > 0 %}
          <div class="facets__wrapper--vertical" id="facets__wrapper--vertical-{{ section.id }}">
            {{ facets_results }}

            {% comment %} -------------------filters-accordion------------------ {% endcomment %}
            <div class="collection-modal">
              <modal-dialog id="popup-modal-{{ section.id }}" class="facets__modal hide-scrollbar">
                <div class="facets__modal-wrapper hide-scrollbar" data-popup aria-hidden="true">
                  <modal-opener class="facets__modal-close">
                    <button id="modal-close-{{ section.id }}" type="link"
                            aria-haspopup="true"
                            aria-expanded="false"
                            data-close-drawers
                            aria-controls="#popup-modal-{{ section.id }}"
                            class="medium-up-hide btn--reset"
                            aria-label="{{ 'accessibility.close' | t }}">
                      {% render 'icon' with 'close' %}
                    </button>
                  </modal-opener>

                  <div class="facets__wrapper--vertical-wrapper" role="dialog" aria-modal="true">
                    <h3 class="facet__filters-label h6 medium-up-hide">
                      {{ 'products.facets.filter_by_label' | t }}
                    </h3>

                    {%- for filter in results.filters -%}
                      {%- assign total_active_values = total_active_values | plus: filter.active_values.size -%}
                      {%- assign filter_label = filter.label | handleize -%}
                      {%- assign first_accordion = '' -%}

                      {% if current_collection_name != blank and current_collection_name == filter_label %}
                        {%- assign first_accordion = 'accordion--first' -%}
                      {% endif %}

                      {% case filter.type %}
                      {% when 'boolean' or 'list' %}
                        {%- unless filter_label == 'product-features' or filter_label == 'size' or filter_label == 'availability' -%}
                          <accordion-element
                            class="accordion {{ first_accordion }}"
                            style="--order: {{ forloop.index | plus: 2 }}"
                            data-match-media="max-width: 1023px">
                            <div class="accordion__item">
                              <button type="button"
                                      aria-expanded="false"
                                      class="body3 body3--bold btn--reset accordion__button"
                                      aria-controls="content-{{ forloop.index }}-{{ section.id }}"
                                      id="accordion-button-{{ forloop.index }}-{{ section.id }}">
                                <span class='footer__menu-list-heading filter-category-name body3--bold'>
                                  {{ filter.label | escape | replace: 'Product type', 'Category' | replace: 'Brand', 'Fabric' }}
                                </span>

                                <span class="accordion__icons block medium-up-hide">
                                  {% render 'icon' with 'arrow-down' %}
                                </span>
                              </button>

                              <div id="content-{{ forloop.index }}-{{ section.id }}"
                                   aria-labelledby="accordion-button-{{ forloop.index }}-{{ section.id }}"
                                   class="facets-inner facets-inner--{{ filter_label }} js-filter"
                                   data-index="4-{{ forloop.index }}">
                                <div class="facets-wrapper">
                                  <legend class="visually-hidden">{{ filter.label | escape }}</legend>

                                  <show-more class="facets-inner__list-accordion show-more no-js-hidden"
                                             aria-expanded="false"
                                             tabindex="-1"
                                             role="list"
                                             data-connected-target="{{ section.id }}-{{ filter.label | escape }}">
                                    <div data-show-more-body class="show-more__wrapper">
                                      {%- for value in filter.values limit: 5 -%}
                                        <div class="list-menu__item facets__item">
                                          <label tabindex="0"
                                                 class="facet-checkbox {% if value.count == 0 and value.active == false %} facet-checkbox--disabled{% endif %}">
                                            <input type="checkbox"
                                                   tabindex="-1"
                                                   data-disable-event-mobile
                                                   name="{{ value.param_name }}"
                                                   value="{{ value.value }}"
                                                   {% if value.active %}checked{% endif %}
                                                    data-category="{{ filter.label | escape | replace: 'Product type', 'Category' | replace: 'Brand', 'Fabric' }}"
                                              {% if value.count == 0 and value.active == false %}disabled{% endif %}>

                                            <span>{{ value.label | escape }}</span>
                                            <span class="visually-hidden">{{ value.label | escape }} ({% if value.count == 1 %}{{ 'products.facets.product_count_simple.one' | t: count: value.count }}{% else %}{{ 'products.facets.product_count_simple.other' | t: count: value.count }}{% endif %})</span>
                                          </label>
                                        </div>
                                      {%- endfor -%}

                                      {% if filter.values.size > 5 %}
                                        <div data-show-more-opener class="show-more__collapsible-wrapper">
                                          {%- for value in filter.values offset: 5 -%}
                                            <div class="list-menu__item facets__item">
                                              <label tabindex="0" class="facet-checkbox{% if value.count == 0 and value.active == false %} facet-checkbox--disabled{% endif %}">
                                                <input type="checkbox"
                                                       tabindex="-1"
                                                       data-disable-event-mobile
                                                       name="{{ value.param_name }}"
                                                       value="{{ value.value }}"
                                                       {% if value.active %}checked{% endif %}
                                                       data-category="{{ filter.label | escape | replace: 'Product type', 'Category' | replace: 'Brand', 'Fabric' }}"
                                                  {% if value.count == 0 and value.active == false %}disabled{% endif %}>

                                                <span>{{ value.label | escape }}</span>
                                                <span class="visually-hidden">{{ value.label | escape }} ({% if value.count == 1 %}{{ 'products.facets.product_count_simple.one' | t: count: value.count }}{% else %}{{ 'products.facets.product_count_simple.other' | t: count: value.count }}{% endif %})</span>
                                              </label>
                                            </div>
                                          {%- endfor -%}
                                        </div>

                                        <button type="button" data-show-more-heading class="show-more__btn btn--reset a">
                                      <span class="show-more__btn-text show-more__btn-text--more">
                                        {{ "products.facets.show_more" | t }}
                                      </span>

                                          <span class="show-more__btn-text show-more__btn-text--less">
                                       {{ "products.facets.show_less" | t }}
                                      </span>

                                          <span class="show-more__btn-icons block">
                                            {% render 'icon' with 'plus-small' %}
                                            {% render 'icon' with 'minus-small' %}
                                          </span>
                                        </button>
                                      {% endif %}
                                    </div>
                                  </show-more>
                                </div>
                              </div>
                            </div>
                          </accordion-element>
                        {%- endunless -%}
                      {% endcase %}
                    {%- endfor -%}
                  </div>

                  <button class="facet__button-mobile-submit btn btn--primary-alt medium-up-hide">{{ 'products.facets.apply' | t }}</button>
                </div>
              </modal-dialog>
            </div>
          </div>
        {% endif %}
      {%- endif -%}
    </form>
  </facet-filters-form>
</div>



