{% liquid
  assign swatch_color = product.title | split: "|" | last | strip
%}

{%  comment  %}
  Fabric swatches
{%  endcomment %}

{%- capture fabric_swatch_content -%}
  {%- render 'fabric-swatches' product: product -%}
{%- endcapture -%}

{%- capture product_tile_media -%}
  {%- render 'ra-product-tile-media', product: product -%}
{%- endcapture -%}

{
  "id": {{ product.id }},
  "has_size_guide": {% if product.metafields.custom.size_guide.value != nil %}
    true
    {% else %}
    false
    {% endif %},
  "available": {{ product.available | json }},
  "badge": {{ product.metafields.badge.label | replace: "'", "`" | json }},
  "badge_override": {{ product.metafields.badge.override | default: false }},
  "add_waitlist_tag": {% if product.tags contains "waitlist" %}true{% else %}false{% endif %},
  "add_no_waitlist_tag": {% if product.tags contains "no waitlist" %}true{% else %}false{% endif %},
  "add_preorder_tag": {% if product.tags contains "pre-order" %}true{% else %}false{% endif %},
  "buy_box_background_image": {{ product.metafields.custom.buy_box_background_image | image_url: 'master' | json }},
  "size_range": {{ product.metafields.custom.size_range | json }},
  "description": {{ product.description | replace: "'", "`" | strip_html | truncate: 200 | json }},
  "title": {{ product.title | replace: "'", "`" | json }},
  "handle": {{ product.handle | json }},
  "type": {{ product.type | replace: "'", "`" | json }},
  "vendor": {{ product.vendor | replace: "'", "`" | json }},
  "url": {{ product.url | json }},
  "price": {{ product.price | json }},
  "price_min": {{ product.price_min | json }},
  "price_max": {{ product.price_max | json }},
  "price_varies": {{ product.price_varies | json }},
  "compare_at_price":{{ product.compare_at_price | json }},
  "excerpt": {{ product.description | replace: "'", "`" | strip_html | truncate: 200 | json }},
  "published_at": {{ product.published_at | date: '%b %d, %Y' | json }},
  "tags": [
    {%- for tag in product.tags -%}
      {{ tag | replace: "'", "`" | json }}
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "collections": [
    {% for collection in product.collections %}
      {
        "title": {{ collection.title | replace: "'", "`" | json }}, "url": {{ collection.handle | json }}
      }
      {%- unless forloop.last -%},{%- endunless -%}
    {% endfor %}
  ],
  "options": [
    {%- for option in product.options -%}
      {{ option | replace: "'", "`" | json }}
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "options_with_values": {
    {%- for option in product.options_with_values -%}
      {{ option.name | replace: "'", "`" | json }}: [
      {% if option.name == 'Color' %}
        {%- for value in option.values -%}
          {% assign swatch_image = shop.metaobjects.color_swatch[value].image.value %}
          {
            {% if swatch_image.src != blank %}
              "url": "{{ swatch_image | image_url: width: 400 }}",
            {% endif %}
            "value": {{ value | replace: "'", "`" | json }}
          }
          {%- unless forloop.last %},{% endunless -%}
        {%- endfor -%}
      {% else%}
        {%- for value in option.values -%}
          {{ value | replace: "'", "`" | json }}
          {%- unless forloop.last %},{% endunless -%}
        {%- endfor -%}
      {% endif %}
      ]
      {%- unless forloop.last %},{% endunless -%}
    {%- endfor -%}
  },
  "featured_image": {{ product.featured_image | json }},
  "looks_product_image": {
    {%- if product.metafields.custom.looks_product_image.value -%}
      "default": [
        { "id": {{ product.metafields.custom.looks_product_image.value.id }}, "alt": {{ product.metafields.custom.looks_product_image.value.alt | replace: '"', '\"' | replace: "'", "`" | json }}, "sizes": { "xs":
        {{ product.metafields.custom.looks_product_image.value.src | image_url: width: 150 | json }}, "sm": {{ product.metafields.custom.looks_product_image.value.src | image_url: width: 640 | json }}, "md":
        {{ product.metafields.custom.looks_product_image.value.src | image_url: width: 860 | json }}, "lg": {{ product.metafields.custom.looks_product_image.value.src | image_url: width: 1200 | json }}, "xl":
        {{ product.metafields.custom.looks_product_image.value.src | image_url: width: 1600 | json }}, "original": {{ product.metafields.custom.looks_product_image.value.src | image_url: width: nil | json }} } }
      ]
    {%- endif -%}
  },
  "images": {
    {%- if product.images -%}
      "default": [
      {%- for image in product.images -%}
        { "id": {{ image.id }}, "alt": {{ image.alt | replace: '"', '\"' | replace: "'", "`" | json }}, "sizes": { "xs":
        {{ image.src | image_url: width: 150 | json }}, "sm": {{ image.src | image_url: width: 640 | json }}, "md":
        {{ image.src | image_url: width: 860 | json }}, "lg": {{ image.src | image_url: width: 1200 | json }}, "xl":
        {{ image.src | image_url: width: 1600 | json }}, "original": {{ image.src | image_url: width: nil | json }} } }
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
      ]
    {%- endif -%}
  },
  "variants_count": {{ product.variants.size | json }},
  "variants": [
    {%- for variant in product.variants -%}
      {
        "available": {{ variant.available | json }},
        {%- if variant.metafields.custom.back_in_stock -%}
          "back_in_stock": "{{ variant.metafields.custom.back_in_stock }}",
        {%- endif -%}
        "barcode": {{ variant.barcode | json }},
        "badge": {{ variant.metafields.badge.label | replace: "'", "`" | json }},
        "badge_override": {{ variant.metafields.badge.override | default: false }},
        "compare_at_price": {{ variant.compare_at_price | json }},
        "id": {{ variant.id }},
        "media": {
          "id": {{ variant.featured_media.id | default: '' | json }}
        },
        "image": {
          {%- if variant.image.id -%}
            "default": {
              "alt": {{ variant.image.alt | replace: "'", "`" | json }},
              "id": {%- if variant.image.id -%}{{ variant.image.id }}{%- else -%}""{%- endif -%},
              "sizes": {
                "sm": {{ variant.image.src | image_url: width: 640 | json }},
                "md": {{ variant.image.src | image_url: width: 860 | json }},
                "lg": {{ variant.image.src | image_url: width: 1200 | json }},
                "xl":{{ variant.image.src | image_url: width: 1600 | json }},
                "original": {{ variant.image.src | image_url: width: nil | json }}
              }
            }
          {%- endif -%}
        },
        "incoming": {{ variant.incoming | json }},
        "inventory_management": {{ variant.inventory_management | json }},
        "inventory_policy": {{ variant.inventory_policy | json }},
        "inventory_quantity": {{ variant.inventory_quantity }},
        "next_incoming_date": {{ variant.next_incoming_date | date: '%b %d, %Y' | json }},
        "options": [
          {{ variant.option1 | json }},
          {{ variant.option2 | json }},
          {{ variant.option3 | json }}
        ],
        "option1": {{ variant.option1 | json }},
        "option2": {{ variant.option2 | json }},
        "option3": {{ variant.option3 | json }},
        "price": {{ variant.price | json }},
        "requires_selling_plan": {{ variant.requires_selling_plan | json }},
        "requires_shipping": {{ variant.requires_shipping | json }},
        "selected": {{ variant.selected | json }},
        "selected_selling_plan_allocation": {{ variant.selected_selling_plan_allocation | json }},
        "selling_plan_allocations": {{ variant.selling_plan_allocations | json }},
        "sku": {{ variant.sku | json }},
        "taxable": {{ variant.taxable | json }},
        "title": {{ variant.title | json }},
        "url": {{ variant.url | json }},
        "weight":{{ variant.weight | json }},
        "weight_unit": {{ variant.weight_unit | json }},
        "weight_in_unit": {{ variant.weight_in_unit | json }}
      }
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "ship_on_date": {{ product.metafields.custom.ship_on_date.value | json }},
  "selling_fast_quantity": {{ product.metafields.custom.selling_fast_quantity | json }},
  "few_items_left_quantity": {{ product.metafields.custom.few_items_left_quantity | json }},
  "child_products": [
    {% for cp in product.metafields.custom.child_products.value %}
      {%- render 'json-child-product', product: cp, parent: cp.metafields.custom.parent_product.value -%}
      {%- unless forloop.last -%},{%- endunless -%}
    {% endfor %}
  ],
  {% if product.metafields.custom.parent_product %}
  "parent_product": {%- render "json-product-two", product: product.metafields.custom.parent_product.value -%},
  {% endif %}
  "color_swatch": {{ swatch_color | downcase | handle | append: '_swatch.png' | file_url | json }},
  "selected_variant": {{ product.selected_variant | json }},
  "has_only_default_variant": {{ product.has_only_default_variant | json }},
  "first_available_variant": {{ product.selected_or_first_available_variant | json }},
  {%- if order != blank -%}
    "order": {{ order }},
  {%- endif -%}
  "selected_selling_plan_allocation": {{ product.selected_selling_plan_allocation | json }},
  "selling_plan_groups": {{ product.selling_plan_groups | json }},
  "pre_order": {{ product.metafields.custom.pre_order.value | json }},
  "final_sale": {{ product.metafields.custom.final_sale_product.value | json }},
  "final_sale_message": {{ settings.final_sale_message | replace: "'", "`" | json }},
  "no_waitlist": {{ product.metafields.custom.no_waitlist.value | json }},
  "coming_soon": {{ product.metafields.custom.coming_soon.value | json }},
  "delayed": {{ product.metafields.custom.delayed.value | json }},
  "custom_badge": {{ product.metafields.custom.custom_badge | replace: "'", "`" | json }},
  "fabric_swatch_content": {{ fabric_swatch_content | replace: "'", "`" | json }},
  "sale_event_price": {{ product.metafields.custom.sale_event_price.value | times: 100.00 | json }},
  "sale_event_discount": {{ product.metafields.custom.sale_event_discount.value | times: 1 | json }},
  "product_tile_media_content": {{ product_tile_media | json }}
}
