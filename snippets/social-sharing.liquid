{%- comment -%}
  {% include 'social-sharing', block_settings: block.settings, share_link: article.url, share_title: article.title, share_permalink: article.url, share_image: article.image %}
{%- endcomment -%}

<ul class="social-sharing">
  {% if block_settings.share_twitter %}
    <li>
      <a class="share share--twitter" target="_blank"
         href="//twitter.com/share?text={{ share_title | url_param_escape }}&amp;url={{ shop.url | append: share_permalink }}">
        {% render 'icon' with 'twitter' %}
        <span class="visually-hidden">{{ 'general.social.alt_text.share_on_twitter' | t }}</span>
      </a>
    </li>
  {% endif %}

  {%- if block_settings.share_mail -%}
    <li>
      <a href="mailto:?subject={{ share_title | url_param_escape }}&amp;body=Check out this site {{ shop.url | append: share_permalink }}"
         title="Share by Email">
        {% render 'icon' with 'mail' %}
      </a>
    </li>
  {%- endif -%}

  {%- if block_settings.share_facebook -%}
    <li>
      <a class="share share--facebook" target="_blank"
         href="//www.facebook.com/sharer.php?u={{ shop.url | append: share_permalink }}">
        {% render 'icon' with 'facebook' %}
        <span class="visually-hidden">{{ 'general.social.alt_text.share_on_facebook' | t }}</span>
      </a>
    </li>
  {%- endif -%}

  {% if block_settings.share_link %}
    <li>
      <a class="share share--link" href="{{ shop.url | append: share_link }}">
        {%- render 'icon' with 'share' -%}
      </a>
    </li>
  {% endif %}

  {% if block_settings.share_pinterest %}
    <li>
      <a class="share share--pinterest" target="_blank"
         href="//pinterest.com/pin/create/button/?url={{ shop.url | append: share_permalink }}&amp;media={{ share_image | img_url: '1024x1024' }}&amp;description={{ share_title | url_param_escape }}">
        {% render 'icon' with 'pinterest' %}
      </a>
    </li>
  {% endif %}
</ul>
