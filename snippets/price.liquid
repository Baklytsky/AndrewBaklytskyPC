{% comment %}
  Renders a list of product's price (regular, sale)

  Accepts:
  - product: {Object} Product Liquid object (optional)
  - show_badges: {Boolean} Renders 'Sale' and 'Sold Out' tags if the product matches the condition (optional)
  - price_class: {String} Adds a price class to the price element (optional)
  - only_final: {Boolean}
  - interval: {Boolean}

  Usage:
{% render 'price', product: product %}
{% endcomment %}

{%- unless product.has_only_default_variant -%}
  {%- if product.price_min != product.price_max and interval -%}
    {%- assign max_price = product.price_max | money -%}
    {%- assign money_price = product.price_min | money | append: ' - ' | append: max_price -%}
    {%- assign price_interval = true -%}
  {%- endif -%}
{%- endunless -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant

  unless price_interval
    assign compare_at_price = current_variant.selected_selling_plan_allocation.compare_at_price | default: current_variant.compare_at_price
    assign price = current_variant.selected_selling_plan_allocation.price | default: current_variant.price | default: 1999

    assign compare_at_price_int = compare_at_price | times: 0.01
    assign price_int = price | times: 0.01

    if  compare_at_price > price
      assign percentage_sale = price_int | times: 100 | divided_by: compare_at_price_int
      assign percentage_sale = 100 | minus: percentage_sale | floor | append: "%"
    endif
  endunless

  assign available = current_variant.available | default: false

  unless price_interval
   assign money_price = price | money
  endunless
-%}

<div class="price
  {%- if price_class %} {{ price_class }}{% endif -%}
  {%- if show_badges %} price--show-badge{% endif -%}">

  <div class="price__container">
    {%- comment -%}
      Explanation of description list:
      - div.price__regular: Displayed when there are no variants on sale
      - div.price__sale: Displayed when a variant is a sale
    {%- endcomment -%}

    {% if compare_at_price > price and only_final != true %}
      <div class="price__sale">
        <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.sale_price' | t }}</span>
        <span class="price-item body3--bold price-item--sale" data-final-price> {{ money_price }} </span>

        {%- unless product.price_varies == false and product.compare_at_price_varies %}
          <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
          <span>
          <s class="price-item body3 price-item--regular color-text-secondary">
            {{ compare_at_price | money }}
          </s>
        </span>
        {%- endunless -%}
      </div>
    {% else %}
      <div class="price__regular body3--bold">
        <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
        <span class="price-item price-item--regular" data-final-price>
        {{ money_price }}
      </span>
      </div>

    {%- endif -%}
  </div>

  {%- if show_badges and compare_at_price > price -%}
    <div class="price__badge-sale body4">
      {{ 'products.product.on_sale' | t: percentage: percentage_sale }}
    </div>
  {% endif -%}
</div>
