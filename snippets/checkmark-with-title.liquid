{%- comment -%}
  {%- render 'checkmark-with-title', title: title, className: className -%}
{%- endcomment -%}

<div class="checkmark {{ className }}">
  {%- render 'icon' with 'checkmark' -%}
  {%- if title != blank -%}
    <span class="checkmark-title body3">{{ title }}</span>
  {%- endif -%}
</div>
