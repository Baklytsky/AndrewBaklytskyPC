{%- comment -%}
{%- render 'pdp-rx-only-details', product: product, section: section -%}
{%- endcomment -%}

<script src="{{ 'component-show-more.min.js' | asset_url }}" defer="defer"></script>
{%- comment -%}
  <script src="{{ 'component-notify-form.min.js' | asset_url }}" defer="defer"></script>
{%- endcomment -%}

{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign rx_badge_title = 'templates.physical_finder.badge_title' | t
  assign rx_safety_info_title = 'templates.physical_finder.safety_info_title' | t
  assign safety_information = product.metafields.accentuate.safety_information_show_more
-%}

<div class="pdp-details rel">
  {%- if rx_badge_title != blank or rx_safety_info_title != blank -%}
    <div class="pdp-details__rx-badge-wrapper">
      {%- if rx_badge_title != blank -%}
        <span class="pdp-details__rx-badge h6">{{ rx_badge_title }}</span>
      {%- endif -%}
      {%- if rx_safety_info_title != blank and safety_information != bank -%}
        <a href="#{{ section.id }}--safety_info" class="pdp-details__rx-badge-link">
          {{ rx_safety_info_title }}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}


  {%- for block in section.blocks -%}
    {%- case block.type -%}
    {%- when 'price' -%}
      {%- liquid assign price_class = 'pdp-details__price price--' | append: section.id -%}
      {%- render 'price', product: product, show_badges: true, price_class: price_class -%}
    {%- when 'subtitle' -%}
      {%- if product.metafields.accentuate.subtitle != blank -%}
        <div class="pdp-details__subtitle body2" {{ block.shopify_attributes }}>
          {{ product.metafields.accentuate.subtitle }}
        </div>
      {%- endif -%}
    {%- when 'info_label' -%}
    {%- liquid assign info_label = product.metafields.custom.info_label -%}
      {%- if info_label != blank -%}
        <div class="pdp-details__label h6" {{ block.shopify_attributes }}>
          {{ info_label }}
        </div>
      {%- endif -%}
    {%- when 'collection' -%}
      <div class="pdp-details__collections">
        {%- render 'product-featured-collections', product: product, class: 'pdp-details__collections-item body3' -%}
      </div>
    {%- when 'title' -%}
      <h3 class="pdp-details__title" {{ block.shopify_attributes }}>
        {{ product.title }}
      </h3>
    {%- when 'variant_picker' -%}
    {%- render 'pdp-rx-only-variant-radios', product: product, id: section.id -%}
    {%- when 'product-rx-form' -%}
    {%- render 'pdp-rx-only-details-form', product: product, id: product_form_id, block: block -%}
    {%- when 'skin_type_and_concern' -%}
    {%- render 'pdp-skin-type-and-concern', product: product, block: block -%}
    {%- when 'description' -%}
    {%- render 'pdp-description', product: product, block: block -%}
    {%- when 'ingredients' -%}
    {%- render 'pdp-ingredients', product: product, block: block -%}
    {%- when 'safety_information' -%}
    {%- render 'pdp-safety-info', product: product, block: block, id: section.id -%}
    {%- when '@app' -%}
    {% render block %}
    {%- endcase -%}
  {%- endfor -%}
</div>



