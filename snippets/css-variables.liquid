{% style %}
  @font-face {
    font-family: 'Boogy Brut Poster';
    font-style: normal;
    src: url('{{ "BoogyBrutPoster-White.otf" | asset_url }}') format("opentype");
    font-weight: 100;
    font-display: swap;
  }

  @font-face {
    font-family: 'Styrene B';
    src: url('{{ "StyreneB-Medium-Web.woff2" | asset_url }}') format('woff2'),
    url('{{ "StyreneB-Medium-Web.woff" | asset_url }}') format('woff');
    font-weight: 500;
    font-style: normal;
    font-stretch: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Styrene B';
    src: url('{{ "StyreneB-RegularItalic-Web.woff2" | asset_url }}') format('woff2'),
    url('{{ "StyreneB-RegularItalic-Web.woff" | asset_url }}') format('woff');
    font-weight: 400;
    font-style: italic;
    font-stretch: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Styrene B';
    src: url('{{ "StyreneB-Regular-Web.woff2" | asset_url }}') format('woff2'),
    url('{{ "StyreneB-Regular-Web.woff" | asset_url }}') format('woff');
    font-weight: 400;
    font-style: normal;
    font-stretch: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Styrene B';
    src: url('{{ "StyreneB-LightItalic-Web.woff2" | asset_url }}') format('woff2'),
    url('{{ "StyreneB-LightItalic-Web.woff" | asset_url }}') format('woff');
    font-weight: 300;
    font-style: italic;
    font-stretch: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Styrene B';
    src: url('{{ "StyreneB-Light-Web.woff2" | asset_url }}') format('woff2'),
    url('{{ "StyreneB-Light-Web.woff" | asset_url  }}') format('woff');
    font-weight: 300;
    font-style: normal;
    font-stretch: normal;
    font-display: swap;
  }

  :root {
    --font-primary: 'Styrene B', sans-serif;
    --font-secondary: 'Boogy Brut Poster', sans-serif;

    --font-body-style: normal;
    --font-body-weight: 400;

    --font-size-body-0:  {{ settings.body0_desk_size }}px;
    --font-size-body-0-mobile: {{ settings.body0_mobile_size }}px;
    --font-size-body-1:  {{ settings.body1_desk_size }}px;
    --font-size-body-1-mobile: {{ settings.body1_mobile_size }}px;
    --font-size-body-2: {{ settings.body2_desk_size }}px;
    --font-size-body-2-mobile: {{ settings.body2_mobile_size }}px;
    --font-size-body-3: {{ settings.body3_desk_size }}px;
    --font-size-body-3-mobile: {{ settings.body3_mobile_size }}px;
    --font-size-body-4: {{ settings.body4_desk_size }}px;
    --font-size-body-4-mobile: {{ settings.body4_mobile_size }}px;


    --font-size-heading-0: {{ settings.h0_desk_size }}px;
    --font-size-heading-mobile-0: {{ settings.h0_mobile_size }}px;
    --font-size-heading-1: {{ settings.h1_desk_size }}px;
    --font-size-heading-mobile-1: {{ settings.h1_mobile_size }}px;
    --font-size-heading-2: {{settings.h2_desk_size }}px;
    --font-size-heading-mobile-2: {{ settings.h2_mobile_size }}px;
    --font-size-heading-3: {{settings.h3_desk_size }}px;
    --font-size-heading-mobile-3: {{ settings.h3_mobile_size }}px;
    --font-size-heading-4: {{settings.h4_desk_size }}px;
    --font-size-heading-mobile-4: {{ settings.h4_mobile_size }}px;
    --font-size-heading-5: {{settings.h5_desk_size }}px;
    --font-size-heading-mobile-5: {{ settings.h5_mobile_size }}px;
    --font-size-heading-6: {{settings.h6_desk_size }}px;
    --font-size-heading-mobile-6: {{ settings.h6_mobile_size }}px;
    --font-size-heading-7: {{settings.h7_desk_size }}px;
    --font-size-heading-mobile-7: {{ settings.h7_mobile_size }}px;

    --button-font-size: 14px;

    --color-body-bg: {{ settings.color_bg_body }};
    --color-bg-primary: {{ settings.color_bg_primary }};

    --color-heading: {{ settings.color_text_heading }};

    --color-text-primary: {{ settings.color_text_body_primary }};
    --color-text-secondary: {{ settings.color_text_body_secondary }};
    --color-text-light: {{ settings.color_text_body_light }};

    --color-link-text: {{ settings.color_link_text }};
    --color-link-text-hover: {{ settings.color_link_text_hover }};

    --color-error: {{ settings.color_error }};

    --color-border: {{ settings.color_border }};

    --color-accent-primary: {{ settings.color_accent_primary }};
    --color-accent-secondary: {{ settings.color_accent_secondary }};

    --color-btn-primary-text: {{ settings.color_primary_button_text }};
    --color-btn-primary-text-hover: {{ settings.color_primary_button_hover_text }};
    --color-btn-primary-text-inactive: {{ settings.color_primary_button_inactive_text }};
    --color-btn-primary-bg: {{ settings.color_primary_button_bg }};
    --color-btn-primary-bg-hover: {{ settings.color_primary_button_bg_hover }};
    --color-btn-primary-bg-inactive: {{ settings.color_primary_button_bg_inactive }};
    --color-btn-primary-border: {{ settings.color_primary_button_border }};
    --color-btn-primary-border-hover: {{ settings.color_primary_button_border_hover }};
    --color-btn-primary-border-inactive: {{ settings.color_primary_button_border_inactive }};

    --color-btn-primary-alt-text: {{ settings.color_primary_alt_button_text }};
    --color-btn-primary-alt-text-hover: {{ settings.color_primary_alt_button_hover_text }};
    --color-btn-primary-alt-bg: {{ settings.color_primary_alt_button_bg }};
    --color-btn-primary-alt-bg-hover: {{ settings.color_primary_alt_button_bg_hover }};
    --color-btn-primary-alt-border: {{ settings.color_primary_alt_button_border }};
    --color-btn-primary-alt-border-hover: {{ settings.color_primary_alt_button_border_hover }};

    --color-btn-secondary-text: {{ settings.color_secondary_button_text }};
    --color-btn-secondary-text-hover: {{ settings.color_secondary_button_hover_text }};
    --color-btn-secondary-text-inactive: {{ settings.color_secondary_button_inactive_text }};
    --color-btn-secondary-bg: {{ settings.color_secondary_button_bg }};
    --color-btn-secondary-bg-hover: {{ settings.color_secondary_button_bg_hover }};
    --color-btn-secondary-bg-inactive: {{ settings.color_secondary_button_bg_inactive }};
    --color-btn-secondary-border: {{ settings.color_secondary_button_border }};
    --color-btn-secondary-border-hover: {{ settings.color_secondary_button_border_hover }};
    --color-btn-secondary-border-inactive: {{ settings.color_secondary_button_border_inactive }};

    --color-btn-secondary-alt-text: {{ settings.color_secondary_alt_button_text }};
    --color-btn-secondary-alt-text-hover: {{ settings.color_secondary_alt_button_hover_text }};
    --color-btn-secondary-alt-bg: {{ settings.color_secondary_alt_button_bg }};
    --color-btn-secondary-alt-bg-hover: {{ settings.color_secondary_alt_button_bg_hover }};
    --color-btn-secondary-alt-border: {{ settings.color_secondary_alt_button_border }};
    --color-btn-secondary-alt-border-hover: {{ settings.color_secondary_alt_button_border_hover }};

    --page-width: {{ settings.page_width }}px;

    --duration-short: 100ms;
    --duration-default: 200ms;
    --duration-long: 500ms;

    --right-arrow-url: url('{{ 'right-arrow.svg' | asset_url }}');
    --left-arrow-url: url('{{ 'left-arrow.svg' | asset_url }}');
    --right-arrow-action-url: url('{{ 'right-arrow-action.svg' | asset_url }}');
    --left-arrow-action-url: url('{{ 'left-arrow-action.svg' | asset_url }}');
    --search-icon-url: url('{{ 'search-icon.svg' | asset_url }}');
    --search-icon-black-url: url('{{ 'search-icon-black.svg' | asset_url }}');
    --filter-icon-url: url('{{ 'filter-icon.svg' | asset_url }}');
    --filter-icon-active-url: url('{{ 'filter-icon-active.svg' | asset_url }}');
    --partner-icon-url: url('{{ 'partner.svg' | asset_url }}');
    --checkmark-icon-url: url('{{ 'checkmark.svg' | asset_url }}');
{% endstyle %}


<script>
  if (!(((window || {}).CSS || {}).supports && window.CSS.supports('(--a: 0)'))) {
    const script = document.createElement('script');
    script.type = 'text/javascript';
    script.src = 'https://cdn.jsdelivr.net/npm/css-vars-ponyfill@2';
    script.onload = function () {
      cssVars({});
    };

    document.getElementsByTagName('head')[0].appendChild(script);
  }
</script>
