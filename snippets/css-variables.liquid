<style>
  :root {
    /*
      Color Pallete - Primary
    */
    --color-primary-900: {{ settings.color_primary_900 }};
    --color-primary-800: {{ settings.color_primary_800 }};
    --color-primary-700: {{ settings.color_primary_700 }};
    --color-primary-600: {{ settings.color_primary_600 }};
    --color-primary-500: {{ settings.color_primary_500 }};
    --color-primary-400: {{ settings.color_primary_400 }};
    --color-primary-300: {{ settings.color_primary_300 }};
    --color-primary-200: {{ settings.color_primary_200 }};
    --color-primary-100: {{ settings.color_primary_100 }};

    /*
      Color Pallete - Secondary
    */
    --color-secondary-900: {{ settings.color_secondary_900 }};
    --color-secondary-800: {{ settings.color_secondary_800 }};
    --color-secondary-700: {{ settings.color_secondary_700 }};
    --color-secondary-600: {{ settings.color_secondary_600 }};
    --color-secondary-500: {{ settings.color_secondary_500 }};
    --color-secondary-400: {{ settings.color_secondary_400 }};
    --color-secondary-300: {{ settings.color_secondary_300 }};
    --color-secondary-200: {{ settings.color_secondary_200 }};
    --color-secondary-100: {{ settings.color_secondary_100 }};

    /*
      Color Pallete - Tertiary
    */
    --color-tertiary-900: {{ settings.color_tertiary_900 }};
    --color-tertiary-800: {{ settings.color_tertiary_800 }};
    --color-tertiary-700: {{ settings.color_tertiary_700 }};
    --color-tertiary-600: {{ settings.color_tertiary_600 }};
    --color-tertiary-500: {{ settings.color_tertiary_500 }};
    --color-tertiary-400: {{ settings.color_tertiary_400 }};
    --color-tertiary-300: {{ settings.color_tertiary_300 }};
    --color-tertiary-200: {{ settings.color_tertiary_200 }};
    --color-tertiary-100: {{ settings.color_tertiary_100 }};

    /*
      Color Pallete - Grey Scales
    */
    --color-grey-900: {{ settings.color_grey_900 }};
    --color-grey-800: {{ settings.color_grey_800 }};
    --color-grey-700: {{ settings.color_grey_700 }};
    --color-grey-600: {{ settings.color_grey_600 }};
    --color-grey-500: {{ settings.color_grey_500 }};
    --color-grey-400: {{ settings.color_grey_400 }};
    --color-grey-300: {{ settings.color_grey_300 }};
    --color-grey-200: {{ settings.color_grey_200 }};
    --color-grey-100: {{ settings.color_grey_100 }};

    /*
      Color Pallete - Util
    */
    --color-util-red: {{ settings.color_util_red }};
    --color-util-green: {{ settings.color_util_green }};
    --color-util-yellow: {{ settings.color_util_yellow }};
    --color-util-white: {{ settings.color_util_white }};

    /*
      Button Colors - Primary
    */
    --btn-primary-bg-default: {{ settings.btn_primary_default_bg }};
    --btn-primary-bg-hover: {{ settings.btn_primary_hover_bg }};
    --btn-primary-text-default: {{ settings.btn_primary_default_text }};
    --btn-primary-text-hover: {{ settings.btn_primary_hover_text }};
    --btn-primary-border-default: {{ settings.btn_primary_default_border }};
    --btn-primary-border-hover: {{ settings.btn_primary_hover_border }};
    --btn-primary-outline-color: {{ settings.btn_primary_color_outline }};

    /*
      Button Colors - Secondary
    */
    --btn-secondary-bg-default: {{ settings.btn_secondary_default_bg }};
    --btn-secondary-bg-hover: {{ settings.btn_secondary_hover_bg }};
    --btn-secondary-text-default: {{ settings.btn_secondary_default_text }};
    --btn-secondary-text-hover: {{ settings.btn_secondary_hover_text }};
    --btn-secondary-border-default: {{ settings.btn_secondary_default_border }};
    --btn-secondary-border-hover: {{ settings.btn_secondary_hover_border }};
    --btn-secondary-outline-color: {{ settings.btn_secondary_color_outline }};

    /*
      Button Colors - Tertiary
    */
    --btn-tertiary-bg-default: {{ settings.btn_tertiary_default_bg }};
    --btn-tertiary-bg-hover: {{ settings.btn_tertiary_hover_bg }};
    --btn-tertiary-text-default: {{ settings.btn_tertiary_default_text }};
    --btn-tertiary-text-hover: {{ settings.btn_tertiary_hover_text }};
    --btn-tertiary-border-default: {{ settings.btn_tertiary_default_border }};
    --btn-tertiary-border-hover: {{ settings.btn_tertiary_hover_border }};
    --btn-tertiary-outline-color: {{ settings.btn_tertiary_outline_color }};

    /*
      Typography - Font families
    */
    --font-family-primary: {{ settings.primary_font }};
    --font-family-secondary: {{ settings.secondary_font }};
    --font-family-teritary: {{ settings.teritary_font }};
    --font-family-quaternary: {{ settings.quaternary_font }};

    /*
      Typography - Font sizes (reset Bedrock font sizes)
    */
    --display-desktop-size: {{ settings.display_desktop_size | append: 'px' }};
    --display-mobile-size: {{ settings.display_mobile_size | append: 'px' }};
    --h1-desktop-size: {{ settings.h1_desktop_size | append: 'px' }};
    --h1-mobile-size: {{ settings.h1_mobile_size | append: 'px' }};
    --h2-desktop-size: {{ settings.h2_desktop_size | append: 'px' }};
    --h2-mobile-size: {{ settings.h2_mobile_size | append: 'px' }};
    --h3-desktop-size: {{ settings.h3_desktop_size | append: 'px' }};
    --h3-mobile-size: {{ settings.h3_mobile_size | append: 'px' }};
    --h4-desktop-size: {{ settings.h4_desktop_size | append: 'px' }};
    --h4-mobile-size: {{ settings.h4_mobile_size | append: 'px' }};
    --h5-desktop-size: {{ settings.h5_desktop_size | append: 'px' }};
    --h5-mobile-size: {{ settings.h5_mobile_size | append: 'px' }};
    --h6-desktop-size: {{ settings.h6_desktop_size | append: 'px' }};
    --h6-mobile-size: {{ settings.h6_mobile_size | append: 'px' }};
    --font-size-lg: {{ settings.font_size_lage | default: 18 | append: 'px' }};
    --font-size: {{ settings.font_size_base | default: 16 | append: 'px' }};
    --font-size-sm: {{ settings.font_size_small | default: 13 | append: 'px' }};
    --font-size-xs: {{ settings.font_size_x_small | default: 12 | append: 'px' }};

    /*
      Form - Inputs
    */
    --input-border-color-default: var({{ settings.input_border_color_default }});
    --input-border-color-hover: var({{ settings.input_border_color_hover }});
    --input-text-color: var({{ settings.input_text_color }});
    --input-placeholder-color: var({{ settings.input_placeholder_color }});
    --input-outline-color: var({{ settings.input_outline_color }});
    --input-error-color: var({{ settings.input_error_color }});
    --input-disabled-border-color: var({{ settings.input_disabled_border }});
    --input-disabled-background-color: var({{ settings.input_disabled_background }});

    /*
      Primitives
    */
    --real-white: #ffffff;
    --white: #ECEAE5;
    --white-33: rgba(250, 250, 250, 0.33);
    --white-75: rgba(236, 234, 229, 0.75);
    --white-50: rgba(236, 234, 229, 0.50);
    --white-25: rgba(236, 234, 229, 0.25);
    --grey: #C0BEBA;
    --black: #28282A;
    --black-75: rgba(40, 40, 42, 0.75);
    --black-50: rgba(40, 40, 42, 0.50);
    --black-25: rgba(40, 40, 42, 0.25);


    /*
      Background Colors
      With Theme Setting Label
    */
    /* Primary */
    --bg-primary: #FAFAF9;
    /* Light */
    --bg-light: #ECEAE5;
    /* Dark */
    --bg-dark: var(--grey);
    /* Transparent */
    --bg-transparent: transparent;

    /*
      Text color
    */
    --text-primary: #28282A;
    --text-secondary: rgba(236, 234, 229, 0.50);
    --text-inverse-primary: #28282A;
    --text-inverse-secondary: rgba(40, 40, 42, 0.50);

    /*
      Stroke color
    */
    --stroke-primary: #ECEAE5;
    --stroke-inverse-primary: #28282A;
    --stroke-inverse-secondary: rgba(40, 40, 42, 0.25);
    --stroke-secondary: rgba(236, 234, 229, 0.25);
    --stroke-secondary-darker: rgba(40, 40, 42, 0.60);

    /* Media Width - 5:4 Images */

    --media-height: 1.25;
    --media-width: 1;


    /* Modal Opacity & Background */

    --modal-opacity: {{ settings.modal_opacity | divided_by: 100.00 }};
    --modal-background: rgba(26, 26, 26, var(--modal-opacity));

    /* Modal image is rendered at lower resolution because it is heavily blurred */
    {% if settings.modal_background_image != blank %}
    --modal-background-image: url('https:{{ settings.modal_background_image.src | img_url: '800x' }}');
    {% endif %}

    /* Cart */
    /* Cart Page Background Color */
    --cart-page-bg-color: var({{ settings.cart_page_background_color }});
    /* Cart CTA Background Color */
    --cart-cta-bg-color: var({{ settings.cart_CTA_BG_color }}, --white);

    /* Inline Cart Opacity & Background */

    --inline-cart-opacity: {{ settings.inline_cart_opacity | divided_by: 100.00 }};
    --inline-cart-background: rgba(26, 26, 26, var(--inline-cart-opacity));

    /* Cart Background image is rendered at lower resolution because it is heavily blurred */
    {% if settings.inline_cart_background_image != blank %}
    --inline-cart-background-image: url('https:{{ settings.inline_cart_background_image.src | img_url: '800x' }}');
    {% endif %}

    /*
      Surfaces color
    */
    --surfaces-glass: rgba(26, 26, 26, 0.30);
    --surfaces-dark: linear-gradient(0deg, rgba(0, 0, 0, 0.08) 0%, rgba(0, 0, 0, 0.08) 100%), rgba(214, 214, 214, 0.45);
    --surfaces-dark-hover: linear-gradient(0deg, rgba(0, 0, 0, 0.04) 0%, rgba(0, 0, 0, 0.04) 100%), rgba(214, 214, 214, 0.22);
    --surfaces-light: linear-gradient(0deg, rgba(94, 94, 94, 0.18) 0%, rgba(94, 94, 94, 0.18) 100%), rgba(255, 255, 255, 0.06);
    --surfaces-light-hover: linear-gradient(0deg, rgba(94, 94, 94, 0.09) 0%, rgba(94, 94, 94, 0.09) 100%), rgba(255, 255, 255, 0.03);

    /*
      Product card colors
    */
    --product-card-price-color: {{ settings.product_card_price_color }};
    --product-card-compare-at-price-color: {{ settings.product_card_compare_at_price_color }};
    --product-card-sale-price-color: {{ settings.product_card_sale_price_color }};
  }
</style>
