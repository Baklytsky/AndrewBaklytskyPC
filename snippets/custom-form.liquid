
{%- comment -%}
{%- render 'custom-form',
  action: action,
  blocks: section.blocks,
  id: 'refersion-form',
  class: 'refersion-form__form',
  bottom_text: bottom_text,
  error_message: error_message,
  success_message: success_message,
  is_subscribed: is_subscribed -%}
{%- endcomment -%}

<form action="{{ action | default: '#' }}" id="{{ id }}" class="{{ class }}">
  <input type="hidden" name="utf8" value="✓">

  {% for block in blocks %}
    {%- assign values = block.settings.values | split: ','  | uniq -%}
    {%- assign required = '' -%}
    {%- assign required_label = '' -%}
    {%- assign placeholder = block.settings.placeholder -%}
    {%- assign title = block.settings.title -%}
    {%- assign name = block.settings.name -%}
    {%- assign regex = block.settings.regex -%}
    {%- assign error_message = block.settings.error_message -%}
    {%- assign prefix = block.settings.prefix -%}

    {%- if name == blank -%}
      {%- assign name = title | handleize  -%}
    {%- endif -%}

    {%- if block.settings.required -%}
      {%- assign required = 'required' -%}
      {%- assign title = title | append: '*' -%}
    {%- endif -%}

    {% case block.type %}

    {% when 'hidden_value' %}
      <input type="hidden" name="{{ name }}" value="{{ block.settings.value }}">

    {% when 'email' %}
      <div class="custom-form__block form-field" {{ block.shopify_attributes }}>
        <label for="Form-{{ section.id }}-{{ forloop.index0 }}" class="form-label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ title | append: '*' }}</label>
        <input type="email"  class="form-input" id="Form-{{ section.id }}-{{ forloop.index0 }}" name="{{ name }}" placeholder="{{ placeholder }}" autocorrect="off" autocapitalize="off" required />
        <span class="form-error hide" data-invalid-message></span>
      </div>

    {% when 'password' %}
      <div class="custom-form__block form-field" {{ block.shopify_attributes }}>
        <label for="Form-{{ section.id }}-{{ forloop.index0 }}" class="form-label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ title | append: '*' }}</label>
        <input type="password"  class="form-input" id="Form-{{ section.id }}-{{ forloop.index0 }}" name="{{ name }}" placeholder="{{ placeholder }}" autocorrect="off" autocapitalize="off" required data-password />
        <span class="form-error hide" data-invalid-message></span>
      </div>
      {%- if block.settings.show_confirm_pass -%}
        <div class="custom-form__block form-field">
          <label for="Form-{{ section.id }}-{{ forloop.index0 }}-confirm" class="form-label {% if block.settings.confirm_hide_label %}visually-hidden{% endif %}">{{ block.settings.confirm_title | append: '*' }}</label>
          <input type="password"  class="form-input" id="Form-{{ section.id }}-{{ forloop.index0 }}-confirm" name="{{ block.settings.confirm_name }}" placeholder="{{ block.settings.confirm_placeholder }}" autocorrect="off" autocapitalize="off" required data-confirm-password />
          <span class="form-error hide" data-invalid-message></span>
        </div>
      {%- endif -%}

    {% when 'text' %}
      <div class="custom-form__block form-field" {{ block.shopify_attributes }}>
        <label for="Form-{{ section.id }}-{{ forloop.index0 }}" class="form-label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ title }}</label>
        <input type="text" class="form-input"
               id="Form-{{ section.id }}-{{ forloop.index0 }}"
               name="{{ name }}" placeholder="{{ placeholder }}"
               autocapitalize="words"
               value="" {{ required }}
              {% if regex != blank %}data-regex="{{ regex }}"{% endif %}
              {% if error_message != blank %}data-regex-error="{{ error_message }}"{% endif %}
              {% if prefix != blank %}data-prefix="{{ prefix }}"{% endif %}
        />
        <span class="form-error hide" data-invalid-message></span>
      </div>

    {% when 'textarea' %}
      <div class="custom-form__block form-field" {{ block.shopify_attributes }}>
        <label for="Form-{{ section.id }}-{{ forloop.index0 }}" class="form-label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ title }}</label>
        <textarea rows="7" class="form-textarea" id="Form-{{ section.id }}-{{ forloop.index0 }}" class="contactFormMessage" name="{{ name }}" placeholder="{{ placeholder }}" {{ required }}></textarea>
        <span class="form-error hide" data-invalid-message></span>
      </div>

    {% when 'phone' %}
      <div class="custom-form__block form-field" {{ block.shopify_attributes }}>
        <label for="Form-{{ section.id }}-{{ forloop.index0 }}" class="form-label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ title }}</label>
        <input type="tel"
               id="Form-{{ section.id }}-{{ forloop.index0 }}"
               class="form-input"
               name="{{ name }}"
               placeholder="{{ placeholder }}"
               value=""
          {{ required }}/>
        <span class="form-error hide" data-invalid-message></span>
      </div>

    {% when 'name' %}
      <div class="custom-form__block form-field" {{ block.shopify_attributes }}>
        <label  for="Form-{{ section.id }}-{{ forloop.index0 }}" class="label--hidden">{{ title }}</label>
        <input type="text" class="contactFormText" id="Form-{{ section.id }}-{{ forloop.index0 }}" name="{{ name }}" placeholder="{{ placeholder }}" autocapitalize="words" value="" {{ required }}/>
        <span class="form-error hide" data-invalid-message></span>
      </div>

    {% when 'radio' %}
      {%- if values.size > 0 -%}
        {%- assign index = forloop.index0 -%}

        <fieldset class="custom-form__block form-field--group form-field" {{ block.shopify_attributes }}>
          {% if title != blank %}
            <legend class="form-label custom-form__label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ title }}</legend>
          {% endif %}

          {%- for value in values -%}
            <div class="form-field--group-item">
              <input type="radio" id="Form-{{ section.id }}-{{ index }}-{{ forloop.index0 }}" class="form__radio visually-hidden" name="{{ name }}" {% if forloop.first %}checked{% endif %} value="{{ value }}" {{ required }}>
              <label for="Form-{{ section.id }}-{{ index }}-{{ forloop.index0 }}">{{ value }}</label>
            </div>
          {%- endfor -%}
          <span class="form-error hide" data-invalid-message></span>
        </fieldset>
      {%- endif -%}

    {% when 'select' %}
      {%- if values.size > 0 -%}
        <fieldset class="custom-form__block form-field" {{ block.shopify_attributes }}>
          <div class="small-up-hide">
            {% if title != blank %}
              <label for="Form-{{ section.id }}-{{ forloop.index0 }}" class="form-label custom-form__label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ title }}</label>
            {% endif %}
            <select id="Form-{{ section.id }}-{{ forloop.index0 }}" class="form__select {% if required != blank %}form__select--required{% endif %}" {{ required }} name="{{ name }}" data-original-select>
              <option value="" disabled selected>{{ title }}</option>
              {%- for value in values -%}
                <option value="{{ value }}">{{ value }}</option>
              {%- endfor -%}
            </select>
          </div>

          <div class="small-hide">
            {% if title != blank %}
              <label for="Form-{{ section.id }}-{{ forloop.index0 }}-custom" class="form-label custom-form__label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ title }}</label>
            {% endif %}

            <custom-select class="form-select body3 form-select-alternative">
              <button type="button" class="btn--reset form-select__btn" tabindex="0" aria-expanded="false" aria-controls="dropdown-day-{{ section.id }}-{{ forloop.index }}">
                <span class="form-select__btn-text">{{ title }}</span>

                {%- render 'icon' with 'arrow-down' -%}
              </button>

              <ul class="form-select__dropdown hide-scrollbar" id="dropdown-day-{{ section.id }}-{{ forloop.index }}" style="display: none;">
                {%- for value in values -%}
                  <li class="form-select__dropdown-option a" aria-selected="false"  data-option-value="{{ value }}">
                    <button type="button" class="btn--reset form-select__dropdown-button body3">{{ value }}</button>
                  </li>
                {%- endfor -%}
              </ul>

              <input name="{{ name }}" data-custom-select-input id="Form-{{ section.id }}-{{ forloop.index0 }}-custom" type="hidden" class="form__input-hidden {% if required != blank %}form__select--required{% endif %}" value="" {{ required }}>
            </custom-select>

          </div>
          <span class="form-error hide" data-invalid-message></span>
        </fieldset>
      {%- endif -%}

    {% when 'checkbox' %}
      <div class="custom-form__block form-field form-field__checkbox" {{ block.shopify_attributes }}>
        <input type="checkbox" id="Form-{{ section.id }}-{{ forloop.index0 }}" class="form-checkbox" name="{{ name }}" {% if block.settings.checked %}checked{% endif %} {{ required }}>
        <label for="Form-{{ section.id }}-{{ forloop.index0 }}" class="form-label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ title }}</label>
        <span class="form-error hide" data-invalid-message></span>
      </div>

    {% when 'province_select' %}
      <div class="custom-form__block form-field small-up-hide">
        <label for="address-province-new" class="form-label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ title }}</label>

        <select class="account__addresses-select province form__select"
                id="address-province-new"
                name="{{ name }}"
                data-original-select
                data-default=""
                autocomplete="address-level1"
                {{ required }}>
        </select>
        <span class="form-error hide" data-invalid-message></span>
      </div>

      <div class="custom-form__block form-field small-hide hidden" id="address-form-custom-province-new">
        <label for="address-province-new-custom" class="form-label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ title }}</label>

        <custom-select class="form-select body3 form-select-alternative small-hide">
          <button type="button" class="btn--reset form-select__btn" tabindex="0" aria-expanded="false" aria-controls="dropdown-province-{{ section.id }}">
            <span class="form-select__btn-text">{{ title }}</span>
            <span class="form-select__dropdown-option--label"></span>
            {%- render 'icon' with 'arrow-down' -%}
          </button>
          <ul class="form-select__dropdown hide-scrollbar" id="dropdown-province-{{ section.id }}" style="display: none;">

          </ul>
          <input name="{{ name }}"
                 id="address-province-custom-new"
                 type="hidden"
                 class="address-form__hidden-input form__input-hidden"
                 value=""
                 data-default=""
                 data-custom-select-input>
        </custom-select>
        <span class="form-error hide" data-invalid-message></span>
      </div>

    {% when 'country_select' %}
      <div data-country-select>
        <div class="custom-form__block form-field small-up-hide">
          <label for="address-country-new"
                 class="form-label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ title }}</label>
          <select id="address-country-new"
                  class="country form__select"
                  name="{{ name }}"
                  data-original-select
                  data-address-country-select
                  data-default=""
                  data-form-id="{{ section.id }}"
                  autocomplete="country">
            {{ all_country_option_tags | remove: '<option value="---" data-provinces="[]">---</option>' }}
          </select>
          <span class="form-error hide" data-invalid-message></span>
        </div>

        <div class="custom-form__block form-field small-hide">
          <label for="address-province-custom-new"
                 class="form-label {% if block.settings.hide_label %}visually-hidden{% endif %}">{{ title }}</label>

          <custom-select class="form-select body3 form-select-alternative address-custom-select">
            <button type="button" class="btn--reset form-select__btn" tabindex="0" aria-expanded="false"
                    aria-selected="true" aria-controls="dropdown-country-{{ section.id }}">
              <span class="form-select__btn-text">United States</span>
              <span class="form-select__dropdown-option--label"></span>
              {%- render 'icon' with 'arrow-down' -%}
            </button>
            <ul class="form-select__dropdown hide-scrollbar" id="dropdown-country-{{ section.id }}"
                style="display: none;" data-custom-select>
              {{ all_country_option_tags | remove: '<option value="---" data-provinces="[]">---</option>' | replace: '<option', '<li class="form-select__dropdown-option a" aria-selected="false">
                  <button type="button" class="btn--reset form-select__dropdown-button body3"' | replace: 'value', 'data-option-value' | replace: '</option>', '</button></li>' }}
            </ul>
            <input name="{{ name }}"
                   id="address-province-custom-new"
                   type="hidden"
                   class="form__input-hidden address-form__country-input"
                   data-select-province="#address-form-custom-province-new"
                   value="United States"
                   data-default="United States"
                   data-custom-select-input
              {{ required }}>
          </custom-select>
          <span class="form-error hide" data-invalid-message></span>
        </div>
      </div>
    {% endcase %}
  {% endfor %}

  <div class="form-field form-field__submit">
    <input type="submit" class="btn btn--primary-alt" value="{{ 'templates.contact.form.send' | t }}">
  </div>

  {% if error_message != blank %}
    <div class="body3 form-error hide" data-form-message="error">
      {{ error_message }}
    </div>
  {% endif %}

  {% if success_message != blank %}
    <div class="body3 form-success hide" data-form-message="success">
      {{ success_message }}
    </div>
  {% endif %}

  {% if is_subscribed != blank %}
    <div class="body3 form-is_subscribed hide" data-form-message="is-subscribed">
      {{ is_subscribed }}
    </div>
  {% endif %}

  <p class="body3 form-error hide" data-form-message="custom"></p>

  <div class="form-field form-field__required-label">
    <span class="body3 form-label">{{ 'templates.contact.form.required' | t }}</span>
  </div>

  {%- if bottom_text != blank -%}
    <p class="body3 form-label contact-form__bottom-text">{{ bottom_text }}</p>
  {%- endif -%}
</form>
