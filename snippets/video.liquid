{%- comment -%}
{%- render 'video',
  video: obj (MP4 video),
  video_youtube_vimeo: obj (Youtube/Vimeo video obj),
  video_url: str (video link),
  video_from_metafield: boolean (MP4 video from metafields),
  poster: img,
  poster_from_metafield: boolean (image from metafields),
  default_controls: boolean,
  controls_position: str (left/center/right)
  autoplay: boolean,
  show_mute_button: boolean,
  show_play_button: boolean,
  controls_color: str (color),
  disable_video_scale_on_desktop: boolean,
  disable_video_scale_on_mobile: boolean,
  class: str
-%}
{%- endcomment -%}

{%- liquid
  if default_controls
    assign default_controls_setting = 1
  else
    assign default_controls_setting = 0
  endif

  if autoplay
    assign video_autoplay = 1
  else
    assign video_autoplay = 0
  endif

  if video != blank
    assign video_type = 'mp4'
  elsif video_youtube_vimeo != blank
    assign video_type = video_youtube_vimeo.type
    assign video_id = video_youtube_vimeo.id
  elsif video_url != blank
    assign video_type = video_url.type
    assign video_id = video_url.id
    if video_url contains 'youtu'
      assign video_type = 'youtube'
      if video_url contains 'v='
        assign video_id = video_url | split: 'v=' | last
      else
        assign video_id = video_url | split: 'youtu.be/' | last
        if video_id contains '?si='
          assign video_id = video_id | split: '?si=' | first
        endif
      endif
    else
      assign video_id = video_url | split: 'vimeo.com/' | last
      assign video_type = 'vimeo'
    endif
  endif

  if controls_color == blank or controls_color == 'transparent'
    assign controls_color = '#FFF'
  endif
-%}

{%- capture video_options -%}
  {
  "videoType": {{ video_type | json }},
  "videoId": {{ video_id | json }},
  "autoplay": {{ video_autoplay }},
  "controls": {{ default_controls_setting }}
  }
{%- endcapture -%}


{% if video != blank or video_youtube_vimeo != blank or video_url != blank %}
  <video-component class='block media-video {{ class }} image-abs-cover
                  {% if video_type == 'mp4' %}normal{% endif %} controls-{{ controls_position }}'
                   data-video-options='{{ video_options }}'
                   style="--controls-color: {{ controls_color }}">
    {% if poster != blank %}
      <div class="media-video__poster js-video-poster">
        {%- if poster_from_metafield -%}
          {% render 'image-metafields',
            image: poster,
            class_name: 'image-abs-cover',
            no_leazy: true,
            alt: poster.alt %}
        {%- else -%}
          {% render 'image',
            image: poster,
            class_name: 'image-abs-cover',
            no_leazy: true,
            alt: poster.alt %}
        {%- endif -%}

        {% render 'icon' with 'large-play-btn' %}
      </div>
    {% endif %}

    {%- if disable_video_scale_on_desktop -%}
      {%- assign video_desk_classname = 'contain-desk' -%}
    {%- endif -%}

    {%- if disable_video_scale_on_mobile -%}
      {%- assign video_mob_classname = 'contain-mobile' -%}
    {%- endif -%}

    <div class='media-video-content'>
      <div class="js-video-wrapper {{ video_desk_classname }} {{ video_mob_classname }}">
        {% unless default_controls %}
          {%- if show_play_button -%}
            <button aria-label='Play Video'
                    class="js-video-play-button">
              <span class="u-sr-only">Play video</span>
              {% render 'icon' with 'play-btn' %}
            </button>
            <button aria-label='Pause Video'
                    class="js-video-pause-button">
              <span class="u-sr-only">Pause video</span>
              {% render 'icon' with 'pause' %}
            </button>
          {%- endif -%}

          {%- if show_mute_button -%}
            <button aria-label='Mute Video'
                    class="js-video-mute-button">
              <span class="u-sr-only">Mute video</span>
              {% render 'icon' with 'mic' %}
            </button>
            <button aria-label='Unmute Video'
                    class="js-video-unmute-button">
              <span class="u-sr-only">Unmute video</span>
              {% render 'icon' with 'mic-off' %}
            </button>
          {%- endif -%}
        {% endunless %}

        {% if video != blank %}

          {%- if video_from_metafield -%}
            <video id="videos" loop muted playsinline {% if autoplay %} autoplay {% endif %} {% if default_controls %} controls {% endif %}>
              <source src="{{ video.original_src }}#t=0.001" type="video/mp4">
            </video>
          {%- else -%}
            <video id="videos" loop muted playsinline {% if autoplay %} autoplay {% endif %} {% if default_controls %} controls {% endif %}>
              {%- for source in video.sources -%}
                <source src="{{ source.url }}#t=0.001" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          {%- endif -%}

        {% elsif video_url != blank or video_youtube_vimeo != blank %}
          <div class="js-video-mount" id="{{ video_id }}"></div>
        {% endif %}
      </div>
    </div>
  </video-component>
{% endif %}




