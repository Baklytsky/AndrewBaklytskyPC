<ul class="classic-pagination">
  {% if paginate.previous %}
    <li>
      <a href="{{ paginate.previous.url }}" title="{{ "general.pagination.previous" | t }}" class="classic-pagination__previous-page">
        {%- render 'icon' with 'arrow-down' -%}
      </a>
    </li>
  {% endif %}

  {% for part in paginate.parts %}
    {% if part.is_link %}
      <li class="classic-pagination__page-title">
        <a href="{{ part.url }}" aria-label="{{ "general.pagination.page" | t: part.title }}">{{ part.title }}</a>
      </li>
    {% else %}
      {% if part.title == paginate.current_page %}
        <li class="classic-pagination__page-title active"><a href="{{ part.url }}" aria-label="{{ "general.pagination.page" | t:number: part.title }}">{{ part.title }}</a></li>
      {% else %}
        <li class="classic-pagination__page-title"><a href="{{ part.url }}" aria-label="{{ "general.pagination.page" | t:number: part.title }}">{{ part.title }}</a></li>
      {% endif %}
    {% endif %}
  {% endfor %}

  {% if paginate.next %}
    <li>
      <a href="{{ paginate.next.url }}" title="{{ "general.pagination.next" | t }}" class="classic-pagination__next-page">
        {%- render 'icon' with 'arrow-down' -%}
      </a>
    </li>
  {% endif %}
</ul>
