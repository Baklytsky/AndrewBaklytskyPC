{% comment %}
    {% render 'article-card' blog: blog, article: article, description_truncate: num, show_date: boolean, show_author: boolean %}
{% endcomment %}

{%- liquid
  assign time_for_reading = article.metafields.main_info.time_for_reading
-%}


<article class="article-card">
  <div class="article-content">
    <div class="article-card__image-wrapper">
      <div class="article-card__image rel">
        <a href="{{ article.url }}">{{ article.title | escape }}</a>
        {%- if article.image != blank -%}
          {% render 'image', image: article.image, class_name: 'image-abs-cover', alt: article.title %}
        {%- else -%}
          <img src="{{ 'obagi_image_placeholder.jpg' | asset_img_url: 'master' }}" class="image-abs-cover" alt="{{ article.title }}">
        {%- endif -%}
      </div>
    </div>

    <div class="article-card__info">
      <header class="article-card__header">
        {%- if article.tags.size > 0 -%}
          <div class="article-card__tags body4">
            {%- for tag in article.tags -%}
             <span>{{ tag }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <h5 class="article-card__title">
          <a href="{{ article.url }}">{{ article.title | escape }}</a>
        </h5>
      </header>
      {%- if article.excerpt.size > 0 or article.content.size > 0 -%}
        <p class="article-card__excerpt rte body3">
          {%- if description_truncate > 0 -%}
            {%- if article.excerpt.size > 0 -%}
              {{ article.excerpt | strip_html | truncate: description_truncate }}
            {%- else -%}
              {{ article.content | strip_html | truncate: description_truncate }}
            {%- endif -%}
          {%- else -%}
            {%- if article.excerpt.size > 0 -%}
              {{ article.excerpt | strip_html | truncatewords: 12 }}
            {%- else -%}
              {{ article.content | strip_html | truncatewords: 12 }}
            {%- endif -%}
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- if show_date or show_author -%}
        <div class="article-card__bottom-info">
          <div class="article-card__date-wrapper">
            {%- if show_date -%}
              <span class="article-card__date body4">
                {{- article.published_at | time_tag: format: 'date' -}}
              </span>
            {%- endif -%}

            {%- if time_for_reading != blank -%}
              <span class="article-card__read-time body4">
                {{ time_for_reading }}
              </span>
            {%- endif -%}
          </div>

          {%- if show_author -%}
            <span class="article-card__author block body4">{{ article.author -}}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</article>
