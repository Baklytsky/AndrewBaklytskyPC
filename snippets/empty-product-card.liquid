{% comment %}
  {% render 'empty-product-card' id:  %}
{% endcomment %}

<div class="product-card">
  <div class="product-card__wrapper">
    <div class="product-card__img-wrapper">
      {{ 'product-1' | placeholder_svg_tag: 'product-card__image image-abs-cover' }}
    </div>

    <div class="product-card__reviews">
      <svg xmlns="http://www.w3.org/2000/svg" width="113" height="20" viewBox="0 0 113 20" fill="none">
        <path d="M10.5 0L12.8511 6.76393L20.0106 6.90983L14.3042 11.2361L16.3779 18.0902L10.5 14L4.62215 18.0902L6.69577 11.2361L0.989435 6.90983L8.14886 6.76393L10.5 0Z" fill="#FFB700"/>
        <path d="M33.5 0L35.8511 6.76393L43.0106 6.90983L37.3042 11.2361L39.3779 18.0902L33.5 14L27.6221 18.0902L29.6958 11.2361L23.9894 6.90983L31.1489 6.76393L33.5 0Z" fill="#FFB700"/>
        <path d="M56.5 0L58.8511 6.76393L66.0106 6.90983L60.3042 11.2361L62.3779 18.0902L56.5 14L50.6221 18.0902L52.6958 11.2361L46.9894 6.90983L54.1489 6.76393L56.5 0Z" fill="#FFB700"/>
        <path d="M79.5 0L81.8511 6.76393L89.0106 6.90983L83.3042 11.2361L85.3779 18.0902L79.5 14L73.6221 18.0902L75.6958 11.2361L69.9894 6.90983L77.1489 6.76393L79.5 0Z" fill="#FFB700"/>
        <path d="M102.5 0L104.851 6.76393L112.011 6.90983L106.304 11.2361L108.378 18.0902L102.5 14L96.6221 18.0902L98.6958 11.2361L92.9894 6.90983L100.149 6.76393L102.5 0Z" fill="#D2D2D2"/>
        <mask id="mask0_1714_96304" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="92" y="0" width="21" height="19">
          <path d="M102.5 0L104.851 6.76393L112.011 6.90983L106.304 11.2361L108.378 18.0902L102.5 14L96.6221 18.0902L98.6958 11.2361L92.9894 6.90983L100.149 6.76393L102.5 0Z" fill="#D9D9D9"/>
        </mask>
        <g mask="url(#mask0_1714_96304)">
          <rect x="92.5" width="16" height="20" fill="#FFB700"/>
        </g>
      </svg>
    </div>

    <a href="{{ routes.root_url }}" class="product-card__title body3">
      {{ 'products.card.empty_product_card_title' | t }}
    </a>

    <div class="price product-card__price">
      <div class="price__container">
          <div class="price__regular body3--bold">
            <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
            <span class="price-item price-item--regular">
              From $35.99
            </span>
          </div>
      </div>
    </div>

    <div class="product-card__btn-wrapper">
      <a href="{{ routes.root_url }}" class="product-card__btn btn btn--secondary btn--small"
         title="{{- 'products.card.button_label' | t -}}"
         aria-label="{{- 'products.card.button_label' | t -}}">
        {{- 'products.card.button_label' | t -}}
      </a>
    </div>
  </div>
</div>
