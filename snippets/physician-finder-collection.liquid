{%- comment -%}
{%- render 'physician-finder-collection',
  button_label: collection_button_label,
  button_link: collection_button_link,
  button_style: collection_button_style,
  show_promo_card: collection_promo_card_show,
  promo_card_image: collection_promo_card_image,
  promo_card_heading: collection_promo_card_heading,
  promo_card_link_label: collection_promo_card_link_label,
  promo_card_link_url: collection_promo_card_link_url,
  collection_promo_banner_show: collection_promo_banner_show
  collection_promo_banner_image: collection_promo_banner_image,
  collection_promo_banner_content_position: collection_promo_banner_content_position,
  collection_promo_banner_content_position_mobile: collection_promo_banner_content_position_mobile,
  collection_promo_banner_heading: collection_promo_banner_heading,
  collection_promo_banner_link_label: collection_promo_banner_link_label,
  collection_promo_banner_link_url: collection_promo_banner_link_url
-%}
{%- endcomment -%}

{{ 'collection.min.css' | asset_url | stylesheet_tag }}
{{ 'grid.min.css' | asset_url | stylesheet_tag }}
{{ 'collection-blocks.min.css' | asset_url | stylesheet_tag }}

<div id="finder-collection__inner" class="finder-collection__inner"></div>
<script id="finder-collection__source" type="text/x-handlebars-template">
  {% raw %}
    <div class="finder-collection__wrapper">
    {{#if products.length}}
    <div class="finder-collection__header">
     <h3 class="finder-collection__title">{{ title }}</h3>
     <span class="body3">{{ products.length }} Products Offered</span>
    </div>
      <ul class="collection__content-grid-list grid product-grid grid--2-col-tablet-down grid--3-col-desktop"
      style="--columns-desktop: 3; --columns-mobile: 2">
        {% endraw %}
          {%- if show_promo_card -%}
            <li class="collection__content-grid-list-item grid__item grid__item-promo {% raw %} {{#ifCond products.length '<' 2}} grid__item-promo--second-position {{else}} grid__item-promo--third-position {{/ifCond}} {% endraw %}">
                {%- render 'promo-card',
                  show_promo_card: show_promo_card,
                  promo_card_image: promo_card_image,
                  promo_card_heading: promo_card_heading,
                  promo_card_link_label: promo_card_link_label,
                  promo_card_link_url: promo_card_link_url
                -%}
            </li>
          {%- endif -%}
          {%- if collection_promo_banner_show -%}
            <li style="{% raw %}--column-position-mobile: {{ banner_mobile_position }}; --column-position-desktop: {{ banner_desktop_position }}{% endraw %}"
              class="collection__content-grid-list-item grid__item grid__item-promo-banner rel">
              {%- render 'promo-banner',
                show_banner: collection_promo_banner_show
                image: collection_promo_banner_image,
                content_position: collection_promo_banner_content_position,
                content_position_mobile: collection_promo_banner_content_position_mobile,
                heading: collection_promo_banner_heading,
                link_label: collection_promo_banner_link_label,
                link_url: collection_promo_banner_link_url -%}
            </li>
          {%- endif -%}
        {% raw %}
        {{#each products}}
          <li class="collection__content-grid-list-item grid__item">
            <product-card class="product-card rel">
              <div class="product-card__wrapper">
                <a href="{{ url }}" class="product-card__img-wrapper">
                  {{#if badge}}
                    <div class="product__badge-wrapper">
                    {{#ifCond badge '==' 'badge_1'}}
                      {% endraw %}
                        {%- if settings.badge_1 != blank -%}
                          {% render 'image', image: settings.badge_1, small_size: true %}
                        {%- endif -%}
                      {% raw %}
                    {{/ifCond}}
                    {{#ifCond badge '==' 'badge_2'}}
                      {% endraw %}
                        {%- if settings.badge_2 != blank -%}
                          {% render 'image', image: settings.badge_2, small_size: true %}
                        {%- endif -%}
                      {% raw %}
                    {{/ifCond}}
                    </div>
                  {{/if}}
                  {{#if media}}
                  <img src="{{ media.[0].[image].[src] }}" alt="{{ title }}" class="product-card__image image-abs-cover">
                    {{#if product_card_second_image}}
                      <img src="{{ product_card_second_image.[0].[src] }}" alt="{{ title }}" class="product-card__image--second image-abs-cover">
                    {{else}}
                      {{#if media.[1]}}
                        <img src="{{ media.[1].[image].[src] }}" alt="{{ title }}" class="product-card__image--second image-abs-cover">
                      {{/if}}
                    {{/if}}
                  {{else}}
                    {% endraw %}
                      <img src="{{ 'obagi_image_placeholder.jpg' | asset_img_url: 'master' }}"
                      class="product-card__image image-abs-cover" alt="{{ product.title }}">
                    {% raw %}
                  {{/if}}
                </a>
                <div class="product-card__content-wrapper flex__column-space">
                  <div class="product-card__info_label body4">
                    {{#if custom_info_label}}
                      {{ custom_info_label }}
                    {{/if}}
                  </div>
                  <div class="product-card__reviews">
                    <div data-bv-show="inline_rating" data-bv-product-id="{{ id }}" data-bv-redirect-url="{{ url }}"
                         data-bv-seo="false"></div>
                  </div>
                  <div class="product-card__main-info-wrapper flex__column-space">
                    <div class="product-card__collections">
                      {{#if collections}}
                        {{#each collections}}
                          <a href="{{ collection_url }}"
                          class="product-card__collections-item body4">{{ heading }} <span>,</span></a>
                        {{/each }}
                      {{/if}}
                    </div>
                    <a href="{{ url }}" class="product-card__title body3">
                      {{{ title }}}
                    </a>
                    <div class="product-card__payment-wrapper flex__column-space">
                      <div class="price price--show-badge">
                        <div class="price__container">
                          {{#ifCond selectedVariant.[compareAtPriceVal] '>' selectedVariant.[priceVal]}}
                            <div class="price__sale">
                              <span class="visually-hidden visually-hidden--inline">{% endraw %}{{ 'products.product.price.sale_price' | t }}{% raw %}</span>
                              <span class="price-item body3--bold price-item--sale" data-final-price> ${{selectedVariant.[price]}} </span>
                              <span class="visually-hidden visually-hidden--inline">{% endraw %}{{ 'products.product.price.regular_price' | t }}{% raw %}</span>
                              <span><s class="price-item body3 price-item--regular color-text-secondary">${{selectedVariant.[compareAtPrice]}}</s></span>
                            </div>
                          {{else}}
                            <div class="price__regular body3--bold">
                              <span class="visually-hidden visually-hidden--inline">{% endraw %}{{ 'products.product.price.regular_price' | t }}{% raw %}</span>
                              <span class="price-item price-item--regular" data-final-price>${{selectedVariant.[price]}}</span>
                            </div>
                          {{/ifCond}}
                        </div>
                        {{#ifCond selectedVariant.[compareAtPriceVal] '>' selectedVariant.[priceVal]}}
                          <div class="price__badge-sale body4">{{percentageSale}} off</div>
                        {{/ifCond}}
                      </div>

                      <div class="product-card__btn-wrapper">
                        {{#if bundle_variants.length}}
                          <product-bundle-form>
                            <form id="{{product_form_id}}"
                              class="form"
                              data-type="add-to-cart-form"
                              novalidate="novalidate"
                              enctype="multipart/form-data">
                              <button
                                id="{{ product_form_id }}-submit"
                                type="submit"
                                name="add"
                                class="quick-add__submit btn btn--secondary btn--small"
                                aria-haspopup="dialog"
                                aria-labelledby="{{ product_form_id }}-submit title-{{ sectionId }}-{{ id }}"
                                aria-live="polite"
                                data-sold-out-message="true"
                                {{#unless bundle_available}}
                                  disabled
                                {{/unless }}>
                                    <span class="product-form__submit-text">
                                      {{#if bundle_available}}
                                        {% endraw %}{{ 'products.product.add_to_cart' | t }}{% raw %}
                                      {{else}}
                                        {% endraw %}{{ 'products.product.sold_out' | t }}{% raw %}
                                      {{/if}}
                                    </span>
                                <div class="sold-out-message visually-hidden">
                                  {% endraw %}{{ 'products.product.sold_out' | t }}{% raw %}
                                </div>
                                <div class="loading-overlay__spinner hidden">
                                  {% endraw %}{% render 'icon' with 'spinner' %}{% raw %}
                                </div>
                              </button>

                              <div class="product-card__error-message-wrapper visually-hidden" role="alert" data-error-wrapper>
                                <span class="product-card__error-message" data-error-message></span>
                              </div>
                            </form>

                            <script type="application/ld+json" data-bundle-obj>
                              {
                                "price_without_discount": {{ selectedVariant.[compareAtPriceVal] }},
                                "price_with_discount": {{ selectedVariant.[priceVal] }},
                                "variants": [{{#each bundle_variants}}{"id": {{ id }} }{{#unless @last}},{{/unless}}{{/each }}],
                                "bundle_id": "{{bundle_uniq_id}}",
                                "bundle_title": "{{title}}",
                                "bundle_handle": "{{handle}}",
                                "bundle_image": "{{{featured_image_json}}}",
                                "bundle_url": "{{url}}",
                                "bundle_collections": [{{#if collections}}{{#each collections}}"{{heading}}"{{#unless @last}},{{/unless}}{{/each }}{{/if}}]
                              }
                            </{{!}}script>
                          </product-bundle-form>
                        {{else}}
                          {{#if hasOnlyDefaultVariant}}
                            {{#unless pre_order}}
                              <product-form>
                               <form id="{{product_form_id}}"
                                  class="form"
                                  data-type="add-to-cart-form"
                                  novalidate="novalidate"
                                  enctype="multipart/form-data">
                                  <input
                                    type="hidden"
                                    class="visually-hidden"
                                    name="id"
                                    value="{{ selectedVariant.[id] }}">

                                  {{#if pre_order }}
                                    <input
                                      type="hidden"
                                      class="pre-order--{{ selectedVariant.id }}"
                                      name="properties[Pre-Order]"
                                      value="{{ selectedVariant.[preOrderDateProp] }}">
                                  {{/if}}

                                  <button
                                    id="{{ product_form_id }}-submit"
                                    type="submit"
                                    name="add"
                                    class="quick-add__submit loading btn btn--secondary btn--small"
                                    aria-haspopup="dialog"
                                    aria-labelledby="{{ product_form_id }}-submit title-{{ sectionId }}-{{ id }}"
                                    aria-live="polite"
                                    data-sold-out-message="true"
                                    {{#unless available}}
                                      disabled
                                    {{/unless }}>
                                      <span class="product-form__submit-text">
                                        {{#if available }}
                                          {% endraw %}{{ 'products.product.add_to_cart' | t }}{% raw %}
                                        {{else}}
                                          {% endraw %}{{ 'products.product.sold_out' | t }}{% raw %}
                                        {{/if}}
                                      </span>
                                    <div class="sold-out-message visually-hidden"> {% endraw %}{{ 'products.product.sold_out' | t }} {% raw %}</div>
                                    <div class="loading-overlay__spinner ">
                                      {% endraw %}{% render 'icon' with 'spinner' %}{% raw %}
                                    </div>
                                  </button>

                                  <div class="product-card__error-message-wrapper visually-hidden" role="alert" data-error-wrapper>
                                    <span class="product-card__error-message" data-error-message></span>
                                  </div>
                                </form>
                              </product-form>

                              <a href="{{url}}" class="hidden product-card__btn  btn btn--secondary btn--small"
                                 title="{% endraw %}{{- 'products.card.button_label_second' | t -}}{% raw %}"
                                 aria-label="{% endraw %}{{- 'products.card.button_label_second' | t -}}{% raw %}">
                                {% endraw %}{{- 'products.card.button_label_second' | t -}}{% raw %}
                              </a>
                            {{/unless }}
                            {{#if pre_order }}
                            <a href="{{url}}" class="product-card__btn btn btn--secondary btn--small"
                               title="{% endraw %}{{ 'products.product.preorder' | t }}{% raw %}"
                               aria-label="{% endraw %}{{ 'products.product.preorder' | t }}{% raw %}">
                              {% endraw %}{{ 'products.product.preorder' | t }}{% raw %}
                            </a>
                            {{/if}}
                          {{else}}
                            {{#if pre_order }}
                            <a href="{{url}}" class="product-card__btn btn btn--secondary btn--small"
                               title="{% endraw %}{{ 'products.product.preorder' | t }}{% raw %}"
                               aria-label="{% endraw %}{{ 'products.product.preorder' | t }}{% raw %}">
                              {% endraw %}{{ 'products.product.preorder' | t }}{% raw %}
                            </a>
                            {{else}}
                            <a href="{{url}}" class="product-card__btn btn btn--secondary btn--small"
                               title="{% endraw %}{{- 'products.card.button_label' | t -}}{% raw %}"
                               aria-label="{% endraw %}{{- 'products.card.button_label' | t -}}{% raw %}">
                              {% endraw %}{{- 'products.card.button_label' | t -}}{% raw %}
                            </a>
                            {{/if}}
                          {{/if}}
                        {{/if}}

                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </product-card>
          </li>

        {{/each }}
      </ul>
      {% endraw %}
        {%- if button_label != blank -%}
          <a{% if button_link == blank %} role="link" aria-disabled="true" disabled{% else %}
            href="{{ button_link }}"{% endif %}
            class="finder-collection__shop-btn {% unless button_style == 'link' %}btn{% endunless %} btn--{{ button_style }}" {{ block.shopify_attributes }}>
            {{ button_label | escape }}
          </a>
        {%- endif -%}
      {% raw %}

    {{/if}}
    </div>
  {% endraw %}
</script>


